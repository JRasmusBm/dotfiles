#!/bin/sh
#
# docker-guard — kill a runaway Docker process before the Mac freezes.
#
# On 2026-11-24 Docker Desktop went from fine to ~30 GB and froze the
# Mac within seconds; the minute-by-minute memlog job never saw it.
# This polls every DOCKER_GUARD_INTERVAL (1) seconds with one ps and
# one awk, and SIGKILLs:
#   - any `docker-scout scout sbom` (Docker's image indexer: 3-30 GB,
#     never needed), whatever its size;
#   - any process under /Applications/Docker.app, Docker's Linux VM
#     (com.apple.Virtualization.VirtualMachine) or docker-scout whose
#     RSS exceeds DOCKER_GUARD_MB (4096).
# Both match the executable, never the arguments: a `claude -p`
# whose prompt mentions docker-scout is not docker-scout.
# Each kill goes to $LOCAL_CONFIG/memlog/docker-guard.log and `notify`.
# Run by launchd (com.jrasmusbm.docker-guard, KeepAlive).
#
#   docker-guard          loop forever
#   docker-guard once     one pass (tests)
#
# DOCKER_GUARD_MATCH overrides the size-checked regex,
# DOCKER_GUARD_SBOM the always-killed one, DOCKER_GUARD_NOTIFY the
# notifier (tests: `true`).

_dir="${LOCAL_CONFIG:-$HOME/.config/jrasmusbm}/memlog"
mkdir -p "$_dir"
_log="$_dir/docker-guard.log"
_mb="${DOCKER_GUARD_MB:-4096}"
_every="${DOCKER_GUARD_INTERVAL:-1}"
# Anchored at the command's start, so they see the executable (and,
# for sbom, its first arguments), never awk's own -v values.
_app='^/Applications/Docker[.]app/'
_vm='^[^ ]*/com[.]apple[.]Virtualization[.]VirtualMachine( |$)'
_scout='^([^ ]*/)?docker-scout( |$)'
_match="${DOCKER_GUARD_MATCH:-$_app|$_vm|$_scout}"
_sbom="${DOCKER_GUARD_SBOM:-^([^ ]*/)?docker-scout scout sbom( |$)}"
_notify="${DOCKER_GUARD_NOTIFY:-notify}"

_pass() {
  ps -axo pid=,rss=,command= | awk -v kb="$((_mb * 1024))" \
    -v m="$_match" -v s="$_sbom" -v lf="$_log" -v nf="$_notify" '
    {
      cmd = $0
      sub(/^ *[0-9]+ +[0-9]+ +/, "", cmd)
      if (!(cmd ~ s || ($2 > kb && cmd ~ m))) next
      system("kill -9 " $1)
      "date \"+%F %T\"" | getline now
      close("date \"+%F %T\"")
      printf "%s killed %d %dMB %s\n", now, $1, $2 / 1024,
        substr(cmd, 1, 200) >> lf
      fflush(lf)
      gsub(/["\\$`]/, "", cmd)
      system(nf " \"docker-guard\" \"killed " int($2 / 1024) \
        "MB: " substr(cmd, 1, 80) "\" >/dev/null 2>&1 &")
    }'
}

case "${1:-}" in
  once) _pass ;;
  "") while :; do _pass; sleep "$_every"; done ;;
  *) sed -n '3,24p' "$0" | cut -c3-; exit 2 ;;
esac
