#!/bin/sh
#
# wt-pr-watch [repo] — for each open PR of mine with a worktree, tell
# its agent (wt-tell: idle Claude, else it starts one) once per event:
#   - a types or lint job failed on the head commit, at once, while
#     the other checks still run (they take 10-15 minutes more; the
#     fix took 3): the tell names the jobs and their error lines.
#     Once per head sha. $WT_CI_FAST names the jobs (default
#     types|lint, an ERE).
#   - CI failed on the head commit, once every check finished (once
#     per head sha), naming only failures no early tell named. The
#     fix push usually replaced that sha by then: one turn, not two.
#     Or
#   - a person reviewed after the last push (once per newest review).
#     Other bots get no tell.
#   - CodeRabbit reviewed the head commit and opened new threads: the
#     tell gives their count and titles, once per review. A re-review
#     with no new threads sends nothing: a tell per push only re-read
#     the PR mid-fix and burned tokens. From its 3rd such round, one
#     still opening Critical or Major threads asks "split it, or ship
#     with deferrals?", and pings me too (once per PR).
#   - the stale bot labelled it (it closes the PR 7 days later; once
#     per head sha).
# Conflicts with dev get no tell: a rebase goes stale as dev moves and
# each force-push reruns CI, so the agent rebases only when it ships.
# Checks done, CLEAN, not draft, based on dev, no "do not merge": pings
# me as `merge` from its cli pane (once per head sha, a key shared with
# claude-notify's stop ping; not while a merge row is pending there, not
# when blocked or snoozed): a green PR whose agent sits idle still
# reaches me.
# Called by wt-sync every minute. A tell that no Claude took
# (not up yet, say) isn't recorded, so the next run retries it.

_repo="${1:-$PWD}"
cd "$_repo" || exit 0
_told="${LOCAL_CONFIG:?}/wt-told"
# <worktree> TAB <pr>:<sha> TAB <checks> per early tell: what the
# finished run's tell leaves out.
_early="$LOCAL_CONFIG/wt-ci-early"
_fastre="^(${WT_CI_FAST:-types|lint})$"
_board="$LOCAL_CONFIG/worktrees/$(basename "$(git rev-parse --show-toplevel)")"
_me="$(timeout 20 gh api user --jq .login 2>/dev/null)" || exit 0
# latestReviews, not reviews/comments/commits: those exceed GraphQL's
# node limit across ~30 PRs. Empty fields are "-": read with a tab IFS
# collapses consecutive tabs. A check reads "<job> (<workflow>)":
# two workflows each have a types job. Fast failures carry their job
# id for the log: "<check>=<job id>;...".
_prs="$(timeout 60 gh pr list --state open --author @me --limit 100 \
  --json number,headRefName,headRefOid,latestReviews,statusCheckRollup,labels \
  --jq 'def check: .name + (if (.workflowName // "") == "" then ""
      else " (\(.workflowName))" end);
    .[] | [.number, .headRefName, .headRefOid,
    ([.statusCheckRollup[]? | select(.conclusion == "FAILURE") | check]
      | unique | join(",")),
    ([.statusCheckRollup[]? | select(.status != null and .status != "COMPLETED")]
      | length),
    ([.latestReviews[]? | select(.author.login != "'"$_me"'"
        and (.author.login | test("coderabbit|bot$|\\[bot\\]$") | not))
      | .submittedAt]
      | max // ""),
    (if any(.labels[]?; .name == "stale") then "stale" else "" end),
    ([.statusCheckRollup[]? | select(.conclusion == "FAILURE"
        and (.name | test("'"$_fastre"'")))
      | check + "=" + ([(.detailsUrl // "")
        | match("/job/([0-9]+)").captures[0].string][0] // "")]
      | unique | join(";")),
    ([.latestReviews[]? | select(.author.login | test("coderabbit"))
      | .submittedAt] | max // "")]
    | map(if . == "" then "-" else . end) | @tsv')" || exit 0

# _errors <check>=<job id>;... — each failed job's error lines, the
# file eslint names above them, at most 20 per job.
_errors() {
  printf '%s\n' "$1" | tr ';' '\n' | while IFS='=' read -r _c _j; do
    test -n "$_j" || continue
    printf '\n%s:\n' "$_c"
    timeout 30 gh run view --job "$_j" --log-failed 2>/dev/null | awk '
      { l = $0; for (i = 0; i < 2; i++) l = substr(l, index(l, "\t") + 1)
        sub(/^[0-9][0-9T:.Z-]* /, "", l) }
      l ~ /^\/home\/runner\/work\// {
        f = l; sub(/^\/home\/runner\/work\/[^\/]*\/[^\/]*\//, "", f) }
      l ~ /^##\[error\]/ && l !~ /Process completed with exit code/ {
        sub(/^##\[error\] */, "", l)
        if (f != shown) { print f; shown = f }
        print substr(l, 1, 300)
        if (++n == 20) exit
      }'
    echo "(all of it: gh run view --job $_j --log-failed)"
  done
}

# _coderabbit <worktree> <pr> <sha> — tell each CodeRabbit review of
# <sha> that opened threads, once per review (cr:<pr>:<review id>); one
# that opened none is marked told here. Fails while a tell was not
# taken, so the caller retries next run. A round is a CodeRabbit
# review that opened threads, any sha; from round 3 on, one still
# opening a Critical or Major adds the rounds and their Majors and asks
# "split it, or ship with deferrals?" (RAS-126: #11829 took 7 rounds,
# 65 threads), and pings me the same, once per PR (cr-rounds:<pr>).
_coderabbit() {
  _ids="$(timeout 20 gh api --paginate \
    "repos/{owner}/{repo}/pulls/$2/reviews" --jq '.[]
    | select((.user.login | test("coderabbit")) and .commit_id == "'"$3"'")
    | .id' 2>/dev/null)" || return 1
  _new=""
  for _id in $_ids; do
    grep -qxF "$1	cr:$2:$_id" "$_told" 2>/dev/null || _new="$_new $_id"
  done
  test -n "$_new" || return 0
  # <review id> TAB <severity> TAB - <title> (<path>) per thread
  # CodeRabbit opened on the PR; the severity is its badge line's word.
  _all="$(timeout 20 gh api --paginate \
    "repos/{owner}/{repo}/pulls/$2/comments" --jq '.[]
    | select(.in_reply_to_id == null and (.user.login | test("coderabbit")))
    | [.pull_request_review_id,
      ([.body | split("\n")[]
        | capture("</picture> (?<s>[A-Za-z]+)\\*\\*") | .s][0] // "-"),
      "- " + ([.body | split("\n")[] | select(test("^\\*\\*[^<*]"))
          | gsub("\\*\\*"; "")][0] // "(untitled)")
        + " (" + .path + ")"] | @tsv' 2>/dev/null)" || return 1
  _rc=0
  for _id in $_new; do
    _threads="$(printf '%s\n' "$_all" | awk -F'\t' -v i="$_id" \
      '$1 == i { print $3 }')"
    if test -z "$_threads"; then
      echo "$1	cr:$2:$_id" >> "$_told"
      continue
    fi
    _n="$(printf '%s\n' "$_threads" | wc -l | tr -d ' ') thread"
    test "$_n" = "1 thread" || _n="${_n}s"
    # Critical and Major threads per round up to this review, in order.
    _majors="$(printf '%s\n' "$_all" | awk -F'\t' -v i="$_id" '
      $1 != "" && $1 + 0 <= i + 0 {
        r[$1]; m[$1] += ($2 == "Critical" || $2 == "Major") }
      END { for (k in r) print k, m[k] }' | sort -n | cut -d' ' -f2 \
      | paste -sd, -)"
    _round="$(printf '%s\n' "$_majors" | tr ',' '\n' | wc -l | tr -d ' ')"
    _rounds=""
    if test "$_round" -ge 3 && test "${_majors##*,}" -gt 0; then
      _rounds="
This is CodeRabbit's round $_round on this PR, still with new Critical \
or Major findings (Critical and Major per round: $_majors). It is not \
converging. Before more fixes, decide: split it, or ship with \
deferrals? I got the same question; tell me your pick and why.
"
      if ! grep -qxF "$1	cr-rounds:$2" "$_told" 2>/dev/null; then
        _pane="$(tmux display-message -p -t "=$(basename "$1"):cli" \
          '#{pane_id}' 2>/dev/null)" || _pane=""
        ( cd "$1" && TMUX_PANE="$_pane" NOTIFY_CLASS=blocked \
          notify "Claude: $(basename "$1")" "#$2: $_round CodeRabbit \
rounds, Majors $_majors. Split it, or ship with deferrals?" )
        echo "$1	cr-rounds:$2" >> "$_told"
      fi
    fi
    wt-tell "$1" "cr:$2:$_id" \
      "#$2 CodeRabbit opened $_n, no agent session" \
      "$(flow-lead red-check) CodeRabbit reviewed PR #$2 and opened \
$_n:
$_threads
$_rounds
Read them, then send what is right to a fresh builder subagent briefed \
with it: this thread writes no code. Push, reply on the threads, and \
tell me what it was." || _rc=1
  done
  return "$_rc"
}

git worktree list --porcelain | awk '
  /^worktree / { w = substr($0, 10) }
  /^branch / { sub("refs/heads/", "", $2); print w "\t" $2 }' \
  | while IFS="$(printf '\t')" read -r _wt _branch; do
    printf '%s\n' "$_prs" | awk -F'\t' -v b="$_branch" '$2 == b' \
      | while IFS="$(printf '\t')" read -r _pr _ _sha _fail _pend _fb _stale \
          _fast _cr; do
        _told_early="$(awk -F'\t' -v w="$_wt" -v k="$_pr:$_sha" \
          '$1 == w && $2 == k { print $3; exit }' "$_early" 2>/dev/null)"
        if test "$_fast" != - && test "$_pend" != 0 \
          && test -z "$_told_early"; then
          _names="$(printf '%s\n' "$_fast" | tr ';' '\n' \
            | sed 's/=[0-9]*$//' | sort -u | paste -sd, -)"
          wt-tell "$_wt" "ci-early:$_pr:$_sha" \
            "#$_pr CI failed ($_names), no agent session" \
            "$(flow-lead is-it-good) CI on PR #$_pr: $_names failed; \
the other checks still run. Their failures come in a later tell only \
if this commit is still the head when they finish. Errors:
$(_errors "$_fast")

Send the code fix to a fresh builder subagent briefed with these: this \
thread writes no code. Push, and tell me what it was." \
            && printf '%s\t%s:%s\t%s\n' "$_wt" "$_pr" "$_sha" "$_names" \
              >> "$_early"
        fi
        _new="$(awk -v f="$_fail" -v t="$_told_early" 'BEGIN {
          split(t, a, ","); for (i in a) told[a[i]]
          n = split(f, b, ",")
          for (i = 1; i <= n; i++) if (!(b[i] in told)) o = o "," b[i]
          print substr(o, 2) }')"
        if test "$_fail" != - && test "$_pend" = 0 && test -n "$_new"; then
          _also=""
          test -z "$_told_early" \
            || _also=", besides the $_told_early I told you about"
          wt-tell "$_wt" "ci:$_pr:$_sha" \
            "#$_pr CI failed ($_new), no agent session" \
            "$(flow-lead is-it-good) CI failed on PR #$_pr ($_new$_also). \
Read the failure, then send the code fix to a fresh builder subagent \
briefed with it: this thread writes no code. Push, and tell me what it \
was."
        fi
        _push=""
        test "$_fb" = - \
          || grep -qxF "$_wt	feedback:$_pr:$_fb" "$_told" 2>/dev/null \
          || _push="$(timeout 20 gh api \
          "repos/{owner}/{repo}/commits/$_sha" \
          --jq .commit.committer.date 2>/dev/null)"
        if test "$_fb" != - && test -n "$_push" && test "$_fb" \> "$_push"; then
          wt-tell "$_wt" "feedback:$_pr:$_fb" \
            "#$_pr has new review comments, no agent session" \
            "$(flow-lead is-it-good) PR #$_pr has review feedback \
newer than your last push ($_fb). Please read it, address what is right, push, and reply on the \
threads."
        fi
        if test "$_cr" != - \
          && ! grep -qxF "$_wt	cr-seen:$_pr:$_cr" "$_told" 2>/dev/null \
          && _coderabbit "$_wt" "$_pr" "$_sha"; then
          echo "$_wt	cr-seen:$_pr:$_cr" >> "$_told"
        fi
        if test "$_stale" = stale; then
          wt-tell "$_wt" "stale:$_pr:$_sha" \
            "#$_pr marked stale, closes in 7 days, no agent session" \
            "$(flow-lead waiting) The stale bot marked PR #$_pr stale; \
it closes the PR 7 days later. Move it forward and push, or if it is no longer wanted, tell me why."
        fi
        test "$_fail" = - && test "$_pend" = 0 || continue
        ! grep -qxF "$_wt	merge-ping:$_pr:$_sha" "$_told" 2>/dev/null \
          || continue
        # pr list reports mergeStateStatus UNKNOWN until a view computes it.
        _state="$(timeout 20 gh pr view "$_pr" \
          --json mergeStateStatus,isDraft,baseRefName,body --jq '
          if (.isDraft | not) and .mergeStateStatus == "CLEAN"
            and .baseRefName == "dev"
            and ((.body // "") | test("do not merge"; "i") | not)
          then "ready" else "-" end' 2>/dev/null)" || continue
        _slug="$(basename "$_wt")"
        if test "$_state" = ready \
          && case "$_wt" in */.worktrees/?*) true ;; *) false ;; esac \
          && ! cut -f1 "$_board.snoozed" 2>/dev/null | grep -qxF "$_slug" \
          && ! cut -f1 "$_board.blocked" 2>/dev/null | grep -qxF "$_slug" \
          && ! awk -F'\t' -v p="$_wt" '$5 == p && $8 == "merge" { f = 1 }
            END { exit !f }' "$LOCAL_CONFIG/notifications" 2>/dev/null; then
          echo "$_wt	merge-ping:$_pr:$_sha" >> "$_told"
          _pane="$(tmux display-message -p -t "=$_slug:cli" '#{pane_id}' \
            2>/dev/null)" || _pane=""
          ( cd "$_wt" && TMUX_PANE="$_pane" NOTIFY_CLASS=merge \
            notify "Claude: $_slug" "READY TO MERGE #$_pr" )
        fi
      done
  done
