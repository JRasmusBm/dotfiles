#!/bin/sh
#
# wt-pr-watch [repo] — for each open PR of mine with a worktree, tell
# its agent (wt-tell: idle Claude, else it starts one) once per event:
#   - CI failed on the head commit (once per head sha), or
#   - someone else reviewed after the last push (once per newest review),
#   - the stale bot labelled it (it closes the PR 7 days later; once
#     per head sha).
# Conflicts with dev get no tell: a rebase goes stale as dev moves and
# each force-push reruns CI, so the agent rebases only when it ships.
# Checks done, CLEAN, not draft, based on dev, no "do not merge": pings
# me as `merge` from its cli pane (once per head sha, not while a merge
# row is pending there, not when blocked or snoozed). `wt rd` clears
# the inbox, so without this a parked PR never comes back to me.
# Called by wt-sync every 5th minute. A tell that finds Claude busy
# or not up yet isn't recorded, so the next run retries it.

_repo="${1:-$PWD}"
cd "$_repo" || exit 0
_told="${LOCAL_CONFIG:?}/wt-told"
_board="$LOCAL_CONFIG/worktrees/$(basename "$(git rev-parse --show-toplevel)")"
_me="$(timeout 20 gh api user --jq .login 2>/dev/null)" || exit 0
# latestReviews, not reviews/comments/commits: those exceed GraphQL's
# node limit across ~30 PRs. Empty fields are "-": read with a tab IFS
# collapses consecutive tabs.
_prs="$(timeout 60 gh pr list --state open --author @me --limit 100 \
  --json number,headRefName,headRefOid,latestReviews,statusCheckRollup,labels \
  --jq '.[] | [.number, .headRefName, .headRefOid,
    ([.statusCheckRollup[]? | select(.conclusion == "FAILURE") | .name]
      | unique | join(",")),
    ([.statusCheckRollup[]? | select(.status != null and .status != "COMPLETED")]
      | length),
    ([.latestReviews[]? | select(.author.login != "'"$_me"'") | .submittedAt]
      | max // ""),
    (if any(.labels[]?; .name == "stale") then "stale" else "" end)]
    | map(if . == "" then "-" else . end) | @tsv')" || exit 0

git worktree list --porcelain | awk '
  /^worktree / { w = substr($0, 10) }
  /^branch / { sub("refs/heads/", "", $2); print w "\t" $2 }' \
  | while IFS="$(printf '\t')" read -r _wt _branch; do
    printf '%s\n' "$_prs" | awk -F'\t' -v b="$_branch" '$2 == b' \
      | while IFS="$(printf '\t')" read -r _pr _ _sha _fail _pend _fb _stale; do
        if test "$_fail" != - && test "$_pend" = 0; then
          wt-tell "$_wt" "ci:$_pr:$_sha" \
            "#$_pr CI failed ($_fail), no agent session" \
            "CI failed on PR #$_pr ($_fail). Please look at the failure, \
fix it, push, and tell me what it was."
        fi
        _push=""
        test "$_fb" = - || _push="$(timeout 20 gh api \
          "repos/{owner}/{repo}/commits/$_sha" \
          --jq .commit.committer.date 2>/dev/null)"
        if test "$_fb" != - && test -n "$_push" && test "$_fb" \> "$_push"; then
          wt-tell "$_wt" "feedback:$_pr:$_fb" \
            "#$_pr has new review comments, no agent session" \
            "PR #$_pr has review feedback newer than your last push \
($_fb). Please read it, address what is right, push, and reply on the \
threads."
        fi
        if test "$_stale" = stale; then
          wt-tell "$_wt" "stale:$_pr:$_sha" \
            "#$_pr marked stale, closes in 7 days, no agent session" \
            "The stale bot marked PR #$_pr stale; it closes the PR 7 days \
later. Move it forward (CI, reviews, what is left to the \
hand-back bar) and push, or if it is no longer wanted, tell me why."
        fi
        test "$_fail" = - && test "$_pend" = 0 || continue
        # pr list reports mergeStateStatus UNKNOWN until a view computes it.
        _state="$(timeout 20 gh pr view "$_pr" \
          --json mergeStateStatus,isDraft,baseRefName,body --jq '
          if (.isDraft | not) and .mergeStateStatus == "CLEAN"
            and .baseRefName == "dev"
            and ((.body // "") | test("do not merge"; "i") | not)
          then "ready" else "-" end' 2>/dev/null)" || continue
        _slug="$(basename "$_wt")"
        if test "$_state" = ready \
          && case "$_wt" in */.worktrees/?*) true ;; *) false ;; esac \
          && ! cut -f1 "$_board.snoozed" 2>/dev/null | grep -qxF "$_slug" \
          && ! grep -qxF "$_wt	merge-ping:$_pr:$_sha" "$_told" 2>/dev/null \
          && ! cut -f1 "$_board.blocked" 2>/dev/null | grep -qxF "$_slug" \
          && ! awk -F'\t' -v p="$_wt" '$5 == p && $8 == "merge" { f = 1 }
            END { exit !f }' "$LOCAL_CONFIG/notifications" 2>/dev/null; then
          echo "$_wt	merge-ping:$_pr:$_sha" >> "$_told"
          _pane="$(tmux display-message -p -t "=$_slug:cli" '#{pane_id}' \
            2>/dev/null)" || _pane=""
          ( cd "$_wt" && TMUX_PANE="$_pane" NOTIFY_CLASS=merge \
            notify "Claude: $_slug" "READY TO MERGE #$_pr" )
        fi
      done
  done
