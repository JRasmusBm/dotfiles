#!/bin/sh
#
# wt-pr-watch [repo] — for each open PR of mine with a worktree, tell
# its agent (wt-tell: idle Claude, else it starts one) once per event:
#   - CI failed on the head commit (once per head sha), or
#   - someone else reviewed after the last push (once per newest review).
# Called by wt-sync every 5th minute. A tell that finds Claude busy
# or not up yet isn't recorded, so the next run retries it.

_repo="${1:-$PWD}"
cd "$_repo" || exit 0
_me="$(timeout 20 gh api user --jq .login 2>/dev/null)" || exit 0
# latestReviews, not reviews/comments/commits: those exceed GraphQL's
# node limit across ~30 PRs.
_prs="$(timeout 60 gh pr list --state open --author @me --limit 100 \
  --json number,headRefName,headRefOid,latestReviews,statusCheckRollup \
  --jq '.[] | [.number, .headRefName, .headRefOid,
    ([.statusCheckRollup[]? | select(.conclusion == "FAILURE") | .name]
      | unique | join(",")),
    ([.statusCheckRollup[]? | select(.status != null and .status != "COMPLETED")]
      | length),
    ([.latestReviews[]? | select(.author.login != "'"$_me"'") | .submittedAt]
      | max // "")] | @tsv')" || exit 0

git worktree list --porcelain | awk '
  /^worktree / { w = substr($0, 10) }
  /^branch / { sub("refs/heads/", "", $2); print w "\t" $2 }' \
  | while IFS="$(printf '\t')" read -r _wt _branch; do
    printf '%s\n' "$_prs" | awk -F'\t' -v b="$_branch" '$2 == b' \
      | while IFS="$(printf '\t')" read -r _pr _ _sha _fail _pend _fb; do
        if test -n "$_fail" && test "$_pend" = 0; then
          wt-tell "$_wt" "ci:$_pr:$_sha" \
            "#$_pr CI failed ($_fail), no agent session" \
            "CI failed on PR #$_pr ($_fail). Please look at the failure, \
fix it, push, and tell me what it was."
        fi
        _push=""
        test -z "$_fb" || _push="$(timeout 20 gh api \
          "repos/{owner}/{repo}/commits/$_sha" \
          --jq .commit.committer.date 2>/dev/null)"
        if test -n "$_fb" && test -n "$_push" && test "$_fb" \> "$_push"; then
          wt-tell "$_wt" "feedback:$_pr:$_fb" \
            "#$_pr has new review comments, no agent session" \
            "PR #$_pr has review feedback newer than your last push \
($_fb). Please read it, address what is right, push, and reply on the \
threads."
        fi
      done
  done
