#!/bin/sh

# tmux status badge: the current worktree's board section
# (`wt` order file), as coloured text. Blocked wins, then an
# active `wt w8` (`w8 15:40 <what…>`, red `overdue` once past
# its deadline; the reason is cut to $WT_BADGE_W8_LEN, 24),
# then the section. A worktree on a priority (`prio rank`) gets
# `P0 #N` first; in the board's `# P0` section, the section shown is
# the one it came from. Prints nothing outside a worktree.
# Usage: wt-badge [dir]

cd "${1:-.}" 2>/dev/null || exit 0
_top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
case "$_top" in
  */.worktrees/?*) ;;
  *) exit 0 ;;
esac
_root="${_top%%/.worktrees/*}"
_slug="${_top##*/}"
_branch="$(git branch --show-current 2>/dev/null)"
_cfg="${LOCAL_CONFIG:-$HOME/.local-config}/worktrees/${_root##*/}"
_p0=""
_n="$(prio rank "$_branch" 2>/dev/null || prio rank "$_slug" 2>/dev/null)" \
  && _p0="#[fg=red,bold]P0 ##$_n#[default] "

if test -f "$_cfg.blocked" \
  && awk -F '\t' -v s="$_slug" '$1 == s { f = 1 } END { exit !f }' \
    "$_cfg.blocked"; then
  echo "$_p0#[fg=red]blocked "
  exit 0
fi

if test -f "$_cfg.waiting"; then
  _w8="$(awk -F '\t' -v s="$_slug" -v now="$(date +%FT%H:%M)" \
    -v n="${WT_BADGE_W8_LEN:-24}" '
    $1 == s {
      t = substr($3, 12)
      if (substr($3, 1, 10) != substr(now, 1, 10)) t = substr($3, 6, 5) " " t
      w = $4
      if (length(w) > n) w = substr(w, 1, n - 1) "…"
      if ($3 <= now) print "#[fg=red]w8 overdue " t " " w " "
      else print "#[fg=#5fafd7]w8 " t " " w " "
      exit
    }' "$_cfg.waiting")"
  if test -n "$_w8"; then
    echo "$_p0$_w8"
    exit 0
  fi
fi

_section="$(test -f "$_cfg" && awk -v b="$_branch" -v s="$_slug" '
  /^[[:space:]]*#/ || /:[[:space:]]*$/ {
    h = $0
    sub(/^[[:space:]]*#+[[:space:]]*/, "", h)
    sub(/:[[:space:]]*$/, "", h)
    next
  }
  { e = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", e) }
  e != "" && (e == b || e == s) { print toupper(h); exit }
' "$_cfg")"

if test "$_section" = P0; then
  _section="$(awk -F '\t' -v b="$_branch" -v s="$_slug" '
    $1 == b || $1 == s { print toupper($2); exit }' "$_cfg.p0" 2>/dev/null)"
  _section="${_section:-IN PROGRESS}"
fi

case "$_section" in
  'IN PROGRESS') _c=yellow ;;
  'TEAM REVIEW') _c=cyan ;;
  'READY TO DEPLOY') _c=green ;;
  'PROD REVIEW') _c=magenta ;;
  'TO ANNOUNCE') _c=blue ;;
  BLOCKED) _c=red ;;
  'NEEDS FOCUS') _c=red ;;
  '') _c='#aaaaaa' _section='OFF BOARD' ;;
  *) _c='#aaaaaa' ;;
esac
echo "$_p0#[fg=$_c]$(echo "$_section" | tr 'A-Z' 'a-z') "
