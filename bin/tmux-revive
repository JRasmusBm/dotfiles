#!/bin/sh
#
# tmux-revive — run by tmux-watch the moment a tmux server dies (and
# every 5 s while its queue has work, every 20 s otherwise) and by
# wt-sync every minute: brings the Claude chats back after a server
# dies (a crash) or restarts (kill-server). One run at a time (a lock).
#   - Snapshots each live server (`tmux-all servers`: default,
#     agents-1..N) to $LOCAL_CONFIG/tmux-revive.snapshot (default) or
#     tmux-revive.snapshot.<server>: `server <pid> <start_time>`, then
#     per pane running Claude session<TAB>window<TAB>cwd<TAB>sid<TAB>work
#     (`claude-pane map`; sid `-` when Claude wrote no session file;
#     work `1` when the pane shows Claude's spinner or a background
#     wait, else `-`).
#   - A server gone, or with another start_time than its snapshot's,
#     queues each chat of that snapshot that isn't live on any server
#     (tmux-revive.queue), once per dead server (tmux-revive.done),
#     with the time the new server started (else now) for a working
#     one. Mid-turn chats go first.
#   - Each run starts the queued chats `run-slot` has room for (the
#     rest keep their place there, for a later run): a mid-turn chat as
#     `revive` (past the cap, memory alone holds it); an idle one only
#     once no mid-turn one waits, and only when `run-slot needs-open`
#     gives a reason (`start`; a wakeup or cron it had set is lost with
#     its process, so it is told too). Any other idle chat is parked:
#     its session gets a shell where it was and `run-slot park` records
#     it closed, so a focus on that pane or a tell resumes it.
#     A missing session is rebuilt like `wt open` does (its .tmux, else
#     the run/vim/cli layout) under its old name, on its own server
#     (tmux-home, shims/tmux), and `claude --resume <sid>` (no sid:
#     `claude --continue || claude`) is typed into a window it just
#     built with the old window's name (`cli`), else into a new window
#     of that name. Panes it didn't build are never touched.
#   - A later run checks each started pane runs Claude, and once a
#     chat that was working shows an empty prompt, tells it: `tmux
#     restarted at <time> while you were working. Check git status and
#     your last step, then carry on.` (state `told`; no prompt within
#     10 min: `untold`). Once none is pending, one notify ping sums up
#     revived, told, parked and failed chats and the cause tmux-watch
#     logged (rows in tmux-revive.log).
# tmux-revive forget — drop the snapshots and queue, so a deliberate
# kill-server stays dead.
# Tests: TMUX_TMPDIR (TMUX unset) points every tmux call, children's
# too, at other servers; CLAUDE_CONFIG_DIR at other session files;
# TMUX_REVIVE_CLAUDE replaces the `claude` typed.

_dir="${LOCAL_CONFIG:?}"
_snap="$_dir/tmux-revive.snapshot"
_q="$_dir/tmux-revive.queue"
_done="$_dir/tmux-revive.done"
_log="$_dir/tmux-revive.log"
_lock="$_dir/tmux-revive.lock"
_claude="${TMUX_REVIVE_CLAUDE:-claude}"
_t="$(printf '\t')"

if test "${1:-}" = forget; then
  rm -f "$_snap" "$_snap".* "$_q"
  exit 0
fi

if ! mkdir "$_lock" 2>/dev/null; then
  kill -0 "$(cat "$_lock/pid" 2>/dev/null)" 2>/dev/null && exit 0
  rm -f "$_lock/pid"
  rmdir "$_lock" 2>/dev/null
  mkdir "$_lock" 2>/dev/null || exit 0
fi
echo $$ > "$_lock/pid"
trap 'rm -f "$_lock/pid"; rmdir "$_lock" 2>/dev/null' EXIT

_is_claude() {
  case "$1" in claude|[0-9]*.[0-9]*.[0-9]*) return 0 ;; esac
  return 1
}

# Succeeds when the pane shows Claude mid-turn or waiting on its
# background agents/shells (wt-cold's patterns).
_working() {
  tmux capture-pane -p -t "$1" -S -60 2>/dev/null | grep . | tail -12 \
    | grep -qE '^[^ ]+ [^ ]+… \([0-9]+[hms]|esc to interrupt|Waiting for [0-9]+ background agent|[0-9]+ (background )?shells? (still )?running|· [0-9]+ shells? ·'
}

# pane<TAB>session<TAB>window<TAB>cwd<TAB>sid<TAB>work of every Claude
# pane on every server (pane keys name their server).
_claude_panes() {
  _m="$(claude-pane map)"
  tmux -u list-panes -a -F \
    "#{pane_id}$_t#S$_t#W$_t#{pane_current_command}$_t#{pane_current_path}" \
    2>/dev/null | while IFS="$_t" read -r _p _s _w _c _d; do
      _is_claude "$_c" || continue
      _row="$(printf '%s\n' "$_m" | awk -F "$_t" -v p="$_p" \
        '$1 == p { print $2 "\t" $3; exit }')"
      _sid="${_row%%"$_t"*}"
      _cwd="${_row#*"$_t"}"
      test -n "$_row" || _cwd="$_d"
      _cwd="$(cd "${_cwd:-$_d}" 2>/dev/null && pwd -P || echo "$_cwd")"
      _work=-
      _working "$_p" && _work=1
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$_p" "$_s" "$_w" "$_cwd" "${_sid:--}" "$_work"
    done
}

_live="$(_claude_panes)"

for _srv in $(tmux-all servers); do
  _f="$_snap"
  test "$_srv" = default || _f="$_snap.$_srv"
  _server="$(tmux -L "$_srv" display-message -p '#{pid} #{start_time}' \
    2>/dev/null)"
  # The server the snapshot saw is gone: queue its chats, once.
  _prev="$(sed -n '1s/^server //p' "$_f" 2>/dev/null)"
  if test -n "$_prev" && test "$_prev" != "$_server" \
    && ! grep -qxF "$_prev" "$_done" 2>/dev/null; then
    echo "$_prev" >> "$_done"
    _rt="$(date +%H:%M)"
    test -z "$_server" || _rt="$(date -r "${_server#* }" +%H:%M)"
    sed 1d "$_f" | while IFS="$_t" read -r _s _w _cwd _sid _work; do
      test -n "$_s" || continue
      if test "$_sid" != -; then
        printf '%s\n' "$_live" | cut -f5 | grep -qxF "$_sid" && continue
      else
        printf '%s\n' "$_live" | cut -f4 | grep -qxF "$_cwd" && continue
      fi
      _tell=-
      test "$_work" != 1 || _tell="$_rt"
      printf 'todo\t%s\t%s\t%s\t%s\t-\t%s\t%s\n' "$_s" "$_w" "$_cwd" \
        "$_sid" "$(date +%s)" "$_tell"
    done >> "$_q"
  fi
  if test -n "$_server"; then
    _tmp="$(mktemp)"
    { echo "server $_server"
      printf '%s\n' "$_live" | grep "^%[0-9]*@$_srv$_t" | cut -f2-
    } > "$_tmp" && mv "$_tmp" "$_f"
  fi
done

test -s "$_q" || exit 0

# Sessions this run built (their windows run nothing yet), and the
# pane ids it typed into.
_built=""
_used=""

# Sets _st (started, failed:<why>) and _pane. PARK (5th arg): only
# make the shell pane, type nothing.
_start() {
  _s="$1" _w="$2" _cwd="$3" _sid="$4" _st="" _pane=""
  test -d "$_cwd" || { _st="failed:no dir"; return; }
  _home="$(git -C "$_cwd" rev-parse --show-toplevel 2>/dev/null)" \
    || _home="$_cwd"
  if ! tmux has-session -t "=$_s" 2>/dev/null; then
    ( cd "$_home" \
      && TMUX_SESSION_NAME="$_s" INITIATED_EXTERNALLY=true \
        source_tmux_script "$_home/.tmux" \
      || TMUX_SESSION_NAME="$_s" INITIATED_EXTERNALLY=true \
        default_tmux_session ) </dev/null >/dev/null 2>&1
    tmux has-session -t "=$_s" 2>/dev/null \
      || { _st="failed:no session"; return; }
    _built="$_built$_s$_t"
  fi
  # A chat already back (started by hand, or this very session) is
  # never typed into again: the text would land in its prompt.
  if test "$_sid" != - \
    && claude-pane map | cut -f2 | grep -qxF "$_sid"; then
    _st=ok; return
  fi
  # Reuse only a shell pane of a session this run built that no
  # earlier start typed into (a pane still shows zsh right after
  # send-keys, so the pane id list is what guards it).
  case "$_t$_built" in *"$_t$_s$_t"*)
    _pane="$(tmux -u list-panes -t "=$_s:=$_w" \
      -F "#{pane_id}$_t#{pane_current_path}$_t#{pane_current_command}" \
      2>/dev/null | awk -F "$_t" -v d="$_cwd" -v u="$_t$_used" '
        $2 == d && $3 ~ /^-?(zsh|bash|sh|fish)$/ \
          && index(u, "\t" $1 "\t") == 0 { print $1; exit }')" ;;
  esac
  if test -n "$_pane"; then
    _used="$_used$_pane$_t"
  else
    _pane="$(tmux new-window -d -P -F '#{pane_id}' -t "=$_s:" \
      -c "$_cwd" -n "$_w")" || { _st="failed:no window"; return; }
  fi
  if test -n "${5:-}"; then
    run-slot park "$_sid" "$_pane" "$_s" "$_cwd" >/dev/null \
      && _st=parked || _st="failed:park"
    return
  fi
  if test "$_sid" != -; then
    tmux send-keys -t "$_pane" "$_claude --resume $_sid" Enter
  else
    tmux send-keys -t "$_pane" "$_claude --continue || $_claude" Enter
  fi
  _st=started
}

_now="$(date +%s)"
_tmp="$(mktemp)"
# Mid-turn chats first; an idle one waits while one of them does.
_hot=""
{ awk -F "$_t" '$1 == "todo" && $8 != "-"' "$_q"
  awk -F "$_t" '!($1 == "todo" && $8 != "-")' "$_q"
} | while IFS="$_t" read -r _st _s _w _cwd _sid _pane _at _tell; do
  _id="revive:$_s:$_w:$_sid"
  case "$_st" in
    todo)
      if test "${_tell:--}" != -; then
        if run-slot gate revive "$_id" -- >/dev/null; then
          _start "$_s" "$_w" "$_cwd" "$_sid"
          _at="$_now"
        else
          _hot=1
        fi
      elif test -z "$_hot"; then
        if test "$_sid" = - \
          || _why="$(run-slot needs-open "$_sid" "$_s")"; then
          if run-slot gate start "$_id" -- >/dev/null; then
            case "${_why:-}" in wakeup*|cron*)
              _tell="$(date -r "$_at" +%H:%M)" ;;
            esac
            _start "$_s" "$_w" "$_cwd" "$_sid"
            _at="$_now"
          fi
        else
          _start "$_s" "$_w" "$_cwd" "$_sid" park
        fi
        _why=""
      fi ;;
    started)
      _c="$(tmux display-message -p -t "$_pane" \
        '#{pane_current_command}' 2>/dev/null)"
      if test -z "$_c"; then _st="failed:pane gone"
      elif _is_claude "$_c"; then _st=ok
      elif test "$(( _now - _at ))" -ge 300; then _st="failed:not running"
      fi ;;
  esac
  if test "$_st" = ok && test "${_tell:--}" != - \
    && test "${_pane:--}" != -; then
    if claude-pane-idle "$_pane"; then
      tmux send-keys -t "$_pane" -l "tmux restarted at $_tell while you \
were working. Check git status and your last step, then carry on."
      sleep 0.5
      tmux send-keys -t "$_pane" Enter
      _st=told
    elif test "$(( _now - _at ))" -lt 600; then _st=started
    else _st=untold
    fi
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$_st" "$_s" "$_w" "$_cwd" "$_sid" "${_pane:--}" "$_at" "${_tell:--}"
done > "$_tmp"
mv "$_tmp" "$_q"

cut -f1 "$_q" | grep -qxE 'todo|started' && exit 0

while IFS="$_t" read -r _st _s _w _cwd _sid _pane _at _tell; do
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%F %T')" "$_st" "$_s" "$_w" "$_cwd" "$_sid"
done < "$_q" >> "$_log"
_ok="$(grep -cE '^(ok|told|untold)' "$_q")"
_told="$(grep -c '^told' "$_q")"
_park="$(grep -c '^parked' "$_q")"
_bad="$(grep -vE '^(ok|told|untold|parked)' "$_q" | cut -f2 | sort -u \
  | tr '\n' ' ')"
_msg="revived $_ok Claude chat(s), told $_told to carry on"
test "$_park" = 0 || _msg="$_msg, $_park idle ones closed (focus resumes)"
test -z "$_bad" || _msg="$_msg; failed: $_bad(tmux-revive.log)"
_why="$(cat "$_dir/tmux-watch.last" 2>/dev/null)"
test -z "$_why" || _msg="$_msg; cause $_why"
rm -f "$_q"
TMUX_PANE='' NOTIFY_CLASS=env notify "tmux revive" "$_msg"
