#!/usr/bin/env python

import os
from sys import argv
import platform
from pathlib import Path
from urllib.parse import unquote


from subprocess import run


def get(command):
    return run(command, capture_output=True).stdout.decode("utf-8")


def main():
    reveal = argv[1] == "--reveal"
    path = argv[-1]

    if path.startswith("http"):
        if platform.system() == "Darwin":
            run(["browse", path])
        else:
            run(["xdg-open", path])
        return

    if path.startswith("file://"):
        # A local page (an artifact opened off-line): the browser, not nvim.
        local = unquote(path[len("file://"):].split("#")[0].split("?")[0])
        if reveal:
            run(["open", "-R", os.path.realpath(local)])
        elif not Path(local).exists():
            print(f"Cannot find file {local}")
            exit(1)
        else:
            run(["open", path])
        return

    if path.startswith("git@github.com"):
        run(["git-open", path.split(":")[1][:-4]])
        return

    path_components = path.split(":")
    raw_file_path = path_components[0]
    if Path(raw_file_path).exists():
        file_path = raw_file_path 
    else:
        current_path = Path(".")
        file_path = None
        while True:
            if (current_path / raw_file_path).exists():
                file_path = current_path / raw_file_path
                break
            next_path = current_path / ".."
            if os.path.realpath(current_path) == os.path.realpath(next_path):
                break
            current_path = next_path

    if file_path is None:
        # Not under this checkout or its parents: the newest copy in a
        # sibling worktree of the same repo (a path from another agent).
        trees = [
            line[len("worktree "):]
            for line in get(["git", "worktree", "list", "--porcelain"]).splitlines()
            if line.startswith("worktree ")
        ]
        found = [Path(t) / raw_file_path for t in trees if (Path(t) / raw_file_path).exists()]
        if found:
            file_path = max(found, key=lambda f: f.stat().st_mtime)

    if file_path is None:
        print(f"Cannot find file {raw_file_path}")
        exit(1)

    if reveal:
        run(["open", "-R", os.path.realpath(file_path)])
        return

    # `silent`: a file-info message wider than the screen leaves nvim
    # at "Press ENTER", which blocks the RPC call (and tmux with it).
    line = path_components[1] if len(path_components) > 1 else ""
    line = f"+{line} " if line.isdigit() else ""
    quoted = os.path.abspath(file_path).replace("'", "''")
    result = run(["nr", "-c",
                  f"exe 'silent edit {line}' . fnameescape('{quoted}')"])

    if result.returncode != 0:
        print(f"Exited with {result.returncode}")
        print("STDOUT")
        print(result.stdout)
        print("STDERR")
        print(result.stderr)



if __name__ == "__main__":
    main()
    exit(0)
