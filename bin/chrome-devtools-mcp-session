#!/bin/sh
# chrome-devtools-mcp on its own profile dir per Claude session, so
# parallel sessions each drive their own browser. The dir starts empty;
# chrome-devtools-mcp-proxy fills it from the logged-in seed on the
# first browser call, starts and stops the server and its Chrome (see
# its header), and deletes the dir when the session exits.

profile=$(mktemp -d "${TMPDIR:-/tmp}/chrome-devtools-mcp.XXXXXX")

if [ -n "$TMUX_PANE" ]; then
  label="$TMUX_PANE · $(tmux display-message -p -t "$TMUX_PANE" '#S:#W.#P')"
else
  label=$(basename "$PWD")
fi

cleanup() {
  [ -n "$child" ] && kill "$child" 2>/dev/null
  wait "$child" 2>/dev/null
}
trap cleanup EXIT
trap 'exit 143' TERM INT HUP

exec 3<&0
python3 -I "$(dirname "$0")/chrome-devtools-mcp-proxy" "$profile" "$label" \
  "$@" <&3 3<&- &
child=$!
wait "$child"
