#!/bin/sh
# chrome-devtools-mcp on a throwaway copy of the logged-in default profile,
# so parallel Claude sessions each drive their own browser. The copy is
# deleted when the session exits. chrome-devtools-mcp-proxy starts the
# server and its Chrome on the first browser call and stops them on
# `dev down`, the dev slot going away, or idle (see its header).

seed="$HOME/.cache/chrome-devtools-mcp/chrome-profile"
profile=$(mktemp -d "${TMPDIR:-/tmp}/chrome-devtools-mcp.XXXXXX")

if [ -n "$TMUX_PANE" ]; then
  label="$TMUX_PANE · $(tmux display-message -p -t "$TMUX_PANE" '#S:#W.#P')"
else
  label=$(basename "$PWD")
fi

if [ -d "$seed" ]; then
  cp -R "$seed/." "$profile"
  rm -f "$profile"/Singleton*
  rm -rf "$profile"/Default/Sessions
  python3 -c 'import json, sys
p = sys.argv[1]
d = json.load(open(p))
d.get("browser", {}).pop("window_placement", None)
json.dump(d, open(p, "w"))' "$profile/Default/Preferences" 2>/dev/null
fi

cleanup() {
  [ -n "$child" ] && kill "$child" 2>/dev/null
  wait "$child" 2>/dev/null
  rm -rf "$profile"
}
trap cleanup EXIT
trap 'exit 143' TERM INT HUP

exec 3<&0
python3 -I "$(dirname "$0")/chrome-devtools-mcp-proxy" "$profile" "$label" \
  "$@" <&3 3<&- &
child=$!
wait "$child"
