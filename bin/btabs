#!/usr/bin/env python3
"""Browser tabs as inventory: count them, close the ones that are done.

  btabs              what's open: total, duplicates, done PRs, by host
  btabs tidy [-n]    close duplicates (keeps the last copy) and tabs of
                    merged or closed GitHub PRs; -n lists only
  btabs tidy --daily  the same, once per weekday from 08:00 (wt-sync),
                    before I start, so no tab vanishes while I read it
  btabs open URL...  open in the browser and remember it as shell-opened
                    (`browse` and $BROWSER point here)
  btabs expire      close tabs left unfocused for BTABS_IDLE_MIN (240)
                    awake minutes; shell-opened and sign-in leftover
                    tabs after 5, extra copies of a page at once (the
                    focused copy stays); also "This artifact is
                    private" tabs (my other Claude login). Never a
                    window's active tab (wt-sync, every minute); -n
                    lists only
  btabs reopen      reopen the last batch closed by tidy or expire

Call tabs (Meet, Zoom, Teams, Slack huddles, Whereby, Jitsi, Webex,
Gather, Discord) are never closed; BTABS_KEEP adds a regex.
  btabs log          append "epoch<TAB>count" to $LOCAL_CONFIG/tabs.log
                    (wt-sync runs it every 5th minute)

Browser: $TABS_BROWSER (default "Brave Browser"), any Chromium one that
speaks AppleScript. Every closed URL is kept in
$LOCAL_CONFIG/tabs-closed.log (epoch, batch, URL), so a tidy is undoable.
"""
import collections
import json
import os
import re
import subprocess
import sys
import time

APP = os.environ.get('TABS_BROWSER', 'Brave Browser')
CONF = os.environ.get('LOCAL_CONFIG') or os.path.expanduser(
    '~/.config/jrasmusbm')
CLOSED = os.path.join(CONF, 'tabs-closed.log')
COUNT_LOG = os.path.join(CONF, 'tabs.log')
OPENED = os.path.join(CONF, 'tabs-opened')     # epoch, url
ACTIVE = os.path.join(CONF, 'tabs-active')     # run epoch; url, idle s
EXPIRE_S = int(os.environ.get('BTABS_EXPIRE_S', '300'))
IDLE_S = int(os.environ.get('BTABS_IDLE_MIN', '240')) * 60
# Pages nobody returns to: a sign-in that finished, an empty new chat.
JUNK = re.compile(r'^https://claude\.ai/(settings/mcp/auth_done|new/?$)'
                  r'|/oauth2?/(callback|authorize)|[?&]code=')
PR = re.compile(r'https://github\.com/([^/]+/[^/]+)/pull/(\d+)')
# Never closed by tidy or expire: a call keeps its URL the whole time,
# so "navigated away" can't protect it, and closing it hangs up.
# BTABS_KEEP adds a regex of your own.
KEEP = re.compile('|'.join(filter(None, [
    r'^https://(meet\.google\.com|([a-z0-9-]+\.)?zoom\.us|'
    r'teams\.(microsoft|live)\.com|app\.slack\.com/huddle|'
    r'([a-z0-9-]+\.)?whereby\.com|meet\.jit\.si|'
    r'([a-z0-9-]+\.)?webex\.com|app\.gather\.town|discord\.com/channels)',
    os.environ.get('BTABS_KEEP', ''),
])))


def osa(script):
    return subprocess.run(['osascript', '-e', script], capture_output=True,
                          text=True, timeout=60).stdout


def running():
    return subprocess.run(['pgrep', '-f', f'/{APP}.app/Contents/MacOS'],
                          capture_output=True).returncode == 0


def tabs():
    """[(window id, tab index 1-based, url)] in window order."""
    if not running():
        return []
    out = osa(f'''set s to ""
tell application "{APP}"
  repeat with w in windows
    set i to 0
    repeat with t in tabs of w
      set i to i + 1
      set s to s & (id of w) & (character id 9) & i & (character id 9) ¬
        & (URL of t) & (character id 10)
    end repeat
  end repeat
end tell
return s''')
    rows = []
    for ln in out.splitlines():
        p = ln.split('\t')
        if len(p) == 3:
            rows.append((p[0], int(p[1]), p[2]))
    return rows


def norm(url):
    # Same page = same URL without its fragment. A query is part of the
    # page (searches, filters), except an artifact's share key.
    url = url.split('#', 1)[0]
    if re.match(r'https://claude\.ai/(code/)?artifact/', url):
        url = url.split('?', 1)[0]
    return url.rstrip('/')


def pr_states(rows):
    """'owner/repo#n' -> MERGED|CLOSED|OPEN, one gh call per PR."""
    keys = {f'{m.group(1)}#{m.group(2)}' for _, _, u in rows
            for m in [PR.match(u)] if m}
    out = {}
    for k in keys:
        repo, n = k.split('#')
        r = subprocess.run(['gh', 'pr', 'view', n, '-R', repo, '--json',
                            'state', '-q', '.state'],
                           capture_output=True, text=True, timeout=30)
        out[k] = r.stdout.strip()
    return out


def plan(rows):
    """Tabs to close: (row, reason)."""
    close = []
    last = {}
    for r in rows:
        last[norm(r[2])] = r
    for r in rows:
        if last[norm(r[2])] is not r and not KEEP.search(r[2]):
            close.append((r, 'duplicate'))
    states = pr_states(rows)
    dup = {id(r) for r, _ in close}
    for r in rows:
        m = PR.match(r[2])
        if m and id(r) not in dup:
            st = states.get(f'{m.group(1)}#{m.group(2)}')
            if st in ('MERGED', 'CLOSED'):
                close.append((r, f'PR {st.lower()}'))
    return close


def status():
    rows = tabs()
    if not rows:
        print(f'{APP}: not running or no tabs')
        return
    n = collections.Counter(norm(u) for _, _, u in rows)
    hosts = collections.Counter(re.sub(r'https?://([^/]+).*', r'\1', u)
                                for _, _, u in rows)
    wins = len({w for w, _, _ in rows})
    print(f'{len(rows)} tabs in {wins} windows, '
          f'{sum(v - 1 for v in n.values() if v > 1)} duplicates')
    for h, c in hosts.most_common(8):
        print(f'  {c:4}  {h}')
    print('`btabs tidy -n` lists what tidy would close.')


def tidy(dry):
    rows = tabs()
    close = plan(rows)
    why = collections.Counter(r for _, r in close)
    print(f'{len(rows)} tabs; closing {len(close)}: ' +
          ', '.join(f'{c} {k}' for k, c in why.most_common()))
    if dry:
        for (w, i, u), r in close[:40]:
            print(f'  {r:10} {u[:100]}')
        return
    close_rows([r for r, _ in close], [w for _, w in close])
    print(f'{len(tabs())} tabs left; `btabs reopen` undoes it.')


def open_urls(urls):
    now = int(time.time())
    with open(OPENED, 'a') as f:
        for u in urls:
            f.write(f'{now}\t{u}\n')
    subprocess.run(['open', '-a', APP, *urls])


def active_tabs():
    """{(window id, tab index)} of each window's active tab."""
    out = osa(f'''set s to ""
tell application "{APP}"
  repeat with w in windows
    set s to s & (id of w) & (character id 9) & (active tab index of w) ¬
      & (character id 10)
  end repeat
end tell
return s''')
    act = set()
    for ln in out.splitlines():
        p = ln.split('\t')
        if len(p) == 2 and p[1].isdigit():
            act.add((p[0], int(p[1])))
    return act


def close_rows(rows, reasons):
    batch = str(int(time.time()))
    with open(CLOSED, 'a') as f:
        for (w, i, u), r in zip(rows, reasons):
            f.write(f'{batch}\t{r}\t{u}\n')
    by_win = collections.defaultdict(list)
    for w, i, u in rows:
        by_win[w].append(i)
    lines = [f'tell application "{APP}"']
    for w, idx in by_win.items():
        for i in sorted(idx, reverse=True):
            lines.append(f'  close tab {i} of (first window whose id is {w})')
    lines.append('end tell')
    osa('\n'.join(lines))


def close_denied():
    """Close artifact tabs that only say "This artifact is private"
    (published under my other Claude login), unless one is the active
    tab: nothing on them is readable, and sessions started before
    CLAUDE_CODE_ARTIFACT_AUTO_OPEN=0 keep opening them."""
    osa(f'''tell application "{APP}"
  repeat with w in windows
    set a to active tab index of w
    repeat with i from (count of tabs of w) to 1 by -1
      if i is not a and title of tab i of w starts with "Request access" ¬
        and URL of tab i of w contains "claude.ai/" then close tab i of w
    end repeat
  end repeat
end tell''')


def expire(dry=False):
    """Close every tab left unfocused too long, timed in awake minutes
    (gaps over 2 minutes, i.e. sleep or a stalled run, count as 2):
    IDLE_S for any tab, EXPIRE_S for shell-opened ones, sign-in
    leftovers (JUNK) and extra copies of a page. A window's active tab
    and calls (KEEP) are never closed."""
    if not running():
        return
    close_denied()
    now = int(time.time())
    try:
        opened = [ln.rstrip('\n').split('\t', 1) for ln in open(OPENED)]
        opened = [(int(t), u) for t, u in opened if now - int(t) < 86400]
    except (OSError, ValueError):
        opened = []
    shell = {norm(u) for _, u in opened}
    idle, last = {}, now
    try:
        with open(ACTIVE) as f:
            last = int(f.readline().strip() or now)
            for ln in f:
                u, t = ln.rstrip('\n').rsplit('\t', 1)
                idle[u] = int(t)
    except (OSError, ValueError):
        pass
    step = max(0, min(now - last, 120))
    rows = tabs()
    act = active_tabs()
    active = {norm(u) for w, i, u in rows if (w, i) in act}
    for u in {norm(r[2]) for r in rows}:
        idle[u] = 0 if u in active else idle.get(u, 0) + step
    keep_row = {}
    for r in rows:
        u = norm(r[2])
        if (r[0], r[1]) in act or u not in keep_row:
            keep_row[u] = r
    close, why = [], []
    for r in rows:
        u = norm(r[2])
        if (r[0], r[1]) in act or KEEP.search(r[2]):
            continue
        if keep_row[u] is not r:
            reason = 'duplicate'
        elif idle[u] >= IDLE_S:
            reason = 'idle'
        elif idle[u] >= EXPIRE_S and (u in shell or JUNK.search(r[2])):
            reason = 'expired'
        else:
            continue
        close.append(r)
        why.append(reason)
    if dry:
        for (w, i, u), r in zip(close, why):
            print(f'  {r:9} {idle[norm(u)] // 60:4}m  {u[:90]}')
        print(f'{len(rows)} tabs; would close {len(close)}')
        return
    if close:
        close_rows(close, why)
    gone = {norm(r[2]) for r, w in zip(close, why) if w != 'duplicate'}
    live = {norm(r[2]) for r in rows} - gone
    with open(OPENED, 'w') as f:
        f.writelines(f'{t}\t{u}\n' for t, u in opened if norm(u) in live)
    with open(ACTIVE, 'w') as f:
        f.write(f'{now}\n')
        f.writelines(f'{u}\t{t}\n' for u, t in idle.items() if u in live)


def reopen():
    try:
        rows = [ln.rstrip('\n').split('\t') for ln in open(CLOSED)]
    except OSError:
        print('nothing to reopen')
        return
    batch = rows[-1][0]
    urls = [r[2] for r in rows if r[0] == batch and r[1] != 'duplicate']
    if not urls:
        print('last tidy closed only duplicates; nothing to reopen')
        return
    script = [f'tell application "{APP}"', '  set w to make new window']
    for u in urls:
        script.append(f'  make new tab at end of tabs of w with properties '
                      f'{{URL:{json.dumps(u)}}}')
    script.append('end tell')
    osa('\n'.join(script))
    print(f'reopened {len(urls)} tabs in a new window')


def log():
    if not running():
        return
    with open(COUNT_LOG, 'a') as f:
        f.write(f'{int(time.time())}\t{len(tabs())}\n')


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else ''
    if cmd == 'tidy' and '--daily' in a:
        stamp = os.path.join(CONF, 'btabs-stamp')
        now = time.localtime()
        today = time.strftime('%Y-%m-%d', now)
        try:
            done = open(stamp).read().strip() == today
        except OSError:
            done = False
        if done or now.tm_wday >= 5 or now.tm_hour < 8 or not running():
            return
        with open(stamp, 'w') as f:
            f.write(today)
        tidy(False)
    elif cmd == 'tidy':
        tidy('-n' in a)
    elif cmd == 'open' and len(a) > 1:
        open_urls(a[1:])
    elif cmd == 'expire':
        expire('-n' in a)
    elif cmd == 'reopen':
        reopen()
    elif cmd == 'log':
        log()
    elif cmd in ('', 'status'):
        status()
    else:
        print(__doc__)
        return 1


if __name__ == '__main__':
    sys.exit(main())
