#!/bin/sh

# notify "title" "message" [sound]
#
# NOTIFY_CLASS ranks it for `notif next` (M-i), most valuable stop
# first: env (machine-wide: VPN, disk; one fix unblocks many
# agents), merge (one keystroke ships a PR), blocked (an agent
# waits on my answer), fail, check (verify after deploy), unset
# (git-w8, bw8, ...), stalled (`wt-cold`: a work item stopped moving;
# inbox only, no toast, sound or bell), step (`prio sync`: a
# priority's current step that no worktree carries; inbox only, and
# ranked by that priority in `notif`), fyi (nothing needed: inbox
# only too). NOTIFY_CTX names the row's place when not called from a
# pane (default: the cwd's basename). NOTIFY_REF tags the row with an
# id that survives a jump re-keying it to another pane, so its sender
# can drop it later (`notif seen-ref`; `wt-cold` does).

_title="${1:-Notification}"
_msg="${2:-done}"
_sound="${3:-/System/Library/Sounds/Glass.aiff}"

_here="$PWD"
[ -n "$TMUX_PANE" ] && _here="$(tmux display-message -p -t "$TMUX_PANE" \
  '#{pane_current_path}' 2>/dev/null || echo "$PWD")"
case "$_here" in
  */.worktrees/?*)
    _wt="${_here#*/.worktrees/}"
    _repo="${_here%%/.worktrees/*}"
    _sf="${LOCAL_CONFIG:-$HOME/.local-config}/worktrees/${_repo##*/}.snoozed"
    [ -f "$_sf" ] && awk -F '\t' -v s="${_wt%%/*}" '$1 == s { f = 1 }
      END { exit !f }' "$_sf" && exit 0
    ;;
esac

_class="${NOTIFY_CLASS:-}"
case "$_class" in fyi|stalled|step) ;; *)
osascript -e "display notification \"$_msg\" with title \"$_title\""
afplay "$_sound" &
;; esac

# Tmux bell for status bar highlight
if [ -n "$TMUX_PANE" ] && [ "$_class" != fyi ] \
  && [ "$_class" != stalled ] && [ "$_class" != step ]; then
  _tty="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}')"
  if [ -n "$_tty" ]; then
    printf '\a' > "$_tty"
  fi
fi

# Append to the persistent notification inbox (`notif`). This
# is the one chokepoint every notifier funnels through
# (claude-notify, git-w8, bw8, ...), so they all land here for
# free. Capture the place to jump back to: the calling tmux
# pane (id + session:window.pane), else the cwd basename.
# NOTIFY_MODE=sticky keeps the row past a visit (see `notif`).
# Plain `>>` of one short line is atomic, so concurrent
# notifiers don't clobber each other; dedup happens at view
# time in `notif`.
if [ -n "$LOCAL_CONFIG" ]; then
  _inbox="$LOCAL_CONFIG/notifications"
  if [ -n "$TMUX_PANE" ]; then
    _ctx="$(tmux display-message -p -t "$TMUX_PANE" '#S:#W.#P' \
      2>/dev/null)"
    _path="$(tmux display-message -p -t "$TMUX_PANE" \
      '#{pane_current_path}' 2>/dev/null)"
  else
    _ctx="${NOTIFY_CTX:-$(basename "$PWD")}"
    _path="$PWD"
  fi
  mkdir -p "$(dirname "$_inbox")"
  # One row per notification: newlines and tabs in the title or
  # message would split it into junk rows (RAS-47), so they become a
  # separator here (the toast above keeps them).
  _flat() {
    printf '%s\n' "$1" | awk '{ gsub(/[\t\r]/, " ") }
      $0 !~ /^ *$/ { printf "%s%s", (n++ ? " \302\267 " : ""), $0 }'
  }
  # Row: epoch  ctx  title  message  path  pane  mode  class  sid
  # [ref]. NOTIFY_SID (a Claude session id) finds the chat again once
  # its pane is gone (`claude-pane`); the path is the anchor `notif`
  # reopens from otherwise (e.g. after `wt rt`/`rm`).
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s%s\n' \
    "$(date +%s)" "$_ctx" "$(_flat "$_title")" "$(_flat "$_msg")" \
    "$_path" \
    "${TMUX_PANE:-}" "${NOTIFY_MODE:-}" "$_class" "${NOTIFY_SID:-}" \
    "${NOTIFY_REF:+	$NOTIFY_REF}" >> "$_inbox"
  focus-log notif-in "${_ctx%%:*}" "$_title" 2>/dev/null || true
  # Update the status-bar counter (`notif count`) right away.
  if [ -n "$TMUX_PANE" ]; then
    tmux refresh-client -S 2>/dev/null || true
  fi
fi
