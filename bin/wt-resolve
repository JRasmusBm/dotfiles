#!/bin/sh

set -e

# Resolves <repo> + optional worktree <slug> to an absolute path
# Usage: wt-resolve <repo> [slug]
#
# zoxide finds the repo root; <root>/.worktrees/<slug> when the
# slug is given. Exits 1 if that worktree isn't on disk.

_repo="$1"
_slug="$2"

if test -z "$_repo"; then
  echo "Usage: wt-resolve <repo> [slug]" >&2
  exit 1
fi

_root="$(zoxide query "$_repo")"

if test -z "$_slug"; then
  echo "$_root"
  exit 0
fi

_wt_path="$_root/.worktrees/$_slug"
if ! test -d "$_wt_path"; then
  echo "wt-resolve: no worktree $_wt_path" >&2
  exit 1
fi
echo "$_wt_path"
