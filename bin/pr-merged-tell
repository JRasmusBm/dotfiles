#!/bin/sh
#
# pr-merged-tell <worktree> <pr> — tell the worktree's agent that <pr>
# merged: it checks the conveyor, runs `wt merged`, and either tells me
# how it would ship it or, when the conveyor is already shipping it to
# production, waits (wt-tell: once, idle Claude, else it starts one).

_root="$1" _pr="$2"
test -n "$_root" && test -n "$_pr" \
  || { sed -n '3,6s/^# \{0,1\}//p' "$0" >&2; exit 2; }
# Already told: skip the gh and conveyor calls (wt-sync runs it every
# minute for 3 days).
grep -qxF "$_root	merged:$_pr" "${LOCAL_CONFIG:?}/wt-told" 2>/dev/null \
  && exit 0
_by="$(cd "$_root" && timeout 10 gh pr view "$_pr" --json mergedBy \
  --jq '.mergedBy.login' 2>/dev/null)"
exec wt-tell "$_root" "merged:$_pr" \
  "#$_pr merged, no agent session: wt merged, then check the conveyor" \
  "PR #$_pr is merged into dev${_by:+ (merged by $_by)}. Check the \
conveyor (get_ship_status). If it is already shipping it to production, \
run wt merged --shipping (board and ticket to Needs live verification); \
wt-sync tells you when it's live or if the conveyor rejects it. If not, \
run wt merged (Ready to deploy) and tell me how you'd ship it \
(dev-workflow, Shipping a PR): the conveyor straight to production, or \
staging first if it's risky. I approve by saying ship. Either way the \
follow-ups blocked on this worktree get unblocked."
