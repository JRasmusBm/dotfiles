#!/bin/sh
#
# pr-merged-tell <worktree> <pr> — tell the worktree's agent that <pr>
# merged: run `wt merged`, record its targets, hand me deploy
# commands (wt-tell: once, idle Claude, else a check ping).

_root="$1" _pr="$2"
test -n "$_root" && test -n "$_pr" \
  || { sed -n '3,5s/^# \{0,1\}//p' "$0" >&2; exit 2; }
_by="$(cd "$_root" && timeout 10 gh pr view "$_pr" --json mergedBy \
  --jq '.mergedBy.login' 2>/dev/null)"
exec wt-tell "$_root" "merged:$_pr" \
  "#$_pr merged, no agent session: wt merged, then deploy" \
  "PR #$_pr is merged into dev${_by:+ (merged by $_by)}. Run wt merged \
(board and ticket to Ready to deploy; the follow-ups blocked on this \
worktree get unblocked). Then load the deploy skill, record its targets \
with pr-where $_pr <targets> (services whose non-test files change, \
plus those importing changed shared or common code: shared-reach \
<commit>; a service with only test changes needs none), and give me \
three deploy commands for this change: staging, production, and both."
