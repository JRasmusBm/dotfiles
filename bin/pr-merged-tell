#!/bin/sh
#
# pr-merged-tell <worktree> <pr> — tell the worktree's agent that <pr>
# merged: run `wt merged`, and either tell me how it would ship it or,
# when the conveyor is already shipping it to production, wait
# (wt-tell: once, idle Claude, else it starts one).

_root="$1" _pr="$2"
test -n "$_root" && test -n "$_pr" \
  || { sed -n '3,6s/^# \{0,1\}//p' "$0" >&2; exit 2; }
# Already told: skip the gh and conveyor calls (wt-sync runs it every
# minute for 3 days).
grep -qxF "$_root	merged:$_pr" "${LOCAL_CONFIG:?}/wt-told" 2>/dev/null \
  && exit 0
_by="$(cd "$_root" && timeout 10 gh pr view "$_pr" --json mergedBy \
  --jq '.mergedBy.login' 2>/dev/null)"
_ship="$(cd "$_root" && timeout 20 conveyor status "$_pr" 2>/dev/null \
  | jq -r 'select(.request.until == "deployed"
      and (.request.status | IN("rejected", "failed", "cancelled") | not))
    | .request.targets | join(",")')"
if test -n "$_ship"; then
  _next="The conveyor is already shipping it to production ($_ship); \
wt-sync tells you when it's live or if the conveyor rejects it."
  _flag=" --shipping" _state="Needs live verification"
else
  _next="It's on dev only. Tell me how you'd ship it (dev-workflow, \
Shipping a PR): through the conveyor straight to production, or \
staging first if it's risky. I approve by saying ship."
  _flag="" _state="Ready to deploy"
fi
exec wt-tell "$_root" "merged:$_pr" \
  "#$_pr merged, no agent session: wt merged, then deploy" \
  "PR #$_pr is merged into dev${_by:+ (merged by $_by)}. Run \
wt merged$_flag (board and ticket to $_state; the follow-ups blocked on \
this worktree get unblocked). $_next"
