#!/bin/sh
#
# pr-merged-tell <worktree> <pr> — tell the worktree's idle Claude
# (its `cli` pane) that <pr> merged: run `wt merged`, then hand me
# deploy commands. Once per worktree and PR
# ($LOCAL_CONFIG/merged-told); fails when there's no idle Claude to
# tell, so the next run (claude-notify, wt-sync) retries.

_root="$1" _pr="$2"
test -n "$_root" && test -n "$_pr" \
  || { sed -n '3,7s/^# \{0,1\}//p' "$0" >&2; exit 2; }
_told="${LOCAL_CONFIG:?}/merged-told"
grep -qxF "$_root	$_pr" "$_told" 2>/dev/null && exit 0

_pane="$(tmux display-message -p -t "=$(basename "$_root"):cli" \
  '#{pane_id}' 2>/dev/null)" || exit 1
claude-pane-idle "$_pane" || exit 1

echo "$_root	$_pr" >> "$_told"
notif seen "$_pane" all >/dev/null 2>&1 || true
tmux send-keys -t "$_pane" -l "PR #$_pr is merged into dev. Run wt \
merged (board and ticket to Ready to deploy; the follow-ups blocked \
on this worktree get unblocked). Then load the deploy skill and give \
me three deploy commands for this change: staging, production, and \
both."
sleep 0.5
tmux send-keys -t "$_pane" Enter
