#!/bin/sh
#
# cswap-auto — `cswap auto`, plus reconnecting Remote Control in
# running Claude sessions after the login changes (by cswap or a
# manual /login). Each tick: `cswap auto --once`, then every idle
# Claude pane whose last Remote Control notice is "disconnected" gets
# `/remote-control`. Idle as in `claude-pane-idle`, so nothing typed
# is touched. Only while the login is mine (`CSWAP_RC_ACCOUNTS`): on a
# borrowed account, Remote Control would hand its owner my sessions.
#
#   cswap-auto           loop (launchd com.jrasmusbm.cswap-auto)
#   cswap-auto --once    one tick
#   cswap-auto -n        list panes it would reconnect

_interval="${CSWAP_AUTO_INTERVAL:-60}"

_stale_panes() {
  tmux list-panes -a -F '#{pane_id}' 2>/dev/null \
  | while read -r _p; do
      claude-pane-idle "$_p" || continue
      tmux capture-pane -p -t "$_p" -S -80 | LC_ALL=C awk '
        /^⏺ Remote Control disconnected/ { d = NR }
        /^  \/remote-control is active/ { a = NR }
        END { exit !(d > a) }' && echo "$_p"
    done
}

_own_login() {
  _email=$(cswap status --json 2>/dev/null | jq -r '.active.email // empty')
  _mine="${CSWAP_RC_ACCOUNTS:-rasmus@polaranalytics.co \
    kylian@polaranalytics.co}"
  case " $_mine " in
    *" $_email "*) return 0 ;;
  esac
  echo "$(date +%H:%M:%S)  skip Remote Control: ${_email:-unknown} isn't mine"
  return 1
}

_reconnect() {
  _panes=$(_stale_panes)
  [ -n "$_panes" ] || return 0
  _own_login || return 0
  for _p in $_panes; do
    tmux send-keys -t "$_p" -l '/remote-control'
    sleep 0.5
    tmux send-keys -t "$_p" Enter
    sleep 3
    if tmux capture-pane -p -t "$_p" | grep -v '^[[:space:]]*$' \
      | tail -1 | grep -q 'Enter to select · Esc to continue'; then
      tmux send-keys -t "$_p" Enter
    fi
    echo "$(date +%H:%M:%S)  reconnected Remote Control in $_p"
  done
}

_tick() {
  cswap auto --once --threshold "${CSWAP_AUTO_THRESHOLD:-98}"
  _reconnect
}

case "${1:-}" in
  -n) _stale_panes ;;
  --once) _tick ;;
  '')
    while :; do
      _tick
      sleep "$_interval"
    done
    ;;
  *) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2; exit 1 ;;
esac
