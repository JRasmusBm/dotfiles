#!/bin/sh
#
# cswap-auto — `cswap auto`, plus reconnecting Remote Control in
# running Claude sessions after the login changes (by cswap or a
# manual /login). Each tick: `cswap auto --once`, then every idle
# Claude pane whose last Remote Control notice is "disconnected" gets
# `/remote-control`. Idle as in `claude-pane-idle`, so nothing typed
# is touched. Only while the login is mine (`CSWAP_RC_ACCOUNTS`): on a
# borrowed account, Remote Control would hand its owner my sessions
# and push a notice per session to their phone, so there it
# disconnects connected idle panes instead. The login must read the
# same on two ticks and is re-read before each pane, so a switch mid
# tick reaches no one; a pane is retried at most every 10 minutes.
#
#   cswap-auto           loop (launchd com.jrasmusbm.cswap-auto)
#   cswap-auto --once    one tick
#   cswap-auto -n        list panes it would reconnect, and print the
#                        weekly pace forecast + message (no notify)
#
# Pace ping: weekdays, first tick at/after 10:00 and 15:00 (once per
# slot per day, stamp in $LOCAL_CONFIG/cswap-pace-stamp). Pools the 7d
# usage of enabled accounts (`cswap list`), extrapolates when the pool
# runs out, and if that is before this Friday 18:00 notifies "Tokens"
# with the day's top sessions (`tok-top`).

_interval="${CSWAP_AUTO_INTERVAL:-60}"

_stale_panes() {
  tmux list-panes -a -F '#{pane_id}' 2>/dev/null \
  | while read -r _p; do
      claude-pane-idle "$_p" || continue
      tmux capture-pane -p -t "$_p" -S -80 | LC_ALL=C awk '
        /^⏺ Remote Control disconnected/ { d = NR }
        /^  \/remote-control is active/ { a = NR }
        END { exit !(d > a) }' && echo "$_p"
    done
}

_active_email() {
  cswap status --json 2>/dev/null | jq -r '.active.email // empty'
}

_own_login() {
  _email=$(_active_email)
  # My logins, one per line (private overlay, not in dotfiles).
  _mine="${CSWAP_RC_ACCOUNTS:-$(cat "$HOME/.config/cswap-rc-accounts" \
    2>/dev/null | tr '\n' ' ')}"
  case " $_mine " in
    *" $_email "*) return 0 ;;
  esac
  echo "$(date +%H:%M:%S)  skip Remote Control: ${_email:-unknown} isn't mine"
  return 1
}

# On a borrowed login, a connected session is listed in its owner's
# claude.ai (11-05: archived ones kept coming back), so switch it off.
_disconnect() { claude-rc-off | grep -v '^busy '; }

_state="${LOCAL_CONFIG:-$HOME/.config}"

# Pane $1 got /remote-control in the last 10 minutes: one that drops
# again at once would otherwise get it (and a push) every tick.
_tried() {
  awk -v p="$1" -v t="$(($(date +%s) - 600))" \
    '$1 == p && $2 > t { f = 1 } END { exit !f }' \
    "$_state/cswap-rc-tries" 2>/dev/null
}

# The cswap shim is switching to a borrowed login: it turns Remote
# Control off everywhere first, so reconnecting now would undo that.
_held() {
  _h=$(cat "$HOME/.config/cswap-rc-hold" 2>/dev/null) || return 1
  kill -0 "$_h" 2>/dev/null && return 0
  rm -f "$HOME/.config/cswap-rc-hold"; return 1
}

_reconnect() {
  _held && { echo "$(date +%H:%M:%S)  hold: cswap shim switching"; \
    return 0; }
  _own_login; _mine=$?
  # A login new since the last tick may be mid-switch (11-10: 45
  # sessions reconnected onto a borrowed login): wait a tick.
  _prev=$(cat "$_state/cswap-rc-login" 2>/dev/null)
  echo "$_email" > "$_state/cswap-rc-login"
  [ "$_mine" = 0 ] || { _disconnect; return 0; }
  [ "$_prev" = "$_email" ] || return 0
  _panes=$(_stale_panes)
  [ -n "$_panes" ] || return 0
  for _p in $_panes; do
    _tried "$_p" && continue
    if [ "$(_active_email)" != "$_email" ]; then
      echo "$(date +%H:%M:%S)  login changed mid-tick, stop reconnecting"
      return 0
    fi
    echo "$_p $(date +%s)" >> "$_state/cswap-rc-tries"
    tmux send-keys -t "$_p" -l '/remote-control'
    sleep 0.5
    tmux send-keys -t "$_p" Enter
    sleep 3
    if tmux capture-pane -p -t "$_p" | grep -v '^[[:space:]]*$' \
      | tail -1 | grep -q 'Enter to select · Esc to continue'; then
      tmux send-keys -t "$_p" Enter
    fi
    echo "$(date +%H:%M:%S)  reconnected Remote Control in $_p"
  done
  tail -n 200 "$_state/cswap-rc-tries" > "$_state/cswap-rc-tries.tmp" \
    && mv "$_state/cswap-rc-tries.tmp" "$_state/cswap-rc-tries"
}

# Pooled 7d forecast over enabled accounts. Prints "<runs out?> <msg>"
# as one line: first word "yes" when it runs out before Friday 18:00.
_pace() {
  _fri=$(gdate -d 'friday 18:00' +%s 2>/dev/null) || return 1
  [ "$(gdate +%u)" = 5 ] && [ "$(gdate +%s)" -ge "$_fri" ] \
    && _fri=$(gdate -d 'next friday 18:00' +%s)
  cswap list 2>/dev/null | gawk -v fri="$_fri" -v now="$(date +%s)" '
    BEGIN { split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", m, " ")
            for (i in m) mon[m[i]] = i; y = strftime("%Y", now) }
    /^  [0-9]+:/ { off = ($0 ~ /\(disabled\)/) }
    /7d:/ && !off {
      used = $0; sub(/.*7d: */, "", used); sub(/%.*/, "", used)
      r = $0; sub(/.*resets /, "", r); split(r, a, " ")
      split(a[3], hm, ":")
      t = mktime(y " " mon[a[1]] " " a[2] " " hm[1] " " hm[2] " 0")
      if (t < now - 86400) t = mktime((y + 1) " " mon[a[1]] " " a[2] \
        " " hm[1] " " hm[2] " 0")
      st = t - 7 * 86400
      if (!n++ || st < first) first = st
      u += used; rem += 100 - used
    }
    END {
      if (!n || now <= first || u <= 0) exit 1
      rate = u / ((now - first) / 3600)
      out = now + rem / rate * 3600
      days = (fri - now) / 86400
      msg = sprintf("Run out %s at this pace; %d%% of an account a day " \
        "lasts to %s.", strftime("%a %H:%M", out),
        days > 0 ? rem / days + 0.5 : 0, strftime("%a %H:%M", fri))
      printf "%s %s\n", (out < fri ? "yes" : "no"), msg
    }'
}

_top3() {
  tok-top --tsv -n 3 2>/dev/null | gawk -F'\t' '
    { name = $2
      if ($6 !~ /\.worktrees\//) name = "main"
      else if (match(name, /^[a-z]+-[0-9]+/)) name = substr(name, 1, RLENGTH)
      s = name " " $1 "M"
      if ($3 != "no PR" && $3 != "-") s = s " " $3
      printf "%s%s", (NR > 1 ? " \302\267 " : ""), s }'
}

_pace_msg() {
  _f=$(_pace) || return 1
  _top=$(_top3)
  _msg="${_f#* }"
  [ -n "$_top" ] && _msg="$_msg Top today: $_top"
  echo "${_f%% *} $_msg"
}

_pace_tick() {
  [ "$(gdate +%u)" -le 5 ] || return 0
  _h=$(gdate +%H)
  if [ "$_h" -ge 15 ]; then _slot=15
  elif [ "$_h" -ge 10 ]; then _slot=10
  else return 0; fi
  _stamp="${LOCAL_CONFIG:-$HOME/.config}/cswap-pace-stamp"
  _key="$(gdate +%F)-$_slot"
  [ "$(cat "$_stamp" 2>/dev/null)" = "$_key" ] && return 0
  echo "$_key" > "$_stamp"
  _r=$(_pace_msg) || return 0
  echo "$(date +%H:%M:%S)  pace: ${_r#* }"
  [ "${_r%% *}" = yes ] && NOTIFY_CLASS=env notify "Tokens" "${_r#* }"
  return 0
}

_tick() {
  cswap auto --once --threshold "${CSWAP_AUTO_THRESHOLD:-98}"
  _reconnect
  _pace_tick
}

case "${1:-}" in
  -n)
    _stale_panes
    _r=$(_pace_msg) && echo "pace ($(echo "${_r%% *}" | sed 's/yes/runs out early/;s/no/on track/')): ${_r#* }"
    ;;
  --once) _tick ;;
  '')
    while :; do
      _tick
      sleep "$_interval"
    done
    ;;
  *) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2; exit 1 ;;
esac
