#!/bin/sh
#
# dev — run a repo's dev processes in the current tmux session's `run`
# window.
#
#   dev up [--wait]  rebuild `run` as fresh shells (index kept), then
#                    source $(repo_root)/.jrb/dev; --wait polls each
#                    URL in DEV_WAIT_URLS
#   dev down         rebuild `run` as a single fresh shell
#   dev trust        show .jrb/dev and trust its sha256 digest
#   dev ls           list tagged dev panes across all sessions
#   dev :            fzf a session with dev panes, switch to its `run`
#   dev logs <tag>   tail -f a tag's log in the current worktree
#
# .jrb/dev is sourced with:
#   TARGET, SESSION        "<session>:run", "<session>"
#   dev_pane <tag> <cmd>   run cmd in a pane (first call reuses the
#                          initial pane, later ones split), output
#                          tee'd to <worktree>/.jrb/logs/<tag>.log
#   dev_wait <url> [s]     poll url until any HTTP response (default
#                          300s), nonzero on timeout
#   DEV_WAIT_URLS          set it for `dev up --wait`

set -e

if test "$(uname)" = 'Darwin'; then
  _grep='ggrep'
else
  _grep='grep'
fi

_tab="$(printf '\t')"

_repo_root() {
  _common_git="$(git rev-parse --git-common-dir)"
  dirname "$(cd "$_common_git" && pwd)"
}

_work_root() {
  git rev-parse --show-toplevel
}

_dev_file() {
  echo "$(_repo_root)/.jrb/dev"
}

_log_dir() {
  echo "$(_work_root)/.jrb/logs"
}

_digest() {
  openssl sha256 "$1"
}

_is_trusted() {
  $_grep -qxF "$(_digest "$1")" ~/..dev.digests 2>/dev/null
}

_session() {
  if test -n "${DEV_SESSION:-}"; then
    echo "$DEV_SESSION"
  elif test -z "${TMUX:-}"; then
    echo "dev: must run inside tmux" >&2
    exit 1
  elif test -n "${TMUX_PANE:-}"; then
    tmux display-message -p -t "$TMUX_PANE" '#S'
  else
    tmux display-message -p '#S'
  fi
}

_run_window() {
  tmux list-windows -t "=$1" \
    -F '#{window_id} #{window_index} #{window_name}' |
    awk '$3 == "run" { print $1, $2; exit }'
}

_with_env() {
  _sub="$1"
  shift
  if test -n "${POLAR_ENV:-}"; then
    tmux "$_sub" -e "POLAR_ENV=$POLAR_ENV" "$@"
  else
    tmux "$_sub" "$@"
  fi
}

_self() {
  echo "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
}

_detach_if_inside_run() {
  test -z "${DEV_SESSION:-}" || return 0
  test -n "${TMUX_PANE:-}" || return 0
  _here="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}')"
  _run="$(_run_window "$_s" | cut -d' ' -f1)"
  test "$_here" = "$_run" || return 0

  mkdir -p "$(_log_dir)"
  _log="$(_log_dir)/dev.log"
  _envs="DEV_SESSION='$_s'"
  if test -n "${POLAR_ENV:-}"; then
    _envs="$_envs POLAR_ENV='$POLAR_ENV'"
  fi
  tmux run-shell -b "cd '$(_work_root)' &&
    $_envs '$(_self)' $* > '$_log' 2>&1;
    tmux display-message 'dev $1 finished: $_log'"
  echo "Rebuilding run window in background; output: $_log"
  exit 0
}

_rebuild() {
  _wr="$(_work_root)"
  set -- $(_run_window "$_s")
  _old_id="${1:-}"
  _old_idx="${2:-}"

  if test -n "$_old_id"; then
    _at="=$_s:"
  elif tmux list-windows -t "=$_s" -F '#{window_index}' |
    $_grep -qx 1; then
    _at="=$_s:"
  else
    _at="=$_s:1"
  fi

  set -- $(_with_env new-window -d -P -F '#{window_id} #{pane_id}' \
    -t "$_at" -n run -c "$_wr")
  _win="$1"
  _first="$2"

  if test -n "$_old_id"; then
    tmux move-window -d -k -s "$_win" -t "=$_s:$_old_idx"
  fi
}

dev_pane() {
  _tag="$1"
  shift
  _cmd="$*"
  _dir="$(_log_dir)"
  _plog="$_dir/$_tag.log"
  mkdir -p "$_dir"
  : > "$_plog"

  if test -n "$_first"; then
    _pane="$_first"
    _first=''
  else
    _pane="$(_with_env split-window -v -d -P -F '#{pane_id}' \
      -t "$_last" -c "$(_work_root)")"
    tmux select-layout -t "$_win" even-vertical
  fi

  _last="$_pane"
  tmux set-option -p -t "$_pane" @dev "$_tag"
  tmux set-option -p -t "$_pane" @dev_log "$_plog"
  tmux select-pane -t "$_pane" -T "$_tag"
  tmux send-keys -t "$_pane" -l "( $_cmd ) 2>&1 | tee '$_plog'"
  tmux send-keys -t "$_pane" Enter
  _tags="$_tags $_tag"
}

dev_wait() {
  _url="$1"
  _deadline=$(( $(date +%s) + ${2:-300} ))
  until curl -s -o /dev/null --max-time 2 "$_url"; do
    if test "$(date +%s)" -ge "$_deadline"; then
      return 1
    fi
    sleep 1
  done
}

_source_dev_file() {
  _path="$1"

  if ! test -x "$_path"; then
    echo ".jrb/dev file not executable: $_path" >&2
    exit 1
  fi

  if ! _is_trusted "$_path"; then
    echo "Untrusted .jrb/dev ($_path). Review it, then run: dev trust" >&2
    exit 1
  fi

  SESSION="$_s"
  TARGET="$_s:run"
  export SESSION TARGET
  cd "$(_work_root)"
  . "$_path"
}

_banner() {
  echo "session: $_s"
  if test -n "${POLAR_ENV:-}"; then
    echo "POLAR_ENV: $POLAR_ENV"
  fi
  for _t in $_tags; do
    echo "  $_t -> $(_log_dir)/$_t.log"
  done
}

_dev_up() {
  _df="$(_dev_file)"
  if ! test -f "$_df"; then
    echo "No .jrb/dev file at $(_repo_root)" >&2
    exit 1
  fi
  if ! _is_trusted "$_df"; then
    echo "Untrusted .jrb/dev ($_df). Review it, then run: dev trust" >&2
    exit 1
  fi

  _s="$(_session)"
  _detach_if_inside_run up "$@"
  _tags=''
  _rebuild
  _source_dev_file "$_df"
  _banner

  test "${1:-}" = '--wait' || return 0
  _failed=0
  for _u in ${DEV_WAIT_URLS:-}; do
    if dev_wait "$_u"; then
      echo "up: $_u"
    else
      echo "timeout: $_u" >&2
      _failed=1
    fi
  done
  return "$_failed"
}

_dev_down() {
  _s="$(_session)"
  _detach_if_inside_run down
  _rebuild
  echo "session: $_s run window reset"
}

_dev_trust() {
  _df="$(_dev_file)"
  if ! test -f "$_df"; then
    echo "No .jrb/dev file at $(_repo_root)" >&2
    exit 1
  fi
  if _is_trusted "$_df"; then
    echo "Already trusted: $_df"
    return
  fi
  cat "$_df"
  if confirm 'Trust this .jrb/dev file?'; then
    _digest "$_df" >> ~/..dev.digests
    return
  fi
  echo "Aborted" >&2
  exit 1
}

_dev_panes() {
  _t="$_tab"
  tmux list-panes -a -F "#{session_name}$_t#{@dev}$_t#{pane_current_command}\
$_t#{pane_current_path}$_t#{@dev_log}" |
    awk -F "$_t" '$2 != ""'
}

_dev_ls() {
  {
    printf 'SESSION\tTAG\tCMD\tPATH\tLOG\n'
    _dev_panes
  } | column -t -s "$_tab"
}

_dev_pick() {
  _pick="$(_dev_panes | cut -f1 | sort -u | fzf)"
  test -n "$_pick" || exit 1
  if test -n "${TMUX:-}"; then
    tmux switch-client -t "=$_pick:run"
  else
    tmux attach-session -t "=$_pick:run"
  fi
}

_dev_logs() {
  if test -z "${1:-}"; then
    echo "Usage: dev logs <tag>" >&2
    exit 1
  fi
  tail -f "$(_log_dir)/$1.log"
}

_usage() {
  echo "Usage: dev [up [--wait]|down|trust|ls|:|logs <tag>]" >&2
  exit 1
}

case "${1:-}" in
  up) shift; _dev_up "$@" ;;
  down) _dev_down ;;
  trust) _dev_trust ;;
  ls) _dev_ls ;;
  :) _dev_pick ;;
  logs) _dev_logs "${2:-}" ;;
  *) _usage ;;
esac
