#!/bin/sh

set -e

_changed() {
  _all=""

  if test "$1" = "-a"; then
    _all=1
    shift
  fi

  _target="${1:-1}"

  case "$_target" in
  .) _base="$(git merge-base HEAD "$(git remote-main-branch)")" ;;
  *[!0-9]*) _base="$_target" ;;
  *) _base="HEAD~$_target" ;;
  esac

  if test -n "$_all"; then
    git diff --name-only "$_base"
  else
    git log \
      --author="$(git config user.name)" \
      --first-parent \
      --name-only \
      --format= \
      "$_base..HEAD"
  fi |
    gawk -F/ 'NF { print ($1 == "services" && NF > 2 ? $3 : $1) }' |
    sort -u
}

# In a repo with a deploy-plan (ice-floe: .github/deploy/targets.json
# and polar's deploy-plan on PATH), no args = what to deploy per
# service; args keep the plain changed-areas listing.
if test $# -eq 0 \
  && test -f "$(git rev-parse --show-toplevel)/.github/deploy/targets.json" \
  && command -v deploy-plan >/dev/null; then
  exec deploy-plan
fi

_changed "$@"
