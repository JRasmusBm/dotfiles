#!/bin/sh

set -e

if test "$(uname)" = 'Darwin'; then
  _grep='ggrep'
else
  _grep='grep'
fi

# Linear workspace slug for issue URLs. Override per machine
# with $LINEAR_WORKSPACE.
_workspace() {
  echo "${LINEAR_WORKSPACE:-polaranalytics-new}"
}

# Pull the Linear identifier (e.g. POL-1527) out of the
# current branch. Branches made by `wt fix`/`wt feat` look
# like <type>/<initials>/<id>-<slug> where <id> is lowercase
# (pol-1527); Linear wants it uppercase.
_branch_identifier() {
  _br="$(git branch --show-current 2>/dev/null || true)"
  if test -z "$_br"; then
    echo "Not on a branch" >&2
    return 1
  fi
  _id="$(printf '%s' "$_br" \
    | $_grep -oiE '[a-z]+-[0-9]+' | head -1 \
    | tr '[:lower:]' '[:upper:]')"
  if test -z "$_id"; then
    echo "No Linear id in branch: $_br" >&2
    return 1
  fi
  echo "$_id"
}

# Open a Linear ticket in the browser. With an explicit id
# ($1, e.g. POL-1715) use it directly; otherwise derive it
# from the current branch. The slug-less /issue/<ID> URL
# redirects to the full ticket.
_lin_open() {
  if test -n "$1"; then
    _id="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
  else
    _id="$(_branch_identifier)" || exit 1
  fi
  _url="https://linear.app/$(_workspace)/issue/$_id"
  echo "$_url" >&2
  open "$_url"
}

_usage() {
  echo "Usage: lin [o|open] [ID]" >&2
}

# No args = primary action (open current ticket). An id like
# POL-1715 is opened directly; `o`/`open` accept one too.
case "${1:-o}" in
  o|open) _lin_open "$2" ;;
  -h|--help|help) _usage ;;
  [A-Za-z]*-[0-9]*) _lin_open "$1" ;;
  *) _usage; exit 1 ;;
esac
