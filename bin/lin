#!/bin/sh
#
# lin — open a Linear ticket in the browser.
#
#   lin              open the current branch's ticket
#   lin o | open     same
#   lin POL-1715     open a specific ticket
#
# With no id, the identifier is read from the current branch
# (e.g. fix/jrb/pol-1527-slug). Workspace defaults to
# polaranalytics-new; override with $LINEAR_WORKSPACE.

set -e

if test "$(uname)" = 'Darwin'; then
  _grep='ggrep'
else
  _grep='grep'
fi

_workspace() {
  echo "${LINEAR_WORKSPACE:-polaranalytics-new}"
}

_branch_identifier() {
  _br="$(git branch --show-current 2>/dev/null || true)"
  if test -z "$_br"; then
    echo "Not on a branch" >&2
    return 1
  fi
  _id="$(printf '%s' "$_br" \
    | $_grep -oiE '[a-z]+-[0-9]+' | head -1 \
    | tr '[:lower:]' '[:upper:]')"
  if test -z "$_id"; then
    echo "No Linear id in branch: $_br" >&2
    return 1
  fi
  echo "$_id"
}

_lin_open() {
  if test -n "$1"; then
    _id="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
  else
    _id="$(_branch_identifier)" || exit 1
  fi
  _url="https://linear.app/$(_workspace)/issue/$_id"
  echo "$_url" >&2
  open "$_url"
}

_usage() {
  echo "Usage: lin [o|open] [ID]" >&2
}

case "${1:-o}" in
  o|open) _lin_open "$2" ;;
  -h|--help|help) _usage ;;
  [A-Za-z]*-[0-9]*) _lin_open "$1" ;;
  *) _usage; exit 1 ;;
esac
