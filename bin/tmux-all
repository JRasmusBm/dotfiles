#!/bin/sh
# tmux-all servers   every tmux server name: default, agents-1..N
#                    (TMUX_AGENT_SHARDS, default 2)
# tmux-all live      the ones whose socket answers
#
# A worktree's session lives on an agents server (shims/tmux); scans
# of every pane or session through the shim already ask each one.

_servers() {
  echo default
  _i=1
  while test "$_i" -le "${TMUX_AGENT_SHARDS:-2}"; do
    echo "agents-$_i"
    _i=$((_i + 1))
  done
}

_dir="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
case "${1:-}" in
  servers) _servers ;;
  live) _servers | while read -r _s; do
      test -S "$_dir/$_s" && echo "$_s"
    done ;;
  *) sed -n '2,4s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
