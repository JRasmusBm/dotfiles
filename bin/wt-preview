#!/bin/sh

# fzf preview for `wt :`. Given the repo root and a picker
# line ("HEADING: branch", "⊘ branch", or a bare name),
# show the worktree's branch, last commit, PR state, and its
# doc (wt doc), else a one-line summary of its latest Claude session.
# Best-effort throughout — missing pieces are skipped so the
# preview never errors out.
# Usage: wt-preview <root> <picker-line>

_root="$1"
_line="$2"
test -n "$_line" || exit 0

# Strip the picker prefix down to the worktree name.
_name="$_line"
case "$_line" in
  '⊘ '*) _name="${_line#⊘ }" ;;
  *': '*) _name="${_line#*: }" ;;
esac
test -n "$_name" || exit 0

_dir="${_name##*/}"
_wt="$_root/.worktrees/$_dir"
test -d "$_wt" || _wt="$_root/.worktrees/$_name"
test -d "$_wt" || exit 0

# Branch + last commit
_branch="$(git -C "$_wt" branch --show-current 2>/dev/null)"
printf 'branch  %s\n' "${_branch:-(detached)}"
git -C "$_wt" log -1 \
  --format='commit  %h  %s%n        %an, %cr' 2>/dev/null
_slug="${_wt##*/}"
# The repo's own lines (its env, ports): .jrb/wt-hook preview.
jrb-hook "$_wt" preview "$_slug" 2>/dev/null
_bf="${LOCAL_CONFIG:-$HOME/.local-config}/worktrees/${_root##*/}.blocked"
if test -f "$_bf"; then
  awk -F '\t' -v s="$_slug" '$1 == s && $3 != "" { print "blocked by  " $3 }
    $1 == s && $3 == "" { print "blocked:    " $4 }' "$_bf"
fi
_nf="${LOCAL_CONFIG:-$HOME/.local-config}/worktrees/${_root##*/}.needsfocus"
if test -f "$_nf"; then
  awk -F '\t' -v s="$_slug" '$1 == s { print "needs focus: " $3 }' "$_nf"
fi
echo

# PR state (best-effort; needs gh)
if command -v gh >/dev/null 2>&1; then
  ( cd "$_wt" 2>/dev/null \
    && gh pr view --json state,title,url \
         -q '"PR " + .state + "  " + .title, "   " + .url' \
       2>/dev/null )
  echo
fi

# The agent's doc (wt doc) when it keeps one: its top says what it
# builds and where it stands. Else a snippet from the most recent
# Claude session for this worktree: the first user prompt. Context
# dir = the path with / and . → -.
_ctx="$HOME/.claude/projects/$(printf '%s' "$_wt" \
  | sed 's![/.]!-!g')"
if test -f "$_wt/.jrb/doc.md"; then
  head -n 30 "$_wt/.jrb/doc.md"
elif test -d "$_ctx"; then
  _last="$(ls -t "$_ctx"/*.jsonl "$_ctx"/*.jsonl.gz 2>/dev/null \
    | head -1)"
  if test -n "$_last"; then
    # First user prompt = what the session was about. Stream
    # and stop at the first match (head closes the pipe), so
    # we don't parse the whole multi-MB transcript.
    _sum=""
    if command -v jq >/dev/null 2>&1; then
      _sum="$(gzip -cdf "$_last" 2>/dev/null | jq -r '
        select(.type=="user") | (.message.content | strings)' \
        2>/dev/null | head -1)"
    fi
    if test -z "$_sum"; then
      _sum="$(gzip -cdf "$_last" 2>/dev/null \
        | grep -m1 '"type":"user"' \
        | sed -n 's/.*"content":"//p')"
    fi
    if test -n "$_sum" && test "$_sum" != null; then
      printf 'last AI  %s\n' "$(printf '%s' "$_sum" \
        | tr '\n' ' ' | cut -c1-240)"
    fi
  fi
fi
