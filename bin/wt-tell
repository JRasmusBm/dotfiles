#!/bin/sh
#
# wt-tell <worktree> <key> <ping> <prompt> — tell the worktree's idle
# Claude (its `cli` pane) <prompt>, once per worktree and key
# ($LOCAL_CONFIG/wt-told). No session (or tmux down, as after a
# reboot) or no Claude in its cli window: starts it with
# `claude --continue` there (plain `claude` when the worktree has
# no conversation yet; the session `run-slot close` closed there,
# if it did; a big chat as a fresh, briefed one: claude-fresh resume) and hands the tell to `run-slot pend`, which delivers it
# once Claude is up and keeps the session open until then: exit 0,
# though not yet told, so the caller stops retrying. WT_TELL_SID names
# the chat instead (a main checkout's: there `--continue` opens the
# wrong one, so without a sid it gets the ping below). Reviving and
# telling both wait their turn in `run-slot` (room on the Mac, tells
# first); a queued one is run from there once there is room. A
# worktree that is gone (or WT_TELL_NO_REVIVE set): pings me (check)
# with <ping> once instead. Claude busy: fails too. Only the agent
# knows whether a tell is what its `wt w8` waits on, so any other tell
# leaves the w8 open and ends with what it waits on, until when (or
# that it is overdue), and to `wt w8 done` if this was it. A w8:* tell
# (wt-sync, at the deadline) ends the w8 and drops the worktree's
# overdue inbox row: its agent checks now, sets a new w8 or pings me if
# it needs me. WT_TELL_CAN_WAIT=1 marks an information-only tell: to a
# parked worktree it is held, not told (see _parked below).

_root="$1" _key="$2" _msg="$3" _prompt="$4"
test -n "$_root" && test -n "$_key" && test -n "$_prompt" \
  || { sed -n '3,6s/^# \{0,1\}//p' "$0" >&2; exit 2; }
_told="${LOCAL_CONFIG:?}/wt-told"
# Ours alone: a tmux server `wt open` starts must not hand it on.
_pending="${RUN_SLOT_PENDING:-}"
unset RUN_SLOT_PENDING
_slug="$(basename "$_root")" _repo="$(basename "${_root%%/.worktrees/*}")"
_wf="$LOCAL_CONFIG/worktrees/$_repo.waiting"
_start=""
case "$_key" in w8:*) _start="${_key##*:}" ;; esac
# A w8:<slug>:<start> tell ends that w8 and its overdue inbox row; any
# other tell leaves the w8 to its agent.
_w8_done() {
  test -n "$_start" || return 0
  notif seen-ref "$_repo/$_slug" >/dev/null 2>&1 || true
  test -f "$_wf" || return 0
  awk -F '\t' -v s="$_slug" -v t="$_start" '!($1 == s && $5 == t)' "$_wf" \
    | sponge "$_wf"
}
# The open w8 any other tell leaves in place, as a line for the prompt.
_w8_open() {
  test -z "$_start" || return 0
  awk -F '\t' -v s="$_slug" -v now="$(date +%FT%H:%M)" '$1 == s {
      d = $3; sub(/T/, " ", d)
      if ($3 > now)
        printf " Your wt w8 is still open: %s, until %s.", $4, d
      else
        printf " Your wt w8 is overdue (since %s): %s. Check on it now.",
          d, $4
      printf " If this tell was that event, run wt w8 done; else it " \
        "stays open."
    }' "$_wf" 2>/dev/null
}
_told_k() { grep -qxF "$_root	$1" "$_told" 2>/dev/null; }
case "$_key" in
  w8:*)
    # Moot once that w8 ended (`wt w8 done`, `ip`, `rm`, its delivered
    # tell) or a new `wt w8` replaced it: done, nothing to say.
    awk -F '\t' -v s="$_slug" -v t="$_start" \
      '$1 == s && $5 == t { f = 1 } END { exit !f }' "$_wf" 2>/dev/null \
      || exit 0
    # Told or pinged already, its row still there (wt-sync offers every
    # overdue one each minute): it ends now, so it stops coming back.
    if _told_k "$_key" || _told_k "ping:$_key"; then
      _w8_done
      exit 0
    fi
    # Its revived chat has it pending (run-slot deliver, until the TTL):
    # leave it there, or both could tell it.
    test -n "$_pending" || ! awk -F '\t' -v now="$(date +%s)" \
      -v id="tell:$(basename "$_root"):$_key" \
      '$2 == id && now - $1 < 259200 { f = 1 } END { exit !f }' \
      "$LOCAL_CONFIG/run-slots/pending" 2>/dev/null || exit 0 ;;
  *) ! _told_k "$_key" || exit 0 ;;
esac

# Parked: its tmux session not attached (nor started) for WT_PARK_HOURS
# (6) and none attached now, no open `wt w8` (its agent waits on something, maybe
# this), not in run-slots/keep (driven over Remote Control), and its
# board row not in # P0, # TEAM REVIEW or # READY TO DEPLOY.
_parked() {
  case "$_root" in */.worktrees/*) ;; *) return 1 ;; esac
  test -d "$_root" || return 1
  # A session never attached has no last attach: its start counts.
  _f='#{session_name}	#{session_attached}	'
  tmux list-sessions -F "$_f#{session_last_attached}	#{session_created}" \
    2>/dev/null | awk -F '\t' -v s="$_slug" \
      -v t="$(( $(date +%s) - ${WT_PARK_HOURS:-6} * 3600 ))" '
    $1 == s { f = $2 > 0 || $3 + 0 > t || ($3 == "" && $4 + 0 > t) }
    END { exit f }' || return 1
  ! awk -F '\t' -v s="$_slug" '$1 == s { f = 1 } END { exit !f }' \
    "$_wf" 2>/dev/null || return 1
  ! grep -qxF "$_slug" "$LOCAL_CONFIG/run-slots/keep" 2>/dev/null \
    || return 1
  _br="$(git -C "$_root" branch --show-current 2>/dev/null)"
  ! awk -v b="$_br" -v s="$_slug" '
    /^[[:space:]]*#/ || /:[[:space:]]*$/ {
      h = toupper($0)
      sub(/^[[:space:]]*#+[[:space:]]*/, "", h)
      sub(/:[[:space:]]*$/, "", h)
      next
    }
    { e = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", e) }
    e != "" && (e == b || e == s) {
      f = h ~ /^(P0|TEAM REVIEW|READY TO DEPLOY)$/
      exit
    }
    END { exit !f }' "$LOCAL_CONFIG/worktrees/$_repo" 2>/dev/null
}
# WT_TELL_CAN_WAIT: the caller says this tell is information the agent
# can act on later (a staging deploy, red CI on a PR nobody reviews).
# To a parked worktree it is held in <repo>.held instead of waking its
# Claude, which re-reads the whole chat for it, and counts as told so
# the caller stops retrying. `wt-held` hands it over when I'm back.
if test -n "${WT_TELL_CAN_WAIT:-}" && _parked; then
  printf '%s\t%s\t%s\t%s\n' "$_slug" "$(date +%s)" "$_key" \
    "$(printf '%s' "$_prompt" | tr '\t\n' '  ')" \
    >> "$LOCAL_CONFIG/worktrees/$_repo.held"
  echo "$_root	$_key" >> "$_told"
  exit 0
fi
# $1: a run-slot id, revive per worktree (two tells, one revive) or
# tell per key. A pumped rerun keeps WT_TELL_NO_REVIVE.
_rerun() {
  "$@" env WT_TELL_NO_REVIVE="${WT_TELL_NO_REVIVE:-}" \
    WT_TELL_SID="${_sid:-}" WT_TELL_CAN_WAIT="${WT_TELL_CAN_WAIT:-}" \
    wt-tell "$_root" "$_key" "$_msg" "$_prompt" >/dev/null
}
_gate() { _rerun run-slot gate tell "$1" --; }
# A pending run (run-slot pump) reports back: 1 = not told yet.
_pend() {
  test -z "$_pending" || return 1
  _rerun run-slot pend "tell:$(basename "$_root"):$_key" --
}

# WT_TELL_SID: the chat to tell, wherever it runs (claude-pane); not
# running, it is resumed by id and the tell pends. Without one a
# main checkout (many chats in one session) gets the ping: its `cli`
# pane is whichever chat ran there last, never the one meant.
_sid="${WT_TELL_SID:-}"
if test -n "$_sid"; then
  _pane="$(claude-pane "$_sid" 2>/dev/null)" || _pane=""
  if test -z "$_pane"; then
    test -z "${WT_TELL_NO_REVIVE:-}" || exit 1
    if _gate "revive:$_sid"; then
      run-slot revive "$_sid" >/dev/null 2>&1 \
        || claude-pane open "$_sid" >/dev/null 2>&1 || true
    fi
    _pend
    exit
  fi
elif case "$_root" in */.worktrees/*) false ;; *) true ;; esac; then
  _pane=""
  WT_TELL_NO_REVIVE=1
else
  _pane="$(tmux display-message -p -t "=$(basename "$_root"):cli" \
    '#{pane_id}' 2>/dev/null)" || _pane=""
fi
_cmd="$(tmux display-message -p -t "$_pane" '#{pane_current_command}' \
  2>/dev/null)" || _cmd=""
case "$_cmd" in zsh|bash|sh|fish) _shell=1 ;; *) _shell="" ;; esac
# A wrapper script (cr) shows as bash while Claude runs under it.
if test -n "$_shell"; then
  _tty="$(tmux display-message -p -t "$_pane" '#{pane_tty}' 2>/dev/null)"
  if ps -o tpgid=,pgid=,comm= -t "${_tty#/dev/}" 2>/dev/null \
    | awk '$1 == $2 && $3 ~ /(^|\/)claude$/ { found = 1 }
      END { exit !found }'; then
    _shell=""
  fi
fi
if { test -z "$_pane" || test -n "$_shell"; } \
  && test -z "${WT_TELL_NO_REVIVE:-}" && test -d "$_root"; then
  if _gate "revive:$(basename "$_root")"; then
    if test -n "$_pane"; then
      run-slot revive "$_pane" >/dev/null \
        || tmux send-keys -t "$_pane" "hash -r; claude $(claude-fresh \
          resume - "$_root" 2>/dev/null || echo --continue) || claude" Enter
    else
      ( cd "$_root" && _WT_CONTINUE=1 WT_NO_ATTACH=1 \
        wt open "$(basename "$_root")" ) >/dev/null 2>&1 || true
    fi
  fi
  _pend
  exit
fi
if test -z "$_pane"; then
  if ! grep -qxF "$_root	ping:$_key" "$_told" 2>/dev/null; then
    echo "$_root	ping:$_key" >> "$_told"
    _w8_done
    # A gone worktree pings from its main checkout.
    ( { cd "$_root" 2>/dev/null || cd "${_root%%/.worktrees/*}"; } \
      && TMUX_PANE='' NOTIFY_CLASS=check notify "$(basename "$_root")" \
        "$_msg" )
  fi
  # Pinged instead: a pending run is settled.
  test -n "$_pending"
  exit
fi
claude-pane-idle "$_pane" || exit 1
_gate "tell:$(basename "$_root"):$_key" || exit 1

echo "$_root	$_key" >> "$_told"
_w8_done
notif seen "$_pane" all >/dev/null 2>&1 || true
tmux send-keys -t "$_pane" -l "$_prompt$(_w8_open)"
sleep 0.5
tmux send-keys -t "$_pane" Enter
