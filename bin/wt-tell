#!/bin/sh
#
# wt-tell <worktree> <key> <ping> <prompt> — tell the worktree's idle
# Claude (its `cli` pane) <prompt>, once per worktree and key
# ($LOCAL_CONFIG/wt-told). No session (or tmux down, as after a
# reboot) or no Claude in its cli window: starts it with
# `claude --continue` there (plain `claude` when the worktree has
# no conversation yet; the session `run-slot close` closed there,
# if it did) and hands the tell to `run-slot pend`, which delivers it
# once Claude is up and keeps the session open until then: exit 0,
# though not yet told, so the caller stops retrying. Reviving and
# telling both wait their turn in `run-slot` (room on the Mac, tells
# first); a queued one is run from there once there is room. A
# worktree that is gone (or WT_TELL_NO_REVIVE set): pings me (check)
# with <ping> once instead. Claude busy: fails too. A tell or ping
# delivered ends the worktree's `wt w8`: what it waited on has
# arrived. A w8:* tell (wt-sync, at the deadline) also drops the
# worktree's overdue inbox row: its agent checks now and pings me if
# it needs me.

_root="$1" _key="$2" _msg="$3" _prompt="$4"
test -n "$_root" && test -n "$_key" && test -n "$_prompt" \
  || { sed -n '3,6s/^# \{0,1\}//p' "$0" >&2; exit 2; }
_told="${LOCAL_CONFIG:?}/wt-told"
# Ours alone: a tmux server `wt open` starts must not hand it on.
_pending="${RUN_SLOT_PENDING:-}"
unset RUN_SLOT_PENDING
_w8_done() {
  _wf="$LOCAL_CONFIG/worktrees/$(basename "${_root%%/.worktrees/*}").waiting"
  case "$_key" in
    w8:*) notif seen-ref "$(basename "${_root%%/.worktrees/*}")/$(basename \
      "$_root")" >/dev/null 2>&1 || true ;;
  esac
  test -f "$_wf" || return 0
  awk -F '\t' -v s="$(basename "$_root")" '$1 != s' "$_wf" | sponge "$_wf"
}
grep -qxF "$_root	$_key" "$_told" 2>/dev/null && exit 0
# A w8:<slug>:<start> tell is moot once that w8 ended (`wt ip`, `rm`,
# a delivered tell) or a new `wt w8` replaced it: done, nothing to say.
case "$_key" in
  w8:*)
    awk -F '\t' -v s="$(basename "$_root")" -v t="${_key##*:}" \
      '$1 == s && $5 == t { f = 1 } END { exit !f }' \
      "$LOCAL_CONFIG/worktrees/$(basename "${_root%%/.worktrees/*}").waiting" \
      2>/dev/null || exit 0 ;;
esac
# $1: a run-slot id, revive per worktree (two tells, one revive) or
# tell per key. A pumped rerun keeps WT_TELL_NO_REVIVE.
_rerun() {
  "$@" env WT_TELL_NO_REVIVE="${WT_TELL_NO_REVIVE:-}" \
    wt-tell "$_root" "$_key" "$_msg" "$_prompt" >/dev/null
}
_gate() { _rerun run-slot gate tell "$1" --; }
# A pending run (run-slot pump) reports back: 1 = not told yet.
_pend() {
  test -z "$_pending" || return 1
  _rerun run-slot pend "tell:$(basename "$_root"):$_key" --
}

_pane="$(tmux display-message -p -t "=$(basename "$_root"):cli" \
  '#{pane_id}' 2>/dev/null)" || _pane=""
_cmd="$(tmux display-message -p -t "$_pane" '#{pane_current_command}' \
  2>/dev/null)" || _cmd=""
case "$_cmd" in zsh|bash|sh|fish) _shell=1 ;; *) _shell="" ;; esac
if { test -z "$_pane" || test -n "$_shell"; } \
  && test -z "${WT_TELL_NO_REVIVE:-}" && test -d "$_root"; then
  if _gate "revive:$(basename "$_root")"; then
    if test -n "$_pane"; then
      run-slot revive "$_pane" >/dev/null \
        || tmux send-keys -t "$_pane" "claude --continue || claude" Enter
    else
      ( cd "$_root" && _WT_CONTINUE=1 WT_NO_ATTACH=1 \
        wt open "$(basename "$_root")" ) >/dev/null 2>&1 || true
    fi
  fi
  _pend
  exit
fi
if test -z "$_pane"; then
  if ! grep -qxF "$_root	ping:$_key" "$_told" 2>/dev/null; then
    echo "$_root	ping:$_key" >> "$_told"
    _w8_done
    # A gone worktree pings from its main checkout.
    ( { cd "$_root" 2>/dev/null || cd "${_root%%/.worktrees/*}"; } \
      && TMUX_PANE='' NOTIFY_CLASS=check notify "$(basename "$_root")" \
        "$_msg" )
  fi
  # Pinged instead: a pending run is settled.
  test -n "$_pending"
  exit
fi
claude-pane-idle "$_pane" || exit 1
_gate "tell:$(basename "$_root"):$_key" || exit 1

echo "$_root	$_key" >> "$_told"
_w8_done
notif seen "$_pane" all >/dev/null 2>&1 || true
tmux send-keys -t "$_pane" -l "$_prompt"
sleep 0.5
tmux send-keys -t "$_pane" Enter
