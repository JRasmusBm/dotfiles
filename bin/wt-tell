#!/bin/sh
#
# wt-tell <worktree> <key> <ping> <prompt> — tell the worktree's idle
# Claude (its `cli` pane) <prompt>, once per worktree and key
# ($LOCAL_CONFIG/wt-told). No session (or tmux down, as after a
# reboot) or no Claude in its cli window: starts it with
# `claude --continue` there, only while memory is free (wt-night's
# limits), at most one per WT_TELL_REVIVE_SECS (default by free GB:
# 30 from 16, 60 from 12, else 120: a new Claude takes a while to
# reach its full size, so the gauge lags), and fails without
# recording the tell, so the caller's next run tells it once Claude
# is up. A worktree that is gone (or WT_TELL_NO_REVIVE set): pings me (check) with <ping>
# once instead. Claude busy: fails too.

_root="$1" _key="$2" _msg="$3" _prompt="$4"
test -n "$_root" && test -n "$_key" && test -n "$_prompt" \
  || { sed -n '3,6s/^# \{0,1\}//p' "$0" >&2; exit 2; }
_told="${LOCAL_CONFIG:?}/wt-told"
grep -qxF "$_root	$_key" "$_told" 2>/dev/null && exit 0

_pane="$(tmux display-message -p -t "=$(basename "$_root"):cli" \
  '#{pane_id}' 2>/dev/null)" || _pane=""
_cmd="$(tmux display-message -p -t "$_pane" '#{pane_current_command}' \
  2>/dev/null)" || _cmd=""
case "$_cmd" in zsh|bash|sh|fish) _shell=1 ;; *) _shell="" ;; esac
if { test -z "$_pane" || test -n "$_shell"; } \
  && test -z "${WT_TELL_NO_REVIVE:-}" && test -d "$_root"; then
  _rv="$LOCAL_CONFIG/wt-tell.revived"
  _now="$(date +%s)"
  _gb="$(vm_stat | awk '/page size of/ { ps = $8 }
    /Pages (free|inactive|speculative)/ { sub(/\./, "", $NF); n += $NF }
    END { print int(n * ps / 1073741824) }')"
  _gap="${WT_TELL_REVIVE_SECS:-}"
  if test -z "$_gap"; then
    if test "$_gb" -ge 16; then _gap=30
    elif test "$_gb" -ge 12; then _gap=60
    else _gap=120; fi
  fi
  if test "$(sysctl -n kern.memorystatus_vm_pressure_level)" -le 1 \
    && test "$_gb" -ge "${WT_NIGHT_MIN_GB:-8}" \
    && test "$(( _now - $(cat "$_rv" 2>/dev/null || echo 0) ))" \
      -ge "$_gap"; then
    echo "$_now" > "$_rv"
    if test -n "$_pane"; then
      tmux send-keys -t "$_pane" "claude --continue" Enter
    else
      ( cd "$_root" && _WT_CONTINUE=1 WT_NO_ATTACH=1 \
        wt open "$(basename "$_root")" ) >/dev/null 2>&1 || true
    fi
  fi
  exit 1
fi
if test -z "$_pane"; then
  if ! grep -qxF "$_root	ping:$_key" "$_told" 2>/dev/null; then
    echo "$_root	ping:$_key" >> "$_told"
    ( cd "$_root" && TMUX_PANE= NOTIFY_CLASS=check \
      notify "$(basename "$_root")" "$_msg" )
  fi
  exit 1
fi
claude-pane-idle "$_pane" || exit 1

echo "$_root	$_key" >> "$_told"
notif seen "$_pane" all >/dev/null 2>&1 || true
tmux send-keys -t "$_pane" -l "$_prompt"
sleep 0.5
tmux send-keys -t "$_pane" Enter
