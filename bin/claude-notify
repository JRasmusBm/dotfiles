#!/bin/sh

# Claude's Notification hook. Classifies what the agent needs from
# me from facts, not from its wording, so `notif next` (M-i) can
# take the most valuable stop first (see NOTIFY_CLASS in notify):
#   merge    its PR is open, not draft, CLEAN, green and based on dev
#            (a stacked PR is fyi until its base merges; wins over
#            a question: the agent's offer rides along in the text)
#   blocked  a permission prompt, or its last message asks me
#   fail     its PR has a failing check
#   (merged) its PR is merged: the agent, not me, is told
#            (pr-merged-tell; wt-sync retries)
#   fyi      anything else ("done", nothing for me)

INPUT=$(cat)
TYPE=$(echo "$INPUT" | jq -r '.notification_type // "unknown"')
TRANSCRIPT=$(echo "$INPUT" | jq -r '.transcript_path // empty')

# Tmux context (session:window.pane) or fallback to cwd
if [ -n "$TMUX_PANE" ]; then
  CONTEXT=$(tmux display-message -p -t "$TMUX_PANE" '#S:#W.#P')
else
  CONTEXT=$(basename "$PWD")
fi

# Sticky: stays in the inbox until I reply (notif seen hook)
export NOTIFY_MODE=sticky

_last_text() {
  test -f "$TRANSCRIPT" || return 0
  tail -40 "$TRANSCRIPT" | jq -rs '
    [ .[] | select(.type == "assistant")
      | .message.content[]? | select(.type == "text") | .text ]
    | last // ""' 2>/dev/null
}

_pr_class() {
  timeout 5 gh pr view --json number,state,isDraft,mergeStateStatus,statusCheckRollup,body,baseRefName \
    2>/dev/null | jq -r '
      ([.statusCheckRollup[]? | (.conclusion // .state // "")]) as $c
      | if .state == "MERGED"
          then "check\tmerged #\(.number): verify it live, then wt rp or wt done"
        elif .state == "CLOSED" then empty
        elif ($c | any(. == "FAILURE" or . == "ERROR" or . == "TIMED_OUT"))
          then "fail\tCI red on #\(.number)"
        elif (.isDraft | not) and .mergeStateStatus == "CLEAN"
          and ((.body // "") | test("do not merge"; "i") | not)
          and .baseRefName != "dev"
          then "fyi\tstacked on \(.baseRefName)"
        elif (.isDraft | not) and .mergeStateStatus == "CLEAN"
          and ((.body // "") | test("do not merge"; "i") | not)
          then "merge\tREADY TO MERGE #\(.number)"
        else empty end' 2>/dev/null
}

_after_local_command() {
  test -f "$TRANSCRIPT" || return 1
  tail -40 "$TRANSCRIPT" | jq -rs '
    [ .[] | select(.type == "user" or .type == "assistant"
        or .subtype == "local_command") ]
    | last | .subtype // ""' 2>/dev/null | grep -qx local_command
}

case "$TYPE" in
  idle_prompt)
    # A slash command like cswap-auto's /remote-control left no
    # reply to wait for.
    _after_local_command && exit 0
    ;;
  permission_prompt)
    NOTIFY_CLASS=blocked notify "Claude: $CONTEXT" "needs permission" \
      /System/Library/Sounds/Funk.aiff
    exit 0
    ;;
esac

_text="$(_last_text | sed -e 's/[[:space:]]*$//')"
_q=""
case "$_text" in
  *\?) _q="$(printf '%s\n' "$_text" | tail -1 | cut -c1-80)" ;;
esac

_pr="$(_pr_class)"
case "$_pr" in
  check*)
    _num="${_pr#*#}" _root="$(git rev-parse --show-toplevel)"
    _pr=""
    if ! grep -qxF "$_root	${_num%%:*}" "${LOCAL_CONFIG:?}/merged-told" \
      2>/dev/null; then
      ( sleep 2; pr-merged-tell "$_root" "${_num%%:*}" ) \
        >/dev/null 2>&1 &
      exit 0
    fi
    ;;
esac
# Any newer ping supersedes this pane's old merge ping.
case "$_pr" in
  merge*) ;;
  *) [ -z "$TMUX_PANE" ] || notif seen "$TMUX_PANE" all >/dev/null 2>&1 || true ;;
esac
case "$_pr" in
  merge*)
    NOTIFY_CLASS=merge notify "Claude: $CONTEXT" \
      "${_pr#*	}${_q:+ (asks: $_q)}"
    ;;
  *)
    if [ -n "$_q" ]; then
      NOTIFY_CLASS=blocked notify "Claude: $CONTEXT" "asks: $_q" \
        /System/Library/Sounds/Funk.aiff
    elif [ -n "$_pr" ]; then
      NOTIFY_CLASS="${_pr%%	*}" notify "Claude: $CONTEXT" "${_pr#*	}"
    else
      NOTIFY_CLASS=fyi notify "Claude: $CONTEXT" "done"
    fi
    ;;
esac
