#!/bin/sh

# claude-pane <sid>       print the tmux pane running Claude session
#                         <sid>, or fail when it runs nowhere
# claude-pane cwd <sid>   print the directory <sid> runs or ran in
# claude-pane of <pane>   print the session id of the Claude in <pane>
# claude-pane open <sid>  the live pane, else resume <sid> in a new
#                         window of its checkout's tmux session
#                         (created if missing); print that pane
# claude-pane map         every live chat: <pane><TAB><sid><TAB><cwd>
#
# A Claude chat's identity is its session id, not the pane it runs
# in: panes get killed and reused, and the main checkout's session
# holds many chats, so a pane or path can't find one again. The
# inbox (`notif`), `chats` (M-/) and `slack-inbox` watches keep the
# id and ask here where it is now.
#
# Live: ${CLAUDE_CONFIG_DIR:-~/.claude}/sessions/<pid>.json (sessionId,
# cwd, tmux "sess:@win.%pane") of a running pid whose ancestry holds
# that pane's shell (pane ids restart with the tmux server).
# Gone: the cwd comes from its transcript's first row.

_cd="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

_live() {
  for _f in "$_cd"/sessions/*.json; do
    test -f "$_f" || continue
    _pid="$(basename "$_f" .json)"
    kill -0 "$_pid" 2>/dev/null || continue
    _pane="$(jq -r --arg s "$1" \
      'select(.sessionId == $s) | .tmux // "" | sub(".*\\."; "")' \
      "$_f" 2>/dev/null)"
    case "$_pane" in %*) ;; *) continue ;; esac
    _shell="$(tmux display-message -p -t "$_pane" '#{pane_pid}' \
      2>/dev/null)" || continue
    _p="$_pid" _n=0
    while test -n "$_p" && test "$_p" -gt 1 && test "$_n" -lt 6; do
      if test "$_p" = "$_shell"; then
        echo "$_pane"
        return 0
      fi
      _p="$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d ' ')"
      _n=$((_n + 1))
    done
  done
  return 1
}

_cwd() {
  for _f in "$_cd"/sessions/*.json; do
    test -f "$_f" || continue
    jq -r --arg s "$1" 'select(.sessionId == $s) | .cwd // empty' \
      "$_f" 2>/dev/null
  done | grep -m1 . && return 0
  _t="$(find "$_cd/projects" -mindepth 2 -maxdepth 2 \
    -name "$1.jsonl" 2>/dev/null | head -1)"
  test -n "$_t" || return 1
  grep -m1 -F '"cwd":"' "$_t" | jq -r '.cwd // empty' 2>/dev/null \
    | grep .
}

_of() {
  for _f in "$_cd"/sessions/*.json; do
    test -f "$_f" || continue
    kill -0 "$(basename "$_f" .json)" 2>/dev/null || continue
    jq -r --arg p "$1" \
      'select((.tmux // "") | endswith("." + $p)) | .sessionId // empty' \
      "$_f" 2>/dev/null
  done | grep -m1 .
}

_map() {
  _ps="$(ps -A -o pid=,ppid=)"
  _panes="$(tmux list-panes -a -F '#{pane_id} #{pane_pid}' 2>/dev/null)"
  for _f in "$_cd"/sessions/*.json; do
    test -f "$_f" || continue
    _pid="$(basename "$_f" .json)"
    kill -0 "$_pid" 2>/dev/null || continue
    jq -r '[(.tmux // "" | sub(".*\\."; "")), .sessionId // "", .cwd // ""]
      | @tsv' "$_f" 2>/dev/null | while IFS="$(printf '\t')" read -r _p _s _c
    do
      case "$_p" in %*) ;; *) continue ;; esac
      _shell="$(printf '%s\n' "$_panes" \
        | awk -v p="$_p" '$1 == p { print $2 }')"
      test -n "$_shell" || continue
      printf '%s\n' "$_ps" | awk -v pid="$_pid" -v sh="$_shell" '
        { up[$1] = $2 }
        END {
          for (p = pid; p > 1 && n < 6; n++) {
            if (p == sh) exit 0
            p = up[p]
          }
          exit 1
        }' && printf '%s\t%s\t%s\n' "$_p" "$_s" "$_c"
    done
  done
}

_open() {
  _live "$1" && return 0
  _dir="$(_cwd "$1")" || return 1
  test -d "$_dir" || return 1
  _home="$_dir"
  case "$_dir" in
    */.worktrees/?*)
      _s="${_dir#*/.worktrees/}"
      _home="${_dir%%/.worktrees/*}/.worktrees/${_s%%/*}"
      ;;
  esac
  _sess="$(tmux-session-name-from-path "$_home")"
  if ! tmux has-session -t "=$_sess" 2>/dev/null; then
    ( cd "$_home" && INITIATED_EXTERNALLY=true default_tmux_session ) \
      >/dev/null 2>&1 || true
  fi
  _new="$(tmux new-window -d -P -F '#{pane_id}' -t "=$_sess:" \
    -c "$_dir" -n claude)" || return 1
  tmux send-keys -t "$_new" "claude --resume $1" Enter
  echo "$_new"
}

case "${1:-}" in
  "") sed -n '3,11s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
  cwd) _cwd "${2:?sid}" ;;
  of) _of "${2:?pane}" ;;
  open) _open "${2:?sid}" ;;
  map) _map ;;
  *) _live "$1" ;;
esac
