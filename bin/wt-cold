#!/usr/bin/env python3
"""Put every work item that stopped moving in my inbox, until it moves.

  wt-cold            every item with its state and reason (dry run)
  wt-cold --ping     sync the inbox: a `stalled` row per STALLED item
  wt-cold --sync     --ping on weekdays 08:00-19:00, every 10 minutes
                     (wt-sync, every minute)
  wt-cold --overdue  only the overdue `wt w8` rows, at any hour (wt-sync,
                     once a deadline passed); leaves every other row
  wt-cold --brief    counts per state and the STALLED list (notif depth);
                     reuses the last run's result when under 10 min old

Items: every row of the board in each repo of wt-sync, in every section,
with or without a worktree on disk; plus one batched item each for my
open PRs not on the board and worktrees on disk with no board row.

Each item is in exactly one state, checked in this order:
  SNOOZED  `wt sz` until a date, or BLOCKED on a worktree that is
  WAITING  `wt w8 <when> "<what>"` before its deadline (an agent may
           poll meanwhile); or the agent waits on a background agent
           or shell, for up to 60 minutes (no cap while a subagent
           keeps writing its transcript)
  ACTIVE   a Claude agent of the worktree is mid-turn, unless its pane
           and branch haven't changed for 60 minutes (spinning)
  STALLED  everything else, waiting on me included:
             w8 deadline passed: "overdue: <what> (expected HH:MM)"
             BLOCKED on a worktree: that worktree's state
             BLOCKED on a ticket (ABC-123 in the reason): WAITING while
             it is started in Linear and changed in the last workday
             BLOCKED on free text: make it a ticket or snooze it
             a pending inbox row on it (not an overdue w8): "waiting
             on you: <its message>",
             or for a bare "done" the agent's last question, else its
             section and PR state
             else the one touch it needs, read from PR, disk and section
Weekends don't count toward any elapsed time.

Pinging: one `stalled` row (`notify`, ranked after merge and blocked)
per STALLED item with no pending row on it, once it has stalled for
WT_STALL_MIN (30) minutes; an overdue w8 at once, even when the worktree
has a pending row of its own or its row was cleared before the deadline
(wt-sync runs --overdue within a minute of it, at any hour). An item
blocked on a stalled worktree gets none: the blocker's row says "+N
blocked on this". A cleared row comes back after WT_STALL_MIN while the
item is still STALLED. A row clears itself on the next run once its item
is no longer STALLED, or is replaced when the touch it needs changed;
rows carry a ref (NOTIFY_REF) so this holds after a jump re-keyed them
onto a pane. Rows whose PR merged or closed while the board row is still
live, rows with no worktree in a live section, unboarded PRs and orphan
worktrees each go in one batched row per repo.

State between runs: $LOCAL_CONFIG/wt-cold-state (JSON). Each --ping /
--sync run appends its counts to $LOCAL_CONFIG/stalled.log: epoch,
stalled, waiting, active, snoozed, inbox pending.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from datetime import datetime, timedelta

HERE = os.path.dirname(os.path.realpath(__file__))
CONF = os.environ.get('LOCAL_CONFIG') or os.path.expanduser(
    '~/.config/jrasmusbm')
STAMP = os.path.join(CONF, 'wt-cold-stamp')
STATE = os.path.join(CONF, 'wt-cold-state')
LAST = os.path.join(CONF, 'wt-cold-last')
COUNTS = os.path.join(CONF, 'stalled.log')
STALL = int(os.environ.get('WT_STALL_MIN', '30')) * 60
CAP = 3600
STATES = ['STALLED', 'WAITING', 'ACTIVE', 'SNOOZED']
# Sections where a merged PR or a missing worktree means the row is
# left over, not on its way.
LIVE = {'P0', 'IN PROGRESS', 'TEAM REVIEW', 'PAUSED', 'BLOCKED', 'NEEDS FOCUS'}
TICKET = re.compile(r'\b[A-Z][A-Z0-9]*-[0-9]+\b')
NOW = time.time()


def notif_depth():
    path = os.path.join(HERE, 'notif-depth')
    loader = importlib.machinery.SourceFileLoader('notif_depth', path)
    spec = importlib.util.spec_from_loader('notif_depth', loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def sh(*cmd, cwd=None, timeout=60):
    try:
        return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                              timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ''


def wk(a, b=None):
    """Seconds from a to b (now) that fall on a weekday."""
    b = NOW if b is None else b
    if b <= a:
        return 0
    t, n = a, 0
    while t < b:
        d = datetime.fromtimestamp(t)
        nxt = datetime.combine(d.date() + timedelta(days=1),
                               datetime.min.time()).timestamp()
        if d.weekday() < 5:
            n += min(nxt, b) - t
        t = nxt
    return n


def ago(sec):
    h = sec / 3600
    return f'{h / 24:.0f}d' if h >= 48 else f'{h:.0f}h' if h >= 1 \
        else f'{sec / 60:.0f}m'


def hm(t):
    return datetime.fromtimestamp(t).strftime('%H:%M')


def day(iso):
    return iso[:10] if iso else '?'


def parse_when(s):
    for fmt in ('%Y-%m-%dT%H:%M', '%Y-%m-%d'):
        try:
            return datetime.strptime(s, fmt).timestamp()
        except ValueError:
            pass
    return None


def iso_ts(s):
    try:
        return datetime.fromisoformat(s.replace('Z', '+00:00')).timestamp()
    except (ValueError, AttributeError):
        return None


def tsv(path):
    try:
        return [ln.rstrip('\n').split('\t') for ln in open(path)
                if ln.strip()]
    except OSError:
        return []


def worktrees(root):
    """branch -> path, for worktrees under <root>/.worktrees."""
    m, wt = {}, None
    for ln in sh('git', '-C', root, 'worktree', 'list',
                 '--porcelain').splitlines():
        if ln.startswith('worktree '):
            wt = ln[9:]
        elif ln.startswith('branch refs/heads/') and wt \
                and '/.worktrees/' in wt:
            m[ln[18:]] = wt
    return m


def prs(root):
    """(head -> my latest PR, open first; open PRs), or (None, None)."""
    out = sh('gh', 'pr', 'list', '--author', '@me', '--state', 'all',
             '--limit', '400', '--json',
             'number,headRefName,state,isDraft,createdAt,mergedAt,closedAt',
             cwd=root)
    opn = sh('gh', 'pr', 'list', '--author', '@me', '--state', 'open',
             '--limit', '100', '--json',
             'number,headRefName,isDraft,mergeStateStatus,statusCheckRollup',
             cwd=root)
    try:
        allp, opn = json.loads(out), json.loads(opn)
    except ValueError:
        return None, None
    best = {}
    for p in allp:
        cur = best.get(p['headRefName'])
        rank = (p['state'] == 'OPEN', p['createdAt'])
        if not cur or rank > (cur['state'] == 'OPEN', cur['createdAt']):
            best[p['headRefName']] = p
    detail = {p['number']: p for p in opn}
    for p in best.values():
        p.update(detail.get(p['number'], {}))
    return best, opn


def ci(pr):
    """running / failing / green / none, and when the earliest run began."""
    checks = pr.get('statusCheckRollup') or []
    if not checks:
        return 'none', None
    run = fail = False
    starts = []
    for c in checks:
        st = c.get('status') or ''
        concl = (c.get('conclusion') or c.get('state') or '').upper()
        if st and st != 'COMPLETED' or concl == 'PENDING':
            run = True
            t = iso_ts(c.get('startedAt') or '')
            if t:
                starts.append(t)
        elif concl in ('FAILURE', 'TIMED_OUT', 'ERROR',
                       'ACTION_REQUIRED', 'STARTUP_FAILURE'):
            fail = True
    return ('failing' if fail else 'running' if run else 'green'), \
        min(starts) if starts else None


def disk(path):
    dirty = len([ln for ln in sh('git', '-C', path, 'status',
                                 '--porcelain').splitlines() if ln])
    base = 'origin/dev' if sh('git', '-C', path, 'rev-parse', '--verify',
                              '--quiet', 'origin/dev') else 'origin/HEAD'
    ahead = sh('git', '-C', path, 'rev-list', '--count',
               f'{base}..HEAD').strip()
    head = sh('git', '-C', path, 'log', '-1', '--format=%H %ct').split()
    return dirty, int(ahead or 0), head[0] if head else '', \
        int(head[1]) if len(head) > 1 else 0


def panes():
    """Claude panes: [(id, session, path)]."""
    out = []
    for ln in sh('tmux', 'list-panes', '-a', '-F',
                 '#{pane_id}\t#{session_name}\t#{pane_current_command}'
                 '\t#{pane_current_path}').splitlines():
        p = ln.split('\t')
        if len(p) == 4 and (p[2] == 'claude' or
                            re.fullmatch(r'\d+\.\d+\.\d+', p[2])):
            out.append((p[0], p[1], p[3]))
    return out


# Claude's busy line: "✽ Misting… (15m 46s · ↓ 5.5k tokens"; older
# builds printed "esc to interrupt".
SPIN = re.compile(r'^\S \S+… \(\d+[hms]|esc to interrupt', re.M)
BG = re.compile(r'Waiting for \d+ background agent|'
                r'\d+ (background )?shells? (still )?running|· \d+ shells? ·')


def pane_state(pid):
    """busy, background-wait, hash of the pane minus digits and spinner."""
    txt = sh('tmux', 'capture-pane', '-p', '-t', pid, '-S', '-60')
    lines = [ln for ln in txt.splitlines() if ln.strip()]
    tail = '\n'.join(lines[-12:])
    busy = bool(SPIN.search(tail))
    bg = not busy and bool(BG.search(tail))
    body = '\n'.join(ln for ln in lines[:-6] if not SPIN.search(ln))
    h = hashlib.sha1(re.sub(r'\d', '', body).encode()).hexdigest()[:12]
    return busy, bg, h


def transcript(path):
    """Newest main-chat write and newest subagent (mtime, birth)."""
    d = os.path.join(os.path.expanduser('~/.claude/projects'),
                     re.sub(r'[/.]', '-', path))
    main, sub = 0, (0, 0)
    try:
        ents = os.listdir(d)
    except OSError:
        return main, sub
    for e in ents:
        p = os.path.join(d, e)
        if e.endswith('.jsonl'):
            main = max(main, os.path.getmtime(p))
        sd = os.path.join(p, 'subagents')
        if os.path.isdir(sd):
            for s in os.listdir(sd):
                if s.endswith('.jsonl'):
                    st = os.stat(os.path.join(sd, s))
                    if st.st_mtime > sub[0]:
                        sub = (st.st_mtime,
                               getattr(st, 'st_birthtime', st.st_mtime))
    return main, sub


def linear_key():
    k = os.environ.get('LINEAR_API_KEY')
    if k:
        return k
    try:
        for ln in open(os.path.expanduser('~/.config/linear.env')):
            m = re.match(r'\s*(?:export\s+)?LINEAR_API_KEY=(.*)', ln)
            if m:
                return m.group(1).strip().strip('"\'')
    except OSError:
        pass
    return None


_tickets = {}


def ticket(tid):
    """(state type, updatedAt epoch) or None when Linear can't say."""
    if tid in _tickets:
        return _tickets[tid]
    res, key = None, linear_key()
    if key:
        q = json.dumps({'query': 'query($id:String!){issue(id:$id)'
                        '{state{type} updatedAt}}', 'variables': {'id': tid}})
        req = urllib.request.Request(
            'https://api.linear.app/graphql', data=q.encode(),
            headers={'Authorization': key,
                     'Content-Type': 'application/json'})
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                i = json.load(r)['data']['issue']
            res = (i['state']['type'], iso_ts(i['updatedAt']))
        except Exception:
            res = None
    _tickets[tid] = res
    return res


def load_state():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return {}


class Board:
    """Everything one repo's items are judged on."""

    def __init__(self, nd, root, inbox, claude):
        self.root = root
        self.repo = os.path.basename(root.rstrip('/'))
        base = os.path.join(CONF, 'worktrees', self.repo)
        self.rows = nd.board(self.repo)
        self.live = worktrees(root)
        self.prs, self.open = prs(root)
        self.blocked = {r[0]: r for r in tsv(base + '.blocked')}
        self.snoozed = {r[0]: r for r in tsv(base + '.snoozed')}
        self.waiting = {r[0]: r for r in tsv(base + '.waiting')}
        self.focus = {r[0]: r for r in tsv(base + '.needsfocus')}
        self.inbox = inbox
        self.claude = claude
        self.items = {}
        self.slug_of = {}
        for sec, br in self.rows:
            slug = os.path.basename(self.live[br]) if br in self.live \
                else br.rsplit('/', 1)[-1]
            self.slug_of[br] = slug
            self.items[slug] = dict(repo=self.repo, root=root, sec=sec,
                                    branch=br, slug=slug,
                                    path=self.live.get(br))

    def find(self, ref):
        if ref in self.items:
            return ref
        return self.slug_of.get(ref) or next(
            (s for s in self.items if ref and ref.rsplit('/', 1)[-1] == s),
            None)


def pending_for(it, inbox):
    """Pending inbox rows on this item: (own stalled rows, others)."""
    own, other = [], []
    path, slug = it['path'] or '\0', it['slug']
    ids = {p[0] for p in it.get('panes', [])}
    for r in inbox:
        r = r + [''] * (9 - len(r))
        if re.fullmatch(r'%\d+@default', r[5]):
            r[5] = r[5][:-len('@default')]
        on = r[1] == slug or r[1].split(':', 1)[0] == slug \
            or r[4] == path or r[4].startswith(path + '/') or r[5] in ids
        if on:
            (own if r[7] == 'stalled' else other).append(r)
    return own, other


def judge(b, it, st, seen=()):
    """Set it['state'], it['why'] (and 'since', 'pin') for one item."""
    if 'state' in it:
        return
    if it['slug'] in seen:
        it.update(state='STALLED', why='blocked in a cycle: wt ip one')
        return
    seen = seen + (it['slug'],)
    s = st.setdefault(f"{b.repo}/{it['slug']}", {})
    slug, sec = it['slug'], it['sec'].upper()

    sz = b.snoozed.get(slug)
    # A date alone wakes at 08:00 (`wt wake`).
    until = parse_when(sz[2] if 'T' in sz[2] else sz[2] + 'T08:00') \
        if sz and len(sz) > 2 else None
    if until and until > NOW:
        it.update(state='SNOOZED', why=f'until {sz[2].replace("T", " ")}')
        return
    if sec == 'SNOOZED' and not sz:
        it.update(state='SNOOZED', why='under SNOOZED, no date: wt sz')
        return

    w8 = b.waiting.get(slug)
    if w8 and len(w8) > 3:
        dl = parse_when(w8[2]) or 0
        if dl > NOW:
            it.update(state='WAITING', why=f'on {w8[3]} until {hm(dl)}')
            s['moved'] = NOW
            return
        it.update(state='STALLED', since=dl, now=True, w8=True,
                  why=f'overdue: {w8[3]} (expected {hm(dl)}): investigate')
        return

    path = it['path']
    it['panes'] = [p for p in b.claude if p[1] == slug or (
        path and (p[2] == path or p[2].startswith(path + '/')))]
    dirty = ahead = 0
    head, ctime = '', 0
    if path:
        dirty, ahead, head, ctime = disk(path)
    main, sub = transcript(path) if path else (0, (0, 0))
    busy = bg = False
    hashes = []
    for pid, _, _ in it['panes']:
        pb, pg, ph = pane_state(pid)
        busy, bg = busy or pb, bg or pg
        hashes.append(ph)
    if not busy and sub[0] and NOW - sub[0] < 600:
        bg = True
    h = ','.join(sorted(hashes))
    if busy:
        if s.get('hash') != h or s.get('head') != head:
            s['hash'], s['head'], s['hash_at'] = h, head, NOW
        s.pop('bg_at', None)
        if wk(s['hash_at']) < CAP:
            it.update(state='ACTIVE', why='agent mid-turn')
            s['moved'] = NOW
            return
        it.update(state='STALLED', since=s['hash_at'],
                  why=f"agent spinning? no pane change or commit for "
                      f"{ago(wk(s['hash_at']))}")
        return
    s.pop('hash', None)

    pr = (b.prs or {}).get(it['branch'])
    gone = not path
    closed = pr and pr['state'] in ('MERGED', 'CLOSED')
    if sec in LIVE and (gone or closed):
        what = 'no worktree' if gone else \
            f"#{pr['number']} {pr['state'].lower()}"
        it.update(state='STALLED', why=f'left over: {what}', batch='stale')
        return

    blk = b.blocked.get(slug) or (sec == 'BLOCKED' and [slug, '', '', ''])
    if blk:
        blk = blk + [''] * (4 - len(blk))
        if not blk[2] and re.fullmatch(r'\S+/\S+', blk[3]):
            blk[2] = blk[3]
        ref = b.find(blk[2]) or b.find(blk[3])
        if ref and ref != slug:
            dep = b.items[ref]
            judge(b, dep, st, seen)
            if dep['state'] == 'STALLED':
                # Its why and ping are folded into the blocker's (fold).
                it.update(state='STALLED', since=dep.get('since'),
                          dep=ref, why=f'blocked by {ref[:30]}')
            else:
                it.update(state=dep['state'],
                          why=f"blocked by {ref[:30]}: "
                              f"{dep['state'].lower()} {dep['why']}")
                if dep['state'] != 'SNOOZED':
                    s['moved'] = NOW
            return
        if blk[2] and not ref:
            it.update(state='STALLED', now=True,
                      why=f'blocker {blk[2][:40]} is gone: wt ip')
            return
        tids = TICKET.findall(blk[3])
        if not tids:
            it.update(state='STALLED', now=True,
                      why='make the blocker a ticket or wt sz <date>: '
                          f'{blk[3][:50] or "no reason recorded"}')
            return
        tid = tids[0]
        t = ticket(tid)
        if t is None:
            it.update(state='STALLED', now=True,
                      why=f"couldn't read {tid}")
        elif t[0] == 'started' and t[1] and wk(t[1]) < 86400:
            it.update(state='WAITING', why=f'on {tid}, in progress')
            s['moved'] = NOW
        else:
            when = datetime.fromtimestamp(t[1]).strftime('%m-%d') \
                if t[1] else '?'
            it.update(state='STALLED', now=True,
                      why=f'{tid} idle since {when}: nudge?')
        return

    if bg:
        s.setdefault('bg_at', min(main or NOW, sub[1] or NOW))
        # A subagent still writing its transcript is moving, however
        # long it runs; the cap is for silent ones (and shells).
        if sub[0] and NOW - sub[0] < 15 * 60:
            it.update(state='WAITING',
                      why=f"on a background agent, working "
                          f"({ago(NOW - s['bg_at'])})")
            s['moved'] = NOW
            return
        if wk(s['bg_at']) < CAP:
            it.update(state='WAITING',
                      why=f"on a background agent or shell "
                          f"({ago(NOW - s['bg_at'])})")
            s['moved'] = NOW
            return
        it.update(state='STALLED', since=s['bg_at'] + CAP,
                  why=f"background agent overdue "
                      f"({ago(NOW - s['bg_at'])}): investigate")
        return
    s.pop('bg_at', None)

    agent = 'agent idle' if it['panes'] else 'no agent'
    if pr and pr['state'] == 'OPEN':
        n, ms = pr['number'], pr.get('mergeStateStatus', '')
        if ms in ('', 'UNKNOWN') and not pr.get('isDraft'):
            # `pr list` leaves it UNKNOWN until something computes it.
            ms = sh('gh', 'pr', 'view', str(n), '--json',
                    'mergeStateStatus', '-q', '.mergeStateStatus',
                    cwd=b.root).strip()
        c, _ = ci(pr)
        if pr.get('isDraft'):
            why = f'#{n} draft, {agent}: brief or drop'
        elif ms == 'DIRTY':
            why = f'#{n} conflicting: rebase'
        elif ms == 'CLEAN':
            why = f'#{n} clean+green: ship?'
        elif c == 'failing':
            why = f'#{n} CI failing: fix'
        elif c == 'running':
            why = f'#{n} CI running, no wt w8: brief the agent'
        elif ms == 'BEHIND':
            why = f'#{n} behind base: rebase'
        elif ms == 'BLOCKED':
            why = f'#{n} waits on review: nudge reviewer?' \
                if sec == 'TEAM REVIEW' else f'#{n} needs review: wt rt?'
        else:
            why = f'#{n} {ms.lower() or "open"}, {agent}: next step?'
    elif sec == 'TO ANNOUNCE':
        why = f"merged {day(pr and pr.get('mergedAt'))}: announce"
    elif sec == 'PROD REVIEW':
        why = 'verify in prod'
    elif sec == 'READY TO DEPLOY':
        why = 'merged: ship it' if closed else 'ready to deploy: ship?'
    elif dirty or ahead:
        why = f'{dirty} dirty files, {ahead} commits, no PR, {agent}: ' \
              'brief or drop'
    else:
        why = f'nothing on disk, {agent}: brief, snooze or drop'
    if sec == 'NEEDS FOCUS':
        f = b.focus.get(slug)
        why = f'needs focus: {(f[2] if f and len(f) > 2 else why)[:70]}'
    elif sec == 'PAUSED':
        why = f'paused, {why}'
    it.update(state='STALLED', why=why,
              since=max(main, ctime, s.get('moved', 0)))


def last_question(sid):
    """The last line ending in `?` the chat's agent wrote since my last
    prompt, or ''."""
    if not sid:
        return ''
    base = os.path.expanduser('~/.claude/projects')
    try:
        path = next(os.path.join(base, d, sid + '.jsonl')
                    for d in os.listdir(base)
                    if os.path.exists(os.path.join(base, d, sid + '.jsonl')))
        with open(path, 'rb') as f:
            f.seek(max(0, os.path.getsize(path) - 400000))
            raw = f.read().decode('utf-8', 'replace').splitlines()[1:]
    except (OSError, StopIteration):
        return ''
    texts = []
    for ln in raw:
        try:
            e = json.loads(ln)
        except ValueError:
            continue
        c = (e.get('message') or {}).get('content')
        if e.get('type') == 'user' and isinstance(c, str):
            texts = []
        elif e.get('type') == 'assistant' and isinstance(c, list):
            texts += [x.get('text', '') for x in c
                      if isinstance(x, dict) and x.get('type') == 'text']
    for t in reversed(texts):
        for ln in reversed(t.splitlines()):
            ln = ln.strip().strip('*_` ')
            if ln.endswith('?') and not ln.startswith('>'):
                return ln
    return ''


def asks(it, rows):
    """What the pending rows on an item wait on me for: a question its
    agent asked, else its PR state and board section."""
    for r in reversed(rows):
        if r[3] not in ('done', ''):
            return r[3][:70]
    for r in reversed(rows):
        q = last_question(r[8])
        if q:
            return f'asks: {q[:65]}'
    return f"{it['sec'].lower()}, {it['why']}"[:70]


def fold(b):
    """An item blocked on a stalled worktree pings through its blocker:
    one row for the blocker, naming how many wait on it."""
    def root(it):
        seen = set()
        while it.get('dep') and it['slug'] not in seen:
            seen.add(it['slug'])
            it = b.items[it['dep']]
        return it
    roots = {}
    for it in b.items.values():
        if it.get('dep'):
            r = root(it)
            roots.setdefault(r['slug'], []).append(it)
    for slug, deps in roots.items():
        r = b.items[slug]
        for it in deps:
            if not it.get('pin'):
                via = '' if it['dep'] == slug else f', via {it["dep"][:20]}'
                it['why'] = f"blocked by {slug[:30]}{via}, which is " \
                    f"stalled: {r['why']}"
        n = len(deps)
        r['why'] += f', +{n} blocked on this' if r.get('batch') \
            else f' (+{n} blocked on this)'


def collect():
    nd = notif_depth()
    inbox = tsv(nd.INBOX)
    claude = panes()
    st = load_state()
    boards, batches = [], []
    for root in nd.repo_roots():
        b = Board(nd, root, inbox, claude)
        for it in b.items.values():
            judge(b, it, st)
        for it in b.items.values():
            _, other = pending_for(it, inbox)
            # An overdue w8 keeps its own row: it ranks above an
            # fyi the worktree already has.
            if it['state'] == 'STALLED' and other and not it.get('batch') \
                    and not it.get('now'):
                it['why'] = f'waiting on you: {asks(it, other)}'
                it['pin'] = True
        fold(b)
        boards.append(b)
        stale = [it for it in b.items.values() if it.get('batch')]
        if stale:
            names = ', '.join(f"{i['slug'][:28]} ({i['why'][11:]})"
                              for i in stale[:6])
            more = f' +{len(stale) - 6}' if len(stale) > 6 else ''
            batches.append(dict(
                ctx=f'{b.repo}:stale', root=root, n=len(stale),
                title=f'{len(stale)} left-over board rows',
                why=f'{names}{more}: wt done / wt cancel each '
                    '(wt e for one with no worktree), or wt ip'))
        if b.open is not None:
            onb = {br for _, br in b.rows}
            loose = [p for p in b.open if p['headRefName'] not in onb]
            if loose:
                batches.append(dict(
                    ctx=f'{b.repo}:loose-prs', root=root, n=len(loose),
                    title=f'{len(loose)} open PRs not on the board',
                    why=', '.join(f"#{p['number']}" for p in loose[:10]) +
                    ': adopt (wt add <branch>) or close'))
        onb = {br for _, br in b.rows}
        orph = [os.path.basename(p) for br, p in b.live.items()
                if br not in onb]
        if orph:
            batches.append(dict(
                ctx=f'{b.repo}:orphans', root=root, n=len(orph),
                title=f'{len(orph)} worktrees with no board row',
                why=', '.join(o[:28] for o in orph[:6]) +
                ': adopt (wt :) or wt rm'))
    keep = {f"{b.repo}/{s}" for b in boards for s in b.items}
    st = {k: v for k, v in st.items() if k in keep}
    with open(STATE + '.tmp', 'w') as f:
        json.dump(st, f)
    os.replace(STATE + '.tmp', STATE)
    return nd, inbox, boards, batches


def last_clears(nd):
    """ref -> when its last stalled row was cleared."""
    out = {}
    for arr, clr, row in nd.read_rows(nd.LOG, True):
        if len(row) > 9 and row[7] == 'stalled' and row[9]:
            out[row[9]] = max(out.get(row[9], 0), clr)
    return out


def notify(cwd, ctx, ref, title, msg):
    env = dict(os.environ, NOTIFY_CLASS='stalled', NOTIFY_CTX=ctx,
               NOTIFY_REF=ref)
    env.pop('TMUX_PANE', None)
    env.pop('NOTIFY_MODE', None)
    subprocess.run(['notify', title, msg], cwd=cwd, env=env,
                   capture_output=True, timeout=30)


def drop(*args):
    """Drop rows by ref (`seen-ref`), or legacy untagged ones by key."""
    subprocess.run(['notif', *args], capture_output=True, timeout=30)


def ping(nd, inbox, boards, batches, overdue=False):
    """Sync the inbox's stalled rows with what is stalled now. Rows are
    found by their ref (NOTIFY_REF), never by ctx or pane: a jump to a
    row re-keys it onto the pane it lands on. overdue: only overdue w8
    rows; every other row and item is left alone."""
    clears = last_clears(nd)
    want, fresh = {}, set()
    for b in boards:
        for it in b.items.values():
            if it['state'] != 'STALLED' or it.get('batch') \
                    or it.get('pin') or it.get('dep'):
                continue
            if overdue and not it.get('w8'):
                continue
            since = it.get('since') or 0
            if not it.get('now') and wk(since) < STALL:
                continue
            ref = f"{b.repo}/{it['slug']}"
            want[ref] = (
                it['path'] or b.root, it['slug'], it['slug'], it['why'])
            # A row cleared before this deadline was about something
            # else: the overdue ping goes out now.
            if it.get('w8') and clears.get(ref, 0) < since:
                fresh.add(ref)
    for x in [] if overdue else batches:
        want[x['ctx']] = (x['root'], x['ctx'], x['title'], x['why'])
    pend, legacy = {}, set()
    for r in inbox:
        if len(r) > 7 and r[7] == 'stalled':
            if len(r) > 9 and r[9]:
                pend.setdefault(r[9], []).append(r[3])
            else:
                legacy.add(r[5] or r[1])
    dropped = sent = 0
    for key in [] if overdue else legacy:
        drop('seen', key, 'stalled')
        dropped += 1
    for ref, msgs in pend.items():
        w = want.get(ref)
        if overdue and not w:
            continue
        if not w or msgs[-1] != w[3]:
            drop('seen-ref', ref)
            dropped += 1
            if w:
                clears[ref] = 0
    for ref, (cwd, ctx, title, msg) in want.items():
        if ref in pend and pend[ref][-1] == msg:
            continue
        if ref not in pend and ref not in fresh \
                and wk(clears.get(ref, 0)) < STALL:
            continue
        notify(cwd, ctx, ref, title, msg)
        sent += 1
    subprocess.run(['tmux', 'refresh-client', '-S'], capture_output=True)
    return sent, dropped


def log_counts(nd, items):
    """One line per pinging run: epoch, stalled, waiting, active,
    snoozed, inbox pending (distinct keys, as `notif count`)."""
    n = [sum(1 for i in items if i['state'] == s) for s in STATES]
    pend = len({nd.key(r) for r in tsv(nd.INBOX)})
    with open(COUNTS, 'a') as f:
        f.write('\t'.join(map(str, [int(NOW), *n, pend])) + '\n')


def flat(boards):
    return [it for b in boards for it in b.items.values()]


def summary(items, batches):
    n = {s: sum(1 for i in items if i['state'] == s) for s in STATES}
    out = ' · '.join(f'{s} {n[s]}' for s in STATES)
    if batches:
        out += f" (+{len(batches)} batched)"
    return out


def line(it):
    sec = it['sec'][:14]
    return f"  {it['slug'][:50]:50} {sec:14} {it['why']}"


def save_last(items, batches):
    data = dict(at=NOW, items=[{k: it[k] for k in
                                ('slug', 'sec', 'state', 'why')}
                               for it in items], batches=batches)
    with open(LAST + '.tmp', 'w') as f:
        json.dump(data, f)
    os.replace(LAST + '.tmp', LAST)


def brief():
    try:
        d = json.load(open(LAST))
        if NOW - d['at'] > 600:
            raise ValueError
        items, batches = d['items'], d['batches']
    except (OSError, ValueError, KeyError):
        _, _, boards, batches = collect()
        items = flat(boards)
        save_last(items, batches)
    print(summary(items, batches))
    stalled = [i for i in items if i['state'] == 'STALLED']
    for i in stalled[:15]:
        print(line(i))
    if len(stalled) > 15:
        print(f'  … {len(stalled) - 15} more (wt-cold)')
    for x in batches:
        print(f"  {x['title']}")


def due():
    now = datetime.now()
    if now.weekday() >= 5 or not 8 <= now.hour < 19:
        return False
    try:
        return NOW - os.path.getmtime(STAMP) >= 590
    except OSError:
        return True


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    g = ap.add_mutually_exclusive_group()
    g.add_argument('--ping', action='store_true')
    g.add_argument('--sync', action='store_true')
    g.add_argument('--overdue', action='store_true')
    g.add_argument('--brief', action='store_true')
    o = ap.parse_args()
    if o.brief:
        return brief()
    if o.sync:
        if not due():
            return
        open(STAMP, 'w').close()
    nd, inbox, boards, batches = collect()
    items = flat(boards)
    save_last(items, batches)
    if o.ping or o.sync or o.overdue:
        # An overdue w8 is judged from local files alone.
        if not o.overdue and any(b.prs is None for b in boards):
            # gh failed (a 504): PR-based judgements are blind, so
            # syncing now would clear rows and re-ping them next run.
            print('wt-cold: gh failed, inbox left as is')
            return 1
        sent, dropped = ping(nd, inbox, boards, batches, o.overdue)
        if not o.overdue:
            log_counts(nd, items)
        print(f'{summary(items, batches)}: {sent} rows sent, '
              f'{dropped} cleared')
        return
    print(summary(items, batches))
    for s in STATES:
        rs = sorted((i for i in items if i['state'] == s),
                    key=lambda i: i['why'])
        if rs:
            print(f'\n{s} ({len(rs)})')
            for i in rs:
                print(line(i))
    if batches:
        print(f'\nBATCHED ({len(batches)})')
        for x in batches:
            print(f"  {x['title']}: {x['why']}")


if __name__ == '__main__':
    sys.exit(main())
