#!/bin/sh
#
# wt-sync — launchd (com.jrasmusbm.wt-sync, every minute), for each
# repo in $WT_SYNC_REPOS (default: the paths listed one per line in
# ~/.config/wt-sync-repos, kept outside dotfiles):
#   - its trusted .jrb/wt-hook sync (jrb-hook): the repo's own tells
#     about merged PRs, deploys and ship queues (pr-merged-tell, wt-tell);
#   - every 5th minute, wt-pr-watch tells the agent of a worktree whose
#     open PR has failing CI or a review newer than its last push, once
#     per head sha / review.
# First, offline too: tmux-revive snapshots the Claude panes and, once
# the tmux server died or restarted, brings them back as run-slot
# makes room; run-slot closes stalled Claude sessions and starts queued agents
# (run-slot ls). `wt wake` in each repo of the list and each repo with a
# snooze: a timed `wt sz` fires within a minute, after a reboot too.
# A `wt w8` deadline that passed since the last run gets its overdue ping
# (wt-cold --overdue, no other row) at any hour.
# Weekdays 08:00-19:00, every 10th minute, wt-cold syncs the inbox
# with every work item that stopped moving (a `stalled` row each).
# On a phone hotspot it polls every 5th minute only; a poll without a
# new deploy is ~10 KB. Android marks its hotspot's DHCP lease with
# vendor option ANDROID_METERED; an iPhone's gateway is 172.20.10.1.

_metered() {
  _if="$(route -n get default 2>/dev/null | awk '/interface:/ { print $2 }')"
  test -n "$_if" || return 1
  ipconfig getpacket "$_if" 2>/dev/null | grep -q ANDROID_METERED \
    || route -n get default | grep -q 'gateway: 172\.20\.10\.1$'
}

tmux-revive >/dev/null 2>&1
# Close stalled Claude sessions, then start what waits for room.
run-slot close >/dev/null 2>&1
run-slot pump >/dev/null 2>&1
# Browser tabs are inventory too: close the ones left unfocused, count
# them every 5th minute. Local, so before anything that can hang.
btabs expire >/dev/null 2>&1
test "$(( $(date +%-M) % 5 ))" != 0 || btabs log >/dev/null 2>&1

_repos="${WT_SYNC_REPOS:-$(cat "$HOME/.config/wt-sync-repos" 2>/dev/null)}"
_boards="$LOCAL_CONFIG/worktrees"

# Snoozes that came due go back on the board. Local, so before the
# metered gate. Rows written by `wt sz` carry their main checkout.
{ printf '%s\n' "$_repos"
  cat "$_boards"/*.snoozed 2>/dev/null | cut -f6; } | sort -u \
  | while IFS= read -r _repo; do
    test -d "$_repo" || continue
    (cd "$_repo" && gtimeout -k 5 60 wt wake >/dev/null 2>&1 </dev/null)
  done

if _metered && test "$(( $(date +%-M) % 5 ))" != 0; then
  exit 0
fi

# A w8 deadline in (last run, now] gets its overdue row now, at any
# hour; wt-cold --sync keeps the weekday window for every other row.
# The stamp moves once the ping went out, so a failure or a reboot
# retries it next run; after an hour of failures it moves on anyway.
_w8s="$LOCAL_CONFIG/wt-w8-stamp"
_now="$(date +%FT%H:%M)"
if test -f "$_w8s"; then
  _last="$(cat "$_w8s")"
  _due="$(for _repo in $_repos; do
      cat "$_boards/$(basename "$_repo").waiting" 2>/dev/null
    done | awk -F '\t' -v a="$_last" -v b="$_now" \
      '$3 > a && $3 <= b { print; exit }')"
  if test -z "$_due" \
    || gtimeout -k 10 300 wt-cold --overdue >/dev/null 2>&1 \
    || awk -v a="$_last" -v b="$(date -v-60M +%FT%H:%M)" \
      'BEGIN { exit !(a < b) }'
  then
    echo "$_now" > "$_w8s"
  fi
else
  echo "$_now" > "$_w8s"
fi

# Unblock tells that couldn't be delivered when `wt` sent them (busy, or
# the session had just started): retried until told, dropped after 3 days.
_ub="$LOCAL_CONFIG/wt-unblocked"
if test -s "$_ub"; then
  _ub_tmp="$(mktemp)"
  while IFS="$(printf '\t')" read -r _r _k _p _m _t; do
    test -n "$_r" || continue
    test "$(( $(date +%s) - _t ))" -lt 259200 || continue
    wt-tell "$_r" "$_k" "$_p" "$_m" >/dev/null 2>&1 \
      || printf '%s\t%s\t%s\t%s\t%s\n' "$_r" "$_k" "$_p" "$_m" "$_t" \
        >> "$_ub_tmp"
  done < "$_ub"
  mv "$_ub_tmp" "$_ub"
fi

for _repo in $_repos; do
  cd "$_repo" || continue
  # Every 5th minute: CI failures and reviews on my open PRs.
  test "$(( $(date +%-M) % 5 ))" != 0 || wt-pr-watch "$_repo"
  # A hung network call must not stall the next minute's run: launchd
  # starts none while this one lives, so revive and tabs would stop.
  gtimeout -k 10 120 jrb-hook "$_repo" sync
done

# Foreground: launchd kills what a job leaves behind when it exits.
# Not due costs a stamp check; due runs ~25 s.
gtimeout -k 10 300 wt-cold --sync >/dev/null 2>&1
# Tabs of finished PRs: once a weekday from 08:00 (one gh call each).
btabs tidy --daily >/dev/null 2>&1
