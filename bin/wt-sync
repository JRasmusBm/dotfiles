#!/bin/sh
#
# wt-sync — launchd (com.jrasmusbm.wt-sync, every minute), for each
# worktree of $WT_SYNC_REPOS with a PR of mine (or on a branch not named .../jrb/..., one I took over) merged since the
# watermark (wt-sync.since: the start of the last clean run, held back
# to the oldest merge whose PR isn't yet told as on production or as
# needing no deploy, so a PR in flight stays tracked however long
# the machine was off; 7 days back on first run), searched from
# WT_SYNC_GRACE (1 day) before it so a merge in a gap between runs
# (clock skew, a late search index) is still seen:
#   - tell its agent (pr-merged-tell, once), so a merge reaches an
#     agent that was already idle when it happened, or that wasn't
#     reachable (machine off, no session) for days;
#   - some of the targets it needs deployed to a stage after it
#     reached that stage's branch (pr-where --status, the same rule
#     as deploy-plan): tell its agent which part is out, once per set
#     of deployed targets; all of them: tell it it's shipped there,
#     once per stage. Nothing to deploy (tests, docs, CI only): tell
#     it so once, so it closes the ticket.
#     Checked when it merges, when a new successful deploy run
#     appeared (whoever dispatched it), and again each run while its
#     Claude was busy.
# And for each worktree with a PR of mine open or merged in the last 3
# days, in a repo with the conveyor (`.mcp.json` on origin/dev): when
# its latest ship request ends rejected or failed, tell its agent once
# per request what the conveyor said, so an agent that ended its turn
# after ship_pr still hears it. Polled when the conveyor's status
# counts moved since the last run, every 10th minute, and each run
# while its Claude was busy. A request that ends done needs no tell
# of its own: merged and deployed are told above.
# On a phone hotspot it polls every 5th minute only; a poll without a
# new deploy is ~10 KB. Android marks its hotspot's DHCP lease with
# vendor option ANDROID_METERED; an iPhone's gateway is 172.20.10.1.

_metered() {
  _if="$(route -n get default 2>/dev/null | awk '/interface:/ { print $2 }')"
  test -n "$_if" || return 1
  ipconfig getpacket "$_if" 2>/dev/null | grep -q ANDROID_METERED \
    || route -n get default | grep -q 'gateway: 172\.20\.10\.1$'
}

if _metered && test "$(( $(date +%-M) % 5 ))" != 0; then
  exit 0
fi

_deployed() {
  _root="$1" _pr="$2"
  pr-where --status "$_pr" 2>/dev/null \
    | while IFS="$(printf '\t')" read -r _stage _cover _targets; do
      case "$_cover" in
        "✓"*) ;;
        [1-9]*/*"(missing "*)
          _miss="$(printf '%s' "$_cover" | sed -E 's/.*\(missing ([^)]*)\).*/\1/')"
          _done="$(printf '%s\n' $(echo "$_targets" | tr ',' ' ') \
            | grep -vxF "$(echo "$_miss" | tr ',' '\n')" | grep -v '^+shared$' \
            | paste -sd, -)"
          wt-tell "$_root" "partly:$_stage:$_pr:$_done" \
            "#$_pr partly on $_stage ($_done; missing $_miss)" \
            "Part of PR #$_pr is deployed to $_stage: $_done. Still \
missing: $_miss, so it isn't shipped yet. Check read-only that the \
deployed part works on $_stage and doesn't break anything without the \
rest, and tell me what you verified." || _retry_later "$_root" "$_pr"
          continue ;;
        "nothing to deploy")
          wt-tell "$_root" "nodeploy:$_pr" \
            "#$_pr needs no deploy, no agent session: wt done or wt ra" \
            "PR #$_pr needs no deploy: none of its changes reach a \
deployed service (tests, docs or CI only), so it took effect when it \
merged. Check that it does what it should where it runs (CI on dev, for \
a test fix), then: wt ra if users or the team should hear about it \
(and draft the release post), else wt done." \
            || _retry_later "$_root" "$_pr"
          return ;;
        *) continue ;;
      esac
      wt-tell "$_root" "deployed:$_stage:$_pr" \
        "#$_pr is on $_stage ($_targets), no agent session: verify it" \
        "PR #$_pr is now deployed to $_stage with all its targets \
($_targets). Check read-only that the change works on $_stage and \
tell me what you verified. Verified on staging and not in production \
yet: end by asking me to ship it to production through the conveyor \
(ship_pr until=deployed with its targets; it promotes master \
too), so staging first never means forgotten. Once it's verified \
in production: wt ra if users or the team should hear about it (and \
draft the release post), else wt done." || _retry_later "$_root" "$_pr"
    done
}

# A tell that found its Claude busy is checked again next run, new
# deploy or not.
_retry_later() {
  printf '%s\t%s\n' "$1" "$2" >> "$_pending"
}

# Whether the conveyor's status counts moved since the last run (or
# it's a 10th minute): only then are ship requests polled one by one.
_ship_moved() {
  git cat-file -e origin/dev:.mcp.json 2>/dev/null || return 1
  _counts="$(timeout 30 conveyor queue 2>/dev/null | jq -c .counts)" \
    || return 1
  _was="$(cat "$_ship_seen" 2>/dev/null)"
  echo "$_counts" > "$_ship_seen"
  test "$_counts" != "$_was" || test "$(( $(date +%-M) % 10 ))" = 0
}

# Tells the agent of worktree $1 when PR $2's latest ship request was
# rejected or failed.
_shipped() {
  _root="$1" _pr="$2"
  _req="$(timeout 30 conveyor status "$_pr" 2>/dev/null | jq -r '
    [.request.id, .request.status, .request.until,
     (.request.targets | join(",")), .request.reason // "",
     (.request.message // "" | gsub("\\s+"; " ")),
     (.nextStep // "" | gsub("\\s+"; " "))] | @tsv')" || return 0
  IFS="$(printf '\t')" read -r _id _st _until _tg _why _msg _next <<EOF
$_req
EOF
  case "$_st" in
    rejected)
      wt-tell "$_root" "conveyor:$_id" \
        "#$_pr rejected by the conveyor ($_why), no agent session" \
        "The conveyor rejected shipping PR #$_pr (until=$_until\
${_tg:+, targets $_tg}): $_why, "$_msg" Next step: "$_next" Fix it as \
that says (dev-workflow, Shipping a PR, lists every reason), then \
ship_pr again with the same until and targets: this ship was already \
asked for, so carrying it through is yours. If it needs a person \
(workflow_change_needs_human) or a call only I can make, tell me what \
and stop. Already handled: say so in one line and stop." \
        || _ship_later "$_root" "$_pr" ;;
    failed)
      wt-tell "$_root" "conveyor:$_id" \
        "#$_pr conveyor ship failed, no agent session" \
        "The conveyor failed shipping PR #$_pr (until=$_until\
${_tg:+, targets $_tg}): "$_msg" Check read-only what failed \
(get_ship_status for the timeline, the deploy run, the rollout) and \
tell me what you found and what you recommend. Don't ship again or \
roll back without me. Already handled: say so in one line and stop." \
        || _ship_later "$_root" "$_pr" ;;
  esac
}

_ship_later() {
  printf '%s\t%s\n' "$1" "$2" >> "$_ship_pending"
}

for _repo in ${WT_SYNC_REPOS:-$HOME/projects/polar/ice-floe}; do
  cd "$_repo" || continue
  _run_start="$(date -u +%FT%TZ)"
  _wm_file="$LOCAL_CONFIG/wt-sync.since.$(basename "$_repo")"
  _wm="$(cat "$_wm_file" 2>/dev/null)"
  test -n "$_wm" || _wm="$(gdate -u -d '7 days ago' +%FT%TZ)"
  _since="$(gdate -u -d "$_wm - ${WT_SYNC_GRACE:-1 day}" +%F)"
  _recent="$(gdate -u -d '3 days ago' +%FT%TZ)"
  _merged="$(timeout 30 gh pr list --state merged --author @me \
    --search "merged:>=$_since" --limit 300 \
    --json number,headRefName,mergedAt \
    --jq '.[] | [.headRefName, .number, .mergedAt] | @tsv')" || continue
  _open_at="$(mktemp)"
  # A worktree on someone else's branch that I committed to (a PR I
  # took over): its PRs aren't mine, so ask by branch.
  _foreign="$(git worktree list --porcelain | awk '
    /^branch / { sub("refs/heads/", "", $2) }
    /^branch / && $2 !~ /\/jrb\// && $2 !~ /^(dev|staging|master|main|worktree-agent-.*)$/ \
      { print $2 }')"
  _merged="$_merged
$(printf '%s\n' "$_foreign" | while read -r _b; do
    test -n "$_b" || continue
    # Only a branch I committed to: a wt review worktree isn't mine.
    test -n "$(git log -1 --format=%H --author="$(git config user.email)" \
      "origin/dev..refs/heads/$_b" 2>/dev/null)" || continue
    timeout 30 gh pr list --state merged --head "$_b" --limit 3 \
      --json number,headRefName,mergedAt \
      --jq '.[] | select(.mergedAt >= "'"$_wm"'") |
        [.headRefName, .number, .mergedAt] | @tsv'
  done)"
  _ship_seen="${LOCAL_CONFIG:?}/wt-sync.conveyor.$(basename "$_repo")"
  _ship_pending="$LOCAL_CONFIG/wt-sync.conveyor-pending.$(basename "$_repo")"
  _ship_retry="$(cat "$_ship_pending" 2>/dev/null)"
  : > "$_ship_pending"
  _open="" _moved=""
  if _ship_moved; then
    _moved=1
    _open="$(timeout 30 gh pr list --state open --author @me --limit 100 \
      --json number,headRefName \
      --jq '.[] | [.headRefName, .number] | @tsv')" || _open=""
  fi
  test -n "$_merged$_open$_ship_retry" \
    || { echo "$_run_start" > "$_wm_file"; rm -f "$_open_at"; continue; }
  _seen="$LOCAL_CONFIG/wt-sync.deploy.$(basename "$_repo")"
  _pending="$LOCAL_CONFIG/wt-sync.pending.$(basename "$_repo")"
  _retry="$(cat "$_pending" 2>/dev/null)"
  : > "$_pending"
  # Ids of the last 20 successful runs, not just the newest: a run
  # started earlier can finish after one already seen.
  _last="$(timeout 30 gh run list --workflow deploy.yaml --status success \
    --limit 20 --json databaseId --jq '[.[].databaseId] | sort | join(",")')" \
    || _last=""
  _new_deploy=""
  if test -n "$_last" && test "$_last" != "$(cat "$_seen" 2>/dev/null)"; then
    _new_deploy=1
  fi
  git worktree list --porcelain | awk '
    /^worktree / { w = substr($0, 10) }
    /^branch / { sub("refs/heads/", "", $2); print w "\t" $2 }' \
    | while IFS="$(printf '\t')" read -r _wt _branch; do
      printf '%s\n' "$_merged" | awk -F'\t' -v b="$_branch" -v w="${_wt##*/}" '
        { n = split($1, a, "/") } $1 == b || a[n] == w' \
        | while IFS="$(printf '\t')" read -r _ _pr _at; do
          # Told whatever its age (pr-merged-tell skips one already
          # told), so a merge that happened while the machine was off
          # over a long weekend still reaches its agent.
          grep -qxF "$_wt	merged:$_pr" "$LOCAL_CONFIG/wt-told" \
            || _retry="$_retry
$_wt	$_pr"
          pr-merged-tell "$_wt" "$_pr"
          # Still in flight: not told as on production / no deploy.
          grep -qxF "$_wt	deployed:production:$_pr" "$LOCAL_CONFIG/wt-told" \
            || grep -qxF "$_wt	nodeploy:$_pr" "$LOCAL_CONFIG/wt-told" \
            || echo "$_at" >> "$_open_at"
          if ! test "$_at" \< "$_recent" && { test -n "$_moved" \
            || printf '%s\n' "$_ship_retry" | grep -qxF "$_wt	$_pr"; }; then
            _shipped "$_wt" "$_pr"
          fi
          if test -n "$_new_deploy" \
            || printf '%s\n' "$_retry" | grep -qxF "$_wt	$_pr"; then
            _deployed "$_wt" "$_pr"
          fi
        done
      printf '%s\n' "$_open" | awk -F'\t' -v b="$_branch" -v w="${_wt##*/}" '
        { n = split($1, a, "/") } NF && ($1 == b || a[n] == w)' \
        | while IFS="$(printf '\t')" read -r _ _pr; do
          _shipped "$_wt" "$_pr"
        done
      # Busy last run, and not polled above (its PR not open any more,
      # or the counts didn't move): polled now.
      test -n "$_moved" || printf '%s\n' "$_ship_retry" \
        | awk -F'\t' -v w="$_wt" '$1 == w { print $2 }' \
        | while read -r _pr; do
          printf '%s\n' "$_merged" | awk -F'\t' -v p="$_pr" -v r="$_recent" \
            '$2 == p && $3 >= r { f = 1 } END { exit !f }' \
            || _shipped "$_wt" "$_pr"
        done
    done
  test -z "$_new_deploy" || echo "$_last" > "$_seen"
  # Clean run: the watermark moves to its start, or to the oldest
  # merge still in flight if that is earlier.
  { cat "$_open_at"; echo "$_run_start"; } | sort | head -n 1 > "$_wm_file"
  rm -f "$_open_at"
done
