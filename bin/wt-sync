#!/bin/sh
#
# wt-sync — launchd (com.jrasmusbm.wt-sync, every minute): for each
# worktree of $WT_SYNC_REPOS whose PR merged in the last 3 days, tell
# its agent (pr-merged-tell), so a merge reaches an agent that was
# already idle when it happened. On an iPhone hotspot (gateway
# 172.20.10.1) it polls every 5th minute only; each poll is ~10 KB
# (TLS + my merged PRs of the last 3 days).

if route -n get default 2>/dev/null | grep -q 'gateway: 172\.20\.10\.1$' \
  && test "$(( $(date +%M) % 5 ))" != 0; then
  exit 0
fi

for _repo in ${WT_SYNC_REPOS:-$HOME/projects/polar/ice-floe}; do
  cd "$_repo" || continue
  _since="$(gdate -u -d '3 days ago' +%F)"
  _merged="$(timeout 30 gh pr list --state merged --author @me \
    --search "merged:>=$_since" --limit 100 --json number,headRefName \
    --jq '.[] | [.headRefName, .number] | @tsv')" || continue
  test -n "$_merged" || continue
  git worktree list --porcelain | awk '
    /^worktree / { w = substr($0, 10) }
    /^branch / { sub("refs/heads/", "", $2); print w "\t" $2 }' \
    | while IFS="$(printf '\t')" read -r _wt _branch; do
      printf '%s\n' "$_merged" | awk -F'\t' -v b="$_branch" '$1 == b { print $2 }' \
        | while read -r _pr; do pr-merged-tell "$_wt" "$_pr"; done
    done
done
