#!/usr/bin/env -S python3 -I
"""pool — one weighted slot pool for agents' dev stacks, devtools
browsers and heavy builds (type-aware tsc/eslint), so the Mac stays
out of swap and a freed slot goes to the next agent at once.

  pool [ls]            units held, holders, queue (oldest first)
  pool :               fzf a holder or waiter, switch to its session
  pool wait KIND       queue for a lease (KIND browser or stack) for
                       this session; exit 0 once held. Keeps its place
                       when asked again. Run it in the background
  pool take heavy PID  queue for a heavy job that PID holds until it
                       exits; exit 75 when this session already has a
                       heavy job running or queued
  pool release [--quiet]
                       drop this session's lease and quit its devtools
                       Chrome (the MCP restarts it on the next call)
  pool touch [SESSION]  renew SESSION's lease
  pool held SESSION [KIND]
                       exit 0 when SESSION holds a lease (of KIND)
  pool hook browser    PreToolUse hook, chrome-devtools tools: renew
                       or take a browser lease, else block the call
  pool hook bash       PreToolUse hook, Bash: prefix heavy commands
                       (builds and test runs, see Heavy jobs)
                       with `pool take heavy $$`, refuse a second one
                       per session; a localhost call renews the lease
  pool log [N]         last N (20) history rows
  pool waits [N]       last N (20) waits, one row each: queued, ended,
                       outcome (granted, gone, waiting), wait_s, units,
                       kind, session, command
  pool test            self-test in a scratch LOCAL_CONFIG

Heavy jobs: type-aware builds (tsc, eslint, `yarn lint`, `check-ts`)
and test runs (mocha, `yarn test:*`, `yarn/npm test`, `run-tests`).

Weights (units): heavy POOL_HEAVY (4) for a build or a full test
suite (`yarn test`, `npm test`, `run-tests`), POOL_TEST (2) for a
targeted test run (mocha, `yarn test:mocha FILES`) with neither beside
it; the first line of POOL_HEAVY_WEIGHTS, `UNITS REGEX`, whose regex
matches "CWD COMMAND", wins over both (builds differ, from 1.9 to 5.6
GB median per run). Stack POOL_STACK (4, its devtools Chrome
included), browser POOL_BROWSER (1); capacity POOL_UNITS (12). Mocha
from memlog 2026-11-03..09: 294 runs, p50 0.85 GB, p90 3.2 GB, max
5.8 GB; ungated, five builds and test runs once ran at once (~15 GB)
while the pool saw two. From memlog 2026-11-03..09 (p90 footprint): one tsc
4.7 GB, one stack 3.1 GB plus its Chrome 1.2 GB, a Chrome alone
1.2 GB, so a unit is about 1.1 GB at p90. Pressure 2 (warn) ran 7% of
the time with under 4 GB in these jobs, 32% at 4-8, 56% at 8-12, 89%
past 12; p90 weights overstate the typical job by ~2x, so 12 units
sits at 6-8 GB on a typical mix.

One queue, strict first in first out: the oldest waiter goes first
even when a smaller one behind it would fit. Waiters poll the state
once a second and the reap they run frees dead holders, so a freed
slot is handed on within about a second.

Holders: a heavy job ends with its PID (or after POOL_STALL seconds,
600, with no CPU in its process tree: it's TERMed). A lease (stack or
browser) belongs to a tmux session and lasts POOL_IDLE seconds (600)
from the session's last devtools call or localhost Bash call; then it
expires: the stack goes down and the browser quits. Nothing extends a
lease but use. A stack lease whose stack is gone after POOL_GRACE
(180) is dropped. jrb's own stacks (CLAUDECODE unset) take their
units at once, never queue and never expire: `dev down` or the end of
the session frees them.

State: $LOCAL_CONFIG/pool/state.json (flock on .lock). History:
pool/history.tsv, one row per event: epoch event kind owner units
wait_s hold_s used/cap queued detail; events queue, acquire,
release, expire, stall, refuse, drop (waiter gone).
"""
import fcntl
import glob
import json
import os
import re
import signal
import subprocess
import sys
import time

CONF = os.environ.get('LOCAL_CONFIG') or os.path.expanduser('~/.config')
DIR = os.path.join(CONF, 'pool')
STATE = os.path.join(DIR, 'state.json')
LOCK = os.path.join(DIR, '.lock')
LOG = os.path.join(DIR, 'history.tsv')
CAP = int(os.environ.get('POOL_UNITS', '12'))
UNITS = {
    'heavy': int(os.environ.get('POOL_HEAVY', '4')),
    'test': int(os.environ.get('POOL_TEST', '2')),
    'stack': int(os.environ.get('POOL_STACK', '4')),
    'browser': int(os.environ.get('POOL_BROWSER', '1')),
}
LEASES = ('browser', 'stack')
IDLE = int(os.environ.get('POOL_IDLE', '600'))
STALL = int(os.environ.get('POOL_STALL', '600'))
GRACE = int(os.environ.get('POOL_GRACE', '180'))
POLL = float(os.environ.get('POOL_POLL', '1'))
REAP = int(os.environ.get('POOL_REAP', '5'))
AGENT = os.environ.get('CLAUDECODE') == '1'

CMD = r'(^|[;&|({`]|\n)\s*([A-Za-z_]+=\S*\s+)*'
END = r'(\s|[)`]|$)'
BUILD_RE = re.compile(
    CMD + r'((npx|yarn|pnpm|exec|time)\s+)*(\S*/)?(eslint|tsc)' + END
    + '|' + CMD + r'(yarn|pnpm|npm run)\s+([^;&|)`]*\s)?'
    r'(lint|check-ts)(:[a-z:-]+)?' + END)
SUITE_RE = re.compile(
    CMD + r'((yarn|pnpm|npm( run)?)\s+test|((exec|time|node)\s+)*'
    r'(\S*/)?run-tests(\.[cm]?[jt]s)?)' + END)
MOCHA_RE = re.compile(
    CMD + r'((npx|yarn|pnpm|exec|time)\s+)*(\S*/)?mocha' + END
    + '|' + CMD + r'(yarn|pnpm|npm run)\s+test:[a-z:-]+' + END)
HEAVY_RE = re.compile('|'.join(
    r.pattern for r in (BUILD_RE, SUITE_RE, MOCHA_RE)))
LOCAL_RE = re.compile(r'(localhost|127\.0\.0\.1):\d+')
READY = ('Take it only when ready to test: the code is done, the build '
         'green, the checklist written, and the person you need at the '
         'keyboard.')


def now():
    return int(time.time())


def sh(*a):
    try:
        return subprocess.run(a, capture_output=True, text=True,
                              timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return ''


def owner():
    """The caller's session: POOL_OWNER, its tmux session, its
    .worktrees/<slug>, else its parent pid."""
    if os.environ.get('POOL_OWNER'):
        return os.environ['POOL_OWNER']
    if os.environ.get('TMUX_PANE'):
        s = sh('tmux', 'display-message', '-p', '-t',
               os.environ['TMUX_PANE'], '#S').strip()
        if s:
            return s
    cwd = os.getcwd()
    if '/.worktrees/' in cwd:
        return cwd.split('/.worktrees/', 1)[1].split('/', 1)[0]
    return f'pid-{os.getppid()}'


def pid_alive(p):
    try:
        os.kill(int(p), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def session_alive(s):
    if s.startswith('pid-'):
        return pid_alive(s[4:])
    return subprocess.run(['tmux', 'has-session', '-t', f'={s}'],
                          capture_output=True).returncode == 0


def stack_running(s):
    if s.startswith('pid-'):
        return True
    out = sh('tmux', 'list-panes', '-s', '-t', f'={s}', '-F', '#{@dev}')
    return any(ln.strip() for ln in out.splitlines())


def tree(pid):
    kids = {}
    for ln in sh('ps', '-axo', 'pid=,ppid=').splitlines():
        p = ln.split()
        if len(p) == 2:
            kids.setdefault(int(p[1]), []).append(int(p[0]))
    out, todo = [], [int(pid)]
    while todo:
        p = todo.pop()
        out.append(p)
        todo += kids.get(p, [])
    return out


def cpu(pid):
    total = 0
    for ln in sh('ps', '-o', 'time=', '-p',
                 ','.join(map(str, tree(pid)))).splitlines():
        m = re.match(r'\s*(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)', ln)
        if m:
            d, h, mi, s = (int(x or 0) for x in m.groups())
            total += ((d * 24 + h) * 60 + mi) * 60 + s
    return total


def adopt():
    """First run: count what test-slot and heavy-slot hold, so the
    cutover doesn't overcommit while their stacks, browsers and builds
    still run. Each lease gets a fresh idle window; a stack held only
    through heavy-slot's `dev:<session>` hold (jrb's own) is human."""
    out, agents = [], set()

    def add(k, o, human=False):
        h = {'kind': k, 'owner': o, 'units': UNITS[k], 'tag': 'adopted',
             'since': now(), 'seen': now(), 'pid': None, 'adopted': 'new'}
        if human:
            h['human'] = True
        out.append(h)

    for f in glob.glob(os.path.join(CONF, 'test-slots', '*.slot')):
        try:
            o = open(f).read().split('\t')[0].strip()
        except OSError:
            continue
        if o and o not in agents and session_alive(o):
            agents.add(o)
            add('stack' if stack_running(o) else 'browser', o)
    for f in glob.glob(os.path.join(CONF, 'heavy-slots', '*', 'until')):
        try:
            u, tag = open(f).read().split(None, 1)
            u = int(u)
        except (OSError, ValueError):
            continue
        o = tag.strip().removeprefix('dev:')
        if (tag.startswith('dev:') and u > now() and o not in agents
                and session_alive(o) and stack_running(o)):
            agents.add(o)
            add('stack', o, human=True)
    for f in glob.glob(os.path.join(CONF, 'heavy-slots', '*', 'pid')):
        try:
            pid = int(open(f).read().split()[0])
        except (OSError, ValueError, IndexError):
            continue
        if pid_alive(pid):
            tag = command_of(pid)
            m = re.search(r'\.worktrees/([^/\s]+)', tag)
            out.append({'kind': 'heavy',
                        'owner': m.group(1) if m else f'heavy-slot-{pid}',
                        'units': heavy_units(cwd_of(pid), tag),
                        'tag': tag,
                        'since': now(), 'seen': now(), 'pid': pid,
                        'adopted': 'new'})
    return out


class Pool:
    """The state under flock: `with Pool() as p:` reads it, reaps it,
    writes it back; side effects run after the lock is gone."""

    def __enter__(self):
        os.makedirs(DIR, exist_ok=True)
        self.fd = open(LOCK, 'a')
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        st = {}
        try:
            with open(STATE) as f:
                st = json.load(f)
        except ValueError:
            pass
        except OSError:
            st = {'holders': adopt()}
        self.holders = st.get('holders', [])
        self.queue = st.get('queue', [])
        self.reaped_at = st.get('reaped_at', 0)
        self.after = []
        for h in self.holders:
            if h.get('adopted') == 'new':
                h['adopted'] = True
                self.log('acquire', h, wait=0, detail='adopted at cutover')
        self.reap()
        return self

    def __exit__(self, *exc):
        tmp = STATE + '.tmp'
        with open(tmp, 'w') as f:
            json.dump({'holders': self.holders, 'queue': self.queue,
                       'reaped_at': self.reaped_at}, f, indent=1)
        os.replace(tmp, STATE)
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        self.fd.close()
        for fn in self.after:
            fn()

    def used(self):
        return sum(h['units'] for h in self.holders)

    def log(self, event, e, wait='', hold='', detail=''):
        row = [now(), event, e['kind'], e['owner'], e['units'], wait,
               hold, f'{self.used()}/{CAP}', len(self.queue),
               detail.replace('\t', ' ').replace('\n', ' ')[:200]]
        with open(LOG, 'a') as f:
            f.write('\t'.join(map(str, row)) + '\n')

    def drop(self, h, event, detail=''):
        self.holders.remove(h)
        self.log(event, h, hold=now() - h['since'], detail=detail)

    def reap(self):
        """Dead pids every call (cheap, keeps the handoff within a
        second); the ps/tmux checks at most every REAP seconds, since
        every waiter reaps once a second."""
        t = now()
        full = t - self.reaped_at >= REAP
        if full:
            self.reaped_at = t
        for h in list(self.holders):
            if h['kind'] == 'heavy':
                if not pid_alive(h['pid']):
                    self.drop(h, 'release')
                    continue
                if not full:
                    continue
                c = cpu(h['pid'])
                if c != h.get('cpu'):
                    h['cpu'], h['cpu_at'] = c, t
                elif t - h.get('cpu_at', t) >= STALL:
                    for p in tree(h['pid']):
                        try:
                            os.kill(p, signal.SIGTERM)
                        except OSError:
                            pass
                    self.drop(h, 'stall', f'pid {h["pid"]} no CPU {STALL}s')
                    print(f'pool: TERMed pid {h["pid"]}, no CPU for '
                          f'{STALL}s', file=sys.stderr)
                continue
            if not h.get('human') and t - h['seen'] > IDLE:
                if not session_alive(h['owner']):
                    self.drop(h, 'release', 'session gone')
                    continue
                self.drop(h, 'expire', f'idle {t - h["seen"]}s')
                self.after.append(lambda o=h['owner'], k=h['kind']:
                                  expired(o, k))
            elif not full:
                continue
            elif not session_alive(h['owner']):
                self.drop(h, 'release', 'session gone')
            elif (h['kind'] == 'stack' and t - h['since'] > GRACE
                  and not stack_running(h['owner'])):
                self.drop(h, 'release', 'stack gone')
        for q in list(self.queue):
            # A heavy entry also goes when the job it queues for died.
            if not pid_alive(q['waiter']) or (
                    q.get('pid') and not pid_alive(q['pid'])):
                self.queue.remove(q)
                self.log('drop', q, wait=t - q['at'])

    def lease(self, o):
        return next((h for h in self.holders
                     if h['owner'] == o and h['kind'] in LEASES), None)

    def heavy(self, o):
        """o's heavy job, held or queued, as (entry, 'running'|'queued')."""
        for h in self.holders:
            if h['owner'] == o and h['kind'] == 'heavy':
                return h, 'running'
        for q in self.queue:
            if q['owner'] == o and q['kind'] == 'heavy':
                return q, 'queued'
        return None, None

    def grant(self, q):
        """Move the queue head q to holders when it fits."""
        if not self.queue or self.queue[0] is not q:
            return False
        if self.used() + q['units'] > CAP:
            return False
        self.queue.pop(0)
        h = {k: q[k] for k in ('kind', 'owner', 'units', 'tag')}
        h.update(since=now(), seen=now(), pid=q.get('pid'))
        self.holders.append(h)
        self.log('acquire', h, wait=now() - q['at'], detail=q.get('tag', ''))
        return True

    def take_now(self, kind, o, human=False, tag=''):
        h = {'kind': kind, 'owner': o, 'units': UNITS[kind], 'tag': tag,
             'since': now(), 'seen': now(), 'pid': None}
        if human:
            h['human'] = True
        self.holders.append(h)
        self.log('acquire', h, wait=0, detail=tag)
        return h


def browser_pids(needle):
    out = []
    for ln in sh('ps', '-axo', 'pid=,command=').splitlines():
        p = ln.strip().split(None, 1)
        if (len(p) == 2 and '/Contents/MacOS/Google Chrome ' in p[1] + ' '
                and '--window-name=Claude ' in p[1] and needle in p[1]):
            out.append(int(p[0]))
    return out


def close_browser(o):
    """Stop o's devtools Chrome: SIGUSR1 to its chrome-devtools-mcp
    proxies (they restart it on the next call), else kill by window
    name."""
    if o.startswith('pid-'):
        return
    d = os.path.join(CONF, 'chrome-mcp', o)
    for f in os.listdir(d) if os.path.isdir(d) else []:
        if f.isdigit() and 'chrome-devtools-mcp-proxy' in sh(
                'ps', '-o', 'command=', '-p', f):
            try:
                os.kill(int(f), signal.SIGUSR1)
            except OSError:
                pass
    for p in browser_pids(f' · {o}:'):
        try:
            os.kill(p, signal.SIGTERM)
        except OSError:
            pass


def expired(o, kind):
    if o.startswith('pid-'):
        return
    if kind == 'stack':
        env = dict(os.environ, DEV_SESSION=o)
        subprocess.Popen(['dev', 'down'], env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        close_browser(o)


def cwd_of(pid):
    out = sh('lsof', '-a', '-p', str(pid), '-d', 'cwd', '-Fn')
    return next((l[1:] for l in out.splitlines() if l.startswith('n')), '')


def heavy_units(cwd, c):
    """POOL_HEAVY_WEIGHTS: lines of `UNITS REGEX`, matched against
    "CWD COMMAND"; the first match wins. Else a targeted test run
    (mocha, `yarn test:*`) with no build or full suite beside it takes
    POOL_TEST, anything else POOL_HEAVY."""
    for line in os.environ.get('POOL_HEAVY_WEIGHTS', '').splitlines():
        u, _, rx = line.strip().partition(' ')
        try:
            if rx and re.search(rx.strip(), f'{cwd} {c}'):
                return int(u)
        except (re.error, ValueError):
            continue
    if (MOCHA_RE.search(c) and not BUILD_RE.search(c)
            and not SUITE_RE.search(c)):
        return UNITS['test']
    return UNITS['heavy']


def queue_entry(p, kind, o, pid=None, tag='', units=None):
    """o's queue entry for kind, now waited on by this process; a new
    one at the back, or the old one keeping its place."""
    for q in p.queue:
        if q['owner'] == o and q['kind'] == kind:
            q['waiter'] = os.getpid()
            return q
    q = {'kind': kind, 'owner': o, 'units': units or UNITS[kind], 'pid': pid,
         'waiter': os.getpid(), 'at': now(), 'tag': tag}
    p.queue.append(q)
    p.log('queue', q, detail=tag)
    return q


def wait_turn(kind, o, pid=None, tag='', units=None):
    said = False
    while True:
        if pid and not pid_alive(pid):
            sys.exit(f'pool: pid {pid} exited before its turn')
        with Pool() as p:
            h = p.lease(o) if kind in LEASES else None
            if h and h['kind'] in (kind, 'stack'):
                # Another waiter for this session got there first.
                p.queue = [q for q in p.queue
                           if not (q['owner'] == o and q['kind'] == kind)]
                return p.used()
            q = queue_entry(p, kind, o, pid, tag, units)
            if p.grant(q):
                return p.used()
            pos = p.queue.index(q) + 1
            used = p.used()
        if not said:
            print(f'pool: queued #{pos} for {kind} ({q["units"]} units, '
                  f'{used}/{CAP} held); waiting. `pool ls` shows the line.',
                  file=sys.stderr)
            said = True
        time.sleep(POLL)


def cmd_wait(kind):
    if kind not in LEASES:
        sys.exit(f'pool: wait takes {" or ".join(LEASES)}, not {kind}')
    o = owner()
    with Pool() as p:
        h = p.lease(o)
        if h and (h['kind'] == kind or h['kind'] == 'stack'):
            h['seen'] = now()
            if not AGENT and kind == 'stack':
                # jrb's stack riding an agent's lease is his now.
                h['human'] = True
            return 0
        if h:
            # A browser lease growing into a stack: give the unit back
            # first, so nothing is held while queued.
            p.drop(h, 'release', 'upgrade to stack')
        if not AGENT:
            p.take_now(kind, o, human=True)
            return 0
    used = wait_turn(kind, o)
    print(f'pool: {o} holds a {kind} lease ({used}/{CAP} units). It '
          f'expires after {IDLE // 60} idle minutes (no devtools or '
          'localhost call); `dev down` or `pool release` when done.')
    return 0


def cmd_take(kind, pid):
    if kind != 'heavy':
        sys.exit('usage: pool take heavy PID')
    o = owner()
    with Pool() as p:
        line = lineage(pid)
        if any(h['kind'] == 'heavy' and str(h['pid']) in line
               for h in p.holders):
            return 0
        e, state = p.heavy(o)
        if e and str(e.get('pid')) not in line:
            p.log('refuse', {'kind': 'heavy', 'owner': o,
                             'units': UNITS['heavy']},
                  detail=f'{state}: {e.get("tag", "")}')
            print(refusal(o, e, state), file=sys.stderr)
            return 75
    tag = command_of(pid)
    wait_turn('heavy', o, pid=int(pid), tag=tag,
              units=heavy_units(cwd_of(pid), tag))
    return 0


def lineage(pid):
    """pid and its ancestors: a heavy job run inside one (the hook's
    shell running `heavy tsc`) re-enters its slot."""
    out, pid = [], str(pid)
    while pid not in ('', '0', '1') and pid not in out and len(out) < 32:
        out.append(pid)
        pid = sh('ps', '-o', 'ppid=', '-p', pid).strip()
    return out


def refusal(o, e, state):
    return (f'pool: {o} already has a heavy job {state} '
            f'({e.get("tag") or "pid " + str(e.get("pid"))}). One heavy '
            'job per session: wait for it, then run this one. Use the '
            'smallest scope that answers the question (changed files '
            "first). Where the repo's CI runs the full checks on a "
            'draft PR, let CI run them.')


def command_of(pid):
    c = sh('ps', '-o', 'command=', '-p', str(pid)).strip()
    # An agent's Bash shell: keep the command it evals.
    m = re.search(r"(?:pool|heavy-slot) take (?:heavy )?\$\$"
                  r"(?: \|\| exit 75)?\\012(.*?)"
                  r"(' < /dev/null && pwd -P|$)", c)
    if m:
        c = m.group(1).replace('\\012', '; ')
    return c[:160]


def cmd_release(quiet=False):
    o = owner()
    msg = 'held no lease'
    with Pool() as p:
        h = p.lease(o)
        if h and h.get('human') and AGENT:
            msg = "holds jrb's own stack: left alone"
        elif h:
            p.drop(h, 'release')
            msg = f'released its {h["kind"]} lease'
        p.after.append(lambda: close_browser(o))
    if not quiet:
        print(f'pool: {o} {msg}; its devtools Chrome closed.')


def cmd_touch(args):
    o = args[0] if args else owner()
    with Pool() as p:
        h = p.lease(o)
        if h:
            h['seen'] = now()


def cmd_held(o, kind=None):
    with Pool() as p:
        h = p.lease(o)
    return 0 if h and (kind is None or h['kind'] == kind) else 1


def hook_browser():
    sys.stdin.read()
    o = owner()
    with Pool() as p:
        h = p.lease(o)
        if h:
            h['seen'] = now()
            return 0
        if not p.queue and p.used() + UNITS['browser'] <= CAP:
            p.take_now('browser', o)
            used = p.used()
            print(json.dumps({'hookSpecificOutput': {
                'hookEventName': 'PreToolUse',
                'additionalContext':
                    f'pool: {o} now holds a browser lease ({used}/{CAP} '
                    f'units shared by all agents). It expires after '
                    f'{IDLE // 60} minutes without a devtools call. Run '
                    '`pool release` the moment you stop driving the '
                    'browser (done, blocked, waiting on a person, CI or '
                    'an agent), not at the end of the task.'}}))
            return 0
        waiting, used = len(p.queue), p.used()
    print(f'pool: no browser lease for {o}: {used}/{CAP} units held, '
          f'{waiting} waiting (`pool ls`). {READY} Then run `pool wait '
          'browser` with run_in_background true (timeout 1500000) and '
          'retry this call when it exits 0. Tell the user you are '
          'waiting and work on something else meanwhile.',
          file=sys.stderr)
    return 2


DOC_RE = re.compile(
    r"^(?P<head>[^\n]*?(?<!<)<<-?(?!<)\s*\\?(['\"]?)(?P<tag>[A-Za-z_]\w*)\2"
    r"[^\n]*)\n(?P<body>.*?)^\s*(?P=tag)\s*$", re.S | re.M)
SHELL_RE = re.compile(r'(^|[;&|(]|\s)(sh|bash|zsh|ssh|xargs|eval)(\s|$)')
FLAG_C_RE = re.compile(
    r'(^|[\s;&|(/])(sh|bash|zsh|dash)(\s+-[A-Za-z]+)*\s+-[A-Za-z]*c\s*$')


def quote_end(c, i):
    """Index of the quote closing the one at c[i] (len(c) if none)."""
    q, j, n = c[i], i + 1, len(c)
    esc = q == '"' or c[i - 1:i] == '$'  # $'..' takes \\ escapes
    while j < n and c[j] != q:
        if q == '"' and c.startswith('$(', j):
            j = paren_end(c, j + 2)
        j += 2 if esc and c[j:j + 1] == '\\' else 1
    return min(j, n)


def paren_end(c, i):
    """Index of the `)` closing the `$(` whose body starts at c[i]."""
    depth, n = 1, len(c)
    while i < n:
        ch = c[i]
        if ch == '\\':
            i += 1
        elif ch in '\'"':
            i = quote_end(c, i)
        elif ch == '(':
            depth += 1
        elif ch == ')':
            depth -= 1
            if not depth:
                return i
        i += 1
    return n


def ran_parts(body):
    """The parts of a double-quoted string the shell runs: $(...) and
    unescaped backticks, each as its own command line."""
    out, i, n = [], 0, len(body)
    while i < n:
        if body[i] == '\\':
            i += 2
        elif body.startswith('$(', i):
            j = paren_end(body, i + 2)
            out.append('\n' + unquoted(body[i + 2:j]) + '\n')
            i = j + 1
        elif body[i] == '`':
            j = body.find('`', i + 1)
            j = n if j < 0 else j
            out.append('\n' + unquoted(body[i + 1:j]) + '\n')
            i = j + 1
        else:
            i += 1
    return ''.join(out)


def unquoted(c):
    """c with the text a shell never runs blanked out, so `tsc` in a
    commit message, an echo, a comment or a heredoc for a file isn't
    taken for a build. Kept: `$(...)` and backticks, `sh -c '...'`,
    and heredocs fed to a shell."""
    def doc(m):
        head = re.sub(r"'[^']*'|\"(\\.|[^\"\\])*\"", "''", m['head'])
        return m['head'] + '\n' + (
            m['body'] if SHELL_RE.search(head) else '')
    c = DOC_RE.sub(doc, c)
    out, i, n = [], 0, len(c)
    while i < n:
        ch = c[i]
        if ch == '\\':
            out.append(c[i:i + 2])
            i += 2
        elif ch == '#' and (i == 0 or c[i - 1] in ' \t\n;&|('):
            j = c.find('\n', i)
            i = n if j < 0 else j
        elif ch in '\'"':
            j = quote_end(c, i)
            body = c[i + 1:j]
            if FLAG_C_RE.search(''.join(out)):
                out.append('\n' + body + '\n')
            elif ch == '"':
                out.append("''" + ran_parts(body))
            else:
                out.append("''")
            i = j + 1
        elif c.startswith('$(', i) and not c.startswith('$((', i):
            j = paren_end(c, i + 2)
            out.append('(' + unquoted(c[i + 2:j]) + ')')
            i = j + 1
        else:
            out.append(ch)
            i += 1
    return ''.join(out)


def hook_bash():
    try:
        inp = json.load(sys.stdin).get('tool_input', {})
    except ValueError:
        return 0
    c = inp.get('command') or ''
    if re.match(r'\s*(pool|heavy-slot) take ', c):
        return 0
    if HEAVY_RE.search(unquoted(c)):
        o = owner()
        with Pool() as p:
            e, state = p.heavy(o)
            if e:
                p.log('refuse', {'kind': 'heavy', 'owner': o,
                                 'units': UNITS['heavy']},
                      detail=f'{state}: {c}')
        if e:
            print(refusal(o, e, state), file=sys.stderr)
            return 2
        print(json.dumps({'hookSpecificOutput': {
            'hookEventName': 'PreToolUse',
            'updatedInput': dict(
                inp, command='pool take heavy $$ || exit 75\n' + c)}}))
        return 0
    if LOCAL_RE.search(c):
        cmd_touch([])
    return 0


def ago(t):
    d = now() - t
    return f'{d // 60}:{d % 60:02d}'


def cmd_ls():
    with Pool() as p:
        holders, queue, used = list(p.holders), list(p.queue), p.used()
    print(f'units: {used}/{CAP}')
    for h in holders:
        if h['kind'] == 'heavy':
            note = f'pid {h["pid"]} {h.get("tag", "")}'
        elif h.get('human'):
            note = 'jrb, renewed by focus'
        else:
            left = IDLE - (now() - h['seen'])
            note = f'idle {ago(h["seen"])}, expires in {max(left, 0) // 60}m'
        print(f'  {h["units"]}u {h["kind"]:7} {h["owner"]}  held '
              f'{ago(h["since"])}  {note}'[:200])
    if queue:
        print('queue:')
    for i, q in enumerate(queue, 1):
        print(f'  #{i} {q["units"]}u {q["kind"]:7} {q["owner"]}  waiting '
              f'{ago(q["at"])}  {q.get("tag", "")}'[:200])


def cmd_legacy_ls():
    """heavy-slot's old `ls` rows for each stack lease. `dev _expire`
    loops and devtools proxies started before the switch poll it for
    their `dev:<session>` hold, and stop the stack or Chrome without
    one."""
    with Pool() as p:
        holders = [h for h in p.holders if h['kind'] == 'stack']
    for i, h in enumerate(holders, 1):
        t = now() if h.get('human') else h['seen']
        until = time.strftime('%H:%M:%S', time.localtime(t + IDLE))
        print(f'{i}\thold\tdev:{h["owner"]} until {until}')


def cmd_pick():
    ls = subprocess.run([sys.argv[0], 'ls'], capture_output=True,
                        text=True).stdout.splitlines()
    rows = [ln for ln in ls if ln.startswith('  ')]
    pick = subprocess.run(['fzf', '--prompt=pool> '], input='\n'.join(rows),
                          capture_output=True, text=True).stdout.split()
    if not pick:
        return 1
    s = pick[3] if pick[0].startswith('#') else pick[2]
    verb = 'switch-client' if os.environ.get('TMUX') else 'attach-session'
    return subprocess.call(['tmux', verb, '-t', f'={s}'])


def cmd_log(n=20):
    try:
        with open(LOG) as f:
            rows = f.readlines()[-int(n):]
    except OSError:
        rows = []
    for r in rows:
        f = r.rstrip('\n').split('\t')
        f[0] = time.strftime('%m-%d %H:%M:%S', time.localtime(int(f[0])))
        print('\t'.join(f))


def cmd_waits(n=20):
    """One row per wait, from the queue row to its acquire or drop."""
    try:
        with open(LOG) as f:
            rows = [r.rstrip('\n').split('\t') for r in f]
    except OSError:
        rows = []
    t = lambda e: time.strftime('%m-%d %H:%M:%S', time.localtime(int(e)))
    open_, out = {}, []
    for f in rows:
        if len(f) < 10:
            continue
        key = (f[2], f[3])
        if f[1] == 'queue':
            open_[key] = f
        elif f[1] in ('acquire', 'drop') and key in open_:
            q = open_.pop(key)
            out.append([t(q[0]), t(f[0]),
                        'granted' if f[1] == 'acquire' else 'gone',
                        int(f[0]) - int(q[0]), q[4], q[2], q[3], q[9]])
    with Pool() as p:
        waiting = list(p.queue)
    for q in waiting:
        out.append([t(q['at']), '-', 'waiting', now() - q['at'],
                    q['units'], q['kind'], q['owner'], q.get('tag', '')])
    print('queued\tended\toutcome\twait_s\tunits\tkind\tsession\tcommand')
    for r in out[-int(n):]:
        print('\t'.join(map(str, r)))


def cmd_test():
    import tempfile
    self = os.path.abspath(sys.argv[0])
    tmp = tempfile.mkdtemp(prefix='pool-test.')
    env = dict(os.environ, LOCAL_CONFIG=tmp, CLAUDECODE='1', POOL_POLL='0.2',
               POOL_UNITS='8', POOL_REAP='0')
    env.pop('TMUX_PANE', None)
    env.pop('TMUX', None)
    fails = []
    keep = []

    def life(tail=':'):
        s = subprocess.Popen(['sh', '-c', f'sleep 600; {tail}'],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        keep.append(s)
        return s

    def run(o, *a, stdin='', bg=False, **extra):
        e = dict(env, POOL_OWNER=o, **extra)
        if bg:
            pr = subprocess.Popen([self, *a], env=e, stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE, text=True)
            keep.append(pr)
            return pr
        return subprocess.run([self, *a], env=e, input=stdin, text=True,
                              capture_output=True)

    def state():
        with open(os.path.join(tmp, 'pool', 'state.json')) as f:
            return json.load(f)

    def check(name, ok):
        print(('ok   ' if ok else 'FAIL ') + name, flush=True)
        if not ok:
            fails.append(name)

    def until(fn, secs=20):
        end = time.time() + secs
        while time.time() < end:
            if fn():
                return True
            time.sleep(0.1)
        return False

    a, b, c, d = (f'pid-{life().pid}' for _ in range(4))
    j1, j2 = life(), life()

    r = run(a, 'take', 'heavy', str(j1.pid))
    check('heavy: free pool takes at once', r.returncode == 0)
    r = run(a, 'take', 'heavy', str(j2.pid))
    check('heavy: second heavy job per session refused',
          r.returncode == 75 and 'One heavy job per session' in r.stderr)
    r = run(a, 'take', 'heavy', str(j1.pid))
    check('heavy: same pid re-enters', r.returncode == 0)
    kid = []
    until(lambda: kid.extend(sh('pgrep', '-P', str(j1.pid)).split()) or kid)
    r = run(a, 'take', 'heavy', kid[0] if kid else '0')
    check('heavy: a job inside the holder re-enters (heavy in hook)',
          r.returncode == 0 and len(state()['holders']) == 1)

    hook = json.dumps({'tool_input': {'command': 'yarn tsc --noEmit'}})
    r = run(a, 'hook', 'bash', stdin=hook)
    check('hook bash: refuses while one runs',
          r.returncode == 2 and 'already has a heavy job' in r.stderr)
    r = run(b, 'hook', 'bash', stdin=hook)
    out = json.loads(r.stdout or '{}').get('hookSpecificOutput', {})
    check('hook bash: prefixes heavy command',
          out.get('updatedInput', {}).get('command', '').startswith(
              'pool take heavy $$ || exit 75\nyarn tsc'))
    r = run(b, 'hook', 'bash',
            stdin=json.dumps({'tool_input': {'command': 'ls'}}))
    check('hook bash: leaves others alone', r.returncode == 0 and not r.stdout)
    for cmd in ('git commit -m "fix\n\neslint passes\n(tsc too)"',
                'git commit -m "$(echo "tsc fix")"',
                'echo "x $(git rev-parse HEAD)\nyarn tsc passes"',
                "gh pr create --title 'use bash' --body-file - <<'EOF'\n"
                "yarn tsc fails\nEOF",
                "python3 - <<'PY'\nprint('yarn check-ts')\nPY",
                'python3 -c "import os; print(1)\nyarn tsc"',
                "cat <<'EOF' > f\ntsc\nEOF\necho done",
                "git commit -m 'mocha passes'", 'grep -r mocha src',
                'cat scripts/run-tests', 'yarn add -D mocha',
                'echo "yarn test fails"', 'ls node_modules/.bin/mocha'):
        r = run(a, 'hook', 'bash',
                stdin=json.dumps({'tool_input': {'command': cmd}}))
        check(f'hook bash: quoted tsc is no build ({cmd[:9]})',
              r.returncode == 0 and not r.stdout)
    for cmd in ('pool ls && yarn tsc', 'out="$(yarn tsc 2>&1)"',
                "bash <<EOF\nyarn tsc\nEOF", 'x=$((1<<2))\nyarn tsc\n2',
                "sh -c 'yarn tsc'", "bash -lc 'yarn tsc'", 'x=`yarn tsc`',
                "cat<<'EOF' > f\ndon't\nEOF\nyarn tsc", '(cd x && yarn tsc)',
                "/bin/sh -ec 'yarn tsc'", 'yarn test:mocha a.test.ts',
                'yarn mocha x', 'npx mocha x', 'node_modules/.bin/mocha x',
                'mocha x', 'yarn test', 'npm test', 'npm run test',
                'node scripts/run-tests', 'cd x && NODE_ENV=t yarn test'):
        r = run(b, 'hook', 'bash',
                stdin=json.dumps({'tool_input': {'command': cmd}}))
        check(f'hook bash: still gated ({cmd[:12]!r})',
              'pool take heavy' in r.stdout)

    # a: heavy 4 of 8. b takes a stack (4): full.
    w = run(b, 'wait', 'stack', bg=True)
    check('lease: stack granted when it fits', w.wait(5) == 0)
    r = run(c, 'hook', 'browser', stdin='{}')
    check('hook browser: blocks when full, says how to wait',
          r.returncode == 2 and 'pool wait browser' in r.stderr)

    # c holds nothing, queues a stack; d queues a browser behind it.
    wc = run(c, 'wait', 'stack', bg=True)
    until(lambda: len(state()['queue']) == 1)
    wd = run(d, 'wait', 'browser', bg=True)
    until(lambda: len(state()['queue']) == 2)
    check('queue: two waiters, in order',
          [q['owner'] for q in state()['queue']] == [c, d])
    check('queue: waiters hold no units',
          all(h['owner'] not in (c, d) for h in state()['holders']))

    # Free 4 units: c (head, 4) fits; d must not jump ahead before it.
    t0 = time.time()
    sh('pkill', '-P', str(j1.pid))
    j1.kill()
    j1.wait()
    check('handoff: head gets the freed units within 2s',
          wc.wait(5) == 0 and time.time() - t0 < 2)
    check('fifo: browser behind it still waits (full again)',
          wd.poll() is None)

    # Upgrade: d waiting; c already holds stack. b releases.
    run(b, 'release', '--quiet')
    check('release: frees the lease and hands it on', wd.wait(5) == 0)
    s = state()
    check('state: c stack + d browser = 5/8',
          sum(h['units'] for h in s['holders']) == 5)
    check('legacy ls: old pollers see the stack as a dev hold',
          f'\thold\tdev:{c} until ' in run(c, 'legacy-ls').stdout)

    # dev up from a browser holder never holds units while queued.
    # a's heavy job (4) queues: 5 + 4 > 8.
    fill = life()
    run(a, 'take', 'heavy', str(fill.pid), bg=True)
    until(lambda: len(state()['queue']) == 1, 2)
    wu = run(d, 'wait', 'stack', bg=True)
    until(lambda: any(q['owner'] == d for q in state()['queue']))
    s = state()
    check('dev up: a browser holder queued for a stack holds nothing',
          all(h['owner'] != d for h in s['holders'])
          and any(q['owner'] == d and q['kind'] == 'stack'
                  for q in s['queue']))
    for pr in keep:
        if pr.args[:1] == [self]:
            pr.kill()
            pr.wait()  # a zombie still answers kill -0

    # A dead waiter leaves the queue.
    check('drop: dead waiters leave the queue',
          until(lambda: (run(a, 'ls'), not state()['queue'])[1]))

    # Idle lease expires.
    e2 = dict(POOL_IDLE='1')
    r = run(c, 'touch')
    time.sleep(2.2)
    run(c, 'ls', **e2)
    check('idle: an unused lease expires',
          all(h['owner'] != c for h in state()['holders']))
    r = run(d, 'touch', d)
    hist = open(os.path.join(tmp, 'pool', 'history.tsv')).read()
    check('history: logs queue, acquire, release, expire, refuse, drop',
          all(f'\t{ev}\t' in hist for ev in
              ('queue', 'acquire', 'release', 'expire', 'refuse', 'drop')))
    wv = run(a, 'waits', '100').stdout
    check('waits: one row per wait, granted and gone',
          '\tgranted\t' in wv and '\tgone\t' in wv)
    t3 = dict(LOCAL_CONFIG=tempfile.mkdtemp(prefix='pool-test.'),
              POOL_HEAVY_WEIGHTS='bad [regex\n2 sleep 600\n6 never')
    run(b, 'take', 'heavy', str(life().pid), **t3)
    with open(os.path.join(t3['LOCAL_CONFIG'], 'pool', 'state.json')) as f:
        check('weights: the first matching POOL_HEAVY_WEIGHTS line sets units',
              [h['units'] for h in json.load(f)['holders']] == [2])
    for cmd, u in (('yarn test:mocha a.test.ts', 2), ('npx mocha x', 2),
                   ('node_modules/.bin/mocha x', 2), ('yarn test', 4),
                   ('npm test', 4), ('node scripts/run-tests', 4),
                   ('yarn tsc; yarn test:mocha x', 4), ('yarn tsc', 4)):
        check(f'weights: {cmd!r} takes {u} units', heavy_units('/x', cmd) == u)
    t4 = dict(LOCAL_CONFIG=tempfile.mkdtemp(prefix='pool-test.'),
              POOL_TEST='3')
    run(b, 'take', 'heavy', str(life('true || npx mocha x').pid), **t4)
    with open(os.path.join(t4['LOCAL_CONFIG'], 'pool', 'state.json')) as f:
        check('weights: POOL_TEST sets a targeted test run\'s units',
              [h['units'] for h in json.load(f)['holders']] == [3])
    w = run(a, 'wait', 'browser', bg=True, CLAUDECODE='')
    check("jrb's own lease: taken at once", w.wait(5) == 0)
    r = run(a, 'ls')
    check('ls: shows units and holders', r.stdout.startswith('units: '))

    # One session, two waiters (a retried `pool wait`): one lease.
    t2 = dict(LOCAL_CONFIG=tempfile.mkdtemp(prefix='pool-test.'),
              POOL_UNITS='1')
    run(b, 'wait', 'browser', **t2)
    w1 = run(c, 'wait', 'browser', bg=True, **t2)
    w2 = run(c, 'wait', 'browser', bg=True, **t2)

    def t2s():
        with open(os.path.join(t2['LOCAL_CONFIG'], 'pool', 'state.json')) as f:
            return json.load(f)
    until(lambda: t2s()['queue'], 3)
    run(b, 'release', '--quiet', **t2)
    check('two waiters, one session: both return, one lease',
          w1.wait(5) == 0 and w2.wait(5) == 0
          and [h['owner'] for h in t2s()['holders']] == [c]
          and not t2s()['queue'])
    gone = life()
    wh = run(d, 'take', 'heavy', str(gone.pid), bg=True, **t2)
    until(lambda: t2s()['queue'], 3)
    gone.kill()
    gone.wait()
    check('heavy: a queued job that died leaves the queue',
          wh.wait(5) != 0 and (run(d, 'ls', **t2), not t2s()['queue'])[1])
    r = subprocess.run([os.path.join(os.path.dirname(self), 'heavy-slot'),
                        'run', 'sh', '-c', 'echo ran'], env=dict(
                            env, POOL_OWNER=d, **dict(t2, POOL_UNITS='8')),
                       capture_output=True,
                       text=True)
    check('shim: heavy-slot run still runs the command',
          r.returncode == 0 and r.stdout == 'ran\n')

    # Cutover: a first run counts what test-slot and heavy-slot hold.
    old = tempfile.mkdtemp(prefix='pool-test.')
    os.makedirs(os.path.join(old, 'test-slots'))
    os.makedirs(os.path.join(old, 'heavy-slots', '1'))
    with open(os.path.join(old, 'test-slots', f'{d}.slot'), 'w') as f:
        f.write(f'{d}\t1\t2\n')
    with open(os.path.join(old, 'heavy-slots', '1', 'pid'), 'w') as f:
        f.write(f'{j2.pid}\n')
    os.makedirs(os.path.join(old, 'heavy-slots', '2'))
    with open(os.path.join(old, 'heavy-slots', '2', 'pid'), 'w') as f:
        f.write('hold\n')
    with open(os.path.join(old, 'heavy-slots', '2', 'until'), 'w') as f:
        f.write(f'{now() + 600} dev:{b}\n')
    run(a, 'ls', LOCAL_CONFIG=old)
    with open(os.path.join(old, 'pool', 'state.json')) as f:
        got = sorted((h['kind'], h['units'], bool(h.get('human')))
                     for h in json.load(f)['holders'])
    check("cutover: adopts agents' stack, jrb's held stack, heavy job",
          got == [('heavy', 4, False), ('stack', 4, False),
                  ('stack', 4, True)])
    run(a, 'ls', LOCAL_CONFIG=old)
    with open(os.path.join(old, 'pool', 'history.tsv')) as f:
        check('cutover: adopted once',
              f.read().count('adopted at cutover') == 3)

    for pr in keep:
        sh('pkill', '-P', str(pr.pid))
        try:
            pr.kill()
        except OSError:
            pass
    print('all ok' if not fails else f'{len(fails)} failed')
    return 1 if fails else 0


def main(a):
    cmd = a[0] if a else 'ls'
    if cmd == 'ls':
        cmd_ls()
    elif cmd == ':':
        return cmd_pick()
    elif cmd == 'wait' and len(a) == 2:
        return cmd_wait(a[1])
    elif cmd == 'take' and len(a) == 3:
        return cmd_take(a[1], a[2])
    elif cmd == 'release':
        cmd_release('--quiet' in a)
    elif cmd == 'touch':
        cmd_touch(a[1:])
    elif cmd == 'held' and len(a) in (2, 3):
        return cmd_held(*a[1:])
    elif cmd == 'hook' and a[1:] == ['browser']:
        return hook_browser()
    elif cmd == 'hook' and a[1:] == ['bash']:
        return hook_bash()
    elif cmd == 'legacy-ls':
        cmd_legacy_ls()
    elif cmd == 'waits':
        cmd_waits(*a[1:2])
    elif cmd == 'log':
        cmd_log(*a[1:2])
    elif cmd == 'test':
        return cmd_test()
    else:
        print(__doc__.split('\n\n')[1], file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]) or 0)
