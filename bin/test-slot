#!/bin/sh
# test-slot — replaced by `pool`. Sessions started before the switch
# still call this from their hooks; delete once none run (`pool` notes).
case "${1:-}" in
  hook) exec "$(dirname "$0")/pool" hook browser ;;
  release) shift; exec "$(dirname "$0")/pool" release "$@" ;;
  acquire|wait) exec "$(dirname "$0")/pool" wait browser ;;
  *) exec "$(dirname "$0")/pool" ls ;;
esac
