#!/bin/sh
# test-slot — replaced by `pool`. Sessions started before the switch
# still call this from their hooks; delete once none run.
p="$(dirname "$0")/pool"
case "${1:-}" in
  hook) exec "$p" hook browser ;;
  release) shift; exec "$p" release "$@" ;;
  acquire|wait) exec "$p" wait browser ;;
  touch) exec "$p" touch ;;
  ls|'') exec "$p" ls ;;
  rush|unrush) echo "no rush: the pool is first in, first out; never expedite one item" >&2; exit 1 ;;
  *) echo "test-slot: replaced by pool (pool ls)" >&2; exit 1 ;;
esac
