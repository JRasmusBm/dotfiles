#!/usr/bin/env python3
#
# tok-runs — where subagent tokens go, per run, read from the local
# transcripts (~/.claude/projects/*/*/subagents/agent-*.jsonl, type
# from the sibling .meta.json). Zero tokens. Weighted as in tok-top:
# input x1, output x5, cache write x1.25, cache read x0.1.
#
#   tok-runs                     builder runs, last 7 days
#   tok-runs --type worker       another agent type ("all" = every one)
#   tok-runs --since 24h         7d|24h|today|yesterday
#   tok-runs --until 2026-11-10  end of window (local date)
#   tok-runs --repo myrepo       only sessions whose dir names it
#   tok-runs --runs              one line per run, heaviest first
#   tok-runs --json              the summary as JSON
#
# Each assistant turn is billed to what it called:
#   edit    Edit/Write/NotebookEdit, or a shell write (heredoc into
#           a file, sed -i, perl -pi, tee, python open(...,'w'))
#   verify  tests, typecheck, lint, builds, CI (gh pr checks/run)
#   browser the browser (chrome-devtools)
#   wait    sleep, --watch, Monitor, polling loops
#   lookup  Read/Grep/Glob, read-only shell (grep, cat, git log, gh
#           view, sed -n, ls, find), WebFetch, Skill loads
#   other   anything else (git commit/push, scripts, reports)
# A turn with several kinds is billed to the first of
# edit > verify > browser > wait > lookup > other.
# "after the last edit" = turns after a run's final edit: work
# that no longer writes code.
#
# A run is a "build" when it has at least one edit turn; else
# "non-build", named by its heaviest kind. "resumed" = the parent
# sent it more work after the brief; "compacted" = it ran out of
# context; "review loops" = a review skill (/iterate-review) ran in
# it, as the brief or a follow-up. --runs flags: B build, R review,
# pN parent follow-ups, cN compactions, tN turns.
import argparse, glob, json, os, re, sys
from collections import defaultdict
from datetime import datetime, timedelta

W = dict(input_tokens=1, output_tokens=5,
         cache_creation_input_tokens=1.25, cache_read_input_tokens=0.1)
HOME = os.path.expanduser("~")
KINDS = ("edit", "verify", "browser", "wait", "lookup", "other")

WRITE = re.compile(
    r"(cat|tee)\s[^|;&]*>\s*[^&>\s]|<<-?\s*['\"]?\w+['\"]?\s*>|"
    r"\b(g?sed|perl)\s+(-\w*\s+)*-\w*i|\bopen\([^)]*['\"][wa]['\"]|"
    r"write_text\(|\.write\(|\bpatch\s+-p|git apply|\bmv\s|\bcp\s")
VERIFY = re.compile(
    r"\b(test|tests|mocha|jest|vitest|cypress|playwright|tsc|eslint|"
    r"typecheck|lint|pytest|go test|cargo (test|build)|build|"
    r"gh (pr checks|run)|run-.*test)\b")
WAIT = re.compile(r"\bsleep\b|--watch\b|\bwhile\b.*\bdo\b|\buntil\b")
LOOKUP = re.compile(
    r"^\s*(cd [^&;]+(&&|;)\s*)?(grep|rg|cat|head|tail|sed -n|ls|find|"
    r"wc|jq|git (log|show|diff|status|blame|grep|branch|rev-parse)|"
    r"gh (pr|issue|api) (view|diff|list)|gh api|node .*run-|awk|"
    r"stat|file|tree|which|echo)\b")


def window(s, until):
    now = (datetime.fromisoformat(until).astimezone() if until
           else datetime.now().astimezone())
    mid = now.replace(hour=0, minute=0, second=0, microsecond=0)
    if s == "today":
        return mid, None
    if s == "yesterday":
        return mid - timedelta(days=1), mid
    if s.endswith("d"):
        return now - timedelta(days=int(s[:-1])), until and now
    if s.endswith("h"):
        return now - timedelta(hours=int(s[:-1])), until and now
    sys.exit("tok-runs: --since today|yesterday|Nd|Nh")


def kind_of(call):
    n, i = call.get("name", ""), call.get("input") or {}
    if n in ("Edit", "Write", "NotebookEdit", "MultiEdit"):
        return "edit"
    if n.startswith("mcp__chrome-devtools"):
        return "browser"
    if n in ("Monitor",):
        return "wait"
    if n in ("Read", "Grep", "Glob", "WebFetch", "WebSearch", "Skill",
             "ToolSearch", "LS"):
        return "lookup"
    if n == "Bash":
        c = i.get("command") or ""
        if WRITE.search(c):
            return "edit"
        if VERIFY.search(c):
            return "verify"
        if WAIT.search(c):
            return "wait"
        if LOOKUP.search(c):
            return "lookup"
    return "other"


def event_of(d):
    """What a user line in a run is: brief, parent, compact or None.

    "parent" = the dispatcher sent more work into a running agent
    (SendMessage, a skill like /iterate-review); background-task
    notices, images, nested hand-backs and hook nags are not.
    """
    c = (d.get("message") or {}).get("content")
    if isinstance(c, list):
        if any(x.get("type") == "tool_result" for x in c):
            return None
        c = " ".join(x.get("text", "") for x in c
                     if x.get("type") == "text")
    c = (c or "").lstrip() if isinstance(c, str) else ""
    if not c or c.startswith(
            ("<system-reminder>", "Base directory for this skill",
             "<command-", "[Request interrupted", "[SYSTEM NOTIFICATION",
             "[Image", "<task-notification", "[handback-",
             "Another Claude session")):
        return None
    if c.startswith("This session is being continued"):
        return "compact"
    return "parent"


REVIEW = re.compile(r"/iterate-review|iterate-review\b")


def run_of(path, lo, hi):
    r = dict(path=path, kinds=defaultdict(float), turns=0, w=0.0,
             briefed=False, parents=0, compacts=0, review=False,
             after_parent=0.0, after_compact=0.0, in_review=0.0,
             since_edit=0.0, tail=defaultdict(float),
             ctx=0, first_ctx=0, reads=defaultdict(int),
             t0=None, last_kind="other", last_w=0.0)
    seen = set()
    for line in open(path, errors="replace"):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") == "user":
            e = event_of(d)
            if e and not r["briefed"]:
                r["briefed"] = True
                e = "brief"
            if e == "parent":
                r["parents"] += 1
            elif e == "compact":
                r["compacts"] += 1
            if e in ("brief", "parent") and REVIEW.search(line):
                r["review"] = True
            continue
        m = d.get("message") or {}
        u = m.get("usage")
        if d.get("type") != "assistant" or not u:
            continue
        mid = m.get("id") or d.get("requestId")
        calls = [x for x in m.get("content") or []
                 if x.get("type") == "tool_use"]
        for c in calls:
            if c.get("name") == "Read":
                r["reads"][(c.get("input") or {}).get("file_path")] += 1
        if mid in seen:
            # Same API response split over lines: later lines carry
            # more tool calls; re-bill the turn if they change kind.
            k = min((kind_of(c) for c in calls), key=KINDS.index,
                    default=None)
            if k and KINDS.index(k) < KINDS.index(r["last_kind"]):
                r["kinds"][r["last_kind"]] -= r["last_w"]
                r["kinds"][k] += r["last_w"]
                r["tail"][r["last_kind"]] -= r["last_w"]
                if k == "edit":
                    r["tail"].clear()
                else:
                    r["tail"][k] += r["last_w"]
                r["last_kind"] = k
            continue
        seen.add(mid)
        try:
            t = datetime.fromisoformat(
                d["timestamp"].replace("Z", "+00:00")).timestamp()
        except (KeyError, ValueError):
            continue
        if t < lo or (hi and t >= hi):
            continue
        w = sum((u.get(k) or 0) * v for k, v in W.items())
        k = min((kind_of(c) for c in calls), key=KINDS.index,
                default="other")
        r["kinds"][k] += w
        r["last_kind"], r["last_w"] = k, w
        if k == "edit":
            r["tail"].clear()
        else:
            r["tail"][k] += w
        r["w"] += w
        r["turns"] += 1
        ctx = sum(u.get(k) or 0 for k in (
            "input_tokens", "cache_read_input_tokens",
            "cache_creation_input_tokens"))
        r["ctx"] += ctx
        if r["t0"] is None:
            r["t0"], r["first_ctx"] = t, ctx
        if r["parents"]:
            r["after_parent"] += w
        if r["compacts"]:
            r["after_compact"] += w
        if r["review"]:
            r["in_review"] += w
    return r if r["turns"] else None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--type", default="builder")
    ap.add_argument("--since", default="7d")
    ap.add_argument("--until")
    ap.add_argument("--repo")
    ap.add_argument("--runs", action="store_true")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    lo, hi = window(a.since, a.until)
    lo, hi = lo.timestamp(), hi.timestamp() if hi else None

    runs = []
    pat = HOME + "/.claude/projects/*/*/subagents/agent-*.meta.json"
    for meta in glob.glob(pat):
        if a.repo and a.repo not in meta:
            continue
        j = meta[: -len(".meta.json")] + ".jsonl"
        if not os.path.exists(j) or os.path.getmtime(j) < lo:
            continue
        try:
            t = json.load(open(meta)).get("agentType", "?")
        except ValueError:
            continue
        if a.type != "all" and t != a.type:
            continue
        r = run_of(j, lo, hi)
        if r:
            r["type"] = t
            r["build"] = r["kinds"]["edit"] > 0
            r["rereads"] = sum(n - 1 for n in r["reads"].values() if n > 1)
            runs.append(r)

    tot = sum(r["w"] for r in runs)
    if not runs:
        print("tok-runs: no runs in window"); return
    kinds = {k: sum(r["kinds"][k] for r in runs) for k in KINDS}
    build = [r for r in runs if r["build"]]
    nonb = [r for r in runs if not r["build"]]
    M = lambda f: round(sum(f(r) for r in runs) / 1e6, 1)
    N = lambda f: sum(1 for r in runs if f(r))
    by_main = defaultdict(lambda: [0, 0.0])
    for r in nonb:
        k = max(KINDS, key=lambda k: r["kinds"][k])
        by_main[k][0] += 1
        by_main[k][1] += r["w"]
    s = dict(
        type=a.type, since=a.since, until=a.until, runs=len(runs),
        weighted_m=round(tot / 1e6, 1),
        per_run_m=round(tot / len(runs) / 1e6, 2),
        turns_per_run=round(sum(r["turns"] for r in runs) / len(runs)),
        first_ctx_k=round(sum(r["first_ctx"] for r in runs)
                          / len(runs) / 1e3),
        kinds_pct={k: round(100 * v / tot) for k, v in kinds.items()},
        build_runs=len(build),
        build_m=round(sum(r["w"] for r in build) / 1e6, 1),
        nonbuild_runs=len(nonb),
        nonbuild_m=round(sum(r["w"] for r in nonb) / 1e6, 1),
        nonbuild_by_kind={k: [n, round(w / 1e6, 1)]
                          for k, (n, w) in by_main.items()},
        avg_ctx_k=round(sum(r["ctx"] for r in runs)
                        / sum(r["turns"] for r in runs) / 1e3),
        resumed_runs=N(lambda r: r["parents"]),
        after_parent_m=M(lambda r: r["after_parent"]),
        compacted_runs=N(lambda r: r["compacts"]),
        compactions=sum(r["compacts"] for r in runs),
        after_compact_m=M(lambda r: r["after_compact"]),
        tail_m=M(lambda r: sum(r["tail"].values())),
        tail_by_kind={k: M(lambda r: r["tail"][k]) for k in KINDS[1:]},
        review_runs=N(lambda r: r["review"]),
        in_review_m=M(lambda r: r["in_review"]),
        rereads_per_run=round(sum(r["rereads"] for r in runs)
                              / len(runs), 1),
    )
    if a.json:
        print(json.dumps(s, indent=1)); return
    if a.runs:
        for r in sorted(runs, key=lambda r: -r["w"]):
            ks = " ".join(f"{k[0]}{100 * r['kinds'][k] / r['w']:.0f}"
                          for k in KINDS if r["kinds"][k])
            print(f"{r['w'] / 1e6:6.1f}M {'B' if r['build'] else '-'}"
                  f"{'R' if r['review'] else '-'} p{r['parents']} "
                  f"c{r['compacts']} t{r['turns']:<4} {ks:<28} "
                  f"{os.path.relpath(r['path'], HOME + '/.claude/projects')}")
        return
    print(f"{a.type} runs, {a.since}{' to ' + a.until if a.until else ''}:"
          f" {s['runs']} runs, {s['weighted_m']}M weighted, "
          f"{s['per_run_m']}M/run, {s['turns_per_run']} turns/run, "
          f"first turn {s['first_ctx_k']}k ctx, avg {s['avg_ctx_k']}k")
    print("turn kinds: " + "  ".join(
        f"{k} {v}%" for k, v in s["kinds_pct"].items()))
    print(f"build runs {s['build_runs']} ({s['build_m']}M), "
          f"non-build {s['nonbuild_runs']} ({s['nonbuild_m']}M): " +
          ", ".join(f"{k} {n} ({w}M)"
                    for k, (n, w) in s["nonbuild_by_kind"].items()))
    print(f"resumed by the parent {s['resumed_runs']} "
          f"({s['after_parent_m']}M after the first follow-up); "
          f"compacted {s['compacted_runs']} ({s['compactions']}x, "
          f"{s['after_compact_m']}M after the first); review loops "
          f"{s['review_runs']} ({s['in_review_m']}M); "
          f"{s['rereads_per_run']} file re-reads/run")
    print(f"after the last edit: {s['tail_m']}M (" + ", ".join(
        f"{k} {v}M" for k, v in s["tail_by_kind"].items() if v) + ")")


main()
