#!/bin/sh
#
# heavy-slot — cap how many type-aware eslint / tsc runs go at once.
# Each builds a full TypeScript program (1.5–4 GB), and agents in
# separate worktrees share nothing, so a few at once swap the laptop.
# run-slot only holds back starts, which run no Bash, so nothing
# waiting there holds or wants a slot here; an agent queued here
# holds no run-slot (run-slot counts it parked), so they can't
# deadlock.
#
#   heavy-slot run CMD...  wait for a free slot, run CMD, free it
#   heavy-slot take PID    wait for a free slot and hold it for PID
#   heavy-slot hold [--try] SECS TAG
#                          hold a slot for SECS under TAG, or renew
#                          TAG's; --try takes one only if it's free
#                          now, else waits (dev up: a running stack)
#   heavy-slot free TAG    release TAG's slot
#   heavy-slot ls          list held slots and rushes
#   heavy-slot rush SLUG [MINS]
#                          cut the line for a worktree (by its tmux
#                          session or its .worktrees/SLUG path) for
#                          MINS (120): its runs may take one extra
#                          slot, HEAVY_SLOTS+1, that no one else can
#   heavy-slot unrush SLUG end that early
#   heavy-slot hook        PreToolUse hook for Bash: prefixes agents'
#                          eslint/tsc/lint commands with
#                          `heavy-slot take $$`, so the slot lives
#                          as long as the tool's shell
#
# Slots: HEAVY_SLOTS (default 2). A slot is a dir holding the pid that
# holds it; a dead pid frees it. The holder renews its lease by using
# CPU: a holder whose process tree used none for HEAVY_SLOT_STALL
# seconds (default 600) is hung (e.g. tsc after a full disk), so its
# tree is TERMed and the slot freed; the agent sees the command fail.
# A `hold` slot has no pid: it expires at its `until` time instead.
# A rush costs one more full TS program in RAM while it's used, so it
# is for one urgent worktree at a time, not a priority system.

set -e

_max="${HEAVY_SLOTS:-2}"
_dir="${LOCAL_CONFIG:-$HOME/.config}/heavy-slots"
mkdir -p "$_dir"

_stall="${HEAVY_SLOT_STALL:-600}"
_tree() {
  echo "$1"
  for _c in $(pgrep -P "$1" 2>/dev/null); do _tree "$_c"; done
}
_cpu() {
  _tree "$1" | xargs ps -o time= -p 2>/dev/null \
    | awk -F'[:.]' '{ s += $1 * 60 + $2 } END { print s + 0 }'
}
_stalled() {
  _now="$(date +%s)"
  _c="$(_cpu "$2")"
  _seen='' _at=''
  test -f "$1/cpu" && read -r _seen _at < "$1/cpu"
  if test "${_seen:-}" != "$_c"; then
    echo "$_c $_now" > "$1/cpu"
    return 1
  fi
  test $((_now - ${_at:-$_now})) -ge "$_stall"
}
_rush="$_dir/.rush"
# The caller's worktree: its tmux session (subagents in scratch
# worktrees share their parent's pane), else its .worktrees/<slug>.
_whoami() {
  test -z "${TMUX_PANE:-}" \
    || tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null || true
  case "$PWD" in */.worktrees/*) _w="${PWD#*/.worktrees/}"; echo "${_w%%/*}" ;; esac
}
_rushed() {
  test -f "$_rush" || return 1
  _me="$(_whoami)"
  test -n "$_me" || return 1
  _now="$(date +%s)"
  while read -r _u _r; do
    test "$_now" -lt "${_u:-0}" || continue
    printf '%s\n' "$_me" | grep -qxF "$_r" && return 0
  done < "$_rush"
  return 1
}
_lim="$_max"
_rushed && _lim=$((_max + 1))
_take() {
  # Re-entrant: an owner already holding one goes on with it (a shell
  # that runs `heavy-slot take $$` again would otherwise hold every
  # slot and wait on itself, stalling all others). Not `hold`: every
  # hold shares that owner, and _hold_once matches by tag already.
  test "$_owner" = hold || for _s in "$_dir"/[0-9]*; do
    test "$(cat "$_s/pid" 2>/dev/null)" = "$_owner" || continue
    _held=''
    return 0
  done
  _i=1
  while test "$_i" -le "$_lim"; do
    _s="$_dir/$_i"
    if mkdir "$_s" 2>/dev/null; then
      test -z "${_until:-}" || echo "$_until $_tag" > "$_s/until"
      echo "$_owner" > "$_s/pid"
      _held="$_s"
      return 0
    fi
    if test -f "$_s/until"; then
      read -r _u _t < "$_s/until" || true
      if test "$(date +%s)" -ge "${_u:-0}"; then
        rm -rf "$_s"
        continue
      fi
      _i=$((_i + 1))
      continue
    fi
    _p="$(cat "$_s/pid" 2>/dev/null || true)"
    if test -n "$_p" && ! kill -0 "$_p" 2>/dev/null; then
      rm -rf "$_s"
      continue
    fi
    if test -n "$_p" && _stalled "$_s" "$_p"; then
      _tree "$_p" | xargs kill -TERM 2>/dev/null || true
      echo "heavy-slot: freed slot ${_s##*/}, pid $_p used no CPU" \
        "for ${_stall}s" >&2
      rm -rf "$_s"
      continue
    fi
    _i=$((_i + 1))
  done
  return 1
}

_wait() {
  _held=''
  _said=''
  until _locked "${1:-_take}"; do
    if test -z "$_said"; then
      echo "heavy-slot: all $_lim slots held (heavy-slot ls), waiting" >&2
      _said=1
      mkdir -p "$_dir/.wait"
      trap 'rm -f "$_dir/.wait/$$"' EXIT
      trap 'exit 130' INT TERM
      printf '%s %s %s\n' "$(date +%s)" "$_owner" "${_tag:-}" \
        > "$_dir/.wait/$$"
    fi
    sleep 3
  done
  rm -f "$_dir/.wait/$$"
  test -n "$_said" && test "${CLAUDECODE:-}" != 1 || return 0
  NOTIFY_CLASS=env notify "heavy-slot" \
    "got a slot: ${_tag:-$_owner}; others queue until it's freed" \
    >/dev/null 2>&1 || true
}

_run() {
  _owner=$$
  _tag="$*"
  _wait
  trap 'rm -rf "$_held"' EXIT
  trap 'exit 130' INT TERM
  _status=0
  "$@" || _status=$?
  exit "$_status"
}

_hook() {
  jq -c '
    .tool_input as $in
    | ($in.command // "") as $c
    | if ($c | test("^heavy-slot take ")) then empty
      elif ($c | test("(^|[;&|({]|\\n)\\s*([A-Za-z_]+=\\S*\\s+)*((npx|yarn|pnpm|exec|time)\\s+)*(\\S*/)?(eslint|tsc)(\\s|$)")
        or ($c | test("(^|[;&|({]|\\n)\\s*([A-Za-z_]+=\\S*\\s+)*(yarn|pnpm|npm run)\\s+([^;&|]*\\s)?(lint|check-ts)(:[a-z:-]+)?(\\s|$)")))
      then {hookSpecificOutput: {hookEventName: "PreToolUse",
        updatedInput: ($in + {command: ("heavy-slot take $$\n" + $c)})}}
      else empty end'
}

_tagged() {
  for _s in "$_dir"/*; do
    test -f "$_s/until" || continue
    read -r _u _t < "$_s/until" || true
    test "$_t" = "$1" && echo "$_s" && return 0
  done
  return 1
}

_lock() {
  until mkdir "$_dir/.lock" 2>/dev/null; do
    find "$_dir/.lock" -maxdepth 0 -mmin +1 -exec rmdir {} \; 2>/dev/null
    sleep 0.1
  done
}

_locked() {
  _lock
  _r=0
  "$@" || _r=$?
  rmdir "$_dir/.lock"
  return "$_r"
}

_hold_once() {
  if _s="$(_tagged "$_tag")"; then
    # Renew, never shorten: a focus must not cut a `dev up --for 60`.
    read -r _u _t < "$_s/until" 2>/dev/null || _u=0
    test "$_until" -le "${_u:-0}" || echo "$_until $_tag" > "$_s/until"
    return 0
  fi
  _take
}

_hold() {
  _try=''
  test "$1" != --try || { _try=1; shift; }
  _until=$(( $(date +%s) + ${1:?usage: heavy-slot hold [--try] SECS TAG} ))
  _tag="${2:?usage: heavy-slot hold [--try] SECS TAG}"
  _owner=hold
  if test -n "$_try"; then
    _locked _hold_once
  else
    _wait _hold_once
  fi
}

_row() {
  _cwd="$(lsof -a -p "$2" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')"
  case "$_cwd" in
    */.worktrees/*) _cwd="${_cwd#*/.worktrees/}" ;;
    *) _cwd="${_cwd##*/}" ;;
  esac
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$_cwd" \
    "${4:-$(ps -o command= -p "$2" 2>/dev/null | _line)}"
}

_ago() {
  _d=$(( $(date +%s) - $1 ))
  printf '%d:%02d' $((_d / 60)) $((_d % 60))
}

_rush_set() {
  _now="$(date +%s)"
  { test ! -f "$_rush" || awk -v n="$_now" -v r="$1" \
      '$1 > n && $2 != r' "$_rush"
    test -z "$2" || echo "$((_now + $2 * 60)) $1"
  } > "$_rush.tmp"
  mv "$_rush.tmp" "$_rush"
}

_ls() {
  _gap=''
  if test -f "$_rush"; then
    while read -r _u _r; do
      test "$(date +%s)" -lt "${_u:-0}" || continue
      printf 'rush\t%s until %s (slot %s)\n' "$_r" \
        "$(date -r "$_u" +%H:%M)" "$((_max + 1))"
    done < "$_rush"
  fi
  for _s in "$_dir"/*; do
    test -d "$_s" || continue
    if test -f "$_s/until"; then
      read -r _u _t < "$_s/until" || true
      test "$(date +%s)" -lt "${_u:-0}" || continue
      _gap=1
      printf '%s\thold\t%s until %s\n' "${_s##*/}" "$_t" \
        "$(date -r "${_u:-0}" +%H:%M:%S)"
      continue
    fi
    _p="$(cat "$_s/pid" 2>/dev/null || true)"
    kill -0 "$_p" 2>/dev/null || continue
    _gap=1
    _row "${_s##*/}" "$_p" \
      "$(ps -o etime= -p "$_p" 2>/dev/null | tr -d ' ')"
  done
  for _w in "$_dir"/.wait/*; do
    test -f "$_w" || continue
    if ! kill -0 "${_w##*/}" 2>/dev/null; then
      rm -f "$_w"
      continue
    fi
    read -r _at _o _t < "$_w" || true
    test -z "$_gap" || { echo; _gap=''; }
    case "$_o" in
      hold) _row wait "${_w##*/}" "$(_ago "$_at")" "$_t" ;;
      *) _row wait "$_o" "$(_ago "$_at")" ;;
    esac
  done
}
# An agent's Bash call shows as `zsh -c source <snapshot> ... eval
# 'heavy-slot take $$\012<command>' ...`: keep the command.
_line() {
  sed -e 's/.*heavy-slot take \$\$\\012//' \
    -e "s/' < \/dev\/null && pwd -P.*//" -e 's/\\012/; /g' \
    -e "s/'\"'\"'/'/g" \
    | cut -c1-160
}

case "${1:-}" in
  run) shift; _run "$@" ;;
  take) _owner="${2:?usage: heavy-slot take PID}"; _wait ;;
  hold) shift; _hold "$@" ;;
  free) _s="$(_tagged "${2:?usage: heavy-slot free TAG}")" && rm -rf "$_s" ;;
  hook) _hook ;;
  ls) _ls ;;
  rush) _locked _rush_set "${2:?usage: heavy-slot rush SLUG [MINS]}" \
    "${3:-120}"; _ls | grep '^rush' ;;
  unrush) _locked _rush_set "${2:?usage: heavy-slot unrush SLUG}" "" ;;
  *) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2; exit 1 ;;
esac
