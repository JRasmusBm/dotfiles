#!/bin/sh
# heavy-slot — replaced by `pool`. Sessions started before the switch
# still call this from their hooks; delete once none run (`pool` notes).
case "${1:-}" in
  hook) exec "$(dirname "$0")/pool" hook bash ;;
  take) exec "$(dirname "$0")/pool" take heavy \
    "${2:?usage: heavy-slot take PID}" ;;
  *) exec "$(dirname "$0")/pool" ls ;;
esac
