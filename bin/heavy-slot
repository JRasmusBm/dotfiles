#!/bin/sh
# heavy-slot — replaced by `pool`. Sessions, `dev _expire` loops and
# devtools proxies started before the switch still call this; delete
# once none run.
p="$(dirname "$0")/pool"
case "${1:-}" in
  hook) exec "$p" hook bash ;;
  take) exec "$p" take heavy "${2:?usage: heavy-slot take PID}" ;;
  run) shift; "$p" take heavy $$ || exit $?; exec "$@" ;;
  ls) exec "$p" legacy-ls ;;
  # Old `dev` mid-run: the pool tracks stacks itself now.
  hold|free) exit 0 ;;
  rush|unrush) echo "no rush: the pool is first in, first out; never expedite one item" >&2; exit 1 ;;
  *) echo "heavy-slot: replaced by pool (pool ls)" >&2; exit 1 ;;
esac
