#!/bin/sh
#
# heavy-slot — cap how many type-aware eslint / tsc runs go at once.
# Each builds a full TypeScript program (1.5–4 GB), and agents in
# separate worktrees share nothing, so a few at once swap the laptop.
#
#   heavy-slot run CMD...  wait for a free slot, run CMD, free it
#   heavy-slot take PID    wait for a free slot and hold it for PID
#   heavy-slot hold [--try] SECS TAG
#                          hold a slot for SECS under TAG, or renew
#                          TAG's; --try takes one only if it's free
#                          now, else waits (dev up: a running stack)
#   heavy-slot free TAG    release TAG's slot
#   heavy-slot ls          list held slots
#   heavy-slot hook        PreToolUse hook for Bash: prefixes agents'
#                          eslint/tsc/lint commands with
#                          `heavy-slot take $$`, so the slot lives
#                          as long as the tool's shell
#
# Slots: HEAVY_SLOTS (default 2). A slot is a dir holding the pid that
# holds it; a dead pid frees it. The holder renews its lease by using
# CPU: a holder whose process tree used none for HEAVY_SLOT_STALL
# seconds (default 600) is hung (e.g. tsc after a full disk), so its
# tree is TERMed and the slot freed; the agent sees the command fail.
# A `hold` slot has no pid: it expires at its `until` time instead.

set -e

_max="${HEAVY_SLOTS:-2}"
_dir="${LOCAL_CONFIG:-$HOME/.config}/heavy-slots"
mkdir -p "$_dir"

_stall="${HEAVY_SLOT_STALL:-600}"
_tree() {
  echo "$1"
  for _c in $(pgrep -P "$1" 2>/dev/null); do _tree "$_c"; done
}
_cpu() {
  _tree "$1" | xargs ps -o time= -p 2>/dev/null \
    | awk -F'[:.]' '{ s += $1 * 60 + $2 } END { print s + 0 }'
}
_stalled() {
  _now="$(date +%s)"
  _c="$(_cpu "$2")"
  _seen='' _at=''
  test -f "$1/cpu" && read -r _seen _at < "$1/cpu"
  if test "${_seen:-}" != "$_c"; then
    echo "$_c $_now" > "$1/cpu"
    return 1
  fi
  test $((_now - ${_at:-$_now})) -ge "$_stall"
}
_take() {
  _i=1
  while test "$_i" -le "$_max"; do
    _s="$_dir/$_i"
    if mkdir "$_s" 2>/dev/null; then
      test -z "${_until:-}" || echo "$_until $_tag" > "$_s/until"
      echo "$_owner" > "$_s/pid"
      _held="$_s"
      return 0
    fi
    if test -f "$_s/until"; then
      read -r _u _t < "$_s/until" || true
      if test "$(date +%s)" -ge "${_u:-0}"; then
        rm -rf "$_s"
        continue
      fi
      _i=$((_i + 1))
      continue
    fi
    _p="$(cat "$_s/pid" 2>/dev/null || true)"
    if test -n "$_p" && ! kill -0 "$_p" 2>/dev/null; then
      rm -rf "$_s"
      continue
    fi
    if test -n "$_p" && _stalled "$_s" "$_p"; then
      _tree "$_p" | xargs kill -TERM 2>/dev/null || true
      echo "heavy-slot: freed slot ${_s##*/}, pid $_p used no CPU" \
        "for ${_stall}s" >&2
      rm -rf "$_s"
      continue
    fi
    _i=$((_i + 1))
  done
  return 1
}

_wait() {
  _held=''
  _said=''
  until _take; do
    if test -z "$_said"; then
      echo "heavy-slot: all $_max slots held (heavy-slot ls), waiting" >&2
      _said=1
    fi
    sleep 3
  done
}

_run() {
  _owner=$$
  _wait
  trap 'rm -rf "$_held"' EXIT
  trap 'exit 130' INT TERM
  _status=0
  "$@" || _status=$?
  exit "$_status"
}

_hook() {
  jq -c '
    .tool_input as $in
    | ($in.command // "") as $c
    | if ($c | test("^heavy-slot take ")) then empty
      elif ($c | test("(^|[;&|({]|\\n)\\s*([A-Za-z_]+=\\S*\\s+)*((npx|yarn|pnpm|exec|time)\\s+)*(\\S*/)?(eslint|tsc)(\\s|$)")
        or ($c | test("(^|[;&|({]|\\n)\\s*([A-Za-z_]+=\\S*\\s+)*(yarn|pnpm|npm run)\\s+([^;&|]*\\s)?(lint|check-ts)(:[a-z:-]+)?(\\s|$)")))
      then {hookSpecificOutput: {hookEventName: "PreToolUse",
        updatedInput: ($in + {command: ("heavy-slot take $$\n" + $c)})}}
      else empty end'
}

_tagged() {
  for _s in "$_dir"/*; do
    test -f "$_s/until" || continue
    read -r _u _t < "$_s/until" || true
    test "$_t" = "$1" && echo "$_s" && return 0
  done
  return 1
}

_lock() {
  until mkdir "$_dir/.lock" 2>/dev/null; do
    find "$_dir/.lock" -maxdepth 0 -mmin +1 -exec rmdir {} \; 2>/dev/null
    sleep 0.1
  done
}

_hold_once() {
  _lock
  _r=1
  if _s="$(_tagged "$_tag")"; then
    echo "$_until $_tag" > "$_s/until"
    _r=0
  elif _take; then
    _r=0
  fi
  rmdir "$_dir/.lock"
  return "$_r"
}

_hold() {
  _try=''
  test "$1" != --try || { _try=1; shift; }
  _until=$(( $(date +%s) + ${1:?usage: heavy-slot hold [--try] SECS TAG} ))
  _tag="${2:?usage: heavy-slot hold [--try] SECS TAG}"
  _owner=hold
  _said=''
  until _hold_once; do
    test -z "$_try" || return 1
    if test -z "$_said"; then
      echo "heavy-slot: all $_max slots held (heavy-slot ls), waiting" >&2
      _said=1
    fi
    sleep 3
  done
}

_ls() {
  for _s in "$_dir"/*; do
    test -d "$_s" || continue
    if test -f "$_s/until"; then
      read -r _u _t < "$_s/until" || true
      printf '%s\thold\t%s until %s\n' "${_s##*/}" "$_t" \
        "$(date -r "${_u:-0}" +%H:%M:%S)"
      continue
    fi
    _p="$(cat "$_s/pid" 2>/dev/null || true)"
    printf '%s\t%s\t%s\n' "${_s##*/}" "$_p" \
      "$(ps -o command= -p "$_p" 2>/dev/null | cut -c1-80)"
  done
}

case "${1:-}" in
  run) shift; _run "$@" ;;
  take) _owner="${2:?usage: heavy-slot take PID}"; _wait ;;
  hold) shift; _hold "$@" ;;
  free) _s="$(_tagged "${2:?usage: heavy-slot free TAG}")" && rm -rf "$_s" ;;
  hook) _hook ;;
  ls) _ls ;;
  *) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2; exit 1 ;;
esac
