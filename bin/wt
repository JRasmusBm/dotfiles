#!/bin/sh

set -e

if test "$(uname)" = 'Darwin'; then
  _grep='ggrep'
  _sed='gsed'
else
  _grep='grep'
  _sed='sed'
fi

_main_root() {
  _common_git="$(git rev-parse --git-common-dir)"
  dirname "$(cd "$_common_git" && pwd)"
}

_repo_name() {
  basename "$(_main_root)"
}

_order_file() {
  echo "$LOCAL_CONFIG/worktrees/$(_repo_name)"
}

_ensure_order_dir() {
  mkdir -p "$LOCAL_CONFIG/worktrees"
}

_resolve_branch_path() {
  _branch="$1"
  _root="$(_main_root)"
  _slug="$(basename "$_branch")"
  _wt_path="${_root}/.worktrees/${_slug}"

  if test -d "$_wt_path"; then
    echo "$_wt_path"
  elif test -d "${_root}/.worktrees/${_branch}"; then
    echo "${_root}/.worktrees/${_branch}"
  else
    echo "$_root"
  fi
}

# Append-only graveyard of removed worktrees. Never
# blanked — it's the searchable registry behind
# `wt resume :`. Rows: slug<TAB>branch<TAB>sha<TAB>date
_registry_file() {
  echo "$LOCAL_CONFIG/worktrees/$(_repo_name).registry"
}

_registry_append() {
  _ra_slug="$1"
  _ra_branch="$2"
  _ra_sha="$3"
  _ensure_order_dir
  printf '%s\t%s\t%s\t%s\n' \
    "$_ra_slug" "$_ra_branch" "$_ra_sha" \
    "$(date -u +%FT%TZ)" >> "$(_registry_file)"
}

_switch_to() {
  _target="$1"
  _session="$(tmux-session-name-from-path "$_target")"

  if ! (tmux list-sessions 2>/dev/null \
    | $_grep -q "$_session"); then
    cd "$_target"
    INITIATED_EXTERNALLY=false \
      source_tmux_script "$_target/.tmux" \
      || default_tmux_session
    return 0
  fi

  tmux-attach-to-session "$_session:cli" \
    || tmux-attach-to-session "$_session:vim" \
    || ta "$_session" \
    || true
}

# All worktrees under .worktrees/ (the disk is the source
# of truth), one per line as "<path>\t<branch>" — branch
# empty when detached.
_wt_worktrees() {
  _root="$(_main_root)"
  git -C "$_root" worktree list --porcelain | awk '
    /^worktree /{ p=$2; b=""; next }
    /^branch /{ b=$2; sub(/^refs\/heads\//, "", b); next }
    /^$/{ if (p ~ /\/\.worktrees\//) print p "\t" b; p=""; b="" }
    END{ if (p != "" && p ~ /\/\.worktrees\//) print p "\t" b }
  '
}

_wt_pick() {
  _root="$(_main_root)"
  _of="$(_order_file)"
  test -f "$_of" || touch "$_of"
  _tab="$(printf '\t')"

  # Show on-disk worktrees that sit under a heading (a FOO:
  # line) in the order file, prefixed with that heading.
  # Speed-dial entries (above the first heading) are hidden —
  # they're on Alt-N already. On-disk worktrees not on the
  # board show as ⊘ and can be adopted.
  _list="$( { printf '#DISK\n'; _wt_worktrees; \
    printf '#ORDER\n'; cat "$_of"; } \
    | awk -F"$_tab" '
        $0 == "#DISK"  { sec = "D"; next }
        $0 == "#ORDER" { sec = "O"; h = ""; next }
        sec == "D" {
          n = split($1, pa, "/"); dir = pa[n]
          br = $2; name = (br != "" ? br : dir)
          if (br != "") ondisk[br] = 1
          ondisk[dir] = 1
          c++; wbr[c] = br; wdir[c] = dir; wname[c] = name
          next
        }
        sec == "O" {
          # Heading: a "# Foo" or "Foo:" line.
          if ($0 ~ /^[[:space:]]*#/ || $0 ~ /:[[:space:]]*$/) {
            h = $0
            sub(/^[[:space:]]*#+[[:space:]]*/, "", h)
            sub(/:[[:space:]]*$/, "", h)
            next
          }
          if ($0 ~ /^[[:space:]]*$/) next
          seen[$0] = 1
          if (h != "" && ondisk[$0]) print h ": " $0
        }
        END {
          for (i = 1; i <= c; i++)
            if (!seen[wbr[i]] && !seen[wdir[i]])
              print "\342\212\230 " wname[i]
        }
      ')"

  # No worktrees → just open an empty fzf (no error). printf
  # (not echo) so an empty list is truly empty, not a blank row.
  _sel="$(printf '%s' "$_list" | fzf --reverse \
    --preview "wt-preview '$_root' {}" \
    --preview-window=right,55%,wrap || true)"

  test -z "$_sel" && exit 0

  case "$_sel" in
    '⊘ '*)
      # Orphan: open its session regardless, and offer to
      # adopt it onto the board.
      _name="${_sel#⊘ }"
      _target="${_root}/.worktrees/$(basename "$_name")"
      test -d "$_target" || _target="${_root}/.worktrees/$_name"
      printf 'Adopt %s onto the board? [Y/n] ' "$_name" >&2
      { read -r _ans </dev/tty || _ans=y; } 2>/dev/null
      case "${_ans:-y}" in
        n|N) : ;;
        *)
          if ! $_grep -qxF "$_name" "$_of" 2>/dev/null; then
            _of_insert "$_name" "$_of"
          fi
          ;;
      esac
      _switch_to "$_target"
      ;;
    *)
      _branch="$(echo "$_sel" | $_sed 's/^[^:]*: //')"
      _switch_to "$(_resolve_branch_path "$_branch")"
      ;;
  esac
}

_wt_edit() {
  _ensure_order_dir
  if test -n "$1"; then
    _of="$LOCAL_CONFIG/worktrees/$1"
  else
    _of="$(_order_file)"
  fi
  touch "$_of"
  ${EDITOR:-vim} "$_of"
}

# Place an entry inside the named heading's section: reuse
# the first freed (blank) slot in that section, else insert a
# new line at the section's end (before the next heading or
# EOF). Appends the heading at EOF if it doesn't exist yet.
_of_place_in_section() {
  _ps_name="$1"
  _ps_entry="$2"
  _ps_of="$3"

  _ps_head="$(awk -v want="$_ps_name" '
    /^[[:space:]]*#/ {
      h = $0
      sub(/^[[:space:]]*#+[[:space:]]*/, "", h)
      if (toupper(h) == toupper(want)) { print NR; exit }
    }' "$_ps_of")"

  if test -z "$_ps_head"; then
    printf '\n# %s\n%s\n' "$_ps_name" "$_ps_entry" >> "$_ps_of"
    return 0
  fi

  _ps_next="$(awk -v s="$_ps_head" '
    NR > s && ($0 ~ /^[[:space:]]*#/ \
      || $0 ~ /:[[:space:]]*$/) { print NR; exit }' "$_ps_of")"
  if test -z "$_ps_next"; then
    _ps_end="$(wc -l < "$_ps_of")"
  else
    _ps_end=$((_ps_next - 1))
  fi

  _ps_blank="$(awk -v a="$((_ps_head + 1))" -v b="$_ps_end" '
    NR >= a && NR <= b && /^[[:space:]]*$/ { print NR; exit }
  ' "$_ps_of")"

  if test -n "$_ps_blank"; then
    $_sed -i "${_ps_blank}c\\${_ps_entry}" "$_ps_of"
  elif test -n "$_ps_next"; then
    $_sed -i "${_ps_next}i\\${_ps_entry}" "$_ps_of"
  else
    printf '%s\n' "$_ps_entry" >> "$_ps_of"
  fi
}

# Add a board entry. Prefer a freed speed-dial slot (a blank
# line above the first heading — line 1 is the default branch,
# so skip it) so a reclaimed Alt-N slot is reused. When the
# speed-dial region is full, drop into # IN PROGRESS instead
# of spilling into a later section's blank or the file tail.
_of_insert() {
  _entry="$1"
  _of="$2"

  # First heading ends the speed-dial region.
  _head="$(awk '
    $0 ~ /^[[:space:]]*#/ || $0 ~ /:[[:space:]]*$/ {
      print NR; exit
    }' "$_of")"

  if test -z "$_head"; then
    # No sections → whole file is the speed-dial region.
    _blank="$(awk 'NR > 1 && /^[[:space:]]*$/ {print NR; exit}' \
      "$_of")"
    if test -n "$_blank"; then
      $_sed -i "${_blank}c\\${_entry}" "$_of"
    else
      echo "$_entry" >> "$_of"
    fi
    return 0
  fi

  # Reuse a freed speed-dial slot (rows 2..head-1).
  _blank="$(awk -v b="$((_head - 1))" \
    'NR > 1 && NR <= b && /^[[:space:]]*$/ {print NR; exit}' \
    "$_of")"
  if test -n "$_blank"; then
    $_sed -i "${_blank}c\\${_entry}" "$_of"
    return 0
  fi

  # Speed-dial full → append into # IN PROGRESS.
  _of_place_in_section 'IN PROGRESS' "$_entry" "$_of"
}

# Build "<type>/<initials>/<id>-<slug>" from a Linear URL,
# or "<type>/<initials>/<slug>" from free text. The Linear
# URL already carries a lowercase, hyphenated, truncated
# slug, so no API/token is needed.
_branch_from() {
  _type="$1"
  _arg="$2"
  _ini="${WT_INITIALS:-jrb}"
  case "$_arg" in
    *linear.app/*issue/*)
      _id="$(printf '%s' "$_arg" \
        | $_sed -nE 's#.*/issue/([^/]+).*#\1#p' \
        | tr '[:upper:]' '[:lower:]')"
      _slug="$(printf '%s' "$_arg" \
        | $_sed -nE 's#.*/issue/[^/]+/([^/?#]+).*#\1#p')"
      if test -n "$_slug"; then
        echo "${_type}/${_ini}/${_id}-${_slug}"
      else
        echo "${_type}/${_ini}/${_id}"
      fi
      ;;
    *)
      # Free text → slugify (lowercase, non-alnum → -, trim)
      _slug="$(printf '%s' "$_arg" \
        | tr '[:upper:]' '[:lower:]' \
        | $_sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
      echo "${_type}/${_ini}/${_slug}"
      ;;
  esac
}

# Session name a board entry resolves to. Only entries ABOVE
# the first heading are Alt-N speed-dials (see _wt_pick + the
# Worktree Workflow docs) and get the <repo>[<line>] name, so
# `wt fix`/`wt feat` and a later Alt-N share one session
# instead of spawning a duplicate. Entries at/below the first
# heading are reached via `wt :` (which names by path), so
# they fall back to the path-derived slug — as does a branch
# not on the board at all.
_speeddial_name() {
  _sn_branch="$1"
  _sn_path="$2"
  _of="$(_order_file)"
  _ln=""
  if test -f "$_of"; then
    _ln="$(awk -v b="$_sn_branch" '
      # First "# Foo" / "Foo:" line ends the speed-dial region.
      ($0 ~ /^[[:space:]]*#/ || $0 ~ /:[[:space:]]*$/) {
        if (!h) h = NR
      }
      $0 == b { ln = NR }
      END { if (ln > 1 && (!h || ln < h)) print ln }
    ' "$_of")"
  fi
  if test -n "$_ln"; then
    echo "$(_repo_name)[$_ln]"
  else
    echo "$(tmux-session-name-from-path "$_sn_path")"
  fi
}

# Open (creating if needed) the worktree's tmux session under
# the given name and, on a freshly created session with a
# prompt, kick off a Claude session in its third window
# (`cli`) preloaded with that prompt. Generic: relies on the
# default run/vim/cli layout that worktrees without a .tmux
# get from default_tmux_session. Exporting TMUX_SESSION_NAME
# is what makes the new session adopt $_session (see
# tmux-session-name-from-path).
_wt_open_with_claude() {
  _target="$1"
  _prompt="$2"
  _session="$3"
  test -n "$_session" \
    || _session="$(tmux-session-name-from-path "$_target")"

  # Build the session detached first so we can preload Claude
  # into the cli window before attaching.
  _created=false
  if ! tmux has-session -t "$_session" 2>/dev/null; then
    ( cd "$_target" \
      && TMUX_SESSION_NAME="$_session" \
         INITIATED_EXTERNALLY=true \
         source_tmux_script "$_target/.tmux" \
      || TMUX_SESSION_NAME="$_session" \
         INITIATED_EXTERNALLY=true default_tmux_session \
    ) >/dev/null 2>&1 || true
    _created=true
  fi

  if test -n "$_prompt" && test "$_created" = true; then
    tmux send-keys -t "$_session:cli" \
      "claude \"$_prompt\"" Enter 2>/dev/null || true
  fi

  tmux-attach-to-session "$_session:cli" \
    || tmux-attach-to-session "$_session:vim" \
    || ta "$_session" \
    || true
}

# `wt fix <url>` / `wt feat <url>`: derive a branch from a
# Linear URL (or description), create the worktree, then open
# it and kick off Claude on the issue. The prefix and the
# kickoff prompt both come from the command name.
_wt_typed() {
  _type="$1"
  shift
  _arg="$1"
  if test -z "$_arg"; then
    echo "Usage: wt $_type <linear-url|description>" >&2
    exit 1
  fi

  _branch="$(_branch_from "$_type" "$_arg")"
  _wt_add "$_branch"

  # Only Linear URLs get a Claude kickoff prompt; free text
  # just opens the worktree session.
  _prompt=""
  case "$_arg" in
    *linear.app/*issue/*)
      if test "$_type" = feat; then
        _prompt="Can you please read $_arg and relative feature docs? Then please grill me on the solution."
      else
        _prompt="Can you please fix $_arg? Please also examine the video and the images"
      fi
      ;;
  esac

  _root="$(_main_root)"
  _wt_path="${_root}/.worktrees/$(basename "$_branch")"
  _session="$(_speeddial_name "$_branch" "$_wt_path")"
  _wt_open_with_claude "$_wt_path" "$_prompt" "$_session"
}

_wt_add() {
  _branch="$1"
  if test -z "$_branch"; then
    echo "Usage: wt add <branch>" >&2
    exit 1
  fi

  git wc "$_branch"

  _ensure_order_dir
  _of="$(_order_file)"
  touch "$_of"

  if $_grep -qx "$_branch" "$_of" 2>/dev/null; then
    return 0
  fi

  _of_insert "$_branch" "$_of"
}

# fzf the active board, previewing PR state + last commit.
# Echoes a branch.
_pick_active_branch() {
  _of="$(_order_file)"
  if ! test -f "$_of"; then
    echo "No order file" >&2
    return 1
  fi
  _root="$(_main_root)"
  awk '/^.+$/{print}' "$_of" \
    | fzf --reverse \
        --preview "wt-preview '$_root' {}" \
        --preview-window=right,55%,wrap
}

# Evict a worktree: remove the checkout AND delete the
# branch, but pin refs/wt/<slug> + log to the registry
# FIRST so it stays fully resurrectable via `wt resume`.
# `rm`/`remove` and bare `.` all do this — only `wt forget`
# destroys the record. Heavy work is detached to the
# background so it survives the tmux kill-session.
_wt_evict_current() {
  _git_dir="$(cd "$(git rev-parse --git-dir)" && pwd)"
  _common="$(cd "$(git rev-parse --git-common-dir)" \
    && pwd)"

  if test "$_git_dir" = "$_common"; then
    echo "Not in a worktree" >&2
    exit 1
  fi

  _root="$(_main_root)"
  _branch="$(git branch --show-current)"
  _wt_path="$(git rev-parse --show-toplevel)"
  _cur_session="${TMUX_SESSION_NAME:-}"
  if test -z "$_cur_session"; then
    _cur_session="$(tmux display-message -p \
      '#{session_name}' 2>/dev/null || true)"
  fi
  cd "$_root"
  _switch_to "$_root"
  _wt_evict "$_branch" "$_wt_path" "$_cur_session"
}

_wt_evict() {
  _branch="${1:-}"
  _wt_path_arg="${2:-}"
  _session_arg="${3:-}"
  if test "$_branch" = '.'; then
    _wt_evict_current
    return
  elif test -z "$_branch" || test "$_branch" = ':'; then
    _branch="$(_pick_active_branch)"
  fi

  if test -z "$_branch"; then
    exit 0
  fi

  _root="$(_main_root)"
  if test -n "$_wt_path_arg"; then
    _wt_path="$_wt_path_arg"
  else
    _wt_path="${_root}/.worktrees/$(basename "$_branch")"
    if ! test -d "$_wt_path"; then
      _wt_path="${_root}/.worktrees/${_branch}"
    fi
  fi
  _wt_name="$(basename "$_wt_path")"
  # Key the registry + ref on the actual worktree dir — the
  # Claude-context anchor — not on the branch name.
  _slug="$_wt_name"

  # Pin the tip + register BEFORE removal so the branch is
  # resurrectable via `wt resume` after we delete it.
  _sha="$(git -C "$_root" rev-parse "$_branch" \
    2>/dev/null \
    || git -C "$_wt_path" rev-parse HEAD 2>/dev/null \
    || true)"
  if test -n "$_sha"; then
    git -C "$_root" update-ref "refs/wt/$_slug" "$_sha"
    _registry_append "$_slug" "$_branch" "$_sha"
  fi

  # Find order file line — try branch name, then
  # worktree dir name (covers worktrees where the
  # current branch differs from the added one)
  _of="$(_order_file)"
  _ln=""
  if test -f "$_of"; then
    _ln="$($_grep -nx "$_branch" "$_of" \
      | head -1 | cut -d: -f1)"
    if test -z "$_ln"; then
      _ln="$($_grep -nx "$_wt_name" "$_of" \
        | head -1 | cut -d: -f1)"
    fi
  fi

  # Compute tmux session names before removal
  _speeddial_session=""
  if test -n "$_ln"; then
    _speeddial_session="$(_repo_name)[$_ln]"
  fi
  _path_session="$_session_arg"
  if test -z "$_path_session" \
    && test -d "$_wt_path"; then
    _path_session="$(tmux-session-name-from-path \
      "$_wt_path")"
  fi

  # Free the order file slot immediately so a new
  # `wt add` can reuse the index right away
  if test -n "$_ln"; then
    $_sed -i "${_ln}s/.*//" "$_of"
  fi

  # Free the tmux speed-dial name immediately by
  # renaming — actual kill happens in the bg cleanup
  _speeddial_rename=""
  if test -n "$_speeddial_session" \
    && tmux has-session -t "$_speeddial_session" \
      2>/dev/null; then
    _speeddial_rename="_removing_$_speeddial_session"
    tmux rename-session -t "$_speeddial_session" \
      "$_speeddial_rename" 2>/dev/null \
      || _speeddial_rename=""
  fi

  # Heavy cleanup in the background, detached so it
  # survives the tmux kill-session at the end. The branch
  # is deleted — refs/wt/<slug> keeps the commit alive;
  # only `wt forget` drops that pin.
  nohup sh -c '
    wt_path="$1"
    root="$2"
    branch="$3"
    speeddial="$4"
    path_sess="$5"

    if [ -d "$wt_path" ]; then
      git worktree remove --force "$wt_path" \
        2>/dev/null || rm -rf "$wt_path"
    fi
    git -C "$root" worktree prune 2>/dev/null
    git -C "$root" branch -D "$branch" 2>/dev/null

    if [ -n "$speeddial" ]; then
      tmux kill-session -t "$speeddial" 2>/dev/null
    fi
    if [ -n "$path_sess" ] \
      && [ "$path_sess" != "$speeddial" ]; then
      tmux kill-session -t "$path_sess" 2>/dev/null
    fi
  ' sh \
    "$_wt_path" "$_root" "$_branch" \
    "${_speeddial_rename:-$_speeddial_session}" \
    "$_path_session" \
    >/dev/null 2>&1 </dev/null &
}

# Move a board entry into a named section: blank its old slot
# (freeing it — blank, not delete, so indices stay stable) and
# drop it into the section via _of_place_in_section.
_move_to_section() {
  _ms_section="$1"
  _ms_entry="$2"
  _ms_oldln="$3"
  _ms_of="$4"

  if test -n "$_ms_oldln"; then
    $_sed -i "${_ms_oldln}s/.*//" "$_ms_of"
  fi
  _of_place_in_section "$_ms_section" "$_ms_entry" "$_ms_of"
}

# Park the current worktree under a review section ($1, e.g.
# "TEAM REVIEW" / "PROD REVIEW"): move its board entry there
# (freeing the speed-dial slot) and kill its tmux session —
# WITHOUT removing the checkout or branch. The PR is still
# open; this just reclaims a speed-dial slot + session for new
# tickets. Reachable later via `wt :`.
_wt_review() {
  _section="$1"
  _git_dir="$(cd "$(git rev-parse --git-dir)" && pwd)"
  _common="$(cd "$(git rev-parse --git-common-dir)" \
    && pwd)"
  if test "$_git_dir" = "$_common"; then
    echo "Not in a worktree" >&2
    exit 1
  fi

  _root="$(_main_root)"
  _branch="$(git branch --show-current)"
  _wt_path="$(git rev-parse --show-toplevel)"
  _wt_name="$(basename "$_wt_path")"
  _cur_session="${TMUX_SESSION_NAME:-}"
  if test -z "$_cur_session"; then
    _cur_session="$(tmux display-message -p \
      '#{session_name}' 2>/dev/null || true)"
  fi

  _ensure_order_dir
  _of="$(_order_file)"
  touch "$_of"

  # Locate the current entry (branch, then worktree dir name).
  _ln="$($_grep -nx "$_branch" "$_of" | head -1 | cut -d: -f1)"
  if test -z "$_ln"; then
    _ln="$($_grep -nx "$_wt_name" "$_of" \
      | head -1 | cut -d: -f1)"
  fi
  _entry="$_branch"
  if test -n "$_ln"; then
    _entry="$($_sed -n "${_ln}p" "$_of")"
  fi

  # Session names to reclaim.
  _speeddial_session=""
  if test -n "$_ln"; then
    _speeddial_session="$(_repo_name)[$_ln]"
  fi
  _path_session="$(tmux-session-name-from-path "$_wt_path")"

  # Move the entry into the chosen review section.
  _move_to_section "$_section" "$_entry" "$_ln" "$_of"

  # Rename the speed-dial session right away so a new ticket
  # taking this freed slot doesn't attach to the dying one.
  _speeddial_rename=""
  if test -n "$_speeddial_session" \
    && tmux has-session -t "$_speeddial_session" \
      2>/dev/null; then
    _speeddial_rename="_review_$_speeddial_session"
    tmux rename-session -t "$_speeddial_session" \
      "$_speeddial_rename" 2>/dev/null \
      || _speeddial_rename=""
  fi

  # Hop the client to root before killing our own session.
  cd "$_root"
  _switch_to "$_root"

  # Kill the worktree's sessions in the background, detached
  # so it survives this pane closing. Checkout + branch stay.
  nohup sh -c '
    speeddial="$1"
    path_sess="$2"
    cur="$3"
    for s in "$speeddial" "$path_sess" "$cur"; do
      [ -n "$s" ] && tmux kill-session -t "$s" 2>/dev/null
    done
  ' sh \
    "${_speeddial_rename:-$_speeddial_session}" \
    "$_path_session" "$_cur_session" \
    >/dev/null 2>&1 </dev/null &
}

_wt_move() {
  _branch="${1:-$(git branch --show-current)}"
  _root="$(_main_root)"
  _wt_path="${_root}/.worktrees/$(basename "$_branch")"

  # Don't move the default branch
  _default="$(git -C "$_root" symbolic-ref \
    refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's|refs/remotes/origin/||')"
  _default="${_default:-main}"
  if test "$_branch" = "$_default"; then
    echo "Can't move the default branch" >&2
    exit 1
  fi

  # Stash if dirty
  _has_stash=false
  if ! git diff --quiet 2>/dev/null \
    || ! git diff --cached --quiet 2>/dev/null; then
    git stash
    _has_stash=true
  fi

  # Switch current checkout to default branch
  _default="$(git -C "$_root" symbolic-ref \
    refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's|refs/remotes/origin/||')"
  _default="${_default:-main}"
  git switch "$_default"

  # Create worktree with existing branch (no -b)
  git worktree add "$_wt_path" "$_branch"

  # Add to order file
  _ensure_order_dir
  _of="$(_order_file)"
  touch "$_of"
  if ! $_grep -qx "$_branch" "$_of" 2>/dev/null; then
    _of_insert "$_branch" "$_of"
  fi

  # Pop stash in new worktree if we stashed
  if test "$_has_stash" = true; then
    git -C "$_wt_path" stash pop
  fi
}

# Re-materialise a removed worktree at its deterministic
# path so `claude -r` finds the same context. No arg or
# `:` opens the registry (the graveyard) in fzf.
_wt_resume() {
  _arg="${1:-:}"
  _root="$(_main_root)"
  _rf="$(_registry_file)"

  if test "$_arg" = ':'; then
    if ! test -f "$_rf"; then
      echo "Nothing removed yet (empty registry)" >&2
      exit 1
    fi
    # Reverse to newest-first, keep one row per slug.
    _sel="$(awk -F'\t' '
      { a[NR] = $0 }
      END {
        for (i = NR; i >= 1; i--) {
          split(a[i], f, "\t")
          if (!seen[f[1]]++) print a[i]
        }
      }' "$_rf" \
      | fzf --reverse --delimiter='\t' --with-nth=1,2,4 \
          --preview "git -C '$_root' log -1 --stat \
            'refs/wt/'{1} 2>/dev/null" \
          --preview-window=right,55%,wrap)"
    test -z "$_sel" && exit 0
    _slug="$(printf '%s' "$_sel" | cut -f1)"
    _branch="$(printf '%s' "$_sel" | cut -f2)"
  else
    _slug="$(basename "$_arg")"
    _branch=""
    if test -f "$_rf"; then
      _branch="$($_grep -P "^$_slug\t" "$_rf" \
        | tail -1 | cut -f2)"
    fi
    test -z "$_branch" && _branch="$_arg"
  fi

  # Resume IS `wt add` from the pinned tip: same `git wc`
  # call, so the worktree lands at its original path and the
  # Claude context (keyed by that path) is right there.
  _wt_path="${_root}/.worktrees/$(basename "$_branch")"
  if test -d "$_wt_path"; then
    echo "Worktree exists; switching" >&2
    _switch_to "$_wt_path"
    return 0
  fi

  _start=""
  if git -C "$_root" show-ref --verify --quiet \
      "refs/wt/$_slug"; then
    _start="refs/wt/$_slug"
  fi
  if test -z "$_start" && ! git -C "$_root" show-ref \
      --verify --quiet "refs/heads/$_branch"; then
    echo "No ref to resume $_slug ($_branch)" >&2
    exit 1
  fi

  git wc "$_branch" $_start

  # Put it back on the active board (same as `wt add`)
  _ensure_order_dir
  _of="$(_order_file)"
  touch "$_of"
  if ! $_grep -qx "$_branch" "$_of" 2>/dev/null; then
    _of_insert "$_branch" "$_of"
  fi

  _switch_to "$_wt_path"
}

# Hard-forget a slug: drop branch + refs/wt/<slug> so it
# leaves the registry's resurrectable set. The Claude
# context dir is intentionally left intact.
_wt_forget() {
  _arg="$1"
  if test -z "$_arg"; then
    echo "Usage: wt forget <slug>" >&2
    exit 1
  fi
  _slug="$(basename "$_arg")"
  _root="$(_main_root)"
  _rf="$(_registry_file)"
  _branch="$_arg"
  if test -f "$_rf"; then
    _b="$($_grep -P "^$_slug\t" "$_rf" \
      | tail -1 | cut -f2)"
    test -n "$_b" && _branch="$_b"
  fi

  _wt_path="${_root}/.worktrees/${_slug}"
  if test -d "$_wt_path"; then
    git -C "$_root" worktree remove --force "$_wt_path" \
      2>/dev/null || rm -rf "$_wt_path"
    git -C "$_root" worktree prune 2>/dev/null
  fi
  git -C "$_root" branch -D "$_branch" 2>/dev/null || true
  git -C "$_root" update-ref -d \
    "refs/wt/$_slug" 2>/dev/null || true
  _registry_append "$_slug" "$_branch" "PURGED"
  echo "Forgot $_slug (Claude context left intact)" >&2
}

# Reclaim disk on existing worktrees by reinstalling so
# Yarn relinks node_modules into the hardlinks-global
# store. Run once after enabling nmMode.
_wt_dedup() {
  _root="$(_main_root)"
  _wt_dir="${_root}/.worktrees"
  if ! test -d "$_wt_dir"; then
    echo "No worktrees" >&2
    exit 0
  fi

  # Collect worktrees with a package.json, then reinstall up
  # to 8 at once. (Guard the list — macOS xargs runs once on
  # empty input.)
  _list="$(for _d in "$_wt_dir"/*/; do
    test -d "$_d" || continue
    test -f "${_d}package.json" || continue
    printf '%s\n' "$_d"
  done)"
  if test -z "$_list"; then
    echo "No worktrees to dedup" >&2
    exit 0
  fi

  printf '%s\n' "$_list" | xargs -P 8 -I {} sh -c '
    d="$1"
    echo ">> yarn install: $d" >&2
    ( cd "$d" && yarn install ) >/dev/null 2>&1 \
      && echo "   done: $d" >&2 \
      || echo "   FAILED: $d" >&2
  ' sh {}
}

# Remove every active worktree whose PR is merged. Confirms
# each (read from /dev/tty); `-f`/`--force` skips prompts.
# Needs gh. Safe to run — removal is reversible via resume.
_wt_clean() {
  _force=false
  case "${1:-}" in
    -f|--force) _force=true ;;
  esac

  if ! command -v gh >/dev/null 2>&1; then
    echo "wt clean needs the gh CLI" >&2
    exit 1
  fi
  _root="$(_main_root)"
  _tab="$(printf '\t')"

  # Source from disk so orphans are included, not just the
  # board. Detached worktrees (no branch) can't be PR-checked.
  _branches="$(_wt_worktrees | cut -f2 | $_grep -v '^$' \
    || true)"
  if test -z "$_branches"; then
    echo "No worktrees" >&2
    return 0
  fi

  echo "Checking PR state of worktrees..." >&2
  # Fan out the gh lookups (8 at a time); each prints its
  # branch only if its PR is merged.
  _merged="$(printf '%s\n' "$_branches" \
    | xargs -P 8 -I {} sh -c '
        root="$1"
        b="$2"
        st="$( (cd "$root" && gh pr view "$b" \
          --json state -q .state 2>/dev/null) || true )"
        if test "$st" = MERGED; then echo "$b"; fi
      ' sh "$_root" {} || true)"

  if test -z "$_merged"; then
    echo "No merged worktrees to remove." >&2
    return 0
  fi
  printf 'merged: %s\n' $_merged >&2

  for _b in $_merged; do
    # Pass the real path so eviction works for orphans whose
    # dir name differs from basename(branch).
    _p="$(_wt_worktrees \
      | awk -F"$_tab" -v b="$_b" '$2==b{print $1; exit}')"
    if test "$_force" = true; then
      echo "removing $_b" >&2
      _wt_evict "$_b" "$_p"
    else
      printf 'Remove merged worktree %s? [y/N] ' "$_b" >&2
      { read _ans </dev/tty || _ans=n; } 2>/dev/null
      case "$_ans" in
        y|Y) _wt_evict "$_b" "$_p" ;;
        *) echo "  skipped $_b" >&2 ;;
      esac
    fi
  done
}

_usage() {
  echo "Usage: wt [.|:|add|fix|feat|rt|rp|rm|clean|resume|forget|dedup|move|e]" >&2
}

case "${1:-}" in
  "") _usage; exit 1 ;;
  :) _wt_pick ;;
  .) _wt_evict . ;;
  e|edit) shift; _wt_edit "$@" ;;
  add) shift; _wt_add "$@" ;;
  fix) shift; _wt_typed fix "$@" ;;
  feat) shift; _wt_typed feat "$@" ;;
  rt) _wt_review 'TEAM REVIEW' ;;
  rp) _wt_review 'PROD REVIEW' ;;
  rm|remove) shift; _wt_evict "$@" ;;
  clean) shift; _wt_clean "$@" ;;
  resume) shift; _wt_resume "$@" ;;
  forget) shift; _wt_forget "$@" ;;
  dedup) _wt_dedup ;;
  move) shift; _wt_move "$@" ;;
  *)
    _usage
    exit 1
    ;;
esac
