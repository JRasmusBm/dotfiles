#!/bin/sh

set -e

if test "$(uname)" = 'Darwin'; then
  _grep='ggrep'
  _sed='gsed'
else
  _grep='grep'
  _sed='sed'
fi

_main_root() {
  _common_git="$(git rev-parse --git-common-dir)"
  dirname "$(cd "$_common_git" && pwd)"
}

_repo_name() {
  basename "$(_main_root)"
}

# The board of the repo at main root $1 (default: this one).
_order_file() {
  echo "$LOCAL_CONFIG/worktrees/$(basename "${1:-$(_main_root)}")"
}

_default_branch() {
  _db="$(git -C "$(_main_root)" symbolic-ref \
    refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's|refs/remotes/origin/||')"
  echo "${_db:-main}"
}

_ensure_order_dir() {
  mkdir -p "$LOCAL_CONFIG/worktrees"
}

# Append-only graveyard of removed worktrees. Never
# blanked — it's the searchable registry behind
# `wt resume :`. Rows: slug<TAB>branch<TAB>sha<TAB>date
# [<TAB>left]: the board section it was removed from, or
# Done/Canceled for `wt done`/`cancel`; resume puts it back there.
# Board line of a worktree: its current branch, else its dir
# name, else a row whose last path part is the dir name — the
# dir is the stable anchor when the branch was switched after
# `wt add` (row fix/jrb/x, dir x, branch fix/jrb/y).
_board_line() {
  _bl="$($_grep -nx "$2" "$1" | head -1 | cut -d: -f1)"
  test -n "$_bl" || _bl="$($_grep -nx "$3" "$1" | head -1 | cut -d: -f1)"
  test -n "$_bl" || _bl="$(awk -v n="$3" '
    { b = $0; sub(/.*\//, "", b) } b == n { print NR; exit }' "$1")"
  echo "$_bl"
}

_registry_file() {
  echo "$LOCAL_CONFIG/worktrees/$(_repo_name).registry"
}

# Let the repo react to a worktree arriving or leaving (e.g. free its
# ports on rm): its trusted .jrb/wt-hook <event> <slug> (jrb-hook).
_repo_hook() {
  jrb-hook "$(_main_root)" "$@" || true
}

# Who blocks whom: slug<TAB>branch<TAB>blocker-slug, one row
# per blocked worktree.
_blocked_file() {
  echo "$LOCAL_CONFIG/worktrees/$(_repo_name).blocked"
}

_block_drop() {
  _nf_drop "$1"
  _bf="$(_blocked_file)"
  test -f "$_bf" || return 0
  awk -F '\t' -v s="$1" '$1 != s' "$_bf" | sponge "$_bf"
}

# Worktrees parked by `wt fx`: slug<TAB>branch<TAB>what I must do,
# one row each. notif ranks their pings last, wt-preview shows it.
_nf_file() {
  echo "$LOCAL_CONFIG/worktrees/$(_repo_name).needsfocus"
}

_nf_drop() {
  _nf="$(_nf_file)"
  test -f "$_nf" || return 0
  awk -F '\t' -v s="$1" '$1 != s' "$_nf" | sponge "$_nf"
}

# When each snoozed worktree comes back, and to which board section:
# slug<TAB>branch<TAB>date (YYYY-MM-DD[THH:MM])<TAB>section<TAB>start
# <TAB>main checkout, one row each. wt-sync reads the checkout to run
# `wt wake` there, so a repo outside its list wakes too.
_snoozed_file() {
  echo "$LOCAL_CONFIG/worktrees/$(_repo_name).snoozed"
}

# The board section (heading) <branch>/<dir> sits under; empty if
# it isn't on the board.
_board_section() {
  _bs_of="$(_order_file)"
  _bs_ln="$(_board_line "$_bs_of" "$1" "$2")"
  test -n "$_bs_ln" || return 0
  awk -v n="$_bs_ln" '
    NR > n { exit }
    /^[[:space:]]*#/ || /:[[:space:]]*$/ {
      h = $0
      sub(/^[[:space:]]*#+[[:space:]]*/, "", h)
      sub(/:[[:space:]]*$/, "", h)
    }
    END { print h }' "$_bs_of"
}

# Whether the board still has a heading named $1.
_board_has_section() {
  awk -v want="$1" '
    /^[[:space:]]*#/ || /:[[:space:]]*$/ {
      h = $0
      sub(/^[[:space:]]*#+[[:space:]]*/, "", h)
      sub(/:[[:space:]]*$/, "", h)
      if (toupper(h) == toupper(want)) f = 1
    }
    END { exit !f }' "$(_order_file)"
}

# What each waiting worktree waits on and until when (`wt w8`):
# slug<TAB>branch<TAB>deadline (YYYY-MM-DDTHH:MM)<TAB>what<TAB>start
# <TAB>main checkout. wt-sync reads the checkout to tell the agent at
# the deadline, so a repo outside its list is told too.
_waiting_file() {
  echo "$LOCAL_CONFIG/worktrees/$(_repo_name).waiting"
}

_w8_drop() {
  _wf="$(_waiting_file)"
  test -f "$_wf" || return 0
  awk -F '\t' -v s="$1" '$1 != s' "$_wf" | sponge "$_wf"
}

_snooze_drop() {
  _sf="$(_snoozed_file)"
  test -f "$_sf" || return 0
  awk -F '\t' -v s="$1" '$1 != s' "$_sf" | sponge "$_sf"
}

# Read a human date ("monday", "tomorrow", "+3 days", "2026-10-19")
# as YYYY-MM-DD, or a time ("+3 hours", "15:00", "tomorrow 9am")
# as YYYY-MM-DDTHH:MM; empty when it is not a date.
_snooze_date() {
  _sd=''
  _sd_fmt=+%F
  if echo "$1" | grep -Eiq 'hour|min|noon|[0-9] ?(am|pm)|[0-9]:[0-9]'; then
    _sd_fmt=+%FT%H:%M
  fi
  if command -v gdate >/dev/null 2>&1; then
    _sd="$(gdate -d "$1" "$_sd_fmt" 2>/dev/null || true)"
  fi
  test -n "$_sd" || _sd="$(date -d "$1" "$_sd_fmt" 2>/dev/null || true)"
  echo "$_sd"
}

# Move the board entry of <branch>/<dir> into <section>.
_board_move() {
  _ensure_order_dir
  _bm_of="$(_order_file)"
  touch "$_bm_of"
  _bm_ln="$(_board_line "$_bm_of" "$1" "$2")"
  _bm_entry="$1"
  if test -n "$_bm_ln"; then
    _bm_entry="$($_sed -n "${_bm_ln}p" "$_bm_of")"
  fi
  _of_drop_line "$_bm_ln" "$_bm_of"
  _of_place_in_section "$3" "$_bm_entry" "$_bm_of"
  echo "wt: $_bm_entry → # $3" >&2
  tmux refresh-client -S 2>/dev/null || true
}

# Clear the notification inbox for a worktree.
_notif_clear() {
  case "$1" in
    */.worktrees/?*) notif seen-path "$1" >/dev/null 2>&1 || true ;;
  esac
}

# Move <branch>'s Linear ticket to state $1, if it has one.
# Fails only when there is a ticket and Linear wasn't updated.
_linear() {
  _li_id="$(lin id "$2" 2>/dev/null)" || return 0
  lin state "$1" "$_li_id" && return 0
  echo "wt: Linear not updated" >&2
  return 1
}

# The blocker went away (or merged, $2): send what it blocked
# back to # IN PROGRESS and tell its agent (wt-tell: idle Claude, a
# session that isn't running is started; else wt-sync retries).
_unblock_dependents() {
  _ud_why="${2:-is gone}"
  _bf="$(_blocked_file)"
  test -f "$_bf" || return 0
  awk -F '\t' -v b="$1" '$3 == b { print $1 "\t" $2 }' "$_bf" \
    | while IFS="$(printf '\t')" read -r _ud_slug _ud_branch; do
      echo "wt: $1 $_ud_why, unblocking $_ud_slug" >&2
      _snooze_drop "$_ud_slug"
      _board_move "$_ud_branch" "$_ud_slug" 'IN PROGRESS'
      _linear 'In Progress' "$_ud_branch" || true
      _ud_root="$(_main_root)/.worktrees/$_ud_slug"
      _ud_ping="Unblocked: $_ud_slug ($1 $_ud_why; back in progress)"
      _ud_msg="$1 $_ud_why, which unblocks this worktree. Before you \
carry on, double-check your assumptions: look for what changed in this \
PR and ticket since the work began (new comments, scope, reviews, \
commits on the base), and how that affects what you planned."
      # Not delivered now (busy, or its session just started): wt-sync
      # keeps trying (wt-unblocked), like any other tell.
      wt-tell "$_ud_root" "unblocked:$1" "$_ud_ping" "$_ud_msg" \
        >/dev/null 2>&1 \
        || printf '%s\t%s\t%s\t%s\t%s\n' "$_ud_root" "unblocked:$1" \
          "$_ud_ping" "$_ud_msg" "$(date +%s)" \
          >> "${LOCAL_CONFIG:?}/wt-unblocked"
    done
  awk -F '\t' -v b="$1" '$3 != b && $1 != b' "$_bf" | sponge "$_bf"
}

# A snoozed worktree whose date or time has arrived goes back to the
# section it was snoozed from (else # IN PROGRESS) and gets a ping in
# its notification inbox. Runs on every wt invocation, and wt-sync
# (launchd, every minute, back after a reboot) runs `wt wake` in each
# repo, so a timed snooze fires within a minute of its time.
_wt_wake() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  _sf="$(_snoozed_file)"
  test -f "$_sf" || return 0
  _now="$(date +%FT%H:%M)"
  # A date without a time wakes at 08:00, not at midnight (wt-sync
  # wakes every minute).
  _due_aw='{ d = $3; if (d !~ /T/) d = d "T08:00" }'
  _due="$(awk -F '\t' -v t="$_now" "$_due_aw d <= t" "$_sf")"
  test -n "$_due" || return 0
  awk -F '\t' -v t="$_now" "$_due_aw d > t" "$_sf" | sponge "$_sf"
  echo "$_due" \
    | while IFS="$(printf '\t')" read -r \
      _wk_slug _wk_branch _wk_date _wk_sec _wk_from _; do
      test -n "$_wk_slug" || continue
      _wk_date="$(echo "$_wk_date" | tr T ' ')"
      echo "wt: $_wk_slug was snoozed until $_wk_date — waking it" >&2
      test -n "$_wk_sec" && _board_has_section "$_wk_sec" \
        || _wk_sec='IN PROGRESS'
      _board_move "$_wk_branch" "$_wk_slug" "$_wk_sec"
      _wk_pane="$(tmux display-message -p -t "=$_wk_slug:cli" \
        '#{pane_id}' 2>/dev/null || true)"
      _wk_woke="$(date '+%F %H:%M')"
      _wk_when=""
      test -z "$_wk_from" \
        || _wk_when="$(gdate -d "@$_wk_from" '+%F %H:%M')"
      _wk_root="$(_main_root)/.worktrees/$_wk_slug"
      _wk_ping="Awake: $_wk_slug (snoozed${_wk_when:+ $_wk_when}; \
back in $_wk_sec)"
      _wk_msg="You were snoozed${_wk_when:+ on $_wk_when} and woke \
$_wk_woke. Before you carry on, double-check your assumptions: look for \
what changed in this PR and ticket since you were snoozed, and how that \
affects what you planned."
      # Retried by wt-sync (wt-unblocked) when not delivered right away.
      wt-tell "$_wk_root" "awake:$_wk_slug:${_wk_from:-$(date +%s)}" \
        "$_wk_ping" "$_wk_msg" >/dev/null 2>&1 \
        || printf '%s\t%s\t%s\t%s\t%s\n' "$_wk_root" \
          "awake:$_wk_slug:${_wk_from:-$(date +%s)}" "$_wk_ping" \
          "$_wk_msg" "$(date +%s)" >> "${LOCAL_CONFIG:?}/wt-unblocked"
    done
}

_registry_append() {
  _ra_slug="$1"
  _ra_branch="$2"
  _ra_sha="$3"
  _ensure_order_dir
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$_ra_slug" "$_ra_branch" "$_ra_sha" \
    "$(date -u +%FT%TZ)" "${4:--}" >> "$(_registry_file)"
}

# True when a person is looking at the pane wt runs from: outside
# tmux (a plain terminal), or inside a session some client views.
# An agent's pane in a session nobody views fails it, so wt never
# switches a client from there: tmux would move the most recent
# client, i.e. me, wherever I am.
_viewed() {
  test -z "${TMUX:-}" && return 0
  _vs="$(tmux display-message -p -t "${TMUX_PANE:-}" \
    '#{session_name}' 2>/dev/null)"
  test -n "$(tmux list-clients -t "=$_vs" 2>/dev/null)"
}

_switch_to() {
  _viewed || return 0
  _target="$1"
  _session="$(tmux-session-name-from-path "$_target")"

  if ! (tmux list-sessions 2>/dev/null \
    | $_grep -q "$_session"); then
    cd "$_target"
    INITIATED_EXTERNALLY=false \
      source_tmux_script "$_target/.tmux" \
      || default_tmux_session
    return 0
  fi

  tmux-attach-to-session "$_session:cli" \
    || tmux-attach-to-session "$_session:vim" \
    || ta "$_session" \
    || true
}

# All worktrees under .worktrees/ (the disk is the source
# of truth), one per line as "<path>\t<branch>" — branch
# empty when detached. $1: another repo's main root.
_wt_worktrees() {
  _root="${1:-$(_main_root)}"
  git -C "$_root" worktree list --porcelain | awk '
    /^worktree /{ p=$2; b=""; next }
    /^branch /{ b=$2; sub(/^refs\/heads\//, "", b); next }
    /^$/{ if (p ~ /\/\.worktrees\//) print p "\t" b; p=""; b="" }
    END{ if (p != "" && p ~ /\/\.worktrees\//) print p "\t" b }
  '
}

# "<path>\t<branch>" of the worktree a branch or dir names.
_wt_match() {
  _wt_worktrees | awk -F '\t' -v a="$1" '
    BEGIN { n = a; sub(/.*\//, "", n) }
    { d = $1; sub(/.*\//, "", d) }
    $2 == a || d == a || d == n { print; exit }'
}

# Repos `wt :` lists together. $WT_GROUP holds `:`-separated
# entries, each a repo path or `label=path` (label defaults to the
# main checkout's dir name). It applies only when the current repo
# is one of them; else the picker lists this repo alone, unlabelled.
# One "<main root>\t<label>" row per repo, the current repo first.
_wt_group() {
  _g_here="$(cd "$(_main_root)" && pwd -P)"
  printf '%s\n' "${WT_GROUP:-}" | tr ':' '\n' \
    | while IFS= read -r _g_e; do
        test -n "$_g_e" || continue
        # A label is what precedes the first `=`, unless that holds a /.
        _g_l="${_g_e%%=*}"
        case "$_g_l" in
          (*/*|"$_g_e") _g_l=""; _g_p="$_g_e" ;;
          (*) _g_p="${_g_e#*=}" ;;
        esac
        case "$_g_p" in ('~'/*) _g_p="$HOME/${_g_p#'~'/}" ;; esac
        if ! _g_c="$(git -C "$_g_p" rev-parse --path-format=absolute \
          --git-common-dir 2>/dev/null)"; then
          echo "wt: WT_GROUP: no repo at $_g_p, skipped" >&2
          continue
        fi
        _g_p="$(cd "$(dirname "$_g_c")" && pwd -P)" || continue
        printf '%s\t%s\n' "$_g_p" "${_g_l:-${_g_p##*/}}"
      done \
    | awk -F '\t' -v h="$_g_here" -v m="$(_main_root)" '
        seen[$1]++ { next }
        $1 == h { print; f = 1; next }
        { o[++n] = $0 }
        END {
          if (!f) { print m "\t"; exit }
          for (i = 1; i <= n; i++) print o[i]
        }'
}

# Picker rows of one repo: "<root>\t<line>\t<label: line>", where
# <line> is what `wt open`/wt-preview take. On-disk worktrees on the
# board show prefixed with their heading (a FOO: line); on-disk
# worktrees not on the board show as ⊘ and can be adopted.
_wt_pick_rows() {
  _pr_root="$1"
  _tab="$(printf '\t')"
  { printf '#DISK\n'
    _wt_worktrees "$_pr_root"
    printf '#ORDER\n'
    cat "$(_order_file "$_pr_root")" 2>/dev/null || true
  } | awk -F"$_tab" -v root="$_pr_root" -v lbl="$2" '
        function row(l) {
          print root "\t" l "\t" (lbl != "" ? lbl ": " : "") l
        }
        $0 == "#DISK"  { sec = "D"; next }
        $0 == "#ORDER" { sec = "O"; h = ""; next }
        sec == "D" {
          n = split($1, pa, "/"); dir = pa[n]
          br = $2; name = (br != "" ? br : dir)
          if (br != "") ondisk[br] = 1
          ondisk[dir] = 1
          c++; wbr[c] = br; wdir[c] = dir; wname[c] = name
          next
        }
        sec == "O" {
          # Heading: a "# Foo" or "Foo:" line.
          if ($0 ~ /^[[:space:]]*#/ || $0 ~ /:[[:space:]]*$/) {
            h = $0
            sub(/^[[:space:]]*#+[[:space:]]*/, "", h)
            sub(/:[[:space:]]*$/, "", h)
            next
          }
          if ($0 ~ /^[[:space:]]*$/) next
          n = split($0, ra, "/"); rdir = ra[n]
          seen[$0] = 1; seen[rdir] = 1
          if (ondisk[$0] || ondisk[rdir])
            row((h != "" ? h ": " : "") $0)
        }
        END {
          for (i = 1; i <= c; i++)
            if (!seen[wbr[i]] && !seen[wdir[i]])
              row("\342\212\230 " wname[i])
        }
      '
}

_wt_pick() {
  _list="$(_wt_group | while IFS="$(printf '\t')" read -r _r _l; do
    _wt_pick_rows "$_r" "$_l"
  done)"

  # No worktrees → just open an empty fzf (no error). printf
  # (not echo) so an empty list is truly empty, not a blank row.
  # --exact: each space-separated term is a literal substring
  # (so `pause rel` hits dev-stack-pause-release), not a
  # char-by-char fuzzy match across the whole branch name.
  # Only the labelled line shows and is searched; the repo root and
  # bare line ride along for the preview and the pick.
  _sel="$(printf '%s' "$_list" | fzf --reverse --exact \
    --delimiter="$(printf '\t')" --with-nth=3 \
    --preview 'wt-preview {1} {2}' \
    --preview-window=right,55%,wrap || true)"

  test -z "$_sel" && exit 0

  # The rest runs in the picked row's repo, which may not be this one.
  cd "$(printf '%s' "$_sel" | cut -f1)"
  _of="$(_order_file)"
  test -f "$_of" || touch "$_of"
  _sel="$(printf '%s' "$_sel" | cut -f2)"
  case "$_sel" in
    '⊘ '*)
      # Orphan: open its session regardless, and offer to
      # adopt it onto the board.
      _name="${_sel#⊘ }"
      _target="$(_wt_match "$_name" | cut -f1)"
      printf 'Adopt %s onto the board? [Y/n] ' "$_name" >&2
      { read -r _ans </dev/tty || _ans=y; } 2>/dev/null
      case "${_ans:-y}" in
        n|N) : ;;
        *)
          if ! $_grep -qxF "$_name" "$_of" 2>/dev/null; then
            _of_insert "$_name" "$_of"
          fi
          ;;
      esac
      _wt_open_with_claude "$_target" ""
      ;;
    *)
      _wt_open "$(echo "$_sel" | $_sed 's/^[^:]*: //')"
      ;;
  esac
}

_wt_edit() {
  _ensure_order_dir
  if test -n "$1"; then
    _of="$LOCAL_CONFIG/worktrees/$1"
  else
    _of="$(_order_file)"
  fi
  touch "$_of"
  ${EDITOR:-vim} "$_of"
}

# Drop a removed/moved entry's row from the board.
_of_drop_line() {
  test -n "$1" || return 0
  $_sed -i "${1}d" "$2"
}

# Place an entry inside the named heading's section: reuse
# the first freed (blank) slot in that section, else insert a
# new line at the section's end (before the next heading or
# EOF). Appends the heading at EOF if it doesn't exist yet.

_of_place_in_section() {
  _ps_name="$1"
  _ps_entry="$2"
  _ps_of="$3"

  _ps_head="$(awk -v want="$_ps_name" '
    /^[[:space:]]*#/ {
      h = $0
      sub(/^[[:space:]]*#+[[:space:]]*/, "", h)
      if (toupper(h) == toupper(want)) { print NR; exit }
    }' "$_ps_of")"

  if test -z "$_ps_head"; then
    printf '\n# %s\n%s\n' "$_ps_name" "$_ps_entry" >> "$_ps_of"
    return 0
  fi

  _ps_next="$(awk -v s="$_ps_head" '
    NR > s && ($0 ~ /^[[:space:]]*#/ \
      || $0 ~ /:[[:space:]]*$/) { print NR; exit }' "$_ps_of")"
  if test -z "$_ps_next"; then
    _ps_end="$(wc -l < "$_ps_of")"
  else
    _ps_end=$((_ps_next - 1))
  fi

  _ps_blank="$(awk -v a="$((_ps_head + 1))" -v b="$_ps_end" '
    NR >= a && NR <= b && /^[[:space:]]*$/ { print NR; exit }
  ' "$_ps_of")"

  if test -n "$_ps_blank"; then
    $_sed -i "${_ps_blank}c\\${_ps_entry}" "$_ps_of"
  elif test -n "$_ps_next"; then
    $_sed -i "${_ps_next}i\\${_ps_entry}" "$_ps_of"
  else
    printf '%s\n' "$_ps_entry" >> "$_ps_of"
  fi
}

# Add a board entry to # IN PROGRESS.
_of_insert() {
  _of_place_in_section 'IN PROGRESS' "$1" "$2"
}

# Build "<type>/<initials>/<id>-<slug>" from a Linear issue
# URL, "<type>/<initials>/<slug>" from a project URL (its
# trailing 12-hex slug id dropped) or from free text. The
# Linear URL already carries a lowercase, hyphenated slug,
# so no API/token is needed.
_branch_from() {
  _type="$1"
  _arg="$2"
  _ini="${WT_INITIALS:-jrb}"
  case "$_arg" in
    *linear.app/*issue/*)
      _id="$(printf '%s' "$_arg" \
        | $_sed -nE 's#.*/issue/([^/]+).*#\1#p' \
        | tr '[:upper:]' '[:lower:]')"
      _slug="$(printf '%s' "$_arg" \
        | $_sed -nE 's#.*/issue/[^/]+/([^/?#]+).*#\1#p')"
      if test -n "$_slug"; then
        echo "${_type}/${_ini}/${_id}-${_slug}"
      else
        echo "${_type}/${_ini}/${_id}"
      fi
      ;;
    *linear.app/*project/*)
      _slug="$(printf '%s' "$_arg" \
        | $_sed -nE 's#.*/project/([^/?#]+).*#\1#p' \
        | $_sed -E 's/-[0-9a-f]{12}$//')"
      echo "${_type}/${_ini}/${_slug}"
      ;;
    *)
      # Free text → slugify (lowercase, non-alnum → -, trim)
      _slug="$(printf '%s' "$_arg" \
        | tr '[:upper:]' '[:lower:]' \
        | $_sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
      echo "${_type}/${_ini}/${_slug}"
      ;;
  esac
}

# Open (creating if needed) the worktree's tmux session under
# the given name and, on a freshly created session with a
# prompt, kick off a Claude session in its third window
# (`cli`) preloaded with that prompt. $WT_PROMPT_EXTRA is
# appended to the prompt; $WT_NO_ATTACH skips the attach
# (batch kickoffs from a script). Generic: relies on the
# default run/vim/cli layout that worktrees without a .tmux
# get from default_tmux_session. Exporting TMUX_SESSION_NAME
# is what makes the new session adopt $_session (see
# tmux-session-name-from-path).
_wt_open_with_claude() {
  _target="$1"
  _prompt="$2"
  _session="$3"
  test -n "$_session" \
    || _session="$(tmux-session-name-from-path "$_target")"

  # Build the session detached first so we can preload Claude
  # into the cli window before attaching.
  _created=false
  if ! tmux has-session -t "$_session" 2>/dev/null; then
    ( cd "$_target" \
      && TMUX_SESSION_NAME="$_session" \
         INITIATED_EXTERNALLY=true \
         source_tmux_script "$_target/.tmux" \
      || TMUX_SESSION_NAME="$_session" \
         INITIATED_EXTERNALLY=true default_tmux_session \
    ) >/dev/null 2>&1 || true
    _created=true
  fi

  # A repo's own kickoff lines: <main-root>/.jrb/wt-prompt, trusted
  # like .jrb/wt-hook (dev trust). Same rules as the prompt: no
  # double quotes, dollar signs or backticks.
  _rp="$(_main_root)/.jrb/wt-prompt"
  if test -n "$_prompt" && test -r "$_rp"; then
    if $_grep -qxF "$(openssl sha256 "$_rp")" ~/..dev.digests \
      2>/dev/null; then
      _prompt="$_prompt $(tr '\n' ' ' < "$_rp")"
    else
      echo "wt: skipped untrusted $_rp (run: dev trust $_rp)" >&2
    fi
  fi
  if test -n "$_prompt" && test -n "$WT_PROMPT_EXTRA"; then
    _prompt="$_prompt $WT_PROMPT_EXTRA"
  fi

  # Long prompts get truncated when typed into a shell that's
  # still starting, so hand Claude the prompt via a file.
  # A detached kickoff (a script's) waits its turn in run-slot, in
  # its cli pane, which shows its place in the queue meanwhile.
  if test -n "$_prompt" && test "$_created" = true; then
    _pf="$(mktemp -t wt-prompt)"
    printf '%s' "$_prompt" >"$_pf"
    _go="claude \"\$(cat $_pf)\""
    test -z "$WT_NO_ATTACH" \
      || _go="run-slot wait start new:$_session && $_go"
    tmux send-keys -t "$_session:cli" "$_go" Enter 2>/dev/null || true
  elif test -n "${_WT_CONTINUE:-}" && test "$_created" = true; then
    # A big chat goes on fresh, from a brief (claude-fresh).
    _a="$(claude-fresh resume - "$_target" 2>/dev/null)" || _a=--continue
    tmux send-keys -t "$_session:cli" "claude $_a || claude" Enter \
      2>/dev/null || true
  fi

  test -n "$WT_NO_ATTACH" && return 0
  _viewed || return 0
  tmux-attach-to-session "$_session:cli" \
    || tmux-attach-to-session "$_session:vim" \
    || ta "$_session" \
    || true
}

# Open an existing board entry by branch name (no fzf). Used
# by the order-file buffer's <CR> mapping.
_wt_open() {
  _branch="$1"
  if test -z "$_branch"; then
    echo "Usage: wt open <branch>" >&2
    exit 1
  fi
  _m="$(_wt_match "$_branch")"
  if test -z "$_m"; then
    echo "wt: no worktree for '$_branch'" >&2
    exit 1
  fi
  _wt_open_with_claude "${_m%%$(printf '\t')*}" ""
}

# `wt fix <url>` / `wt feat <url>`: derive a branch from a
# Linear URL (or description), create the worktree, then open
# it and kick off Claude on the issue. The prefix and the
# kickoff prompt both come from the command name.
_wt_typed() {
  _type="$1"
  shift
  _arg="$1"
  if test -z "$_arg"; then
    echo "Usage: wt $_type <linear-url|description>" >&2
    exit 1
  fi

  _branch="$(_branch_from "$_type" "$_arg")"
  prio warn "$_branch" || true
  _wt_add "$_branch"

  # Only Linear URLs get a Claude kickoff prompt; free text
  # just opens the worktree session.
  _done="Testing is yours: a local stack and your own browser, never my login, a token or a staging deploy as the first ask. Work that needs another ticket's PR first: wt rb that ticket, never poll it. The work has two phases. Phase 1, build and align: test the change on every surface it touches (unit, API, MCP, the app in the browser, Cypress - whichever apply). Then take objects that already exist one step past your change: for each stored shape your diff reads or writes, open a saved object of that shape in a test environment, do the next thing a user does with it, and state Real data: shape x count, result in the hand-back. Publish an artifact: what the design is, how it was tested, screenshots. Open a draft PR (CI runs on drafts) with a current body, and hand back with the PR link, the artifact link, what could bite us, and Added beyond the ask: each requirement you or a parent brief brought in that I never asked for (undo, recovery, extra modes), built at its smallest or not at all, listed as a question. No /iterate-review in phase 1: review rounds before I have seen the design are thrown away when it changes. Phase 2, polish for release, is the rd skill (/rd): /iterate-review until green, then wt rd. Going straight on is your call, the test being whether a design choice I would want to see is still open. Straight through to phase 2, and to shipping where the rules allow it (a fix PR): a bug with a clear expected result, a small change with one obvious behaviour, mechanical work, or an exact spec from me or a stakeholder. Stop after phase 1, ending on whether the design is right: new UI or behaviour where more than one reasonable design exists, or a fan-out where I gave the goal but not each case. My word overrides your call: my own words relayed verbatim in your brief (put it in RD right away or ship it when green: phase 2 now; show me first: stop after phase 1), the rd label (phase 2) or no-rd label (stop after phase 1) on the ticket (read the labels again before each hand-back), or /rd typed here. A brief's verdict on its own ideas is not my word. Say in one line which case applied and why."
  _prompt=""
  case "$_arg" in
    *linear.app/*issue/*)
      if test "$_type" = feat; then
        _prompt="Can you please read $_arg and relative feature docs? Then please grill me on the solution. Once we agree and it is built: $_done"
      else
        _prompt="Can you please fix $_arg? Please also examine the video and the images. $_done"
      fi
      ;;
    *linear.app/*project/*)
      _prompt="Can you please read the Linear project $_arg — its overview, documents, milestones and issues — and relative feature docs? Then please grill me on the solution."
      ;;
  esac

  _root="$(_main_root)"
  _wt_open_with_claude "${_root}/.worktrees/$(basename "$_branch")" \
    "$_prompt"
}

# Create the worktree and put the branch on the board.
# The optional start point is passed through to `git wc`
# (`wt review` uses it to pin a fetched PR head).
_wt_add() {
  _branch="$1"
  _start="${2:-}"
  if test -z "$_branch"; then
    echo "Usage: wt add <branch> [<start-point>]" >&2
    exit 1
  fi

  if test -n "$_start"; then
    git wc "$_branch" "$_start"
  else
    git wc "$_branch"
  fi
  _repo_hook add "$(basename "$_branch")"

  _ensure_order_dir
  _of="$(_order_file)"
  touch "$_of"

  if $_grep -qx "$_branch" "$_of" 2>/dev/null; then
    return 0
  fi

  _of_insert "$_branch" "$_of"
}

# fzf an open PR that somebody else owns. Echoes its number.
_pick_pr() {
  if ! command -v gh >/dev/null 2>&1; then
    echo "wt review needs gh" >&2
    exit 1
  fi
  _prs="$(gh pr list --limit 50 --search '-author:@me' \
    2>/dev/null)"
  if test -z "$_prs"; then
    echo "No open PRs from others" >&2
    exit 0
  fi
  printf '%s\n' "$_prs" | fzf --reverse \
    --preview 'gh pr view {1}' \
    --preview-window=right,55%,wrap \
    | awk '{ print $1 }'
}

# `wt review [<pr>|<pr-url>|<branch>]`: check somebody
# else's work out in its own worktree and open a Claude
# session primed to review it. No arg (or `:`) fzf-picks an
# open PR. The branch usually isn't local yet, so we always
# fetch first — a PR by number from refs/pull/<n>/head (so
# forks work too), a bare branch name from origin — and hand
# `wt add` the fetched sha as the start point.
_wt_review() {
  _arg="${1:-:}"
  _root="$(_main_root)"

  if test "$_arg" = ':'; then
    _arg="$(_pick_pr)"
    test -n "$_arg" || exit 0
  fi

  # All-digits = PR number; a PR URL yields one too.
  _pr=""
  case "$_arg" in
    *[!0-9]*)
      case "$_arg" in
        */pull/*)
          _pr="$(printf '%s' "$_arg" \
            | $_sed -nE 's#.*/pull/([0-9]+).*#\1#p')"
          ;;
      esac
      ;;
    *) _pr="$_arg" ;;
  esac

  _url=""
  _base=""
  _author=""
  _fork=false
  _fetched=false
  if test -n "$_pr"; then
    if ! command -v gh >/dev/null 2>&1; then
      echo "wt review <pr> needs gh" >&2
      exit 1
    fi
    _meta="$(gh pr view "$_pr" --json \
      headRefName,baseRefName,url,author,isCrossRepository \
      -q '[.headRefName, .baseRefName, .url,
           .author.login, .isCrossRepository] | @tsv' \
      2>/dev/null)"
    if test -z "$_meta"; then
      echo "No PR $_pr in $(_repo_name)" >&2
      exit 1
    fi
    _branch="$(printf '%s' "$_meta" | cut -f1)"
    _base="$(printf '%s' "$_meta" | cut -f2)"
    _url="$(printf '%s' "$_meta" | cut -f3)"
    _author="$(printf '%s' "$_meta" | cut -f4)"
    if test "$(printf '%s' "$_meta" | cut -f5)" = true
    then
      _fork=true
    fi
    # The PR ref is the one sha that's right for both a
    # same-repo PR and a fork. For a same-repo PR also
    # refresh origin/<branch>, so the worktree can track it
    # instead of sitting on a detached-ish pinned sha.
    if git -C "$_root" fetch -q origin \
        "refs/pull/${_pr}/head" 2>/dev/null; then
      _fetched=true
    fi
    if test "$_fork" != true; then
      git -C "$_root" fetch -q origin "$_branch" \
        2>/dev/null || true
    fi
  else
    _branch="$_arg"
    if git -C "$_root" fetch -q origin "$_branch" \
        2>/dev/null; then
      _fetched=true
    fi
  fi

  # Only trust FETCH_HEAD if *our* fetch wrote it.
  _head=""
  if test "$_fetched" = true; then
    _head="$(git -C "$_root" rev-parse -q --verify \
      FETCH_HEAD || true)"
  fi
  # A fork's head branch has no origin/<branch> — and a
  # same-named branch on origin would be a different one.
  _remote=""
  if test "$_fork" != true; then
    _remote="$(git -C "$_root" rev-parse -q --verify \
      "refs/remotes/origin/$_branch" || true)"
  fi
  test -n "$_head" || _head="$_remote"
  if test -z "$_head" && ! git -C "$_root" show-ref \
      --verify --quiet "refs/heads/$_branch"; then
    echo "Can't find $_branch locally or on origin" >&2
    exit 1
  fi

  # Same-repo branch: let `git wc` set up the upstream.
  # Fork PR: there's no origin/<branch>, so pin the sha we
  # fetched out of refs/pull/<n>/head.
  _start=""
  test -n "$_remote" || _start="$_head"

  _wt_path="${_root}/.worktrees/$(basename "$_branch")"
  if test -d "$_wt_path"; then
    echo "Worktree exists; opening it" >&2
  else
    # A local branch of the same name is likely a stale
    # copy of their work: fast-forward it when that's safe.
    # If it has diverged it's probably mine, not theirs —
    # never rewrite it, but say so, or the review silently
    # runs against the wrong commits.
    if git -C "$_root" show-ref --verify --quiet \
        "refs/heads/$_branch" && test -n "$_head"; then
      if git -C "$_root" merge-base --is-ancestor \
          "$_branch" "$_head"; then
        git -C "$_root" branch -f "$_branch" "$_head" \
          2>/dev/null || true
      else
        echo "WARNING: local $_branch diverges from" >&2
        echo "origin — reviewing the LOCAL copy" >&2
      fi
    fi
    _wt_add "$_branch" "$_start"
  fi

  test -n "$_base" || _base="$(_default_branch)"
  _ref="${_url:-$_branch}"
  _by=""
  if test -n "$_author"; then
    _by=" by $_author"
  fi

  # Kickoff prompt: how to review comes before the findings,
  # since the point is to start MY review, not replace it.
  _prompt="I am about to review ${_ref}${_by}"
  _prompt="$_prompt (branch ${_branch}, base ${_base})."
  _prompt="$_prompt Read the description and the full diff"
  _prompt="$_prompt against ${_base} first. Then give me two"
  _prompt="$_prompt things: 1) how to approach this review -"
  _prompt="$_prompt what to read first and in what order,"
  _prompt="$_prompt what to focus on, and what to verify by"
  _prompt="$_prompt running it; 2) your own findings, most"
  _prompt="$_prompt serious first, each with a file:line."
  _prompt="$_prompt Review only - do not change any code."

  _wt_open_with_claude "$_wt_path" "$_prompt"
}

# fzf the active board, previewing PR state + last commit.
# Echoes a branch.
_pick_active_branch() {
  _of="$(_order_file)"
  if ! test -f "$_of"; then
    echo "No order file" >&2
    return 1
  fi
  _root="$(_main_root)"
  awk '/^.+$/{print}' "$_of" \
    | fzf --reverse \
        --preview "wt-preview '$_root' {}" \
        --preview-window=right,55%,wrap
}

# Evict a worktree: remove the checkout AND delete the
# branch, but pin refs/wt/<slug> + log to the registry
# FIRST so it stays fully resurrectable via `wt resume`.
# `rm`/`remove` and bare `.` all do this — only `wt forget`
# destroys the record. Heavy work is detached to the
# background so it survives the tmux kill-session.
_wt_evict_current() {
  _git_dir="$(cd "$(git rev-parse --git-dir)" && pwd)"
  _common="$(cd "$(git rev-parse --git-common-dir)" \
    && pwd)"

  if test "$_git_dir" = "$_common"; then
    _wt_evict_leftover
    echo "Not in a worktree" >&2
    exit 1
  fi

  _root="$(_main_root)"
  _branch="$(git branch --show-current)"
  _wt_path="$(git rev-parse --show-toplevel)"
  # By path, not the caller's session: `cd <wt> && wt done` from
  # a pane in another session (the main checkout's) must not
  # take that session down.
  _cur_session="$(tmux-session-name-from-path "$_wt_path")"
  if test -n "${_WT_STATE:-}"; then
    if ! _linear "$_WT_STATE" "$_branch"; then
      echo "wt: not removing $(basename "$_wt_path")" >&2
      exit 1
    fi
    _WT_ENDED="$_WT_STATE"
    _WT_STATE=''
  fi
  cd "$_root"
  _switch_to "$_root"
  _wt_evict "$_branch" "$_wt_path" "$_cur_session"
}

# `wt rm .` from a removed worktree's dir: the dir comes back when
# its session outlived the removal (a running Claude rewrites
# .claude/ there), and git then sees the main checkout. Say it's
# already removed and finish the job: drop the dir, kill the
# session. Returns when cwd isn't such a dir; leaves a dir holding
# anything besides .claude/ (work done after the removal).
_wt_evict_leftover() {
  _lo_cwd="$(pwd -P)"
  case "$_lo_cwd" in
    */.worktrees/?*) ;;
    *) return 0 ;;
  esac
  _lo_root="${_lo_cwd%%/.worktrees/*}"
  _lo_slug="${_lo_cwd#"$_lo_root"/.worktrees/}"
  _lo_slug="${_lo_slug%%/*}"
  _lo_dir="$_lo_root/.worktrees/$_lo_slug"
  test -e "$_lo_dir/.git" && return 0
  _lo_row="$(awk -F '\t' -v s="$_lo_slug" '$1 == s' \
    "$(_registry_file)" 2>/dev/null | tail -1)"
  test -n "$_lo_row" || return 0
  _lo_branch="$(echo "$_lo_row" | cut -f2)"
  _lo_date="$(echo "$_lo_row" | cut -f4)"
  _lo_left="$(echo "$_lo_row" | cut -f5)"
  echo "wt: $_lo_slug was already removed" \
    "(${_lo_left:-removed} $_lo_date); undo with: wt resume $_lo_slug" >&2
  if test -n "${_WT_STATE:-}" && test "$_WT_STATE" != "$_lo_left"; then
    _linear "$_WT_STATE" "$_lo_branch" || true
  fi
  _lo_extra="$(ls -A "$_lo_dir" | $_grep -vx '.claude' || true)"
  if test -n "$_lo_extra"; then
    echo "wt: leaving $_lo_dir, it holds files written" \
      "after the removal:" >&2
    echo "$_lo_extra" | sed 's/^/  /' >&2
    exit 1
  fi
  # By name, not the current session: a pane cd'd here from
  # another session must not take that one down.
  _lo_session="$(tmux-session-name-from-path "$_lo_dir")"
  test "$_lo_session" != "$(tmux-session-name-from-path "$_lo_root")" \
    || _lo_session=''
  echo "wt: clearing its leftover dir and session" >&2
  _notif_clear "$_lo_dir"
  cd "$_lo_root"
  _switch_to "$_lo_root"
  nohup sh -c '
    rm -rf "$1"
    test -z "$2" || tmux kill-session -t "=$2" 2>/dev/null
  ' sh "$_lo_dir" "$_lo_session" >/dev/null 2>&1 </dev/null &
  exit 0
}

# `wt cancel`: close my open PRs from this branch (only mine: a
# `wt review` worktree carries someone else's). Reversible with
# `gh pr reopen`; a failure warns and never blocks the removal.
_close_my_prs() {
  _cp_prs="$(cd "$1" && timeout 20 gh pr list --state open \
    --author @me --head "$2" --json number -q '.[].number' \
    2>/dev/null)" || {
    echo "wt: couldn't list PRs for $2; close them by hand" >&2
    return 0
  }
  for _cp_n in $_cp_prs; do
    if (cd "$1" && timeout 20 gh pr close "$_cp_n" >/dev/null 2>&1)
    then
      echo "wt: closed PR #$_cp_n (undo: gh pr reopen $_cp_n)" >&2
    else
      echo "wt: couldn't close PR #$_cp_n" >&2
    fi
  done
}

_wt_evict() {
  _branch="${1:-}"
  _wt_path_arg="${2:-}"
  _session_arg="${3:-}"
  if test "$_branch" = '.'; then
    _wt_evict_current
    return
  elif test -z "$_branch" || test "$_branch" = ':'; then
    _branch="$(_pick_active_branch)"
  fi

  if test -z "$_branch"; then
    exit 0
  fi

  _root="$(_main_root)"
  if test -n "$_wt_path_arg"; then
    _wt_path="$_wt_path_arg"
  else
    _match="$(_wt_match "$_branch")"
    if test -z "$_match"; then
      echo "wt: no worktree for '$_branch'" >&2
      exit 1
    fi
    _wt_path="${_match%%$(printf '\t')*}"
    _match_branch="${_match#*$(printf '\t')}"
    test -z "$_match_branch" || _branch="$_match_branch"
  fi
  _wt_name="$(basename "$_wt_path")"
  if test -n "${_WT_STATE:-}" && ! _linear "$_WT_STATE" "$_branch"; then
    echo "wt: not removing $_wt_name" >&2
    exit 1
  fi
  # Key the registry + ref on the actual worktree dir — the
  # Claude-context anchor — not on the branch name.
  _slug="$_wt_name"

  # Pin the tip + register BEFORE removal so the branch is
  # resurrectable via `wt resume` after we delete it.
  _sha="$(git -C "$_root" rev-parse -q --verify \
    "refs/heads/$_branch^{commit}" \
    || git -C "$_wt_path" rev-parse -q --verify HEAD \
    || true)"
  _left="${_WT_STATE:-${_WT_ENDED:-}}"
  test -n "$_left" || _left="$(_board_section "$_branch" "$_wt_name")"
  if test -n "$_sha"; then
    git -C "$_root" update-ref "refs/wt/$_slug" "$_sha"
    _registry_append "$_slug" "$_branch" "$_sha" "$_left"
  fi
  test "$_left" = Canceled && _close_my_prs "$_root" "$_branch"
  _repo_hook rm "$_slug"
  tsp unpin "$(_repo_name):$_slug" 2>/dev/null || true

  _of="$(_order_file)"
  _ln=""
  test -f "$_of" && _ln="$(_board_line "$_of" "$_branch" "$_wt_name")"

  _session="$_session_arg"
  if test -z "$_session" && test -d "$_wt_path"; then
    _session="$(tmux-session-name-from-path "$_wt_path")"
  fi
  # Never the main checkout's session: it holds the main work.
  test "$_session" != "$(tmux-session-name-from-path "$_root")" \
    || _session=''

  _of_drop_line "$_ln" "$_of"
  _unblock_dependents "$_slug"
  _snooze_drop "$_slug"
  _w8_drop "$_slug"
  _nf_drop "$_slug"
  _notif_clear "$_wt_path"

  echo "wt: removing $_wt_name ($_branch) in background;" \
    "undo with: wt resume $_slug" >&2

  # Heavy cleanup in the background, detached so it
  # survives the tmux kill-session at the end. The branch
  # is deleted — refs/wt/<slug> keeps the commit alive;
  # only `wt forget` drops that pin.
  nohup sh -c '
    wt_path="$1"
    root="$2"
    branch="$3"
    sess="$4"

    if [ -d "$wt_path" ]; then
      git worktree remove --force "$wt_path" \
        2>/dev/null || rm -rf "$wt_path"
    fi
    git -C "$root" worktree prune 2>/dev/null
    git -C "$root" branch -D "$branch" 2>/dev/null

    if [ -n "$sess" ]; then
      docker-slot out "$sess" 2>/dev/null
      tmux kill-session -t "=$sess" 2>/dev/null
    fi
  ' sh \
    "$_wt_path" "$_root" "$_branch" "$_session" \
    >/dev/null 2>&1 </dev/null &
}

# `wt retire <branch> <Done|Canceled>` (wt-cold): a board row whose
# ticket closed without `wt done` leaves the board the way `wt done`
# takes it off, minus Linear, which is already final. A checkout
# holding work no remote has (dirty files, unpushed commits) stays on
# disk with its branch and session, off the board.
_wt_retire() {
  _root="$(_main_root)"
  _match="$(_wt_match "$1")"
  _rt_path="${_match%%$(printf '\t')*}"
  if test -n "$_rt_path"; then
    _rt_dirty="$(git -C "$_rt_path" status --porcelain | wc -l \
      | tr -d ' ')"
    _rt_ahead="$(git -C "$_rt_path" rev-list --count HEAD --not \
      --remotes 2>/dev/null || echo 0)"
    # A merged branch whose remote was deleted: its PR holds the work.
    if test "$_rt_ahead" != 0 && test "$(cd "$_root" && timeout 20 \
      gh pr list --state all --head "$1" --limit 1 --json headRefOid \
      -q '.[0].headRefOid' 2>/dev/null)" = \
      "$(git -C "$_rt_path" rev-parse HEAD)"; then
      _rt_ahead=0
    fi
    if test "$_rt_dirty$_rt_ahead" = 00; then
      _WT_ENDED="$2" _wt_evict "$1" "$_rt_path"
      return
    fi
    echo "wt: keeping $_rt_path on disk ($_rt_dirty dirty files," \
      "$_rt_ahead unpushed commits)" >&2
  fi
  _rt_name="$(basename "${_rt_path:-$1}")"
  _of="$(_order_file)"
  _of_drop_line "$(_board_line "$_of" "$1" "$_rt_name")" "$_of"
  _unblock_dependents "$_rt_name"
  _snooze_drop "$_rt_name"
  _w8_drop "$_rt_name"
  _nf_drop "$_rt_name"
  echo "wt: took $1 off the board ($2)" >&2
}

_require_worktree() {
  _git_dir="$(cd "$(git rev-parse --git-dir)" && pwd)"
  _common="$(cd "$(git rev-parse --git-common-dir)" \
    && pwd)"
  if test "$_git_dir" = "$_common"; then
    echo "Not in a worktree" >&2
    exit 1
  fi
}

# Move the current worktree's board entry into section $1
# (review sections, back to IN PROGRESS) and its Linear ticket
# to state $2. Checkout, branch and tmux session stay; `wt :`
# then shows it under that heading. Clears any block or snooze on it.
_wt_park() {
  _require_worktree
  _wt_name="$(basename "$(git rev-parse --show-toplevel)")"
  _branch="$(git branch --show-current)"
  _block_drop "$_wt_name"
  _snooze_drop "$_wt_name"
  _w8_drop "$_wt_name"
  _board_move "$_branch" "$_wt_name" "$1"
  _linear "$2" "$_branch" || true
  # Parked as merged and live: what waits on it is free, whichever way
  # it got here (agents park with rp/ra and skip `wt merged`).
  case "$1" in
    'PROD REVIEW'|'TO ANNOUNCE')
      _unblock_dependents "$_wt_name" merged || true ;;
  esac
  test "$1" = 'IN PROGRESS' \
    || _notif_clear "$(git rev-parse --show-toplevel)"
}

# Park the current worktree under # NEEDS FOCUS: the next step is
# mine and takes real focus (manual setup, a direction check), so
# quick unblocks come first. Ticket → Owner review. Unlike the review
# parks the inbox stays; notif ranks its pings after every other
# class. $1 = what I must do (optional, shown by wt-preview).
_wt_focus() {
  _require_worktree
  _self="$(basename "$(git rev-parse --show-toplevel)")"
  _branch="$(git branch --show-current)"
  _block_drop "$_self"
  _snooze_drop "$_self"
  _ensure_order_dir
  printf '%s\t%s\t%s\n' "$_self" "$_branch" "${1:-}" >> "$(_nf_file)"
  _board_move "$_branch" "$_self" 'NEEDS FOCUS'
  _linear 'Owner review' "$_branch" || true
}

# Park the current worktree under # BLOCKED until the blocker
# (a branch or dir; `:`/none = fzf) is removed, which sends it
# back to # IN PROGRESS.
_wt_block() {
  _require_worktree
  _self="$(basename "$(git rev-parse --show-toplevel)")"
  _branch="$(git branch --show-current)"
  _arg="${1:-:}"
  if test "$_arg" = ':'; then
    _arg="$(_wt_worktrees | cut -f1 | xargs -n1 basename \
      | $_grep -vxF "$_self" \
      | fzf --reverse --prompt='blocked by> ' \
        --preview "wt-preview '$(_main_root)' {}" \
        --preview-window=right,55%,wrap || true)"
    test -n "$_arg" || exit 0
  fi
  _m="$(_wt_match "$_arg")"
  if test -z "$_m"; then
    # Not a worktree: a reason ("design review with Marina", "risks
    # to settle with Pascal"). Nothing unblocks it but `wt ip`.
    _block_drop "$_self"
    printf '%s\t%s\t\t%s\n' "$_self" "$_branch" "$_arg" \
      >> "$(_blocked_file)"
    _board_move "$_branch" "$_self" 'BLOCKED'
    _notif_clear "$(git rev-parse --show-toplevel)"
    echo "wt: blocked: $_arg" >&2
    _linear Blocked "$_branch" || true
    return 0
  fi
  _blocker="$(basename "${_m%%$(printf '\t')*}")"
  if test "$_blocker" = "$_self"; then
    echo "wt: a worktree can't block itself" >&2
    exit 1
  fi
  _block_drop "$_self"
  printf '%s\t%s\t%s\n' "$_self" "$_branch" "$_blocker" \
    >> "$(_blocked_file)"
  _board_move "$_branch" "$_self" 'BLOCKED'
  _notif_clear "$(git rev-parse --show-toplevel)"
  echo "wt: blocked by $_blocker" >&2
  _linear Blocked "$_branch" || true
  _bl_id="$(lin id "${_m#*$(printf '\t')}" 2>/dev/null)" || return 0
  _self_id="$(lin id "$_branch" 2>/dev/null)" || return 0
  lin block "$_bl_id" "$_self_id" || echo "wt: Linear not updated" >&2
}

# Park the current worktree under # SNOOZED until <when>
# ("monday", "tomorrow", "+3 days", "2026-10-19", "+3 hours",
# "15:00"). The next wt run on or after that date sends it back to
# the section it came from and pings its cli pane; wt-sync runs `wt
# wake` every minute, so it wakes within a minute of its time (08:00 for
# a date alone). A block stays, and unblocking wakes it. Linear is left
# alone: snoozing is when I plan to look at it again, not a state the
# team shares.
_wt_snooze() {
  _require_worktree
  _self="$(basename "$(git rev-parse --show-toplevel)")"
  _branch="$(git branch --show-current)"
  if test -z "${1:-}"; then
    echo "wt: snooze needs a date (monday, tomorrow, +3 days," \
      "+3 hours, 15:00, 2026-10-19)" >&2
    exit 1
  fi
  _until="$(_snooze_date "$1")"
  if test -z "$_until"; then
    echo "wt: can't read '$1' as a date" >&2
    exit 1
  fi
  case "$_until" in
    *T*) _future="$(awk -v a="$_until" -v b="$(date +%FT%H:%M)" \
      'BEGIN { print (a > b) }')" ;;
    *) _future="$(test "$(echo "$_until" | tr -d '-')" -gt \
      "$(date +%Y%m%d)" && echo 1 || echo 0)" ;;
  esac
  if test "$_future" != 1; then
    echo "wt: $(echo "$_until" | tr T ' ') is not in the future" >&2
    exit 1
  fi
  _from="$(_board_section "$_branch" "$_self")"
  case "$(echo "$_from" | tr 'a-z' 'A-Z')" in
    SNOOZED) _from='' ;;
  esac
  _snooze_drop "$_self"
  _w8_drop "$_self"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$_self" "$_branch" "$_until" \
    "${_from:--}" "$(date +%s)" "$(_main_root)" >> "$(_snoozed_file)"
  _board_move "$_branch" "$_self" 'SNOOZED'
  _nf_drop "$_self"
  _notif_clear "$(git rev-parse --show-toplevel)"
  echo "wt: snoozed until $(echo "$_until" | tr T ' ')" >&2
}

# The current worktree waits on <what> (a deploy, CI, a review, a
# colleague's answer) until <when>: a duration (`1h`, `30m`, `+2
# hours`) or a time (`15:30`, `tomorrow 9am`). Until then `wt-cold`
# counts it WAITING and sends no stalled ping. Within a minute of the
# deadline, at any hour and after a reboot too, wt-sync tells its agent
# to check now (wt-tell, retried); until that lands the row is STALLED
# with "overdue: <what>" (wt-cold --overdue, listed repos). `wt w8
# done` (the event arrived), `ip`, `rt`, `rd`, `rp`, `ra`, `sz`, `done`,
# `rm` and its deadline tell end the wait; any other tell leaves it
# open and reminds the agent of it.
_wt_w8() {
  _require_worktree
  _self="$(basename "$(git rev-parse --show-toplevel)")"
  if test "${1:-}" = done; then
    _w8_drop "$_self"
    echo "wt: done waiting" >&2
    return 0
  fi
  if test -z "${1:-}" || test -z "${2:-}"; then
    echo "wt: usage: wt w8 <1h|30m|15:30|...> \"<what>\" | wt w8 done" >&2
    exit 1
  fi
  # A wait on me hides my question as WAITING, so wt-cold never
  # pings it: end the turn on the question instead.
  if printf '%s' "$2" | grep -qiE \
    '(^|[^[:alnum:]])(rasmus|me|my|user)([^[:alnum:]]|$)'; then
    echo "wt: no w8 on me: end the turn on the question (it pings)," \
      "or take your recommended answer if it's reversible" >&2
    exit 1
  fi
  _w8_in="$(echo "$1" | sed -E 's/^\+?([0-9]+) ?h$/+\1 hours/;
    s/^\+?([0-9]+) ?m$/+\1 minutes/')"
  _until="$(gdate -d "$_w8_in" +%FT%H:%M 2>/dev/null)" || _until=""
  if test -z "$_until"; then
    echo "wt: can't read '$1' as a duration or time" >&2
    exit 1
  fi
  if test "$(gdate -d "$_until" +%s)" -le "$(date +%s)"; then
    echo "wt: $(echo "$_until" | tr T ' ') is not in the future" >&2
    exit 1
  fi
  _w8_drop "$_self"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$_self" \
    "$(git branch --show-current)" "$_until" \
    "$(printf '%s' "$2" | tr '\t\n' '  ')" "$(date +%s)" "$(_main_root)" \
    >> "$(_waiting_file)"
  echo "wt: waiting on $2 until $(echo "$_until" | tr T ' ')" >&2
}

# Pin the current worktree to Alt-N (`tsp pin`), as
# <repo>:<slug>; Alt-N then attaches its existing session.
_wt_pin() {
  _slug="$(basename "$(git rev-parse --show-toplevel)")"
  if test "$(git rev-parse --show-toplevel)" = "$(_main_root)"; then
    tsp pin "$(_repo_name)" "$@"
  else
    tsp pin "$(_repo_name):$_slug" "$@"
  fi
}

# Print + copy the current worktree's slug (its session name),
# for pointing other agents or `wt` commands at it.
_wt_id() {
  _id="$(basename "$(git rev-parse --show-toplevel)")"
  printf '%s' "$_id" | pbcopy
  echo "$_id"
}

_wt_unpin() {
  _slug="$(basename "$(git rev-parse --show-toplevel)")"
  tsp unpin "${1:-$(_repo_name):$_slug}"
}

_wt_move() {
  _branch="${1:-$(git branch --show-current)}"
  _root="$(_main_root)"
  _wt_path="${_root}/.worktrees/$(basename "$_branch")"

  # Don't move the default branch
  _default="$(_default_branch)"
  if test "$_branch" = "$_default"; then
    echo "Can't move the default branch" >&2
    exit 1
  fi

  # Stash if dirty
  _has_stash=false
  if ! git diff --quiet 2>/dev/null \
    || ! git diff --cached --quiet 2>/dev/null; then
    git stash
    _has_stash=true
  fi

  # Switch current checkout to default branch
  git switch "$_default"

  # Create worktree with existing branch (no -b)
  git worktree add "$_wt_path" "$_branch"
  _repo_hook add "$(basename "$_branch")"

  # Add to order file
  _ensure_order_dir
  _of="$(_order_file)"
  touch "$_of"
  if ! $_grep -qx "$_branch" "$_of" 2>/dev/null; then
    _of_insert "$_branch" "$_of"
  fi

  # Pop stash in new worktree if we stashed
  if test "$_has_stash" = true; then
    git -C "$_wt_path" stash pop
  fi
}

# Re-materialise a removed worktree at its deterministic
# path so `claude -r` finds the same context. No arg or
# `:` opens the registry (the graveyard) in fzf.
_wt_resume() {
  _arg="${1:-:}"
  _root="$(_main_root)"
  _rf="$(_registry_file)"

  if test "$_arg" = ':'; then
    if ! test -f "$_rf"; then
      echo "Nothing removed yet (empty registry)" >&2
      exit 1
    fi
    # Reverse to newest-first, keep one row per slug.
    _sel="$(awk -F'\t' '
      { a[NR] = $0 }
      END {
        for (i = NR; i >= 1; i--) {
          split(a[i], f, "\t")
          if (!seen[f[1]]++) print a[i]
        }
      }' "$_rf" \
      | fzf --reverse --delimiter='\t' --with-nth=1,2,4 \
          --preview "git -C '$_root' log -1 --stat \
            'refs/wt/'{1} 2>/dev/null" \
          --preview-window=right,55%,wrap)"
    test -z "$_sel" && exit 0
    _slug="$(printf '%s' "$_sel" | cut -f1)"
    _branch="$(printf '%s' "$_sel" | cut -f2)"
    _left="$(printf '%s' "$_sel" | cut -f5)"
  else
    _slug="$(basename "$_arg")"
    _branch=""
    _left=""
    if test -f "$_rf"; then
      _row="$($_grep -P "^$_slug\t" "$_rf" | tail -1)"
      _branch="$(printf '%s' "$_row" | cut -f2)"
      _left="$(printf '%s' "$_row" | cut -f5)"
    fi
    test -z "$_branch" && _branch="$_arg"
  fi

  # Resume IS `wt add` from the pinned tip: same `git wc`
  # call, so the worktree lands at its original path and the
  # Claude context (keyed by that path) is right there.
  _wt_path="${_root}/.worktrees/$(basename "$_branch")"
  if test -d "$_wt_path"; then
    echo "Worktree exists; switching" >&2
    _switch_to "$_wt_path"
    return 0
  fi

  _start=""
  if git -C "$_root" show-ref --verify --quiet \
      "refs/wt/$_slug"; then
    _start="refs/wt/$_slug"
  fi
  if test -z "$_start" && ! git -C "$_root" show-ref \
      --verify --quiet "refs/heads/$_branch"; then
    echo "No ref to resume $_slug ($_branch)" >&2
    exit 1
  fi

  git wc "$_branch" $_start
  _repo_hook add "$_slug"

  # Back where it left the board. A finished ticket stays off it
  # (`wt ip` picks it back up); rows from before the column: IN PROGRESS.
  _ensure_order_dir
  _of="$(_order_file)"
  touch "$_of"
  case "$_left" in
    Done|Canceled)
      echo "wt: ticket was $_left; left off the board (wt ip to resume work)" >&2 ;;
    *)
      case "$_left" in ''|-) _left='IN PROGRESS' ;; esac
      if ! $_grep -qx "$_branch" "$_of" 2>/dev/null; then
        _of_place_in_section "$_left" "$_branch" "$_of"
      fi ;;
  esac

  # Its Claude context is keyed by this path, so pick it up.
  _WT_CONTINUE=1 _wt_open_with_claude "$_wt_path" ""
}

# Hard-forget a slug: drop branch + refs/wt/<slug> so it
# leaves the registry's resurrectable set. The Claude
# context dir is intentionally left intact.
_wt_forget() {
  _arg="$1"
  if test -z "$_arg"; then
    echo "Usage: wt forget <slug>" >&2
    exit 1
  fi
  _slug="$(basename "$_arg")"
  _root="$(_main_root)"
  _rf="$(_registry_file)"
  _branch="$_arg"
  if test -f "$_rf"; then
    _b="$($_grep -P "^$_slug\t" "$_rf" \
      | tail -1 | cut -f2)"
    test -n "$_b" && _branch="$_b"
  fi

  _wt_path="${_root}/.worktrees/${_slug}"
  if test -d "$_wt_path"; then
    git -C "$_root" worktree remove --force "$_wt_path" \
      2>/dev/null || rm -rf "$_wt_path"
    git -C "$_root" worktree prune 2>/dev/null
  fi
  git -C "$_root" branch -D "$_branch" 2>/dev/null || true
  git -C "$_root" update-ref -d \
    "refs/wt/$_slug" 2>/dev/null || true
  _registry_append "$_slug" "$_branch" "PURGED"
  _repo_hook forget "$_slug"
  echo "Forgot $_slug (Claude context left intact)" >&2
}

# Reclaim disk on existing worktrees by reinstalling so
# Yarn relinks node_modules into the hardlinks-global
# store. Run once after enabling nmMode.
_wt_dedup() {
  _root="$(_main_root)"
  _wt_dir="${_root}/.worktrees"
  if ! test -d "$_wt_dir"; then
    echo "No worktrees" >&2
    exit 0
  fi

  # Collect worktrees with a package.json, then reinstall up
  # to 8 at once. (Guard the list — macOS xargs runs once on
  # empty input.)
  _list="$(for _d in "$_wt_dir"/*/; do
    test -d "$_d" || continue
    test -f "${_d}package.json" || continue
    printf '%s\n' "$_d"
  done)"
  if test -z "$_list"; then
    echo "No worktrees to dedup" >&2
    exit 0
  fi

  printf '%s\n' "$_list" | xargs -P 8 -I {} sh -c '
    d="$1"
    echo ">> yarn install: $d" >&2
    ( cd "$d" && yarn install ) >/dev/null 2>&1 \
      && echo "   done: $d" >&2 \
      || echo "   FAILED: $d" >&2
  ' sh {}
}

# Remove Claude Code's isolated subagent worktrees
# (`.claude/worktrees/agent-*`) untouched for WT_AGENT_TTL hours
# (default 24). Claude only auto-removes the unchanged ones, and
# `wt` never shows them, so the rest are invisible work that
# piles up GBs. Uncommitted changes get a snapshot commit; every
# head is pinned to refs/wt/<id> and logged to the registry first.
_wt_clean_agents() {
  _root="$(_main_root)"
  _ttl=$(( ${WT_AGENT_TTL:-24} * 3600 ))
  _now="$(date +%s)"
  _n=0
  git -C "$_root" worktree list --porcelain | awk '
    /^worktree /{ p=$2; b=""; next }
    /^branch /{ b=$2; sub(/^refs\/heads\//, "", b); next }
    /^$/{ if (p ~ /\/\.claude\/worktrees\/agent-/) print p "\t" b; p="" }
  ' > "${TMPDIR:-/tmp}/wt-agents.$$"
  while IFS="$(printf '\t')" read -r _p _b; do
    _id="$(basename "$_p")"
    _at="$(git -C "$_p" log -1 --format=%ct 2>/dev/null || echo 0)"
    _mt="$(cd "$_p" && git status --porcelain 2>/dev/null \
      | cut -c4- | xargs stat -f %m 2>/dev/null | sort -n | tail -1)"
    test "${_mt:-0}" -gt "$_at" && _at="$_mt"
    test $((_now - _at)) -ge "$_ttl" || continue
    if test -n "$(git -C "$_p" status --porcelain 2>/dev/null)"; then
      git -C "$_p" add -A
      git -C "$_p" commit -q --no-verify \
        -m "wip: snapshot of $_id before wt clean"
    fi
    _sha="$(git -C "$_p" rev-parse -q --verify HEAD || true)"
    test -n "$_sha" || continue
    git -C "$_root" update-ref "refs/wt/$_id" "$_sha"
    _registry_append "$_id" "${_b:-DETACHED}" "$_sha"
    git -C "$_root" worktree remove --force "$_p" || continue
    test -z "$_b" || git -C "$_root" branch -D -q "$_b" || true
    _n=$((_n + 1))
  done < "${TMPDIR:-/tmp}/wt-agents.$$"
  rm -f "${TMPDIR:-/tmp}/wt-agents.$$"
  test "$_n" -eq 0 || echo "removed $_n agent worktrees" \
    "(heads pinned in refs/wt/)" >&2
}

# Remove every active worktree whose PR is merged, except
# # PROD REVIEW / # TO ANNOUNCE entries (still to verify or
# announce). Confirms
# each (read from /dev/tty); `-f`/`--force` skips prompts.
# Needs gh. Safe to run — removal is reversible via resume.
# Sweeps stale subagent worktrees first (_wt_clean_agents).
_wt_clean() {
  _force=false
  case "${1:-}" in
    -f|--force) _force=true ;;
  esac
  _wt_clean_agents

  if ! command -v gh >/dev/null 2>&1; then
    echo "wt clean needs the gh CLI" >&2
    exit 1
  fi
  _root="$(_main_root)"
  _tab="$(printf '\t')"

  # Source from disk so orphans are included, not just the
  # board. Detached worktrees (no branch) can't be PR-checked.
  _branches="$(_wt_worktrees | cut -f2 | $_grep -v '^$' \
    || true)"
  if test -z "$_branches"; then
    echo "No worktrees" >&2
    return 0
  fi

  echo "Checking PR state of worktrees..." >&2
  # Fan out the gh lookups (8 at a time); each prints its
  # branch only if its PR is merged.
  _merged="$(printf '%s\n' "$_branches" \
    | xargs -P 8 -I {} sh -c '
        root="$1"
        b="$2"
        st="$( (cd "$root" && gh pr view "$b" \
          --json state -q .state 2>/dev/null) || true )"
        if test "$st" = MERGED; then echo "$b"; fi
      ' sh "$_root" {} || true)"

  if test -z "$_merged"; then
    echo "No merged worktrees to remove." >&2
    return 0
  fi
  printf 'merged: %s\n' $_merged >&2

  for _b in $_merged; do
    # Pass the real path so eviction works for orphans whose
    # dir name differs from basename(branch).
    _p="$(_wt_worktrees \
      | awk -F"$_tab" -v b="$_b" '$2==b{print $1; exit}')"
    _sec="$(_board_section "$_b" "${_p##*/}")"
    if test "$_sec" = 'PROD REVIEW' || test "$_sec" = 'TO ANNOUNCE'
    then
      echo "  kept $_b ($_sec: wt done once verified and announced)" >&2
      continue
    fi
    if test "$_force" = true; then
      echo "removing $_b" >&2
      _wt_evict "$_b" "$_p"
    else
      printf 'Remove merged worktree %s? [y/N] ' "$_b" >&2
      { read _ans </dev/tty || _ans=n; } 2>/dev/null
      case "$_ans" in
        y|Y) _wt_evict "$_b" "$_p" ;;
        *) echo "  skipped $_b" >&2 ;;
      esac
    fi
  done
}

_usage() {
  echo "Usage: wt [.|:|open|add|fix|feat|review|id|pin|unpin|rb|fx|sz|w8|night|wake|ip|rt|rd|rp|rm|done|cancel|clean|resume|forget|dedup|move|e]" >&2
}

# Snoozed worktrees whose date has come wake up on any wt run.
case "${1:-}" in
  wake|"") : ;;
  *) _wt_wake || true ;;
esac

case "${1:-}" in
  "") _usage; exit 1 ;;
  :) _wt_pick ;;
  .) _wt_evict . ;;
  e|edit) shift; _wt_edit "$@" ;;
  open) shift; _wt_open "$@" ;;
  add) shift
    # An agent's `wt add <free text>` makes a worktree with no ticket,
    # no kickoff and no agent: an orphan I have to ask about.
    if test -n "${CLAUDECODE:-}" && test -z "${WT_ALLOW_ADD:-}" \
      && ! echo "${1:-}" | $_grep -Eiq '[a-z]+-[0-9]+'; then
      echo "wt: agents don't run 'wt add' with free text. New work is" \
        "a ticket: claim-work, then 'WT_NO_ATTACH=1 wt fix|feat <url>'" \
        "with WT_PROMPT_EXTRA (work-management skill). A shared" \
        "blocker (red dev CI): check 'gh pr list' for a fix in" \
        "flight first and wait on it ('wt rb')." >&2
      exit 1
    fi
    _wt_add "$@" ;;
  fix) shift; _wt_typed fix "$@" ;;
  feat) shift; _wt_typed feat "$@" ;;
  review) shift; _wt_review "$@" ;;
  id) _wt_id ;;
  pin) shift; _wt_pin "$@" ;;
  unpin) shift; _wt_unpin "$@" ;;
  rb) shift; _wt_block "$@" ;;
  fx|focus) shift; _wt_focus "$@" ;;
  sz|snooze) shift; _wt_snooze "$@" ;;
  w8|wait) shift; _wt_w8 "$@" ;;
  night) shift; exec wt-night "$@" ;;
  wake) _wt_wake ;;
  ip) _wt_park 'IN PROGRESS' 'In Progress' ;;
  rt) _wt_park 'TEAM REVIEW' 'Team review' ;;
  rd) _wt_park 'READY TO DEPLOY' 'Ready to deploy' ;;
  merged)
    # Already on its way to production (the repo's hook says so, e.g.
    # a ship queue deploying it): nothing waits on me but checking it
    # arrived, so Needs live verification, not Ready to deploy.
    _require_worktree
    _m_sec="$(_board_section "$(git branch --show-current)" \
      "$(basename "$(git rev-parse --show-toplevel)")")"
    _m_pr="$(timeout 20 gh pr list --state merged \
      --head "$(git branch --show-current)" --limit 1 \
      --json number --jq '.[0].number' 2>/dev/null)" || _m_pr=""
    _m_ship=""
    test -z "$_m_pr" || _m_ship="$(timeout 30 jrb-hook . shipping \
      "$_m_pr" 2>/dev/null)" || _m_ship=""
    case "$_m_sec:$_m_ship" in
      'PROD REVIEW':*|'TO ANNOUNCE':*|'READY TO DEPLOY':) ;;
      *:y) _wt_park 'PROD REVIEW' 'Needs live verification' ;;
      *) _wt_park 'READY TO DEPLOY' 'Ready to deploy' ;;
    esac
    # Parking ends any wait, so a merge that
    # still has a deploy ahead leaves the agent waiting with nothing
    # to wake it: wait on the deploy here (90m, the ship queue's
    # usual run) instead of trusting every agent to remember.
    if test "$_m_ship" = y && ! awk -F '\t' -v s="$(basename \
      "$(git rev-parse --show-toplevel)")" '$1 == s { f = 1 }
      END { exit !f }' "$(_waiting_file)" 2>/dev/null; then
      _wt_w8 90m "PR #$_m_pr deploy to production, then verify it live"
    fi
    _unblock_dependents "$(basename "$(git rev-parse --show-toplevel)")" \
      merged
    ;;
  rp) _wt_park 'PROD REVIEW' 'Needs live verification' ;;
  ra) _wt_park 'TO ANNOUNCE' 'Needs announcement' ;;
  done) shift; _WT_STATE=Done; _wt_evict "${1:-.}" ;;
  cancel) shift; _WT_STATE=Canceled; _wt_evict "${1:-.}" ;;
  retire) shift; _wt_retire "$1" "$2" ;;
  rm|remove) shift; _wt_evict "$@" ;;
  clean) shift; _wt_clean "$@" ;;
  resume) shift; _wt_resume "$@" ;;
  forget) shift; _wt_forget "$@" ;;
  dedup) _wt_dedup ;;
  move) shift; _wt_move "$@" ;;
  *)
    _usage
    exit 1
    ;;
esac
