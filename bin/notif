#!/bin/sh

set -e

# Persistent notification inbox, keyed per tmux pane. `notify`
# appends rows here; this viewer collapses them to one entry
# per pane and jumps back to it. Rows:
#   epoch ctx title message path pane mode class sid
# A Claude row's sid (session id) is where a jump goes first
# (`claude-pane open`): the chat's live pane, else the chat
# resumed in a new window. Panes die and the main checkout's
# session holds many chats, so pane and path can't find it.
# mode `sticky` (Claude) survives a visit and clears on reply;
# anything else clears on arrival. Cleared rows move to the
# recent file, listed under the pending ones in the picker. Every
# cleared row also goes to the never-trimmed `.log` (same shape:
# cleared epoch, then the row), which `notif-depth` reads.
#
#   notif               picker: pending, then recent
#   notif depth         inbox depth per day, work items per state
#   notif next <pane>   pending pane after <pane> in rank order
#                       (a focused worktree's pings first, and
#                       from anywhere else straight to them; then
#                       pings of worktrees on priority 1, 2, …
#                       (`prio`), then the rest; within each, a
#                       worktree `wt rb` blocked on another goes
#                       late, one `wt fx` parked under NEEDS FOCUS
#                       last of all; then class, see notify: env, merge,
#                       blocked, slack, fail, check, unset, stalled
#                       and step, fyi; then
#                       most follow-ups blocked on it; then
#                       oldest)
#   notif focus <pane>  toggle focus on <pane>'s worktree (else
#                       its Claude chat, else the pane): its pings
#                       rank above everything
#   notif later <pane>  re-queue <pane> at the back; if it runs
#                       a command (not a shell, Claude or an
#                       interactive app like vim), notify
#                       when that finishes instead (zsh precmd)
#   notif seen <key> [all]  drop a pane's rows; without `all` (the
#                       Claude reply hooks) merge pings stay;
#                       `stalled` drops only its `stalled` rows
#   notif seen-ref <ref>  drop the rows tagged <ref> (NOTIFY_REF),
#                       wherever a jump re-keyed them
#   notif arrive <key>  drop its non-sticky rows (focus hooks)
#   notif go <pane> <ctx> <path> [sid]  jump like the picker does;
#                       a `prio:` guess row opens its popup
#                       (`prio guess`), which clears it once settled
#   notif count         status-bar badge
#   notif clear         empty the inbox

_inbox() {
  echo "${LOCAL_CONFIG:?LOCAL_CONFIG unset}/notifications"
}

_recent() {
  echo "$(_inbox).recent"
}

# A row written while agents ran on their own servers (RAS-33) may
# key its pane %N@default: that is pane %N. Every program reading
# rows starts with this, so its first rule skips a line that is no row
# (no epoch first, or too short: a message split by raw newlines,
# RAS-47); a rewrite of the inbox drops it.
_KEY='$1 !~ /^[0-9]+$/ || NF < 5 { next }
function key(  p) {
  p = $6; sub(/@default$/, "", p)
  return p != "" ? p : $2
}
function rank(c) {
  return c == "env" ? 1 : c == "merge" ? 2 : c == "blocked" ? 3 \
    : c == "slack" ? 3.5 \
    : c == "fail" ? 4 : c == "check" ? 5 \
    : c == "stalled" || c == "step" ? 6.5 \
    : c == "fyi" ? 7 : 6
}
function slug(p,  i, s) {
  i = index(p, "/.worktrees/")
  if (!i) return ""
  s = substr(p, i + 12); sub(/\/.*/, "", s)
  return s
}
function focused(k, p,  s) {
  s = slug(p)
  if (s != "") return index(foc, " " s " ") > 0
  return index(foc, " " k " ") > 0 || ($9 != "" && index(foc, " " $9 " ") > 0)
}
function p0slug(s) {
  s = tolower(s); gsub(/[^a-z0-9]+/, "-", s)
  sub(/^-+/, "", s); sub(/-+$/, "", s)
  return substr(s, 1, 40)
}
function p0load(  l, n, t, f) {
  p0ok = 1
  if (pf == "") return
  while ((getline l < pf) > 0) {
    if (l ~ /^[ \t]*$/ || l ~ /^#/ || l ~ /^[ \t]/) continue
    n++; t = p0slug(l); if (!(t in p0o)) p0o[t] = n
  }
  close(pf)
  while ((getline l < (pf ".tickets")) > 0) {
    split(l, f, "\t")
    if (f[3] != "open" || !((t = p0slug(f[1])) in p0o)) continue
    n = p0o[t]; t = tolower(f[2])
    if (!(t in p0t) || n < p0t[t]) p0t[t] = n
  }
  close(pf ".tickets")
}
function prank(k, p,  s, t, r, a) {
  if (!p0ok) p0load()
  if (k ~ /^prio:/) {
    split(k, a, ":")
    return (a[2] in p0o) ? p0o[a[2]] : 0
  }
  s = tolower(slug(p))
  if (s == "") return 0
  if (s in p0c) return p0c[s]
  r = 0
  for (t in p0t)
    if ((!r || p0t[t] < r) && s ~ ("(^|[^a-z0-9])" t "([^0-9]|$)"))
      r = p0t[t]
  return p0c[s] = r
}
function prio(c, p, k,  s, kids, rest, j, b) {
  s = slug(p)
  if (focused(k, p)) return rank(c)
  b = prank(k, p); b = b ? b * 1000 : 1000000
  if (s != "" && index(nfc, " " s " ")) return b + 200 + rank(c) * 10
  if (s != "" && index(blk, " " s ">")) return b + 100 + rank(c) * 10
  kids = 0; rest = blk
  while (s != "" && (j = index(rest, ">" s " "))) {
    kids++; rest = substr(rest, j + 1)
  }
  return b + rank(c) * 10 + 9 - (kids > 9 ? 9 : kids)
}'

_prio_file() {
  echo "${LOCAL_CONFIG:?}/priorities"
}

_focus_file() {
  echo "$(_inbox).focus"
}

# " slug-or-pane ..." of focused places.
_focused() {
  printf ' '
  cat "$(_focus_file)" 2>/dev/null | tr '\n' ' '
}

# " slug ..." of worktrees `wt fx` parked under # NEEDS FOCUS.
_needsfocus() {
  printf ' '
  cat "${LOCAL_CONFIG:?}"/worktrees/*.needsfocus 2>/dev/null \
    | awk -F'\t' '{ printf "%s ", $1 }'
}

# " child>blocker ..." from every board's `wt rb` records, so a
# follow-up blocked on a worktree queues behind it.
_blocked() {
  printf ' '
  cat "${LOCAL_CONFIG:?}"/worktrees/*.blocked 2>/dev/null \
    | awk -F'\t' '$3 != "" { printf "%s>%s ", $1, $3 }'
}

# Drop rows for key $1 (only non-sticky ones when $2 is `arrive`;
# only `stalled` ones when it is `stalled`; all but `merge` rows when
# it is `reply`, since a merge ping is
# done when the PR merges, not when I talk to the agent), logging
# them to the recent file. Fast no-op when
# nothing matches, so the focus hooks stay cheap.
_notif_drop() {
  _d_key="$1"
  _d_mode="${2:-all}"
  _f="$(_inbox)"
  test -n "$_d_key" || return 0
  test -f "$_f" || return 0
  _d_match="$_KEY"'
    function hit() {
      if (m == "path") return $5 == k || index($5, k "/") == 1
      if (m == "ref") return $10 == k
      return key() == k && (m != "arrive" || $7 != "sticky") \
        && (m != "reply" || $8 != "merge") \
        && (m != "stalled" || $8 == "stalled")
    }'
  awk -F'\t' -v k="$_d_key" -v m="$_d_mode" "$_d_match"'
    hit() { found = 1 } END { exit !found }' "$_f" || return 0
  _now="$(date +%s)"
  awk -F'\t' -v k="$_d_key" -v m="$_d_mode" "$_d_match"'
    hit() { print }' "$_f" \
    | sed "s/^/$_now	/" | tee -a "$(_inbox).log" >> "$(_recent)"
  _tmp="$(mktemp)"
  awk -F'\t' -v k="$_d_key" -v m="$_d_mode" "$_d_match"'
    !hit()' "$_f" > "$_tmp" && mv "$_tmp" "$_f"
  _tmp="$(mktemp)"
  tail -200 "$(_recent)" > "$_tmp" && mv "$_tmp" "$(_recent)"
  tmux refresh-client -S 2>/dev/null || true
}

_notif_clear() {
  _f="$(_inbox)"
  test -s "$_f" && sed "s/^/$(date +%s)	/" "$_f" >> "$_f.log"
  : > "$_f" 2>/dev/null || true
}

# Status-bar badge: count of distinct pending panes. Prints
# "(N)  " when >0, nothing when empty.
_notif_count() {
  _f="$(_inbox)"
  test -f "$_f" || return 0
  _n="$(awk -F'\t' "$_KEY"'
    { if (!(key() in s)) { s[key()] = 1; n++ } }
    END { print n+0 }' "$_f")"
  if test "$_n" -gt 0; then
    printf '(%s)  ' "$_n"
  fi
}

# Collapse rows (on stdin, epoch first) to one line per key,
# newest first:
# key<TAB>mark<TAB>ctx<TAB>×N<TAB>message<TAB>path<TAB>sid. Keys in
# `skip` (space-separated) are left out; at most `max` lines.
_collapse() {
  awk -F'\t' -v mark="$1" -v skip=" $2 " -v max="${3:-0}" \
    -v blk="$(_blocked)" -v nfc="$(_needsfocus)" -v pf="$(_prio_file)" \
      -v foc="$(_focused)" "$_KEY"'
    {
      k = key()
      if (index(skip, " " k " ")) next
      if (!(k in ts)) { order[++n] = k; r[k] = 1e9 }
      if (prio($8, $5, k) < r[k]) r[k] = prio($8, $5, k)
      count[k]++
      if ($1 + 0 >= ts[k] + 0) {
        ts[k] = $1; ctx[k] = $2; msg[k] = $4; path[k] = $5
        if ($9 != "") sid[k] = $9
      }
    }
    END {
      for (i = 2; i <= n; i++)
        for (j = i; j > 1 && (r[order[j]] < r[order[j-1]] \
            || (r[order[j]] == r[order[j-1]] \
              && ts[order[j]] > ts[order[j-1]])); j--) {
          t = order[j]; order[j] = order[j-1]; order[j-1] = t
        }
      if (max > 0 && n > max) n = max
      for (i = 1; i <= n; i++) {
        k = order[i]
        cnt = (count[k] > 1 ? "\303\227" count[k] : "")
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", \
          k, mark, ctx[k], cnt, msg[k], path[k], sid[k]
      }
    }'
}

_pending_keys() {
  test -f "$(_inbox)" || return 0
  awk -F'\t' "$_KEY"'{ print key() }' "$(_inbox)" | sort -u \
    | tr '\n' ' '
}

_notif_list() {
  test -f "$(_inbox)" && _collapse '●' < "$(_inbox)"
  test -f "$(_recent)" || return 0
  cut -f2- "$(_recent)" | _collapse '·' "$(_pending_keys)" 10
}

# Move key $1's rows (and chat $4's, from any pane it ran in)
# onto the pane we landed on ($2, a tmux target), so M-y and
# M-i rotation see them as this pane's.
# With $3 `sticky` they also turn sticky: a session started for
# them showed me nothing yet, so the focus hooks must not clear
# them.
_notif_rekey() {
  _r_new="$(tmux display-message -p -t "$2" '#{pane_id}' \
    2>/dev/null)" || return 0
  test -n "$_r_new" || return 0
  test "$_r_new" != "$1" || test -n "${4:-}" || return 0
  _r_ctx="$(tmux display-message -p -t "$_r_new" '#S:#W.#P')"
  _f="$(_inbox)"
  _tmp="$(mktemp)"
  awk -F'\t' -v k="$1" -v n="$_r_new" -v c="$_r_ctx" \
    -v s="${3:-}" -v sid="${4:-}" "$_KEY"'
    (k != "" && key() == k) || (sid != "" && $9 == sid) {
      $2 = c; $6 = n; if (s) $7 = "sticky"
    }
    { print }
  ' OFS='\t' "$_f" > "$_tmp" && mv "$_tmp" "$_f"
  tmux refresh-client -S 2>/dev/null || true
}

# Jump to a Claude chat by its sid ($4) wherever it runs now, or
# resumed in a new window when it runs nowhere; else to a pane:
# by id while it lives, else its session:window,
# else recreate the session at its path (its worktree root, for
# a worktree; a removed one comes back via `wt resume`, Claude
# continuing). A fallback landing re-keys the rows to the pane
# landed on. Returns 1 when the place is truly gone, 2 when it is
# there but switching to it failed.
_notif_jump() {
  _j_stuck=""
  _j_key="$1"
  _j_ctx="$2"
  _j_path="$3"
  _j_sid="${4:-}"
  case "$_j_key" in
    prio:*)
      _j_t="${_j_key##*:}"
      tmux display-popup -E -w 90% -h 80% "prio guess $_j_t" 2>/dev/null \
        || tmux new-window "prio guess $_j_t" 2>/dev/null || return 2
      return 0
      ;;
  esac
  if test -n "$_j_sid"; then
    _j_live="$(claude-pane "$_j_sid" || true)" _j_to=""
    # Closed by run-slot: resume it (in its pane while that is a shell)
    # and mark it revived, so a later focus there doesn't resume it
    # again; else a new window.
    test -n "$_j_live" \
      || _j_to="$(run-slot revive "$_j_sid" 2>/dev/null)" || _j_to=""
    _j_to="${_j_live:-${_j_to:-$(claude-pane open "$_j_sid" 2>/dev/null \
      || true)}}"
    if test -n "$_j_to" && tmux switch-client -t "$_j_to" 2>/dev/null; then
      tmux select-window -t "$_j_to" 2>/dev/null || true
      tmux select-pane -t "$_j_to" 2>/dev/null || true
      if test -n "$_j_live"; then
        _notif_rekey "$_j_key" "$_j_to" "" "$_j_sid"
        _notif_drop "$_j_to" arrive
      else
        _notif_rekey "$_j_key" "$_j_to" sticky "$_j_sid"
      fi
      return 0
    fi
    test -z "$_j_to" || _j_stuck=1
  fi
  case "$_j_key" in
    %*)
      if tmux switch-client -t "$_j_key" 2>/dev/null; then
        tmux select-window -t "$_j_key" 2>/dev/null || true
        tmux select-pane -t "$_j_key" 2>/dev/null || true
        _notif_drop "$_j_key" arrive
        return 0
      fi
      # Not a bare exit status: with no client, display-message
      # -t on a dead pane falls back to another and succeeds.
      test "$(tmux display-message -p -t "$_j_key" '#{pane_id}' \
        2>/dev/null)" != "$_j_key" || _j_stuck=1
      ;;
  esac
  if tmux switch-client -t "=$_j_ctx" 2>/dev/null; then
    _notif_rekey "$_j_key" "$_j_ctx"
    _notif_drop "$(tmux display-message -p '#{pane_id}')" arrive
    return 0
  fi
  ! tmux has-session -t "=$_j_ctx" 2>/dev/null || _j_stuck=1
  _j_home="$_j_path"
  case "$_j_path" in
    */.worktrees/*)
      _j_wt="${_j_path%%/.worktrees/*}/.worktrees/"
      _j_slug="${_j_path#"$_j_wt"}"
      _j_wt="$_j_wt${_j_slug%%/*}"
      if ! test -d "$_j_wt"; then
        tmux display-message "Resuming ${_j_slug%%/*}…" 2>/dev/null
        ( cd "${_j_path%%/.worktrees/*}" \
          && WT_NO_ATTACH=1 wt resume "${_j_slug%%/*}" ) \
          >/dev/null 2>&1 || true
      fi
      _j_home="$_j_wt"
      ;;
  esac
  if test -n "$_j_home" && test -d "$_j_home"; then
    _j_sess="$(tmux-session-name-from-path "$_j_home")"
    if ! tmux has-session -t "=$_j_sess" 2>/dev/null; then
      ( cd "$_j_home" \
        && INITIATED_EXTERNALLY=true default_tmux_session ) \
        >/dev/null 2>&1 || true
    fi
    if tmux switch-client -t "=$_j_sess" 2>/dev/null \
      || tmux-attach-to-session "$_j_sess" 2>/dev/null; then
      _notif_rekey "$_j_key" "$_j_sess" sticky
      return 0
    fi
    _j_stuck=1
  fi
  test -z "$_j_stuck" || return 2
  return 1
}

# Arriving at a live place clears its non-sticky rows (in
# _notif_jump); starting or resuming a session for them does
# not. A gone place is dropped entirely, and says so; one that is
# there but would not take the switch keeps its rows (returns 2).
_go() {
  _g_rc=0
  _notif_jump "$1" "$2" "$3" "${4:-}" || _g_rc=$?
  case "$_g_rc" in
    0|2) return "$_g_rc" ;;
  esac
  _notif_drop "$1"
  tmux display-message "Cleared ${2:-$1}: gone" 2>/dev/null || true
  return 1
}

# The pending pane queued after the current one (wrapping), or
# the oldest if the current one isn't pending, so repeated M-i
# rotates through sticky entries instead of sticking.
_notif_next() {
  _f="$(_inbox)"
  _here_key="${1:-}"
  _skip="" _stuck=""
  while test -f "$_f"; do
    _line="$(awk -F'\t' -v h="$_here_key" -v blk="$(_blocked)" \
      -v skip=" $_skip " \
      -v nfc="$(_needsfocus)" -v pf="$(_prio_file)" \
      -v foc="$(_focused)" "$_KEY"'
      {
        k = key()
        if (index(skip, " " k " ")) next
        if (!(k in r)) { o[++n] = k; r[k] = 1e9; t[k] = $1 }
        if (prio($8, $5, k) < r[k]) r[k] = prio($8, $5, k)
        if (focused(k, $5)) fk[k] = 1
        if ($1 + 0 < t[k] + 0) t[k] = $1
        row[k] = k "\t" $2 "\t" $5 "\t" $9
      }
      END {
        for (i = 2; i <= n; i++)
          for (j = i; j > 1 && (r[o[j]] < r[o[j-1]] \
              || (r[o[j]] == r[o[j-1]] && t[o[j]] < t[o[j-1]])); j--) {
            x = o[j]; o[j] = o[j-1]; o[j-1] = x
          }
        for (i = 1; i <= n; i++) if (o[i] == h) at = i
        if (n == 0 || (at && n == 1)) exit
        if (!fk[h] && fk[o[1]]) { print row[o[1]]; exit }
        print row[o[at % n + 1]]
      }' "$_f")"
    test -n "$_line" || break
    _n_key="$(printf '%s' "$_line" | cut -f1)"
    _n_ctx="$(printf '%s' "$_line" | cut -f2)"
    _n_rc=0
    _go "$_n_key" "$_n_ctx" \
      "$(printf '%s' "$_line" | cut -f3)" \
      "$(printf '%s' "$_line" | cut -f4)" || _n_rc=$?
    case "$_n_rc" in
      0) return 0 ;;
      2) _skip="$_skip $_n_key" _stuck="$_stuck ${_n_ctx:-$_n_key}" ;;
    esac
  done
  if test -n "$_stuck"; then
    tmux display-message "Could not switch to$_stuck (kept in the inbox)" \
      2>/dev/null || true
    return 1
  fi
  tmux display-message "No other notifications" 2>/dev/null || true
}

# Re-queue this pane at the back as sticky: its pending rows
# move to the end, or a fresh row is added if there were none.
_notif_later() {
  _f="$(_inbox)"
  _l_key="${1:?usage: notif later <pane>}"
  touch "$_f"
  _now="$(date +%s)"
  _cmd="$(tmux display-message -p -t "$_l_key" '#{pane_current_command}')"
  case "$_cmd" in
    zsh|bash|sh|[0-9]*) ;;
    vi|vim|nvim|less|more|man|top|htop|btop|lazygit|tig|fzf|ssh|mosh) ;;
    psql|mysql|sqlite3|redis-cli|python*|ipython|irb|ghci|watch) ;;
    *)
      tmux set -p -t "$_l_key" @notif_done 1
      tmux display-message "Will notify when $_cmd finishes" 2>/dev/null \
        || true
      return 0
      ;;
  esac
  _tmp="$(mktemp)"
  awk -F'\t' -v k="$_l_key" -v now="$_now" "$_KEY"'
    key() != k { print; next }
    { $1 = now; $7 = "sticky"; held[++n] = $0 }
    END { for (i = 1; i <= n; i++) print held[i] }
  ' OFS='\t' "$_f" > "$_tmp" && mv "$_tmp" "$_f"
  if ! awk -F'\t' -v k="$_l_key" "$_KEY"'
    key() == k { found = 1 } END { exit !found }' "$_f"; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$_now" \
      "$(tmux display-message -p -t "$_l_key" '#S:#W.#P')" \
      'Snoozed' 'snoozed' "$(tmux display-message -p \
        -t "$_l_key" '#{pane_current_path}')" \
      "$_l_key" sticky >> "$_f"
  fi
  tmux refresh-client -S 2>/dev/null || true
  tmux display-message "Snoozed" 2>/dev/null || true
}

# Toggle focus on this pane's worktree (its slug), else its Claude
# chat (sid, which outlives the pane), else the pane.
_notif_focus() {
  _fo_key="${1:?usage: notif focus <pane>}"
  _fo_path="$(tmux display-message -p -t "$_fo_key" '#{pane_current_path}')"
  _fo_id="$(claude-pane of "$_fo_key" || echo "$_fo_key")"
  case "$_fo_path" in
    */.worktrees/*)
      _fo_id="${_fo_path#*/.worktrees/}"; _fo_id="${_fo_id%%/*}" ;;
  esac
  _ff="$(_focus_file)"
  touch "$_ff"
  if grep -qxF "$_fo_id" "$_ff"; then
    _tmp="$(mktemp)"
    grep -vxF "$_fo_id" "$_ff" > "$_tmp" || true
    mv "$_tmp" "$_ff"
    tmux display-message "Unfocused $_fo_id" 2>/dev/null || true
  else
    echo "$_fo_id" >> "$_ff"
    tmux display-message "Focused $_fo_id: its pings come first" \
      2>/dev/null || true
  fi
  tmux refresh-client -S 2>/dev/null || true
}

_notif_open() {
  _list="$(_notif_list)"
  if test -z "$_list"; then
    echo "Inbox empty" >&2
    exit 0
  fi

  _sel="$(printf '%s\n' "$_list" | fzf --reverse \
    --delimiter='\t' --with-nth=2,3,4,5 \
    --header 'enter: go  ctrl-x: dismiss' \
    --bind "ctrl-x:execute-silent($0 seen {1})+reload($0 _list)" \
    --preview "$0 _preview {1}" \
    --preview-window=down,40%,wrap || true)"
  test -n "$_sel" || exit 0

  _go "$(printf '%s' "$_sel" | cut -f1)" \
    "$(printf '%s' "$_sel" | cut -f3)" \
    "$(printf '%s' "$_sel" | cut -f6)" \
    "$(printf '%s' "$_sel" | cut -f7)" \
    || tmux display-message "Place gone; cleared" 2>/dev/null \
    || true
}

# Preview: a pane's rows, oldest→newest, as
# "HH:MM  title — message"; recent ones if none pending.
_notif_preview() {
  _pv_rows() {
    awk -F'\t' -v k="$1" "$_KEY"'
      key() == k {
        "date -r " $1 " +%H:%M" | getline t
        close("date -r " $1 " +%H:%M")
        printf "%s  %s \342\200\224 %s\n", t, $3, $4
      }'
  }
  _pv="$(test -f "$(_inbox)" && _pv_rows "$1" < "$(_inbox)")"
  if test -z "$_pv" && test -f "$(_recent)"; then
    _pv="$(cut -f2- "$(_recent)" | _pv_rows "$1" | tail -5)"
  fi
  printf '%s\n' "$_pv"
}

# My inbox actions feed the my-impact focus log, to tell jumps the
# inbox called me to from ones I made on my own.
case "${1:-}" in
  next|later|focus|seen|arrive|go)
    case "${2:-}" in
      %*@default) _a1="$1" _a2="${2%@default}"; shift 2
        set -- "$_a1" "$_a2" "$@" ;;
    esac ;;
esac

case "${1:-}" in
  ""|:|open|next|later|seen|focus)
    _sess="$(tmux display-message -p -t "${2:-}" '#S' 2>/dev/null)"
    focus-log notif "${1:-open}" "$_sess" 2>/dev/null || true
    ;;
esac

case "${1:-}" in
  ""|:|open) _notif_open ;;
  next) shift; _notif_next "$@" ;;
  later) shift; _notif_later "$@" ;;
  focus) shift; _notif_focus "$@" ;;
  count) _notif_count ;;
  depth) shift; exec notif-depth "$@" ;;
  seen) shift; _notif_drop "${1:-}" "${2:-reply}" ;;
  seen-path) shift; _notif_drop "${1:-}" path ;;
  seen-ref) shift; _notif_drop "${1:-}" ref ;;
  arrive) shift; _notif_drop "${1:-}" arrive ;;
  go) shift; _notif_jump "${1:-}" "${2:-}" "${3:-}" "${4:-}" ;;
  clear) _notif_clear ;;
  _list) _notif_list ;;
  _preview) shift; _notif_preview "$@" ;;
  *)
    echo "Usage: notif [open|next|later|focus|seen|arrive|count|depth|clear]" >&2
    exit 1
    ;;
esac
