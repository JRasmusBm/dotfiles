#!/bin/sh

set -e

# Persistent notification inbox. `notify` appends rows
# (epoch<TAB>context<TAB>title<TAB>message) here; this viewer
# collapses them to one entry per place, lets you jump to the
# place (fzf + Enter), and clears entries on arrival.
#
#   notif              open the inbox picker (primary action)
#   notif seen <ctx>   drop all rows for a context (focus hook)
#   notif clear        empty the inbox

if test "$(uname)" = 'Darwin'; then
  _grep='ggrep'
else
  _grep='grep'
fi

_inbox() {
  echo "${LOCAL_CONFIG:?LOCAL_CONFIG unset}/notifications"
}

# Remove every row whose context (col 2) matches $1. Fast
# path: only rewrite the file when there's actually a match,
# so the focus hooks that call this on every navigation are
# nearly free. Rewrite via temp + mv so it's atomic.
_notif_seen() {
  _ns_ctx="$1"
  _f="$(_inbox)"
  test -n "$_ns_ctx" || return 0
  test -f "$_f" || return 0
  if ! awk -F'\t' -v c="$_ns_ctx" \
    '$2 == c { found = 1 } END { exit !found }' "$_f"; then
    return 0
  fi
  _tmp="$(mktemp)"
  awk -F'\t' -v c="$_ns_ctx" '$2 != c' "$_f" > "$_tmp" \
    && mv "$_tmp" "$_f"
  # We changed the inbox → refresh the status-bar badge now.
  tmux refresh-client -S 2>/dev/null || true
}

_notif_clear() {
  _f="$(_inbox)"
  : > "$_f" 2>/dev/null || true
}

# Status-bar badge: count of distinct pending places. Prints
# "(N)  " when >0, nothing when empty (so the status segment
# self-hides). Portable distinct-count (no length(array)).
_notif_count() {
  _f="$(_inbox)"
  test -f "$_f" || return 0
  _n="$(awk -F'\t' \
    '{ if ($2 != "" && !($2 in s)) { s[$2]=1; n++ } } \
     END { print n+0 }' "$_f")"
  if test "$_n" -gt 0; then
    printf '(%s)  ' "$_n"
  fi
}

# Build the collapsed view: one line per context, newest
# first, with a ×N count. Output is TSV
# context<TAB>×N<TAB>title<TAB>message<TAB>path — col 1
# (context) + col 5 (path) are action keys, cols 2-4 shown.
_notif_list() {
  _f="$(_inbox)"
  test -f "$_f" || return 0
  awk -F'\t' '
    {
      ctx = $2
      if (!(ctx in seen)) { order[++n] = ctx; seen[ctx] = 1 }
      count[ctx]++
      # Keep the newest (largest epoch) title/message/path.
      if ($1 + 0 >= ts[ctx] + 0) {
        ts[ctx] = $1; title[ctx] = $3; msg[ctx] = $4
        path[ctx] = $5
      }
    }
    END {
      # Emit newest-first by last-seen epoch.
      for (i = 1; i <= n; i++) {
        c = order[i]
        rank[i] = ts[c]
      }
      # Simple insertion sort on the small set, desc by ts.
      for (i = 2; i <= n; i++)
        for (j = i; j > 1 && rank[j] > rank[j-1]; j--) {
          tr = rank[j]; rank[j] = rank[j-1]; rank[j-1] = tr
          to = order[j]; order[j] = order[j-1]; order[j-1] = to
        }
      for (i = 1; i <= n; i++) {
        c = order[i]
        cnt = (count[c] > 1 ? "\303\227" count[c] : "")
        printf "%s\t%s\t%s\t%s\t%s\n", \
          c, cnt, title[c], msg[c], path[c]
      }
    }' "$_f"
}

# Jump to a notification's place. Fast path: its tmux session
# is still alive → switch to it. If the session is gone (e.g.
# killed by `wt rt`/`rm`) but the worktree is still on disk,
# recreate the session at that path (same default-layout path
# `wt` uses). Returns 0 if we landed somewhere, 1 if the place
# is truly gone.
_notif_jump() {
  _j_ctx="$1"
  _j_path="$2"
  tmux switch-client -t "$_j_ctx" 2>/dev/null && return 0
  if test -n "$_j_path" && test -d "$_j_path"; then
    _j_sess="$(tmux-session-name-from-path "$_j_path")"
    if ! tmux has-session -t "$_j_sess" 2>/dev/null; then
      ( cd "$_j_path" \
        && INITIATED_EXTERNALLY=true default_tmux_session ) \
        >/dev/null 2>&1 || true
    fi
    tmux switch-client -t "$_j_sess" 2>/dev/null && return 0
    tmux-attach-to-session "$_j_sess" 2>/dev/null && return 0
  fi
  return 1
}

# Jump straight to the oldest pending notification (FIFO),
# no picker. Rows are appended chronologically, so the first
# line is the oldest. Clear each as we go (explicitly, since a
# recreated session may have a different name than the stored
# context, so the arrival hook wouldn't match); if a place is
# truly gone (worktree removed), skip to the next one.
_notif_next() {
  _f="$(_inbox)"
  while test -f "$_f"; do
    _line="$(head -1 "$_f" 2>/dev/null)"
    test -n "$_line" || break
    _ctx="$(printf '%s' "$_line" | cut -f2)"
    _path="$(printf '%s' "$_line" | cut -f5)"
    _notif_seen "$_ctx"
    _notif_jump "$_ctx" "$_path" && return 0
    # Place gone — entry already cleared; try the next one.
  done
  tmux display-message "No notifications" 2>/dev/null || true
}

_notif_open() {
  _list="$(_notif_list)"
  if test -z "$_list"; then
    echo "Inbox empty" >&2
    exit 0
  fi

  _sel="$(printf '%s\n' "$_list" | fzf --reverse \
    --delimiter='\t' --with-nth=2,3,4 \
    --preview "$0 _preview {1}" \
    --preview-window=down,40%,wrap || true)"
  test -z "$_sel" && exit 0

  _ctx="$(printf '%s' "$_sel" | cut -f1)"
  _path="$(printf '%s' "$_sel" | cut -f5)"
  test -n "$_ctx" || exit 0

  # Clear it explicitly (a recreated session may be renamed,
  # so the arrival hook might not match), then jump — to the
  # live session or, if it's gone, the worktree on disk.
  _notif_seen "$_ctx"
  _notif_jump "$_ctx" "$_path" \
    || tmux display-message "Place gone; cleared" 2>/dev/null \
    || true
}

# Preview: the raw rows for a context, oldest→newest, as
# "HH:MM  title — message".
_notif_preview() {
  _pv_ctx="$1"
  _f="$(_inbox)"
  test -f "$_f" || return 0
  awk -F'\t' -v c="$_pv_ctx" '
    $2 == c {
      "date -r " $1 " +%H:%M" | getline t
      close("date -r " $1 " +%H:%M")
      printf "%s  %s \342\200\224 %s\n", t, $3, $4
    }' "$_f"
}

case "${1:-}" in
  ""|:|open) _notif_open ;;
  next) _notif_next ;;
  count) _notif_count ;;
  seen) shift; _notif_seen "$@" ;;
  clear) _notif_clear ;;
  _preview) shift; _notif_preview "$@" ;;
  *)
    echo "Usage: notif [open|next|count|seen <ctx>|clear]" >&2
    exit 1
    ;;
esac
