{
  "cleanupPeriodDays": 1825,
  "permissions": {
    "allow": [
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "mcp__conveyor__ship_pr",
      "mcp__conveyor__cancel_ship"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledMcpjsonServers": [
    "conveyor"
  ],
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/claude-notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/accretion-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/claude-penv",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$TMUX_PANE\" ] || ~/.bin/notif seen \"$TMUX_PANE\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$TMUX_PANE\" ] || ~/.bin/notif seen \"$TMUX_PANE\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__chrome-devtools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/test-slot hook",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/heavy-slot hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/read-size-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/test-slot release --quiet",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-fable-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Marking the user's own pull requests ready for review with `gh pr ready` (never merging them)",
      "Commenting `@coderabbitai review` on the user's own pull requests to trigger a review",
      "Shipping an ice-floe PR to production through the conveyor MCP `ship_pr` after the user said to ship, merge or deploy it",
      "Resolving review threads (gh api graphql resolveReviewThread, and a reply naming the fixing commit) on the user's own ice-floe PR after the user said to ship it, when the current code already addresses the thread",
      "Read-only queries against ice-floe production or staging Postgres through `node tools/src/lib/run-prod-pg.js` (with or without `--staging`), for debugging or verification, and briefing a subagent to run them: it connects to the reader replica (port 5433), which refuses writes. Allowed: SELECT, WITH ... SELECT, EXPLAIN (not EXPLAIN ANALYZE of a write), SHOW. Not allowed: any write or DDL, pg_terminate_backend / pg_cancel_backend, advisory locks, LOCK, SET of server settings, or connecting to the writer port 5432"
    ]
  },
  "voiceEnabled": true
}
