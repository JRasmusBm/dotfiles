RPROMPT_BASE="%F{blue}%~%f"
setopt PROMPT_SUBST

date_cmd='date'
if type gdate >/dev/null ; then
  date_cmd='gdate'
fi

function preexec() {
  timer=$(($($date_cmd +%s%0N)/1000000))
}

function precmd() {
  if [ $timer ]; then
    now=$(($($date_cmd +%s%0N)/1000000))
    elapsed=$(($now-$timer))

    export RPROMPT="%F{cyan}${elapsed}ms %{$reset_color%} $RPROMPT_BASE"
    unset timer
  fi
}

# Anonymous function to avoid leaking NBSP variable.
function () {
  if [[ -n "$TMUX" ]]; then
    local LVL=$(($SHLVL - 1))
  else
    local LVL=$SHLVL
  fi
  if [[ $EUID -eq 0 ]]; then
    local SUFFIX=$(printf '#%.0s' {1..$LVL})
  else
    local SUFFIX=$(printf '\$%.0s' {1..$LVL})
  fi
  if [[ -n "$TMUX" ]]; then
    # Note use a non-breaking space at the end of the prompt because we can use it as
    # a find pattern to jump back in tmux.
    export PS1="%F{green}${SSH_TTY:+%n@%m}%f%B${SSH_TTY:+:}%b%F{blue}%1~%F{yellow}%B%(1j.*.)%(?..!)%b%f%F{red}%B${SUFFIX}%b%f %F{blue}➶%b%f "
    export ZLE_RPROMPT_INDENT=0
  else
    # Don't bother with ZLE_RPROMPT_INDENT here, because it ends up eating the
    # space after PS1.
    export PS1="%F{green}${SSH_TTY:+%n@%m}%f%B${SSH_TTY:+:}%b%F{blue}%1~%F{yellow}%B%(1j.*.)%(?..!)%b%f%F{red}%B${SUFFIX}%b%f %F{blue}➶%b "
  fi
}

export RPROMPT=$RPROMPT_BASE
export SPROMPT="zsh: correct %F{red}'%R'%f to %F{red}'%r'%f [%B%Uy%u%bes, %B%Un%u%bo, %B%Ue%u%bdit, %B%Ua%u%bbort]? "

DISABLE_AUTO_TITLE="true" # Don't rename tmux windows

[ -f $HOME/.config/broot/launcher/bash/br ] && source $HOME/.config/broot/launcher/bash/br
[ -f "/home/jrasmusbm/.ghcup/env" ] && source "/home/jrasmusbm/.ghcup/env" # ghcup-env

if test -d "$HOME/.pyenv" ; then
  export PYENV_ROOT="$HOME/.pyenv"
  # Put shims on PATH directly (the part that must happen eagerly so
  # python/pip resolve through pyenv), but defer the slow
  # `pyenv init -` (completions + the pyenv shell function) until the
  # first actual `pyenv` invocation.
  export PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"
  pyenv() {
    unset -f pyenv
    eval "$(command pyenv init -)"
    pyenv "$@"
  }
fi

export FLYCTL_INSTALL="/home/jrasmusbm/.fly"

export NVM_DIR="$HOME/.nvm"
# Lazy-load nvm: sourcing nvm.sh on every startup is slow, so define
# stubs that load the real nvm on first use of nvm/node/npm/npx.
if [ -s "$NVM_DIR/nvm.sh" ]; then
  _load_nvm() {
    unset -f nvm node npm npx yarn corepack pnpm _load_nvm
    \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  }
  nvm()     { _load_nvm; nvm "$@"; }
  node()    { _load_nvm; node "$@"; }
  npm()     { _load_nvm; npm "$@"; }
  npx()     { _load_nvm; npx "$@"; }
  yarn()    { _load_nvm; yarn "$@"; }
  corepack(){ _load_nvm; corepack "$@"; }
  pnpm()    { _load_nvm; pnpm "$@"; }
fi

