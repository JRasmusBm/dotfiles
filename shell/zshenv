#!/bin/zsh

export FZF_DEFAULT_OPTS="--preview 'preview {}'"
export LOCAL_CONFIG="$HOME/.config/jrasmusbm"
export XDG_CONFIG_HOME="$HOME/.config"
# tmux-watch keeps the live server out of /tmp (RAS-41); the shim finds
# it too, this is for the bare binary.
[[ -d $HOME/.local/state/tmux && -z ${TMUX_TMPDIR+x} ]] \
  && export TMUX_TMPDIR="$HOME/.local/state/tmux"
# Shell-opened tabs close 5 minutes after they last had focus (btabs).
export BROWSER=browse

# Aliases
alias "q"="exit"
alias "$"=""
alias "so"="source"
alias "ac"="source ./.venv/bin/activate"
alias "ls"="my-ls"
alias "grep"='my-grep'
alias "da"="deactivate"
alias "cdr"='cd `cd-root`'
alias ..="cd .."
alias 2..="cd ../.."
alias 3..="cd ../../.."
alias 4..="cd ../../../.."
alias 5..="cd ../../../../.."


alias ssh="ssh -R 127.0.0.1:2222:127.0.0.1:22"
alias hsl="pool ls"

function scpb() {
  scp -r -P2222 "$1" rasmus@127.0.0.1:"$2"
}

function b {
  f=$(mktemp)
  (
    set +e
    broot --outcmd "$f" "$@"
    code=$?
    if [ "$code" != 0 ]; then
      rm -f "$f"
      exit "$code"
    fi
  )
  code=$?
  if [ "$code" != 0 ]; then
    return "$code"
  fi
  d=$(<"$f")
  rm -f "$f"
  eval "$d"
}

source ~/.paths.sh

if [[ -n $VIRTUAL_ENV && -e "${VIRTUAL_ENV}/bin/activate" ]]; then
  source "${VIRTUAL_ENV}/bin/activate"
fi

test -f "$HOME/.cargo/env" && . "$HOME/.cargo/env"
test -f "$HOME/.rover/env" && . "/home/jrasmusbm/.rover/env"

ssh-add -k 2> /dev/null

# Private overlay (~/.private, a symlink its own link script makes):
# work env, secrets and settings that don't belong in public dotfiles.
if test -f "$HOME/.private/.zshenv" ; then
  source "$HOME/.private/.zshenv"
fi


export POETRY_VIRTUALENVS_IN_PROJECT='true'
export NODE_OPTIONS='--max-old-space-size=4096'
export SKIP_LINT_GRAPH=1
export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
export ANDROID_HOME=$HOME/Library/Android/sdk

