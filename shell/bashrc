#!/bin/bash

if test "$(uname)" = 'Darwin' ; then
  grep_cmd='ggrep'
else
  grep_cmd='grep'
fi

# Interactice Shells {{{
case $- in
  *i*) ;;
  *) return ;;
esac
#}}}

# On Termux, drop straight into the Ubuntu proot-distro if it's
# installed. Guarded so it only fires in Termux's own shell (not
# inside the proot, where $HOME isn't com.termux and proot-distro
# is absent). Bind Termux's ~/.ssh into the proot so git auth (the
# one secret not in the dotfiles repo) is shared. Set NO_PROOT=1 to
# stay in the bare Termux shell.
if echo "$HOME" | "$grep_cmd" -q 'com.termux' \
  && test -z "$NO_PROOT" \
  && command -v proot-distro > /dev/null \
  && test -d "$PREFIX/var/lib/proot-distro/installed-rootfs/ubuntu" ; then
  proot_args=""
  test -d "$HOME/.ssh" && proot_args="--bind $HOME/.ssh:/root/.ssh"
  exec proot-distro login ubuntu $proot_args
fi

# All PATH/MANPATH setup lives in paths.sh (login bash gets it via
# ~/.profile; source it here too so non-login interactive bash
# matches — paths.sh rebuilds PATH from scratch, so this is
# idempotent). paths.sh also exports DOTFILES, used just below.
source "$HOME/.paths.sh"

export FLYCTL_INSTALL="/home/jrasmusbm/.fly"
export LOCAL_CONFIG="$HOME/.config/jrasmusbm"
export plug="$DOTFILES/vim/pack/bundle/opt"

# Aliases
alias q="exit"
# alias \$=""
alias so="source"
alias ac="source ./.venv/bin/activate"
alias ls="my-ls"
if type my-grep 2> /dev/null ; then
  alias grep='my-grep'
fi
alias da="deactivate"
alias cdr='cd `cd-root`'
alias ..="cd .."
alias 2..="cd ../.."
alias 3..="cd ../../.."
alias 4..="cd ../../../.."
alias 5..="cd ../../../../.."

# History {{{
shopt -s histappend

HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
#}}}

set -o vi

shopt -s checkwinsize
shopt -s globstar

test -x "/usr/bin/lesspipe" && eval "$(SHELL=/bin/sh lesspipe)"

if test -z "${debian_chroot:-}" && test -r "/etc/debian_chroot"; then
  debian_chroot=$(cat /etc/debian_chroot)
fi

if ! echo "$HOME" | "$grep_cmd" -q 'com.termux' ; then
PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
fi

export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

test -f "$HOME/.fzf.bash" && source "$HOME/.fzf.bash"

export VISUAL=vim
export EDITOR="$VISUAL"

# Virualenvs
export WORKON_HOME=$HOME/.virtualenvs
export PROJECT_HOME=$HOME/Envs
export ANDROID_HOME=$HOME/Android/Sdk

if test -d "$HOME/.pyenv"; then
  export PYENV_ROOT="$HOME/.pyenv"
  eval "$(pyenv init --path)"
  eval "$(pyenv init -)"
fi

test -f "$HOME/.config/broot/launcher/bash/br" && source "$HOME/.config/broot/launcher/bash/br"

test -f "$HOME/.cargo/env" && . "$HOME/.cargo/env"

test -f "$HOME/.rover/env" && source "$HOME/.rover/env"
if type zoxide 2> /dev/null ; then 
				eval "$(zoxide init bash)"
fi
