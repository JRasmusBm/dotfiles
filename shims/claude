#!/bin/zsh -f
# Every `claude` launch goes through here (shims/ is first on PATH, and
# the zsh `claude` wrapper ends in `command claude`), so the settings
# each session needs are added here, not in the zsh function: shells
# keep the function they started with, and scripts (`cr`, revivers,
# `command claude`) never call it.
#
# - $CLAUDE_EXTRA_SETTINGS: private settings (an overlay's hooks, MCP
#   servers, permissions) layered on ~/.claude/settings.json. Missing
#   them, a session revived by `cr` ran with none of the overlay's
#   hooks.
# - On a borrowed login (~/.config/borrowed-logins, overlay), and while
#   the cswap shim switches to one (~/.config/cswap-rc-hold names a
#   live pid), Claude starts with `disableRemoteControl: true`. Each
#   session connected under a borrowed login pushes a notice to its
#   owner's phone. `remoteControlAtStartup: false` is not enough:
#   `--resume` of a session that had Remote Control on connects it
#   again regardless (11-11: four sessions revived on a borrowed login
#   connected, 2.1.322).
# - `--resume SID` of a session claude-archive gzipped gunzips it first
#   (claude-unarchive): --resume only finds .jsonl.
#
# Both merge into the first --settings (JSON or file) when there is
# one: a second --settings flag isn't documented to merge. The caller's
# --settings wins over the extra file; Remote Control off wins over
# both. CLAUDE_REAL names the real binary (default: the next claude on
# PATH).

real="${CLAUDE_REAL:-}"
if [[ -z "$real" ]]; then
  for d in ${(s.:.)PATH}; do
    [[ "$d" == */shims ]] && continue
    [[ -x "$d/claude" ]] && { real="$d/claude"; break; }
  done
fi
[[ -n "$real" ]] || { print -u2 "claude shim: no real claude on PATH"; exit 127; }

# Subcommands (`claude mcp …`, `claude update`) take no --settings.
case "${1:-}" in
  mcp|config|update|doctor|install|migrate-installer|setup-token|plugin|\
  --version|-v|--help|-h) exec "$real" "$@" ;;
esac

for (( i = 1; i <= $#; i++ )); do
  case "${@[i]}" in
    -r|--resume) sid="${@[i+1]:-}" ;;
    --resume=*) sid="${@[i]#--resume=}" ;;
    *) continue ;;
  esac
  [[ -n "$sid" && "$sid" != -* ]] || continue
  gz=(
    "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$sid".jsonl.gz(N)
  )
  (( $#gz )) && "${0:A:h}/../bin/claude-unarchive" "$sid" >/dev/null
done

extra='{}'
if [[ -r "${CLAUDE_EXTRA_SETTINGS:-}" ]]; then
  extra="$(jq -c . "$CLAUDE_EXTRA_SETTINGS" 2>/dev/null)" || {
    print -u2 "claude shim: unreadable JSON: $CLAUDE_EXTRA_SETTINGS"
    extra='{}'
  }
fi

off=0 hold=
[[ -r "$HOME/.config/cswap-rc-hold" ]] \
  && hold="$(<"$HOME/.config/cswap-rc-hold")"
if [[ -n "$hold" ]] && kill -0 "$hold" 2>/dev/null; then
  off=1
else
  login="$(jq -r '.oauthAccount.emailAddress // ""' ~/.claude.json \
    2>/dev/null)"
  [[ -n "$login" ]] && grep -qixF -- "$login" \
    "$HOME/.config/borrowed-logins" 2>/dev/null && off=1
fi
rc='{}'
(( off )) && rc='{"disableRemoteControl":true,"remoteControlAtStartup":false}'
[[ "$extra" == '{}' && "$rc" == '{}' ]] && exec "$real" "$@"

merge() { jq -c --argjson e "$extra" --argjson r "$rc" '$e * . * $r' <<<"$1"; }
args=() done=0
while (( $# )); do
  a="$1"; shift
  if (( ! done )) && [[ "$a" == --settings || "$a" == --settings=* ]]; then
    if [[ "$a" == --settings=* ]]; then v="${a#--settings=}"
    else v="$1"; shift; fi
    [[ "$v" == \{* ]] || v="$(<"$v")"
    args+=(--settings "$(merge "$v")")
    done=1
  else
    args+=("$a")
  fi
done
(( done )) || args=(--settings "$(merge '{}')" "${args[@]}")
exec "$real" "${args[@]}"
