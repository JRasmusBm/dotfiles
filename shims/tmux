#!/bin/sh
# Every `tmux` goes through here (shims/ is first on PATH): a guard on
# the calls that took every agent down.
#
# Refused with exit 1 and a row in $LOCAL_CONFIG/tmux-guard.log:
# - TMUX_TMPDIR set but empty or not a directory: tmux would fall back
#   to /tmp and act on the real server (a test's cleanup after its
#   temp dir is gone).
# - kill-server on `default` in the real socket dir, unless
#   TMUX_KILL_SERVER=1. Every kill-server is logged.
# A TMUX_TMPDIR other than /tmp beats $TMUX: the command reaches the
# server it names, not the pane's live one.
# TMUX_REAL names the real binary (default: the next tmux on PATH).
#
# Shells started while agents ran on their own servers (RAS-33) still
# hold TMUX_PANE=%N@default, and pass it on: the suffix is dropped
# here, from it and from -t/-s, so `-t "$TMUX_PANE"` finds the pane.

_log() {
  _l="${LOCAL_CONFIG:-$HOME/.config/jrasmusbm}/tmux-guard.log"
  printf '%s\t%s\tpid=%s\tppid=%s\tparent=%s\tcwd=%s\tTMUX_TMPDIR=%s\tTMUX=%s\targs=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$$" "$PPID" \
    "$(ps -o command= -p "$PPID" 2>/dev/null | cut -c1-200)" "$PWD" \
    "${TMUX_TMPDIR-<unset>}" "${TMUX-}" "$_argv" >> "$_l" 2>/dev/null
}

_real="${TMUX_REAL:-}"
if test -z "$_real"; then
  _ifs="$IFS"
  IFS=:
  for _d in $PATH; do
    case "$_d" in */shims) continue ;; esac
    if test -x "$_d/tmux"; then
      _real="$_d/tmux"
      break
    fi
  done
  IFS="$_ifs"
fi
test -n "$_real" || { echo "tmux: no real tmux on PATH" >&2; exit 127; }

_argv="$*"
if test "${TMUX_TMPDIR+x}" = x \
  && { test -z "$TMUX_TMPDIR" || ! test -d "$TMUX_TMPDIR"; }; then
  _log "refused: TMUX_TMPDIR empty or missing"
  echo "tmux: refused: TMUX_TMPDIR='$TMUX_TMPDIR' is empty or missing," \
    "so this would reach the real server" >&2
  exit 1
fi

# tmux prefers $TMUX's socket over TMUX_TMPDIR, so inside tmux a test's
# own TMUX_TMPDIR still reached the live server (RAS-41). A TMUX_TMPDIR
# other than /tmp wins: drop TMUX and TMUX_PANE unless $TMUX already
# names a socket in it (a pane of that server).
if test -n "${TMUX_TMPDIR:-}" && test -n "${TMUX:-}"; then
  _td="$(cd "$TMUX_TMPDIR" && pwd -P)"
  case "$_td" in
    /tmp|/private/tmp) ;;
    *)
      case "${TMUX%%,*}" in
        "$_td"/tmux-*/*|"${TMUX_TMPDIR%/}"/tmux-*/*) ;;
        *) unset TMUX TMUX_PANE ;;
      esac ;;
  esac
fi

# kill-server (or a prefix of it) as a command: first non-flag word, or
# right after a `;`. -L/-S name the socket.
_L="" _S="" _kill="" _want="" _atcmd=1 _pre=1
for _a in "$@"; do
  if test -n "$_want"; then
    case "$_want" in L) _L="$_a" ;; S) _S="$_a" ;; esac
    _want=""
    continue
  fi
  if test -n "$_pre"; then
    case "$_a" in
      -L|-S) _want="${_a#-}"; continue ;;
      -f|-c|-T) _want=x; continue ;;
      -L?*) _L="${_a#-L}"; continue ;;
      -S?*) _S="${_a#-S}"; continue ;;
      -*) continue ;;
    esac
    _pre=""
  fi
  if test -n "$_atcmd"; then
    _atcmd=""
    case "$_a" in
      kill-ser|kill-serv|kill-serve|kill-server) _kill=1 ;;
    esac
    continue
  fi
  case "$_a" in \;|*\;) _atcmd=1 ;; esac
done

if test -n "$_kill"; then
  _dir0="${TMUX_TMPDIR:-/tmp}/tmux-${UID:-$(id -u)}"
  if test -n "$_S"; then
    _sock="$_S"
  elif test -n "$_L"; then
    _sock="$_dir0/$_L"
  elif test -n "${TMUX:-}"; then
    _sock="${TMUX%%,*}"
  else
    _sock="$_dir0/default"
  fi
  case "$_sock" in
    /tmp/tmux-"${UID:-$(id -u)}"/default|/private/tmp/tmux-"${UID:-$(id -u)}"/default)
      if test "${TMUX_KILL_SERVER:-}" != 1; then
        _log "refused: kill-server $_sock"
        echo "tmux: refused: kill-server on $_sock holds live agents" \
          "(TMUX_KILL_SERVER=1 to mean it; tmux-kill-all does)" >&2
        exit 1
      fi ;;
  esac
  _log "allowed: kill-server $_sock"
fi

test -z "${TMUX_PANE+x}" || TMUX_PANE="${TMUX_PANE%@default}"
_n=$#
_tv=""
while test "$_n" -gt 0; do
  _a="$1"
  shift
  if test -n "$_tv"; then
    _a="${_a%@default}"
    _tv=""
  else
    case "$_a" in
      -t|-s) _tv=1 ;;
      -t?*@default|-s?*@default) _a="${_a%@default}" ;;
    esac
  fi
  set -- "$@" "$_a"
  _n=$((_n - 1))
done

# A server started from launchd (no LANG) gives its panes the C locale:
# vim then reads UTF-8 as latin1.
export LANG="${LANG:-en_US.UTF-8}"
exec "$_real" "$@"
